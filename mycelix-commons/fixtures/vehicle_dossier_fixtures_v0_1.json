      },
      "invariants": [
        "private_route_trace_not_shared_by_default",
        "expired_or_absent_consent_denies_release"
      ]
    },
    {
      "id": "VD08_INCOMPATIBLE_PART",
      "expected": "reject_qualified_install_claim",
      "input": {

        "party_signatures": 2
      },
      "invariants": [
        "both_parties_bound_to_same_transfer_digest",
        "legal_title_status_remains_jurisdiction_scoped"
      ]
    },
    {
      "id": "VD05_COMPETING_TRANSFERS",
      "expected": "retain_disputed",
      "input": {
        "event_kind": "transfer_acknowledged",
        "overlapping_claims": 2,
        "common_authority_receipt": null
      },
      "invariants": [
        "no_last_writer_wins",
        "preserve_both_signed_histories"
      ]

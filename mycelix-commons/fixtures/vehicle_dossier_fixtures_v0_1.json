{
  "corpus_version": "mycelix-vehicle-dossier-fixtures/0.1",
  "status": "synthetic-contract-fixtures-not-deployed",
  "claim_ceiling": [
    "Fixtures exercise intended decisions only; they do not prove correct current production behavior.",
    "Public/private visibility includes metadata risks beyond payload JSON.",
    "Signed ownership assertions do not establish legal title.",
    "Repair events and part identity do not prove workmanship or safety."
  ],
  "schema_ref": "../schemas/vehicle_record_envelope_v0_1.schema.json",
  "fixtures": [
    {
      "id": "VD01_VALID_REPAIR_ATTESTATION",
      "expected": "accept_as_scoped_provider_assertion",
      "input": {
        "event_kind": "maintenance_performed",
        "claim_status": "counterparty_attested",
        "visibility_policy": "shared_pseudonymous"
      },
      "invariants": [
        "opaque_vehicle_ref",
        "provider_credential_scope_checked_separately",
        "work_procedure_and_part_revision_referenced",
        "post_repair_measurement_present",
        "public_payload_has_no_direct_identifiers"
      ]
    },
    {
      "id": "VD02_UNSIGNED_REPAIR",
      "expected": "retain_as_unverified_assertion",
      "input": {
        "event_kind": "maintenance_performed",
        "signature": null,
        "claim_status": "asserted"
      },
      "invariants": [
        "must_not_render_as_provider_verified",
        "missing_signature_is_visible"
      ]
    },
    {
      "id": "VD03_UNILATERAL_TRANSFER",
      "expected": "keep_transfer_pending",
      "input": {
        "event_kind": "transfer_proposed",

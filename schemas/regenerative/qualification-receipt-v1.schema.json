{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mycelix://schemas/regenerative/qualification-receipt-v1",
  "title": "REGEN Qualification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "subject",
    "campaign",
    "environment",
    "dependencies",
    "fixtures",
    "assertions",
    "result",
    "proposition",
    "non_claims",
    "evidence_refs"
  ],
  "properties": {
    "schema": {"const": "mycelix.regen.qualification-receipt-v1"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "declared_identity", "observed_identity", "git"],
      "properties": {
        "class": {"enum": ["ProductHead", "IntegrationMerge", "ReleaseArtifact", "ExternalFixture"]},
        "declared_identity": {"type": "string", "minLength": 1, "maxLength": 512},
        "observed_identity": {"type": "string", "minLength": 1, "maxLength": 512},
        "git": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "commit_sha", "tree_sha", "parent_shas"],
              "properties": {
                "repository": {"type": "string", "minLength": 1, "maxLength": 256},
                "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "tree_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
                "parent_shas": {
                  "type": "array",
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
                }
              }
            }
          ]
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "workflow_ref", "run_ref", "job_ref", "executed"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "workflow_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "run_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "job_ref": {"type": ["string", "null"], "maxLength": 256},
        "executed": {"type": "boolean"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "operating_system", "toolchains"],
      "properties": {
        "runner": {"type": "string", "minLength": 1, "maxLength": 256},
        "operating_system": {"type": "string", "minLength": 1, "maxLength": 256},
        "toolchains": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "identities"],
      "properties": {
        "state": {"enum": ["ProductFrozen", "ExecutionResolved", "Unresolved"]},
        "identities": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "digest"],
            "properties": {
              "kind": {"type": "string", "minLength": 1, "maxLength": 128},
              "digest": {"type": "string", "minLength": 3, "maxLength": 512}
            }
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "git_blob"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_blob": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "result": {"enum": ["pass", "fail", "indeterminate"]},
          "details": {"type": "string", "maxLength": 2048}
        }
      }
    },
    "result": {"enum": ["pass", "fail", "indeterminate"]},
    "proposition": {"type": "string", "minLength": 1, "maxLength": 4096},
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    }
  }
}

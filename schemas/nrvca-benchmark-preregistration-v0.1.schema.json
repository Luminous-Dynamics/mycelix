{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/schemas/nrvca-benchmark-preregistration-v0.1.schema.json",
  "title": "NRVCA benchmark preregistration v0.1",
  "description": "Pre-results contract for a national-accounting bridge evaluation; schema validity does not establish source truth or empirical performance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "task_type",
    "title",
    "hypothesis",
    "null_hypothesis",
    "scope",
    "source_policy",
    "source_ids",
    "arms",
    "metrics",
    "comparison_protocol",
    "failure_policy",
    "guardrails",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "nrvca-benchmark/0.1"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "status": {
      "enum": [
        "design_only",
        "preregistered",
        "in_progress",
        "completed",
        "invalidated"
      ]
    },
    "task_type": {
      "enum": [
        "accounting_reconciliation",
        "nowcasting",
        "decision_value",
        "outcome_monitoring",
        "coverage_quality"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "null_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "geographic_level",
        "period_scope",
        "unit_of_analysis",
        "out_of_scope"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "geographic_level": {
          "enum": [
            "national",
            "subnational",
            "multi_country"
          ]
        },
        "period_scope": {
          "type": "string",
          "minLength": 1
        },
        "unit_of_analysis": {
          "type": "string",
          "minLength": 1
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest_required_before_execution",
        "rights_review_required",
        "vintage_policy",
        "time_alignment_policy",
        "missingness_policy",
        "revision_policy"
      ],
      "properties": {
        "content_digest_required_before_execution": {
          "const": true
        },
        "rights_review_required": {
          "const": true
        },
        "vintage_policy": {
          "enum": [
            "frozen_vintage_per_run",
            "new_vintage_is_new_run"
          ]
        },
        "time_alignment_policy": {
          "enum": [
            "explicit_alignment_only",
            "no_implicit_calendar_hydrological_join"
          ]
        },
        "missingness_policy": {
          "enum": [
            "preserve_unknown_and_report_coverage",
            "exclude_only_with_reason_and_census"
          ]
        },
        "revision_policy": {
          "enum": [
            "revisions_are_new_vintages",
            "use_latest_only_for_descriptive_not_real_time_tasks"
          ]
        }
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arm_id",
          "role",
          "method",
          "description",
          "resource_budget_policy"
        ],
        "properties": {
          "arm_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "role": {
            "enum": [
              "incumbent",
              "simple_baseline",
              "strong_baseline",
              "candidate",
              "ablation"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resource_budget_policy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "definition",
          "unit",
          "direction",
          "primary",
          "acceptance_rule",
          "guardrail"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "higher_is_better",
              "lower_is_better",
              "target_range",
              "zero_tolerance"
            ]
          },
          "primary": {
            "type": "boolean"
          },
          "target_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "practical_effect_threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "acceptance_rule": {
            "type": "string",
            "minLength": 1
          },
          "guardrail": {
            "type": "boolean"
          }
        }
      }
    },
    "comparison_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preregister_before_results",
        "sampling_or_split",
        "independent_oracle",
        "uncertainty_method",
        "subgroup_policy",
        "multiple_comparison_policy"
      ],
      "properties": {
        "preregister_before_results": {
          "const": true
        },
        "sampling_or_split": {
          "type": "string",
          "minLength": 1
        },
        "independent_oracle": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty_method": {
          "type": "string",
          "minLength": 1
        },
        "subgroup_policy": {
          "type": "string",
          "minLength": 1
        },
        "multiple_comparison_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_failed_runs",
        "retain_unfavourable_results",
        "excluded_case_ledger",
        "no_posthoc_threshold_changes"
      ],
      "properties": {
        "retain_failed_runs": {
          "const": true
        },
        "retain_unfavourable_results": {
          "const": true
        },
        "excluded_case_ledger": {
          "const": true
        },
        "no_posthoc_threshold_changes": {
          "const": true
        }
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

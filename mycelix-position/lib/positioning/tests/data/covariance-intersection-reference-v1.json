{
  "schema": "mycelix-position-covariance-intersection-reference-v1",
  "profile": "DiagonalCovarianceIntersectionReferenceV1",
  "status": "research-only independent equation reference; does not call PeerFusion3D or covariance_intersection_3d",
  "scope": "Pairwise 3D estimates with diagonal covariance only. This is not a full 3x3 covariance CI, a multi-source optimizer, or a measurement/provenance validation.",
  "equation": {
    "precision_i": "J_i = 1 / P_i",
    "fused_precision_i": "J_f = omega * J_a + (1 - omega) * J_b",
    "fused_variance_i": "P_f = 1 / J_f",
    "fused_mean_i": "x_f = P_f * (omega * J_a * x_a + (1 - omega) * J_b * x_b)"
  },
  "decision_rules": [
    "Each mean and diagonal covariance vector has exactly three finite elements.",
    "Each covariance diagonal value must be strictly positive and finite. Singular or zero-variance inputs require a separately qualified model and are rejected by this reference.",
    "omega must be finite and in [0,1]; it is rejected rather than silently clamped.",
    "Every reciprocal, weighted precision, numerator, output covariance and output mean must remain finite, and output covariance must be strictly positive.",
    "Trust, reputation, confidence and source count do not appear in the CI numerical equations; they belong to admission policy and provenance.",
    "The CI covariance is an information-weighted convex combination, so each positive diagonal output variance lies between the corresponding input variances."
  ],
  "case_count": 23,
  "valid_case_count": 12,
  "invalid_case_count": 11,

  "mutation_controls": [
    {
      "id": "CI3D-MUT-001",
      "description": "Multiply precision from two equal unit covariance estimates as if inputs were independent, incorrectly halving covariance.",
      "must_be_detected_by": "CI3D-001-equal-unit-covariance;CI3D-002-large-disagreement-no-spurious-precision"
    },
    {
      "id": "CI3D-MUT-002",
      "description": "Compute mean as a trust-weighted average while claiming it is information-form CI.",
      "must_be_detected_by": "CI3D-003-unequal-diagonal-covariance;CI3D-006-asymmetric-weight"
    },
    {
      "id": "CI3D-MUT-003",
      "description": "Silently clamp invalid omega instead of rejecting it.",
      "must_be_detected_by": "CI3D-X01-negative-omega;CI3D-X02-omega-above-one;CI3D-X03-nan-omega"
    },
    {
      "id": "CI3D-MUT-004",
      "description": "Replace zero/negative/non-finite covariance with a fabricated high-precision surrogate.",
      "must_be_detected_by": "CI3D-X06-negative-covariance;CI3D-X07-zero-covariance;CI3D-X08-nan-covariance"
    },
    {
      "id": "CI3D-MUT-005",
      "description": "Ignore non-finite intermediate/output arithmetic.",
      "must_be_detected_by": "CI3D-X09-inverse-overflow;CI3D-X10-weighted-mean-overflow;CI3D-X11-covariance-overflow"
    },
    {
      "id": "CI3D-MUT-006",
      "description": "Use trust/reputation weight as a covariance precision multiplier.",
      "must_be_detected_by": "CI3D-001-equal-unit-covariance;CI3D-004-omega-one-selects-a"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/conformance/qual-001s/qualification_vectors_v1.schema.json",
  "title": "QUAL-001S Semantic Qualification Corpus V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "revision",
    "qualification_target",
    "vectors"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.qual-001s.semantic-corpus-v1"
    },
    "corpus_id": {
      "const": "QUAL-001S"
    },
    "revision": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "qualification_target": {
      "const": "mycelix.qual.static-subject-independence.v0.3"
    },
    "vectors": {
      "type": "array",
      "minItems": 28,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"
    },
    "state": {
      "enum": [
        "UNAVAILABLE",
        "OBSERVED",
        "VERIFIED",
        "CONTRADICTED"
      ]
    },
    "authority": {
      "enum": [
        "NONE",
        "AUTHORITY_AUTHORIZED",
        "AUTHORITY_REJECTED",
        "NOT_ACCEPTED",
        "EXECUTION_OBSERVED",
        "EXECUTION_FAILED",
        "PROVENANCE_MISMATCH",
        "EVIDENCE_MISSING",
        "CONFORMANCE_CONTRADICTED"
      ]
    },
    "claim": {
      "enum": [
        "evidence_only",
        "execution_observed",
        "successor_conformance",
        "rotation_authorization",
        "rotation_adoption",
        "post_adoption_independence"
      ]
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_id",
        "kind",
        "proposition_id",
        "source_identity",
        "epoch_id",
        "requested_claims",
        "admitted_claims",
        "theorem",
        "upstream_evidence",
        "evidence_disposition",
        "authority_outcome",
        "expected_state",
        "expected_claims",
        "nonclaims"
      ],
      "properties": {
        "vector_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "positive",
            "negative",
            "metamorphic",
            "provenance",
            "availability"
          ]
        },
        "proposition_id": {
          "$ref": "#/$defs/id"
        },
        "source_identity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "epoch_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requested_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "uniqueItems": true
        },
        "admitted_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "uniqueItems": true
        },
        "theorem": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upstream_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "evidence_disposition": {
          "$ref": "#/$defs/state"
        },
        "authority_outcome": {
          "$ref": "#/$defs/authority"
        },
        "expected_state": {
          "$ref": "#/$defs/state"
        },
        "expected_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "uniqueItems": true
        },
        "nonclaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "target": {
              "type": "string"
            },
            "expected_effect": {
              "type": "string"
            },
            "fixture": {
              "type": "string"
            },
            "before_wire": {
              "type": "string"
            },
            "after_wire": {
              "type": "string"
            },
            "expected_canonical": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

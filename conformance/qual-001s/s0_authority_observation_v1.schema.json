{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/conformance/qual-001s/s0_authority_observation_v1.schema.json",
  "title": "QUAL-001S S0 Authority Observation V1",
  "description": "Typed observation record for S0 authorization and dispatch. API acceptance is not execution; execution observation is not qualification or adoption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "epoch_id",
    "repository_id",
    "repository_full_name",
    "s0_workflow_source_commit_sha",
    "s1_workflow_source_commit_sha",
    "dispatch_nonce_hex",
    "event_type",
    "request_authentication",
    "actor_authorization",
    "event_authorization",
    "workflow_source_authentication",
    "dispatch_result",
    "run_attribution",
    "observation_state"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.qual-001s.s0-authority-observation-v1"
    },
    "profile": {
      "const": "mycelix.qual.static-subject-independence.v0.3"
    },
    "epoch_id": {
      "$ref": "#/$defs/epoch"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repository_full_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "s0_workflow_source_commit_sha": {
      "$ref": "#/$defs/git_sha"
    },
    "s1_workflow_source_commit_sha": {
      "$ref": "#/$defs/git_sha"
    },
    "dispatch_nonce_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_type": {
      "const": "workflow_dispatch"
    },
    "request_authentication": {
      "$ref": "#/$defs/disposition"
    },
    "actor_authorization": {
      "$ref": "#/$defs/disposition"
    },
    "event_authorization": {
      "$ref": "#/$defs/disposition"
    },
    "workflow_source_authentication": {
      "$ref": "#/$defs/disposition"
    },
    "dispatch_result": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "UNOBSERVED"
      ]
    },
    "run_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "OBSERVED",
            "UNOBSERVED",
            "CONTRADICTED"
          ]
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workflow_file_commit_sha": {
          "$ref": "#/$defs/git_sha"
        }
      }
    },
    "observation_state": {
      "enum": [
        "OBSERVED",
        "UNAVAILABLE",
        "CONTRADICTED"
      ]
    }
  },
  "$defs": {
    "epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source"
      ],
      "properties": {
        "state": {
          "enum": [
            "OBSERVED",
            "UNAVAILABLE",
            "CONTRADICTED"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "rule_id": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}

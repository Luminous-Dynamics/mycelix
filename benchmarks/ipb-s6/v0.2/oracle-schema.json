{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/benchmarks/ipb-s6/v0.2/oracle-schema.json",
  "title": "IPB-S6 v0.2 red-team oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "oracle_version",
    "synthetic",
    "status",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "oracle_version": {
      "const": "0.2"
    },
    "synthetic": {
      "const": true
    },
    "status": {
      "const": "development_oracle_not_independently_adjudicated"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "action_outcome",
          "authorization_disposition",
          "claim_disposition",
          "execution_state",
          "mutation_count",
          "retry_count",
          "source_independence",
          "required_reason_codes",
          "prohibited_inferences"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^S6R-[0-9]{3}$"
          },
          "action_outcome": {
            "enum": [
              "ALLOW_SCOPED",
              "ALLOW_PARTIAL",
              "BLOCK",
              "HOLD_FOR_RECONCILIATION"
            ]
          },
          "authorization_disposition": {
            "enum": [
              "verified",
              "invalid",
              "issuer_untrusted",
              "revoked",
              "expired",
              "not_yet_valid",
              "status_unknown",
              "scope_mismatch"
            ]
          },
          "claim_disposition": {
            "enum": [
              "supported",
              "not_evaluated",
              "contested",
              "unsupported",
              "stale",
              "indeterminate"
            ]
          },
          "execution_state": {
            "enum": [
              "NOT_STARTED",
              "UNKNOWN",
              "RECONCILED_SUCCESS",
              "RECONCILED_FAILURE",
              "COMPENSATION_REQUIRED"
            ]
          },
          "mutation_count": {
            "type": "integer",
            "minimum": 0
          },
          "retry_count": {
            "type": "integer",
            "minimum": 0
          },
          "source_independence": {
            "enum": [
              "not_applicable",
              "single_common_upstream",
              "independent_sources"
            ]
          },
          "required_reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prohibited_inferences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

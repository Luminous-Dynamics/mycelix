{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/benchmarks/ipb-s6/v0.1/oracle-schema.json",
  "title": "IPB-S6 synthetic scenario oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "synthetic",
    "as_of",
    "status",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "corpus_version": {
      "const": "0.1"
    },
    "synthetic": {
      "const": true
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "development_oracle_not_independently_adjudicated"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "action_outcome",
          "expected_claim_dispositions",
          "prohibited_inferences",
          "side_effect_expectation"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^S6-[0-9]{3}$"
          },
          "action_outcome": {
            "enum": [
              "ALLOW_SCOPED",
              "ALLOW_PARTIAL",
              "BLOCK",
              "HOLD_FOR_RECONCILIATION"
            ]
          },
          "expected_claim_dispositions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_ref",
                "dimension",
                "disposition"
              ],
              "properties": {
                "asset_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "dimension": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "prohibited_inferences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "side_effect_expectation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

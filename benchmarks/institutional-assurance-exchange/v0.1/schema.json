{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/benchmarks/institutional-assurance-exchange/v0.1/schema.json",
  "title": "Institutional Assurance Exchange decision packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchange_version",
    "packet_id",
    "created_at",
    "query",
    "intent_baseline",
    "claims",
    "authority",
    "decision",
    "replay",
    "execution",
    "evidence_receipts"
  ],
  "properties": {
    "exchange_version": {
      "const": "0.1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "intent_baseline": {
      "$ref": "#/$defs/intentBaseline"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "replay": {
      "$ref": "#/$defs/replay"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "evidence_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceReceipt"
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "purpose",
        "asset_ref",
        "requested_by_ref",
        "effective_at",
        "known_at"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "requested_by_ref": {
          "type": "string",
          "minLength": 1
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "known_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "intentBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "baseline_id",
        "version",
        "sha256",
        "approval_ref",
        "approved_by_ref",
        "approved_at",
        "source_refs"
      ],
      "properties": {
        "system_id": {
          "const": "symthaea"
        },
        "baseline_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        },
        "approved_by_ref": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ref",
        "asset_ref",
        "dimension",
        "disposition",
        "source_refs",
        "competence_ref",
        "effective_from",
        "observed_at",
        "freshness_until",
        "limitations",
        "source_receipt_refs"
      ],
      "properties": {
        "claim_ref": {
          "type": "string",
          "minLength": 1
        },
        "asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": [
            "title",
            "beneficial_interest",
            "possession",
            "custody",
            "encumbrance",
            "permitted_use",
            "valuation",
            "condition",
            "provenance",
            "insurance",
            "operational_authority",
            "operational_dependency",
            "object_identity"
          ]
        },
        "disposition": {
          "enum": [
            "supported_within_scope",
            "partially_supported",
            "contested",
            "indeterminate",
            "unavailable",
            "stale",
            "contradicted",
            "unsupported"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "competence_ref": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "freshness_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_receipt_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_ref",
        "subject_ref",
        "entity_ref",
        "action_scope",
        "purpose_scope",
        "asset_scope",
        "valid_from",
        "valid_through",
        "verification_state",
        "verifier_ref"
      ],
      "properties": {
        "authorization_ref": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "entity_ref": {
          "type": "string",
          "minLength": 1
        },
        "action_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purpose_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asset_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_through": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verification_state": {
          "enum": [
            "verified",
            "invalid",
            "revoked",
            "expired",
            "not_yet_valid",
            "status_unknown",
            "issuer_untrusted",
            "scope_mismatch",
            "not_adjudicated"
          ]
        },
        "verifier_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "reason_codes",
        "supporting_claim_refs",
        "required_evidence",
        "limitations",
        "policy_ref",
        "evaluator_ref",
        "evaluated_at"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "ALLOW_SCOPED",
            "ALLOW_PARTIAL",
            "BLOCK",
            "HOLD_FOR_RECONCILIATION"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supporting_claim_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_ref": {
          "type": "string",
          "minLength": 1
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_at",
        "known_at",
        "prior_decision_refs",
        "supersedes_refs",
        "invalidation_refs"
      ],
      "properties": {
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "known_at": {
          "type": "string",
          "format": "date-time"
        },
        "prior_decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invalidation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "operation_ref",
        "idempotency_ref",
        "mutation_count",
        "retry_count",
        "reattempt_permitted",
        "reconciliation_required"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_STARTED",
            "PREPARED",
            "SUBMITTED",
            "ACKNOWLEDGED",
            "UNKNOWN",
            "RECONCILED_SUCCESS",
            "RECONCILED_FAILURE",
            "COMPENSATION_REQUIRED"
          ]
        },
        "operation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "mutation_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "reattempt_permitted": {
          "type": "boolean"
        },
        "reconciliation_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reattempt_permitted": {
                "const": false
              },
              "reconciliation_required": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "mutation_count": {
                "minimum": 1
              },
              "operation_ref": {
                "type": "string"
              },
              "idempotency_ref": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "evidenceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_ref",
        "source_ref",
        "source_version",
        "content_digest_sha256",
        "retrieved_at",
        "observed_at",
        "effective_from",
        "effective_through",
        "adapter_ref",
        "adapter_build_sha256",
        "upstream_provider_refs",
        "completeness",
        "attestation_ref",
        "signature_verification",
        "issuer_trust_state"
      ],
      "properties": {
        "receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "content_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_through": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_ref": {
          "type": "string",
          "minLength": 1
        },
        "adapter_build_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "upstream_provider_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "attestation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature_verification": {
          "enum": [
            "not_provided",
            "verified",
            "invalid",
            "verification_unknown"
          ]
        },
        "issuer_trust_state": {
          "enum": [
            "trusted",
            "untrusted",
            "unknown",
            "not_applicable"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "state": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "disposition": {
                "const": "HOLD_FOR_RECONCILIATION"
              }
            },
            "required": [
              "disposition"
            ]
          }
        },
        "required": [
          "decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authority": {
            "properties": {
              "verification_state": {
                "enum": [
                  "invalid",
                  "revoked",
                  "expired",
                  "not_yet_valid",
                  "status_unknown",
                  "issuer_untrusted",
                  "scope_mismatch",
                  "not_adjudicated"
                ]
              }
            },
            "required": [
              "verification_state"
            ]
          }
        },
        "required": [
          "authority"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "disposition": {
                "enum": [
                  "BLOCK",
                  "HOLD_FOR_RECONCILIATION"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          }
        },
        "required": [
          "decision"
        ]
      }
    }
  ]
}

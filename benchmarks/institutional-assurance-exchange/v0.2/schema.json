{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/benchmarks/institutional-assurance-exchange/v0.2/schema.json",
  "title": "Institutional Assurance Exchange vertical-slice fixture v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchange_version",
    "synthetic",
    "status",
    "packet_id",
    "institution",
    "asset",
    "source_brief",
    "intent_candidates",
    "intent_baseline",
    "claim_observations",
    "evidence_receipts",
    "authority",
    "queries",
    "operation_history",
    "execution_control",
    "environment",
    "policy_ref",
    "evaluator_ref"
  ],
  "properties": {
    "exchange_version": {
      "const": "0.2"
    },
    "synthetic": {
      "const": true
    },
    "status": {
      "const": "development"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "institution": {
      "type": "object",
      "required": [
        "entity_ref",
        "label"
      ],
      "properties": {
        "entity_ref": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_ref",
        "asset_class",
        "contracting_entity_ref"
      ],
      "properties": {
        "asset_ref": {
          "type": "string"
        },
        "asset_class": {
          "type": "string"
        },
        "contracting_entity_ref": {
          "type": "string"
        }
      }
    },
    "source_brief": {
      "type": "object",
      "required": [
        "document_ref",
        "version",
        "content"
      ],
      "properties": {
        "document_ref": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "intent_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement_ref",
          "source_document_ref",
          "source_version",
          "span_start_byte",
          "span_end_byte",
          "exact_text",
          "modality",
          "applies_to_actions",
          "claim_dimensions",
          "conditions"
        ],
        "properties": {
          "requirement_ref": {
            "type": "string"
          },
          "source_document_ref": {
            "type": "string"
          },
          "source_version": {
            "type": "string"
          },
          "span_start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "span_end_byte": {
            "type": "integer",
            "minimum": 0
          },
          "exact_text": {
            "type": "string",
            "minLength": 1
          },
          "modality": {
            "enum": [
              "mandatory",
              "conditional",
              "preferred",
              "unresolved"
            ]
          },
          "applies_to_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "intent_baseline": {
      "type": "object",
      "required": [
        "system_id",
        "baseline_id",
        "version",
        "sha256",
        "digest_verification",
        "approval",
        "requirement_refs"
      ],
      "properties": {
        "system_id": {
          "const": "symthaea"
        },
        "baseline_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "digest_verification": {
          "const": "synthetic_placeholder_not_cryptographically_verified"
        },
        "approval": {
          "type": "object",
          "required": [
            "approval_ref",
            "approved_by_ref",
            "approver_role",
            "state",
            "approved_at",
            "approval_kind"
          ],
          "properties": {
            "approval_ref": {
              "type": "string"
            },
            "approved_by_ref": {
              "type": "string"
            },
            "approver_role": {
              "type": "string"
            },
            "state": {
              "const": "accepted"
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "approval_kind": {
              "const": "human_record_not_cryptographically_verified"
            }
          }
        },
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_ref",
          "asset_ref",
          "dimension",
          "disposition",
          "value",
          "source_ref",
          "source_version",
          "competent_for",
          "provider_ref",
          "effective_from",
          "effective_through",
          "observed_at",
          "source_receipt_ref",
          "limitations"
        ],
        "properties": {
          "claim_ref": {
            "type": "string"
          },
          "asset_ref": {
            "type": "string"
          },
          "dimension": {
            "enum": [
              "title",
              "custody",
              "permitted_use",
              "land_use_variance",
              "condition"
            ]
          },
          "disposition": {
            "enum": [
              "supported_within_scope",
              "partially_supported",
              "contested",
              "indeterminate",
              "unavailable",
              "stale",
              "contradicted",
              "unsupported"
            ]
          },
          "value": {
            "type": "object"
          },
          "source_ref": {
            "type": "string"
          },
          "source_version": {
            "type": "string"
          },
          "competent_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider_ref": {
            "type": "string"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "effective_through": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_receipt_ref": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "receipt_ref",
          "source_ref",
          "source_version",
          "content_digest_sha256",
          "digest_verification",
          "retrieved_at",
          "adapter_ref",
          "adapter_build_sha256",
          "upstream_provider_refs",
          "completeness",
          "signature_verification",
          "issuer_trust_state"
        ],
        "properties": {
          "receipt_ref": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "source_version": {
            "type": "string"
          },
          "content_digest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "digest_verification": {
            "const": "synthetic_placeholder_not_cryptographically_verified"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "adapter_ref": {
            "type": "string"
          },
          "adapter_build_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "upstream_provider_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "completeness": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "signature_verification": {
            "enum": [
              "not_provided",
              "verified",
              "invalid",
              "verification_unknown"
            ]
          },
          "issuer_trust_state": {
            "enum": [
              "trusted",
              "untrusted",
              "unknown",
              "not_applicable"
            ]
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "authorization_ref",
        "subject_ref",
        "entity_ref",
        "action_scope",
        "purpose_scope",
        "asset_scope",
        "valid_from",
        "valid_through",
        "verification_state",
        "verifier_ref",
        "status_events"
      ],
      "properties": {
        "authorization_ref": {
          "type": "string"
        },
        "subject_ref": {
          "type": "string"
        },
        "entity_ref": {
          "type": "string"
        },
        "action_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purpose_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_through": {
          "type": "string",
          "format": "date-time"
        },
        "verification_state": {
          "enum": [
            "verified",
            "invalid",
            "revoked",
            "expired",
            "not_yet_valid",
            "status_unknown",
            "issuer_untrusted",
            "scope_mismatch",
            "not_adjudicated"
          ]
        },
        "verifier_ref": {
          "type": "string"
        },
        "status_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_ref",
              "status",
              "effective_at",
              "observed_at"
            ],
            "properties": {
              "event_ref": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "active",
                  "revoked",
                  "expired",
                  "unknown"
                ]
              },
              "effective_at": {
                "type": "string",
                "format": "date-time"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "query_ref",
          "action",
          "purpose",
          "asset_ref",
          "actor_ref",
          "contracting_entity_ref",
          "effective_at",
          "known_at",
          "action_at",
          "excluded_claim_refs",
          "added_claim_refs",
          "claim_bindings"
        ],
        "properties": {
          "query_ref": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "asset_ref": {
            "type": "string"
          },
          "actor_ref": {
            "type": "string"
          },
          "contracting_entity_ref": {
            "type": "string"
          },
          "effective_at": {
            "type": "string",
            "format": "date-time"
          },
          "known_at": {
            "type": "string",
            "format": "date-time"
          },
          "action_at": {
            "type": "string",
            "format": "date-time"
          },
          "excluded_claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "added_claim_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "requirement_ref",
                "claim_ref"
              ],
              "properties": {
                "requirement_ref": {
                  "type": "string"
                },
                "claim_ref": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "operation_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_ref",
          "operation_ref",
          "idempotency_ref",
          "event_type",
          "outcome",
          "occurred_at",
          "observed_at",
          "mutation_count",
          "receipt_ref",
          "action",
          "purpose",
          "asset_ref",
          "actor_ref",
          "fields",
          "possible_external_side_effect"
        ],
        "properties": {
          "event_ref": {
            "type": "string"
          },
          "operation_ref": {
            "type": "string"
          },
          "idempotency_ref": {
            "type": "string"
          },
          "event_type": {
            "enum": [
              "submit_attempt",
              "timeout",
              "completion_receipt",
              "failure_receipt",
              "reconciliation"
            ]
          },
          "outcome": {
            "enum": [
              "submitted",
              "unknown",
              "success",
              "failure",
              "reconciled"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "mutation_count": {
            "type": "integer",
            "minimum": 0
          },
          "receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "asset_ref": {
            "type": "string",
            "minLength": 1
          },
          "actor_ref": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "possible_external_side_effect": {
            "type": "boolean"
          }
        }
      }
    },
    "execution_control": {
      "type": "object",
      "required": [
        "operation_ref",
        "idempotency_ref",
        "state",
        "mutation_count",
        "retry_count",
        "reattempt_permitted",
        "reconciliation_required",
        "authorized_write_boundary"
      ],
      "properties": {
        "operation_ref": {
          "type": "string"
        },
        "idempotency_ref": {
          "type": "string"
        },
        "state": {
          "enum": [
            "UNKNOWN",
            "RECONCILED_SUCCESS",
            "RECONCILED_FAILURE",
            "NOT_STARTED"
          ]
        },
        "mutation_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "reattempt_permitted": {
          "type": "boolean"
        },
        "reconciliation_required": {
          "type": "boolean"
        },
        "authorized_write_boundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "purpose",
              "asset_ref",
              "actor_ref",
              "fields",
              "authorization_ref",
              "possible_external_side_effect"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "asset_ref": {
                "type": "string",
                "minLength": 1
              },
              "actor_ref": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "authorization_ref": {
                "type": "string",
                "minLength": 1
              },
              "possible_external_side_effect": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "mode",
        "external_io_enabled",
        "network_enabled",
        "mutations_enabled"
      ],
      "properties": {
        "mode": {
          "const": "synthetic_fixture_only"
        },
        "external_io_enabled": {
          "const": false
        },
        "network_enabled": {
          "const": false
        },
        "mutations_enabled": {
          "const": false
        }
      }
    },
    "policy_ref": {
      "type": "string"
    },
    "evaluator_ref": {
      "type": "string"
    }
  }
}

{
  "schema": "mycelix-beta-trust-posterior-reference-v1",
  "profile": "IndependentBernoulliEvidencePosteriorV1",
  "status": "research-only mathematical reference; not a production trust decision rule",
  "assumptions": [
    "Each observation is a correctly specified binary outcome from a distinct, conditionally independent trial.",
    "The Bernoulli success probability is stationary over the observation window.",
    "Prior alpha and beta are finite and strictly positive.",
    "Duplicate events, correlated sources, identity linkage, evidence authenticity, time decay and adversarial dependence are outside this posterior primitive and must be handled by a higher layer.",
    "The lower bound is a conservative posterior-distribution bound derived from Cantelli's one-sided inequality; it is not a frequentist confidence interval or an empirical calibration guarantee."
  ],
  "math": {
    "posterior_alpha": "alpha0 + successes",
    "posterior_beta": "beta0 + failures",
    "mean": "alpha / (alpha + beta)",
    "variance": "alpha * beta / ((alpha + beta)^2 * (alpha + beta + 1))",
    "lower_bound": "max(0, mean - sqrt(variance * (1 - epsilon) / epsilon))",
    "lower_bound_semantics": "For posterior random variable theta and 0 < epsilon < 1, Cantelli implies posterior mass below this bound is at most epsilon (trivial if the bound is clamped to zero)."
  },
  "default_prior": {
    "alpha": "1",
    "beta": "1",
    "interpretation": "Uniform Beta(1,1); no historical evidence. Jeffreys Beta(0.5,0.5) appears as a separate sensitivity case."
  },
  "default_tail_probability": "0.05",
  "case_count": 20,

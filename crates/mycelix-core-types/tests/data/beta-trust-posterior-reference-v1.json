  "mutation_controls": [
    {
      "id": "BTP-MUT-001",
      "description": "Ignore observations and return the prior mean.",
      "must_be_detected_by": "BTP-006-ten-successes"
    },
    {
      "id": "BTP-MUT-002",
      "description": "Swap success and failure counts.",
      "must_be_detected_by": "BTP-009-ten-success-one-failure"
    },
    {
      "id": "BTP-MUT-003",
      "description": "Omit the +1 term in the Beta variance denominator.",
      "must_be_detected_by": "BTP-002-jeffreys-prior-no-evidence"
    },
    {
      "id": "BTP-MUT-004",
      "description": "Use epsilon/(1-epsilon) instead of (1-epsilon)/epsilon in the Cantelli safety margin.",
      "must_be_detected_by": "BTP-006-ten-successes"
    },
    {
      "id": "BTP-MUT-005",
      "description": "Replace the uncertainty-adjusted lower bound with the posterior mean.",
      "must_be_detected_by": "BTP-008-balanced-evidence"
    }

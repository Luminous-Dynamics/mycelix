{
  "schema": "mycelix-trust-calibration-reference-v1",
  "profile": "BinaryProbabilityScoreReferenceV1",
  "status": "research-only score arithmetic reference; no model calibration result is claimed",
  "prediction_semantics": "Every input probability must be a calibrated or calibratable probability of the same explicitly named binary outcome. A TCDM trust_level/confidence value is not a probability by name alone.",
  "metrics": {
    "brier_score": "mean((p_i-y_i)^2); lower is better; strictly proper for binary probability forecasts.",
    "log_loss": "mean(-y_i*ln(p_i)-(1-y_i)*ln(1-p_i)); p_i must be strictly within (0,1), finite.",
    "mean_probability": "mean(p_i), reported beside the observed_positive_rate.",
    "observed_positive_rate": "mean(y_i), the empirical event rate in this finite fixture."
  },

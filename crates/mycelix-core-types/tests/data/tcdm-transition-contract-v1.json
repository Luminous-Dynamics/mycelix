  "mutation_controls": [
    {
      "id": "TC-MUT-001",
      "description": "Permit backward timestamps, causing a decay factor above one.",
      "must_be_detected_by": "TC-007-backwards-time"
    },
    {
      "id": "TC-MUT-002",
      "description": "Clamp negative weights to an effective learning rate and accept them.",
      "must_be_detected_by": "TC-022-negative-interaction-weight"
    },
    {
      "id": "TC-MUT-003",
      "description": "Increase confidence by a fixed constant even when weight is zero.",
      "must_be_detected_by": "TC-019-zero-weight-is-no-op"
    },
    {
      "id": "TC-MUT-004",
      "description": "Use unchecked time subtraction or interaction-count increment.",
      "must_be_detected_by": "TC-008-delta-overflow"
    },
    {
      "id": "TC-MUT-005",
      "description": "Allow non-finite or out-of-range state to propagate.",
      "must_be_detected_by": "TC-011-nan-decay-rate"
    }
  ]

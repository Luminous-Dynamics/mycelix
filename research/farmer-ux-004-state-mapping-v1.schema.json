{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/farmer-ux-004-state-mapping-v1.schema.json",
  "title": "Farmer UX-004 local attempt to service state mapping",
  "description": "Proposed adapter contract; not evidence that a working integration exists.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "tracking_issue",
    "source_lifecycle_reference",
    "operation_attempt_statuses",
    "farmer_service_states",
    "allowed_promotions",
    "invariants",
    "non_goals",
    "network_send_rule"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "proposed_adapter_contract_not_implementation"
    },
    "tracking_issue": {
      "type": "string",
      "format": "uri"
    },
    "source_lifecycle_reference": {
      "type": "object",
      "required": [
        "pr",
        "branch",
        "source_blob_sha",
        "maturity"
      ],
      "properties": {
        "pr": {
          "type": "string",
          "format": "uri"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "source_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "maturity": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "operation_attempt_statuses": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "status",
          "dispatch_eligible",
          "needs_reconciliation",
          "meaning",
          "can_advance_to_submitted"
        ],
        "properties": {
          "status": {
            "enum": [
              "Prepared",
              "Submitted",
              "Confirmed",
              "ExplicitlyRejected",
              "OutcomeUnknown",
              "ReconciledApplied",
              "ReconciledNotApplied",
              "NotSent"
            ]
          },
          "needs_reconciliation": {
            "type": "boolean"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "can_advance_to_submitted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "farmer_service_states": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "state",
          "source",
          "meaning"
        ],
        "properties": {
          "state": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "allowed_promotions": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "requires",
          "prohibited_without"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prohibited_without": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "network_send_rule": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

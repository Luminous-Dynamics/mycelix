{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/farmer-ux-001-cases-v1.schema.json",
  "title": "Farmer UX-001 synthetic case corpus",
  "description": "Structural contract for synthetic decision-to-outcome UX cases. This schema does not validate business semantics or field outcomes.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "tracking_issue",
    "workflow",
    "shared_invariants",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "synthetic_contract_draft_not_field_validated"
    },
    "tracking_issue": {
      "type": "string",
      "format": "uri"
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "shared_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "setup",
        "events",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FUX-[A-Z]+-[0-9]{3}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "object",
          "minProperties": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "expected": {
          "type": "object",
          "required": [
            "request_state",
            "visible_state",
            "side_effect_counts",
            "must_show",
            "must_not_show",
            "invariant_checks"
          ],
          "properties": {
            "request_state": {
              "type": "string",
              "minLength": 1
            },
            "visible_state": {
              "type": "string",
              "minLength": 1
            },
            "side_effect_counts": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "must_show": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "must_not_show": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "invariant_checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}

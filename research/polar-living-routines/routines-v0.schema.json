{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/polar-living-routines/routines-v0.schema.json",
  "title": "Voluntary Polar Routine Catalog v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "evidence_tier",
    "claim_ceiling",
    "deployment_status",
    "created_date",
    "governing_principles",
    "privacy_defaults",
    "evidence_sources",
    "routines"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "artifact_kind": {
      "const": "voluntary-polar-routine-catalog"
    },
    "status": {
      "const": "proposed"
    },
    "evidence_tier": {
      "const": "S0"
    },
    "claim_ceiling": {
      "const": "design_hypothesis_only"
    },
    "deployment_status": {
      "const": "not_for_deployment"
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "governing_principles": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "privacy_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personal_data_collected",
        "sensitive_health_data_collected",
        "personal_location_history_collected",
        "individual_adherence_scoring",
        "default_storage",
        "optional_personal_notes_storage",
        "retention_of_personal_data",
        "aggregate_reporting",
        "distributed_ledger_personal_data",
        "participation"
      ],
      "properties": {
        "personal_data_collected": {
          "const": false
        },
        "sensitive_health_data_collected": {
          "const": false
        },
        "personal_location_history_collected": {
          "const": false
        },
        "individual_adherence_scoring": {
          "const": false
        },
        "default_storage": {
          "const": "none"
        },
        "optional_personal_notes_storage": {
          "const": "local_device_only_under_user_control"
        },
        "retention_of_personal_data": {
          "const": "none_by_default"
        },
        "aggregate_reporting": {
          "const": "only_opt_in_aggregate_after_disclosure_review"
        },
        "distributed_ledger_personal_data": {
          "const": false
        },
        "participation": {
          "const": "voluntary"
        }
      }
    },
    "evidence_sources": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "year",
          "url",
          "population",
          "finding",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2026
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "population": {
            "type": "string",
            "minLength": 5
          },
          "finding": {
            "type": "string",
            "minLength": 5
          },
          "limitation": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "routines": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/routine"
      }
    }
  },
  "$defs": {
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "trigger",
        "options",
        "autonomy_note",
        "avoid",
        "evidence_class",
        "evidence_note",
        "evaluation",
        "impact_claim",
        "evidence_source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^POLAR-HABIT-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 5
        },
        "category": {
          "type": "string",
          "minLength": 3
        },
        "trigger": {
          "type": "string",
          "minLength": 10
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "autonomy_note": {
          "type": "string",
          "minLength": 10
        },
        "avoid": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "evidence_class": {
          "enum": [
            "research_hypothesis",
            "community_guidance",
            "operational_context"
          ]
        },
        "evidence_note": {
          "type": "string",
          "minLength": 10
        },
        "evaluation": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "impact_claim": {
          "const": "none"
        },
        "evidence_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "evidence_tier": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4"
            ]
          }
        },
        "required": [
          "evidence_tier"
        ]
      }
    },
    {
      "not": {
        "properties": {
          "deployment_status": {
            "enum": [
              "pilot_authorized",
              "approved",
              "deployed"
            ]
          }
        },
        "required": [
          "deployment_status"
        ]
      }
    }
  ]
}

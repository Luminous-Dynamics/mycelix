{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/neurotwin/schemas/evaluation-receipt-v0.1.schema.json",
  "title": "NeuroTwin Aggregate Evaluation Receipt v0.1",
  "description": "Aggregate-only research evidence receipt. It must never contain participant identifiers, row-level features or predictions, raw health modalities, embeddings, gradients, or small-cell statistics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "synthetic_only",
    "study",
    "authorization",
    "run",
    "cohort",
    "task",
    "model",
    "metrics",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "neurotwin-evaluation-receipt-v0.1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "synthetic_only": {
      "type": "boolean",
      "description": "True for repository fixtures or contract tests. False is only allowed for an approved real analysis in a controlled environment."
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_id", "protocol_version", "protocol_sha256", "dataset_provider", "dataset_release_id", "analysis_scope_ref"],
      "properties": {
        "study_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "protocol_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "protocol_sha256": { "$ref": "#/$defs/sha256" },
        "dataset_provider": { "type": "string", "minLength": 2, "maxLength": 96 },
        "dataset_release_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "analysis_scope_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Opaque reference to a controlled, approved study-use manifest. Never a bearer credential or public download URL."
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ethics_status", "dua_status", "scope_verified", "compute_location"],
      "properties": {
        "ethics_status": { "enum": ["approved", "exempt", "not_applicable_for_synthetic", "not_authorized"] },
        "ethics_reference_redacted": { "type": ["string", "null"], "maxLength": 128 },
        "dua_status": { "enum": ["signed", "not_required_for_synthetic", "not_authorized"] },
        "scope_verified": { "type": "boolean" },
        "compute_location": { "enum": ["controlled_provider_workspace", "approved_institutional_environment", "local_synthetic_only"] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_commit", "environment_sha256", "preprocessing_sha256", "split_manifest_sha256", "started_at", "completed_at", "execution_mode"],
      "properties": {
        "code_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "environment_sha256": { "$ref": "#/$defs/sha256" },
        "preprocessing_sha256": { "$ref": "#/$defs/sha256" },
        "split_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "execution_mode": { "enum": ["centralized_controlled", "federated_approved", "local_synthetic"] }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "n_total", "small_cell_suppression_applied"],
      "properties": {
        "population": { "const": "major_depressive_disorder" },
        "n_total": { "type": "integer", "minimum": 0 },
        "small_cell_suppression_applied": { "type": "boolean" },
        "suppression_threshold": { "type": ["integer", "null"], "minimum": 5 },
        "site_count": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "endpoint", "prediction_time", "validation_design", "direction"],
      "properties": {
        "claim_type": { "enum": ["prognosis", "treatment_effect_heterogeneity", "treatment_policy_value"] },
        "endpoint": { "type": "string", "minLength": 3, "maxLength": 128 },
        "prediction_time": { "type": "string", "minLength": 2, "maxLength": 64 },
        "validation_design": { "enum": ["internal_nested", "cross_trial", "external_trial", "silent_prospective", "randomized_policy_evaluation", "synthetic_contract_test"] },
        "direction": { "type": "string", "minLength": 3, "maxLength": 128 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_family", "configuration_sha256"],
      "properties": {
        "model_id": { "type": "string", "minLength": 2, "maxLength": 96 },
        "model_family": { "type": "string", "minLength": 2, "maxLength": 96 },
        "configuration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "confidence_interval"],
        "properties": {
          "name": { "enum": ["auroc", "auprc", "balanced_accuracy", "sensitivity", "specificity", "brier_score", "log_loss", "calibration_intercept", "calibration_slope", "policy_value_difference", "net_benefit", "coverage", "abstention_rate"] },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 24 },
          "confidence_interval": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["level", "lower", "upper"],
            "properties": {
              "level": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "lower": { "type": "number" },
              "upper": { "type": "number" }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3, "maxLength": 512 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
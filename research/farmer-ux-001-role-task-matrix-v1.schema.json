{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/farmer-ux-001-role-task-matrix-v1.schema.json",
  "title": "Farmer UX-001 role/task matrix",
  "description": "Structural contract for role-specific interface projections over shared work/evidence primitives. It does not qualify user needs or validate field outcomes.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "tracking_issue",
    "organizing_principle",
    "first_workflow",
    "shared_capabilities",
    "roles",
    "prioritization_rule",
    "non_goals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "product_hypothesis_for_field_validation"
    },
    "tracking_issue": {
      "type": "string",
      "format": "uri"
    },
    "organizing_principle": {
      "type": "string",
      "minLength": 1
    },
    "first_workflow": {
      "type": "string",
      "minLength": 1
    },
    "shared_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "purpose",
          "key_tasks",
          "interface_projection",
          "critical_risks",
          "outcome_metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "key_tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "interface_projection": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "critical_risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome_metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "prioritization_rule": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/common-ground-trial-v0.1.json",
  "title": "Common Ground joint-action trace v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "events",
    "expected"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "benchmark_version",
        "task_digest",
        "oracle_spec_digest",
        "expected_final_state_digest",
        "oracle_attestation_digest",
        "helper_id",
        "worker_id",
        "worker_state_digest",
        "worker_state_version",
        "view_mode",
        "required_placements",
        "time_budget_ms",
        "turn_budget"
      ],
      "properties": {
        "trial_id": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_version": {
          "type": "string",
          "minLength": 1
        },
        "task_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "oracle_spec_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_final_state_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "oracle_attestation_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "helper_id": {
          "type": "string",
          "minLength": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "worker_state_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "worker_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "view_mode": {
          "enum": [
            "shared_worker_state",
            "private_worker_state"
          ]
        },
        "required_placements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_id",
              "target_slot_id"
            ],
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "target_slot_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "time_budget_ms": {
          "type": "integer",
          "minimum": 1
        },
        "turn_budget": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_id",
          "timestamp_ms",
          "kind"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_ms": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "task_state_visible",
                  "message_delivered",
                  "clarification_requested",
                  "clarification_resolved",
                  "referent_confirmed",
                  "joint_action_executed",
                  "repair_started",
                  "repair_completed",
                  "verbal_acknowledgement",
                  "trial_completed"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification",
        "outcome",
        "joint_success",
        "exact_placements",
        "required_placements",
        "verbal_acknowledgements"
      ],
      "properties": {
        "qualification": {
          "enum": [
            "pass",
            "fail",
            "indeterminate"
          ]
        },
        "outcome": {
          "enum": [
            "success",
            "incomplete",
            "incorrect",
            "not_evaluable"
          ]
        },
        "joint_success": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "exact_placements": {
          "type": "integer",
          "minimum": 0
        },
        "required_placements": {
          "type": "integer",
          "minimum": 0
        },
        "verbal_acknowledgements": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

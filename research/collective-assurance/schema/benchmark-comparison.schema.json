{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/benchmark-comparison-v0.1.json",
  "title":"Matched benchmark comparison v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["intent","baseline","candidate"],
  "properties":{
    "intent":{"enum":["matched_system","cross_model_context"]},
    "baseline":{"$ref":"#/$defs/run"},
    "candidate":{"$ref":"#/$defs/run"}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "run":{
      "type":"object","additionalProperties":false,
      "required":[
        "run_id","system_variant","system_config_digest","benchmark_id","benchmark_version",
        "dataset_digest","split_digest","task_family_digest","evaluation_protocol_digest",
        "scorer_digest","model_snapshot_digest","tokenizer_digest","prompt_digest",
        "toolset_digest","decoding_config_digest","context_tokens","max_output_tokens",
        "time_budget_ms","token_budget","compute_budget_millijoules","agent_count",
        "memory_budget_bytes","seed_policy_id","seed"
      ],
      "properties":{
        "run_id":{"type":"string","minLength":1},
        "system_variant":{"type":"string","minLength":1},
        "system_config_digest":{"$ref":"#/$defs/digest"},
        "benchmark_id":{"type":"string","minLength":1},
        "benchmark_version":{"type":"string","minLength":1},
        "dataset_digest":{"$ref":"#/$defs/digest"},
        "split_digest":{"$ref":"#/$defs/digest"},
        "task_family_digest":{"$ref":"#/$defs/digest"},
        "evaluation_protocol_digest":{"$ref":"#/$defs/digest"},
        "scorer_digest":{"$ref":"#/$defs/digest"},
        "model_snapshot_digest":{"$ref":"#/$defs/digest"},
        "tokenizer_digest":{"$ref":"#/$defs/digest"},
        "prompt_digest":{"$ref":"#/$defs/digest"},
        "toolset_digest":{"$ref":"#/$defs/digest"},
        "decoding_config_digest":{"$ref":"#/$defs/digest"},
        "context_tokens":{"type":"integer","minimum":1},
        "max_output_tokens":{"type":"integer","minimum":1},
        "time_budget_ms":{"type":"integer","minimum":1},
        "token_budget":{"type":"integer","minimum":1},
        "compute_budget_millijoules":{"type":"integer","minimum":1},
        "agent_count":{"type":"integer","minimum":1},
        "memory_budget_bytes":{"type":"integer","minimum":1},
        "seed_policy_id":{"type":"string","minLength":1},
        "seed":{"type":"integer","minimum":0}
      }
    }
  }
}
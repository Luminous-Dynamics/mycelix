{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/inquiry-rer-acb-factorial-v0.1.schema.json",
  "title": "Inquiry RER ACB Factorial Block v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["study", "block", "arms"],
  "properties": {
    "study": { "$ref": "#/$defs/study" },
    "block": { "$ref": "#/$defs/block" },
    "arms": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "study": {
      "type": "object", "additionalProperties": false,
      "required": ["study_id","benchmark_id","benchmark_version","benchmark_certificate_digest","split_digest","model_snapshot_digest","tokenizer_digest","system_prompt_digest","user_prompt_template_digest","toolchain_digest","decoding_digest","scorer_digest","evaluator_digest","inference_plan_digest","randomization_policy_digest","random_seed_digest","context_budget_tokens","output_budget_tokens","compute_budget_microusd","wall_clock_budget_ms","memory_budget_bytes","agent_count","exposure_trust_profile_digest"],
      "properties": {
        "study_id": { "type": "string", "minLength": 1 },
        "benchmark_id": { "type": "string", "minLength": 1 },
        "benchmark_version": { "type": "string", "minLength": 1 },
        "benchmark_certificate_digest": { "$ref": "#/$defs/digest" },
        "split_digest": { "$ref": "#/$defs/digest" },
        "model_snapshot_digest": { "$ref": "#/$defs/digest" },
        "tokenizer_digest": { "$ref": "#/$defs/digest" },
        "system_prompt_digest": { "$ref": "#/$defs/digest" },
        "user_prompt_template_digest": { "$ref": "#/$defs/digest" },
        "toolchain_digest": { "$ref": "#/$defs/digest" },
        "decoding_digest": { "$ref": "#/$defs/digest" },
        "scorer_digest": { "$ref": "#/$defs/digest" },
        "evaluator_digest": { "$ref": "#/$defs/digest" },
        "inference_plan_digest": { "$ref": "#/$defs/digest" },
        "randomization_policy_digest": { "$ref": "#/$defs/digest" },
        "random_seed_digest": { "$ref": "#/$defs/digest" },
        "context_budget_tokens": { "type": "integer", "minimum": 1 },
        "output_budget_tokens": { "type": "integer", "minimum": 1 },
        "compute_budget_microusd": { "type": "integer", "minimum": 1 },
        "wall_clock_budget_ms": { "type": "integer", "minimum": 1 },
        "memory_budget_bytes": { "type": "integer", "minimum": 1 },
        "agent_count": { "type": "integer", "minimum": 1 },
        "exposure_trust_profile_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["block_id","source_group_id","task_id","task_digest","initial_candidate_pool_digest","initial_retrieval_seed_digest","frozen_history_cutoff_ms"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "source_group_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "task_digest": { "$ref": "#/$defs/digest" },
        "initial_candidate_pool_digest": { "$ref": "#/$defs/digest" },
        "initial_retrieval_seed_digest": { "$ref": "#/$defs/digest" },
        "frozen_history_cutoff_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "treatment": {
      "type": "object", "additionalProperties": false,
      "required": ["inquiry","rer","acb"],
      "properties": {
        "inquiry": { "type": "boolean" }, "rer": { "type": "boolean" }, "acb": { "type": "boolean" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["applied","receipt_digest"],
      "properties": { "applied": { "type": "boolean" }, "receipt_digest": { "$ref": "#/$defs/digest" } }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["l2_quality","verified_evidence_coverage","recalled_pairs","recalled_but_unused_pairs","unsupported_material_claims","conflict_preservation_failures","unauthorized_disclosure_count","unauthorized_action_count","over_refusal_rate","latency_ms","total_cost_microusd","input_tokens","output_tokens","inquiry_requests","newly_verified_source_origins","rer_added_evidence_count","generator_visible_evidence_count","constraint_items_processed","unaccounted_visible_evidence_count","rights_provenance_gate","constraint_gate","response_audit_gate"],
      "properties": {
        "l2_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "verified_evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "recalled_pairs": { "type": "integer", "minimum": 0 },
        "recalled_but_unused_pairs": { "type": "integer", "minimum": 0 },
        "unsupported_material_claims": { "type": "integer", "minimum": 0 },
        "conflict_preservation_failures": { "type": "integer", "minimum": 0 },
        "unauthorized_disclosure_count": { "type": "integer", "minimum": 0 },
        "unauthorized_action_count": { "type": "integer", "minimum": 0 },
        "over_refusal_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "total_cost_microusd": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "inquiry_requests": { "type": "integer", "minimum": 0 },
        "newly_verified_source_origins": { "type": "integer", "minimum": 0 },
        "rer_added_evidence_count": { "type": "integer", "minimum": 0 },
        "generator_visible_evidence_count": { "type": "integer", "minimum": 0 },
        "constraint_items_processed": { "type": "integer", "minimum": 0 },
        "unaccounted_visible_evidence_count": { "type": "integer", "minimum": 0 },
        "rights_provenance_gate": { "enum": ["Pass","Fail","Indeterminate","NotApplied"] },
        "constraint_gate": { "enum": ["Pass","Fail","Indeterminate","NotApplied"] },
        "response_audit_gate": { "enum": ["Pass","Fail","Indeterminate","NotApplied"] }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id","treatment","study","block","post_inquiry_candidate_pool_digest","inquiry_execution","rer_execution","acb_execution","rights_provenance_receipt_digest","generation_exposure_receipt_digest","execution_receipt_digest","rer_bundle_receipt_digest","constraint_receipt_digest","independent_response_audit_receipt_digest","evaluator_receipt_digest","outcome"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "treatment": { "$ref": "#/$defs/treatment" },
        "study": { "$ref": "#/$defs/study" },
        "block": { "$ref": "#/$defs/block" },
        "post_inquiry_candidate_pool_digest": { "$ref": "#/$defs/digest" },
        "inquiry_execution": { "$ref": "#/$defs/receipt" },
        "rer_execution": { "$ref": "#/$defs/receipt" },
        "acb_execution": { "$ref": "#/$defs/receipt" },
        "rights_provenance_receipt_digest": { "$ref": "#/$defs/digest" },
        "generation_exposure_receipt_digest": { "$ref": "#/$defs/digest" },
        "execution_receipt_digest": { "$ref": "#/$defs/digest" },
        "rer_bundle_receipt_digest": { "$ref": "#/$defs/digest" },
        "constraint_receipt_digest": { "$ref": "#/$defs/digest" },
        "independent_response_audit_receipt_digest": { "$ref": "#/$defs/digest" },
        "evaluator_receipt_digest": { "$ref": "#/$defs/digest" },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    }
  }
}
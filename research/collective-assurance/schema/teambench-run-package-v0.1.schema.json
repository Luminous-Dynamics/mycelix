{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/teambench-run-package-v0.1.schema.json",
  "title": "TeamBench Version-Pinned Run Package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "run_mode",
    "upstream_repository",
    "upstream_commit",
    "benchmark_version",
    "dataset_manifest_digest",
    "task_manifest_digest",
    "native_grader_digest",
    "excluded_task_manifest_digest",
    "eligible_task_ids",
    "excluded_tasks",
    "model_snapshot_digest",
    "tokenizer_digest",
    "prompt_config_digest",
    "toolset_digest",
    "decoding_config_digest",
    "seed_policy_id",
    "seed",
    "per_task_time_budget_ms",
    "per_task_token_budget",
    "per_task_compute_budget_millijoules",
    "condition_runs",
    "task_manifest_path",
    "task_manifest_blob_sha",
    "re_curation_notice_path",
    "re_curation_notice_blob_sha"
  ],
  "properties": {
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "run_mode": {
      "enum": [
        "mock_provider_smoke",
        "model_evaluation"
      ]
    },
    "upstream_repository": {
      "const": "https://github.com/ybkim95/TeamBench"
    },
    "upstream_commit": {
      "type": "string",
      "const": "d185aef1916fd86a9ba554d581fd256319a973af",
      "pattern": "^[0-9a-f]{40}$"
    },
    "benchmark_version": {
      "type": "string",
      "const": "2.1"
    },
    "dataset_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "task_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "native_grader_digest": {
      "$ref": "#/$defs/digest"
    },
    "excluded_task_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "eligible_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "excluded_tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excluded_task"
      }
    },
    "model_snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "tokenizer_digest": {
      "$ref": "#/$defs/digest"
    },
    "prompt_config_digest": {
      "$ref": "#/$defs/digest"
    },
    "toolset_digest": {
      "$ref": "#/$defs/digest"
    },
    "decoding_config_digest": {
      "$ref": "#/$defs/digest"
    },
    "seed_policy_id": {
      "$ref": "#/$defs/id"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "per_task_time_budget_ms": {
      "type": "integer",
      "minimum": 1
    },
    "per_task_token_budget": {
      "type": "integer",
      "minimum": 1
    },
    "per_task_compute_budget_millijoules": {
      "type": "integer",
      "minimum": 1
    },
    "condition_runs": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/condition_run"
      }
    },
    "task_manifest_path": {
      "const": "leaderboard/data/leaderboard_90_tasks.json"
    },
    "task_manifest_blob_sha": {
      "type": "string",
      "const": "59125b3fa9a82eede1f5a832c51c2ba32f5af591",
      "pattern": "^[0-9a-f]{40}$"
    },
    "re_curation_notice_path": {
      "const": "README.md"
    },
    "re_curation_notice_blob_sha": {
      "type": "string",
      "const": "6c39b66fed83c52f397c2d3b4f84e7bafe854061",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "condition": {
      "enum": [
        "oracle",
        "restricted",
        "team_no_verify",
        "team_no_plan",
        "full"
      ]
    },
    "role": {
      "enum": [
        "oracle",
        "restricted",
        "planner",
        "executor",
        "verifier"
      ]
    },
    "excluded_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "reason",
        "evidence_digest"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "boundary_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "actor_role",
        "boundary_id",
        "expected_allowed",
        "observed",
        "evidence_digest"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "actor_role": {
          "$ref": "#/$defs/role"
        },
        "boundary_id": {
          "$ref": "#/$defs/id"
        },
        "expected_allowed": {
          "type": "boolean"
        },
        "observed": {
          "enum": [
            "allowed",
            "blocked",
            "unknown"
          ]
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "task_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "state",
        "raw_output_digest",
        "native_grader_output_digest",
        "native_grader_disposition",
        "native_score_micros",
        "verifier_disposition",
        "role_boundary_events",
        "resource_usage"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": [
            "evaluated",
            "infrastructure_error",
            "not_run"
          ]
        },
        "raw_output_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_grader_output_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_grader_disposition": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            null
          ]
        },
        "verifier_disposition": {
          "enum": [
            "accept",
            "reject",
            "no_verdict",
            null
          ]
        },
        "role_boundary_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundary_event"
          }
        },
        "native_score_micros": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_usage": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_tokens",
                "output_tokens",
                "wall_clock_ms",
                "provider_cost_micro_usd",
                "tool_call_count",
                "inter_agent_message_count",
                "evidence_digest"
              ],
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "wall_clock_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "provider_cost_micro_usd": {
                  "type": "integer",
                  "minimum": 0
                },
                "tool_call_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "inter_agent_message_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "evidence_digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "condition_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "condition",
        "system_config_digest",
        "role_profile_digest",
        "raw_result_manifest_digest",
        "agent_count",
        "role_boundary_inventory_complete",
        "tasks",
        "roles",
        "execution_backend",
        "runtime_manifest_digest"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "system_config_digest": {
          "$ref": "#/$defs/digest"
        },
        "role_profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "raw_result_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "agent_count": {
          "type": "integer",
          "minimum": 1
        },
        "role_boundary_inventory_complete": {
          "type": "boolean"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task_observation"
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "execution_backend": {
          "enum": [
            "in_process_tool_boundary",
            "docker_container_isolation",
            "unknown"
          ]
        },
        "runtime_manifest_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}

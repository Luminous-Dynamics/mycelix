{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pareto-comparison-v0.1.json",
  "title": "Assurance-constrained Pareto comparison v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "baseline",
    "candidate"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_gate_ids",
        "required_metrics",
        "confidence_level_bps",
        "minimum_independent_units"
      ],
      "properties": {
        "required_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "task_quality",
              "authorized_task_completion",
              "evidence_coverage",
              "unique_information_preservation",
              "agency",
              "calibration",
              "burden_score",
              "unauthorized_action_rate",
              "unauthorized_disclosure_rate",
              "false_ai_off_pass_rate",
              "over_refusal_rate",
              "p95_latency_ms",
              "total_cost_micro_usd",
              "energy_milli_joules",
              "human_review_seconds",
              "input_tokens",
              "output_tokens",
              "tool_calls"
            ]
          }
        },
        "confidence_level_bps": {
          "type": "integer",
          "minimum": 9000,
          "maximum": 9999
        },
        "minimum_independent_units": {
          "type": "integer",
          "minimum": 2
        }
      },
      "allOf": [
        {
          "properties": {
            "required_metrics": {
              "contains": {
                "const": "task_quality"
              }
            }
          }
        },
        {
          "properties": {
            "required_metrics": {
              "contains": {
                "const": "evidence_coverage"
              }
            }
          }
        },
        {
          "properties": {
            "required_metrics": {
              "contains": {
                "const": "agency"
              }
            }
          }
        },
        {
          "properties": {
            "required_metrics": {
              "contains": {
                "const": "unauthorized_action_rate"
              }
            }
          }
        },
        {
          "properties": {
            "required_metrics": {
              "contains": {
                "const": "unauthorized_disclosure_rate"
              }
            }
          }
        },
        {
          "properties": {
            "required_metrics": {
              "contains": {
                "const": "over_refusal_rate"
              }
            }
          }
        },
        {
          "properties": {
            "required_metrics": {
              "contains": {
                "const": "p95_latency_ms"
              }
            }
          }
        },
        {
          "properties": {
            "required_metrics": {
              "contains": {
                "const": "total_cost_micro_usd"
              }
            }
          }
        }
      ]
    },
    "baseline": {
      "$ref": "#/$defs/run"
    },
    "candidate": {
      "$ref": "#/$defs/run"
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "mandatory_gates",
        "metrics"
      ],
      "properties": {
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "system_variant",
            "system_config_digest",
            "benchmark_id",
            "benchmark_version",
            "dataset_digest",
            "split_digest",
            "task_family_digest",
            "evaluation_protocol_digest",
            "scorer_digest",
            "model_snapshot_digest",
            "tokenizer_digest",
            "prompt_digest",
            "toolset_digest",
            "decoding_config_digest",
            "context_tokens",
            "max_output_tokens",
            "time_budget_ms",
            "token_budget",
            "compute_budget_millijoules",
            "agent_count",
            "memory_budget_bytes",
            "seed_policy_id",
            "seed"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "system_variant": {
              "type": "string",
              "minLength": 1
            },
            "system_config_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "benchmark_id": {
              "type": "string",
              "minLength": 1
            },
            "benchmark_version": {
              "type": "string",
              "minLength": 1
            },
            "dataset_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "split_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "task_family_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evaluation_protocol_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "scorer_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "model_snapshot_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "tokenizer_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "prompt_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "toolset_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "decoding_config_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "context_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "time_budget_ms": {
              "type": "integer",
              "minimum": 1
            },
            "token_budget": {
              "type": "integer",
              "minimum": 1
            },
            "compute_budget_millijoules": {
              "type": "integer",
              "minimum": 1
            },
            "agent_count": {
              "type": "integer",
              "minimum": 1
            },
            "memory_budget_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "seed_policy_id": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "mandatory_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate_id",
              "disposition",
              "evidence_digest"
            ],
            "properties": {
              "gate_id": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown"
                ]
              },
              "evidence_digest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "lower_bound",
              "point_estimate",
              "upper_bound",
              "confidence_level_bps",
              "independent_units",
              "observation_count",
              "measurement_evidence_digest",
              "paired_unit_manifest_digest",
              "simultaneous_intervals",
              "inference_plan_digest"
            ],
            "properties": {
              "metric": {
                "enum": [
                  "task_quality",
                  "authorized_task_completion",
                  "evidence_coverage",
                  "unique_information_preservation",
                  "agency",
                  "calibration",
                  "burden_score",
                  "unauthorized_action_rate",
                  "unauthorized_disclosure_rate",
                  "false_ai_off_pass_rate",
                  "over_refusal_rate",
                  "p95_latency_ms",
                  "total_cost_micro_usd",
                  "energy_milli_joules",
                  "human_review_seconds",
                  "input_tokens",
                  "output_tokens",
                  "tool_calls"
                ]
              },
              "lower_bound": {
                "type": "number"
              },
              "point_estimate": {
                "type": "number"
              },
              "upper_bound": {
                "type": "number"
              },
              "confidence_level_bps": {
                "type": "integer",
                "minimum": 9000,
                "maximum": 9999
              },
              "independent_units": {
                "type": "integer",
                "minimum": 0
              },
              "observation_count": {
                "type": "integer",
                "minimum": 0
              },
              "measurement_evidence_digest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              },
              "paired_unit_manifest_digest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              },
              "simultaneous_intervals": {
                "type": "boolean",
                "const": true
              },
              "inference_plan_digest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}

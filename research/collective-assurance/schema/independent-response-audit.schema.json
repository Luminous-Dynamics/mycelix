{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/independent-response-audit-v0.1.json",
  "title":"Independent response-span audit v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["request_id","response_id","auditor_id","audit_protocol_digest","coverage_complete","response_text","available_evidence","claims"],
  "properties":{
    "request_id":{"type":"string","minLength":1},
    "response_id":{"type":"string","minLength":1},
    "auditor_id":{"type":"string","minLength":1},
    "audit_protocol_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "coverage_complete":{"type":"boolean"},
    "response_text":{"type":"string","minLength":1},
    "claims":{
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,
        "required":["annotation_id","start_byte","end_byte","claim_span_digest","disposition","supporting_evidence_ids","contradicting_evidence_ids","rationale"],
        "properties":{
          "annotation_id":{"type":"string","minLength":1},
          "start_byte":{"type":"integer","minimum":0},
          "end_byte":{"type":"integer","minimum":1},
          "claim_span_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "disposition":{"enum":["supported","contested","unresolved","non_material"]},
          "supporting_evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "contradicting_evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "rationale":{"type":["string","null"]}
        }
      }
    },
    "available_evidence":{
      "type":"array",
      "items":{"type":"object","additionalProperties":false,
        "required":["evidence_id","source_origin_id","source_digest","status","verified"],
        "properties":{
          "evidence_id":{"type":"string","minLength":1},
          "source_origin_id":{"type":"string","minLength":1},
          "source_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "status":{"enum":["current","superseded","disputed","expired","unknown"]},
          "verified":{"type":"boolean"}
        }
      }
    }
  }
}
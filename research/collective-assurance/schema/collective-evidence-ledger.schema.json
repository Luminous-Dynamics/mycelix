{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/collective-evidence-ledger-v0.1.json",
  "title":"Collective evidence lineage ledger v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","genesis_digest","events","root_digest"],
  "properties":{
    "schema_version":{"const":"collective-evidence-ledger-v0.1"},
    "genesis_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "root_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "events":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["sequence","event_id","timestamp_ms","actor_id","recipient_id","parent_event_id","previous_digest","event_digest","kind"],
        "properties":{
          "sequence":{"type":"integer","minimum":1},
          "event_id":{"type":"string","minLength":1},
          "timestamp_ms":{"type":"integer","minimum":0},
          "actor_id":{"type":"string","minLength":1},
          "recipient_id":{"type":["string","null"]},
          "parent_event_id":{"type":["string","null"]},
          "previous_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "event_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "kind":{"oneOf":[
            {"type":"object","additionalProperties":false,"required":["type","information_id","source_origin_id","permission","permitted_recipients"],"properties":{
              "type":{"const":"information_assigned"},
              "information_id":{"type":"string","minLength":1},
              "source_origin_id":{"type":"string","minLength":1},
              "permission":{"enum":["shareable","scoped","withheld_by_rights","unknown"]},
              "permitted_recipients":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
            }},
            {"type":"object","additionalProperties":false,"required":["type","request_id","information_id"],"properties":{
              "type":{"const":"request_created"},
              "request_id":{"type":"string","minLength":1},
              "information_id":{"type":"string","minLength":1}
            }},
            {"type":"object","additionalProperties":false,"required":["type","request_id"],"properties":{
              "type":{"const":"request_delivered"},
              "request_id":{"type":"string","minLength":1}
            }},
            {"type":"object","additionalProperties":false,"required":["type","request_id","outcome","evidence_id","payload_digest"],"properties":{
              "type":{"const":"disclosure"},
              "request_id":{"type":"string","minLength":1},
              "outcome":{"enum":["granted","withheld_by_rights","no_response"]},
              "evidence_id":{"type":["string","null"]},
              "payload_digest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}
            }},
            {"type":"object","additionalProperties":false,"required":["type","evidence_id","outcome","payload_digest"],"properties":{
              "type":{"const":"evidence_verified"},
              "evidence_id":{"type":"string","minLength":1},
              "outcome":{"enum":["verified","rejected"]},
              "payload_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
            }},
            {"type":"object","additionalProperties":false,"required":["type","evidence_id"],"properties":{
              "type":{"const":"information_viewed"},
              "evidence_id":{"type":"string","minLength":1}
            }},
            {"type":"object","additionalProperties":false,"required":["type","claim_id","revision","disposition","supporting_evidence_ids","contradicting_evidence_ids"],"properties":{
              "type":{"const":"claim_revised"},
              "claim_id":{"type":"string","minLength":1},
              "revision":{"type":"integer","minimum":1},
              "disposition":{"enum":["supported","disputed","unknown"]},
              "supporting_evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
              "contradicting_evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
            }},
            {"type":"object","additionalProperties":false,"required":["type","decision_id","revision","disposition","claims"],"properties":{
              "type":{"const":"decision_recorded"},
              "decision_id":{"type":"string","minLength":1},
              "revision":{"type":"integer","minimum":1},
              "disposition":{"enum":["decide","defer","abstain"]},
              "claims":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["claim_id","revision"],"properties":{
                "claim_id":{"type":"string","minLength":1},
                "revision":{"type":"integer","minimum":1}
              }}}
            }}
          ]}
        }
      }
    }
  }
}
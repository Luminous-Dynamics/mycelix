{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/generation-input-exposure-v0.1.schema.json",
  "title": "Generation Input Exposure Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "signature_base64"],
  "properties": {
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "generation_id", "request_id", "responder_id", "purpose_id", "challenge_nonce", "signer_key_id", "model_snapshot_digest", "prompt_template_digest", "input_payload_digest", "generated_at_ms", "exposed_evidence"],
      "properties": {
        "schema_version": { "const": "generation-input-exposure-v0.1" },
        "run_id": { "type": "string", "minLength": 1 },
        "generation_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "responder_id": { "type": "string", "minLength": 1 },
        "purpose_id": { "type": "string", "minLength": 1 },
        "challenge_nonce": { "type": "string", "minLength": 32 },
        "signer_key_id": { "type": "string", "minLength": 1 },
        "model_snapshot_digest": { "$ref": "#/$defs/digest" },
        "prompt_template_digest": { "$ref": "#/$defs/digest" },
        "input_payload_digest": { "$ref": "#/$defs/digest" },
        "generated_at_ms": { "type": "integer", "minimum": 0 },
        "exposed_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence_entry" } }
      }
    },
    "signature_base64": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "evidence_id", "source_digest", "subject_id", "scope_id", "authorized_responder_id", "status", "applicability", "verified", "required"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_digest": { "$ref": "#/$defs/digest" },
        "subject_id": { "type": "string", "minLength": 1 },
        "scope_id": { "type": "string", "minLength": 1 },
        "authorized_responder_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["Current", "Superseded", "Disputed", "Expired", "Unknown"] },
        "applicability": { "enum": ["Applicable", "NotApplicable", "Conditional", "Unknown"] },
        "verified": { "const": true },
        "required": { "const": true }
      }
    }
  }
}
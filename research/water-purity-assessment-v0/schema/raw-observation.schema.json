{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/water-purity-observation-0.1.0.json",
  "title": "Water quality raw observation envelope",
  "description": "Synthetic-only contract for source observations. This object has no potability, standards-compliance, safety or certification field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "evidence_class",
    "evidence_ceiling",
    "observation_type",
    "subject",
    "sample",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{3,128}$"
    },
    "evidence_class": {
      "const": "synthetic_only"
    },
    "evidence_ceiling": {
      "const": "synthetic_observation_semantics_only_no_physical_claim"
    },
    "observation_type": {
      "enum": [
        "field_sensor",
        "laboratory_sample",
        "operator_record"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "sample_point_id",
        "intended_use"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sample_point_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "intended_use": {
          "const": "synthetic_test_only"
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_time_utc",
        "acquired_time_utc",
        "sampler_id",
        "chain_of_custody_status",
        "collection_method_id",
        "collection_method_revision"
      ],
      "properties": {
        "valid_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "acquired_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "sampler_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "chain_of_custody_status": {
          "enum": [
            "qualified",
            "unqualified",
            "unknown",
            "not_applicable"
          ]
        },
        "collection_method_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "collection_method_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "analyte_id",
          "value",
          "unit",
          "qualifier",
          "absolute_uncertainty",
          "detection_limit",
          "method_profile_id",
          "method_profile_revision",
          "instrument_ref",
          "calibration_state",
          "condition_applicability"
        ],
        "properties": {
          "analyte_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,63}$"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "qualifier": {
            "enum": [
              "measured",
              "below_detection",
              "missing",
              "invalid",
              "censored"
            ]
          },
          "absolute_uncertainty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "detection_limit": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "method_profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "method_profile_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "instrument_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "calibration_state": {
            "enum": [
              "qualified",
              "stale",
              "missing",
              "not_applicable",
              "unknown"
            ]
          },
          "condition_applicability": {
            "enum": [
              "within_envelope",
              "outside_envelope",
              "indeterminate",
              "not_applicable",
              "unknown"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  }
}

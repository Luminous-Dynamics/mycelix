{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/life-privacy-eval/gallery-sweep-report.schema.json",
  "title": "LIFE Gallery Sweep Report",
  "type": "object",
  "required": [
    "schema_version",
    "evaluator_version",
    "evaluation_mode",
    "seed",
    "requested_bootstrap_replicates",
    "per_draw_subject_risk_bound_policy",
    "per_draw_subject_risk_bound_alpha",
    "gallery_sampling",
    "gallery_sizes",
    "max_fpir_target",
    "threshold_policy",
    "frozen_threshold_policy",
    "size_results",
    "task_utility_evidence_present",
    "official_conformance_evidence_present",
    "overall_release_gate",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evaluator_version": {
      "const": "0.9.0"
    },
    "evaluation_mode": {
      "const": "gallery_scaling_open_set_identification"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "gallery_sampling": {
      "type": "object",
      "required": [
        "method",
        "rng",
        "draw_count",
        "candidate_frame_size",
        "candidate_score_semantics",
        "uncertainty_scope",
        "crossed_bootstrap_coverage_validation_status"
      ],
      "properties": {
        "method": {
          "const": "deterministic_seeded_uniform_without_replacement_nested_prefix_draws"
        },
        "rng": {
          "const": "xorshift64"
        },
        "draw_count": {
          "type": "integer",
          "minimum": 2
        },
        "candidate_frame_size": {
          "type": "integer",
          "minimum": 2
        },
        "candidate_score_semantics": {
          "const": "pairwise_scores_are_assumed_gallery_invariant"
        },
        "uncertainty_scope": {
          "const": "conditional_on_candidate_frame; crossed query-subject and gallery-draw resampling"
        },
        "crossed_bootstrap_coverage_validation_status": {
          "const": "KNOWN_SPARSE_EVENT_UNDERCOVERAGE_DO_NOT_USE_FOR_CERTIFICATION"
        }
      },
      "additionalProperties": true
    },
    "gallery_sizes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "integer",
        "minimum": 2
      }
    },
    "max_fpir_target": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "threshold_policy": {
      "type": "string",
      "minLength": 1
    },
    "frozen_threshold_policy": {
      "type": "object",
      "required": [
        "reference_gallery_size",
        "threshold"
      ],
      "properties": {
        "reference_gallery_size": {
          "type": "integer",
          "minimum": 2
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "size_results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "gallery_size",
          "validation_query_subjects",
          "test_query_subjects",
          "validation_locked_operating_point",
          "frozen_reference_threshold_scaling",
          "validation_metrics_at_frozen_threshold",
          "validation_metrics_at_frozen_threshold_by_stratum"
        ],
        "properties": {
          "gallery_size": {
            "type": "integer",
            "minimum": 2
          },
          "validation_query_subjects": {
            "type": "integer",
            "minimum": 1
          },
          "test_query_subjects": {
            "type": "integer",
            "minimum": 1
          },
          "validation_locked_operating_point": {
            "type": "object",
            "required": [
              "threshold",
              "operating_point_found",
              "validation_metrics",
              "validation_metrics_by_stratum",
              "validation_observed_fpir",
              "test_metrics",
              "test_metrics_by_stratum",
              "test_crossed_bootstrap_ci95",
              "per_gallery_draw_test_metrics"
            ],
            "properties": {
              "threshold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "operating_point_found": {
                "type": "boolean"
              },
              "validation_metrics": {
                "$ref": "#/$defs/metrics"
              },
              "validation_observed_fpir": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "test_metrics": {
                "$ref": "#/$defs/metrics"
              },
              "test_crossed_bootstrap_ci95": {
                "$ref": "#/$defs/intervals"
              },
              "per_gallery_draw_test_metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "draw_id",
                    "mated_queries",
                    "nonmated_queries",
                    "fpir",
                    "subject_level_any_false_identification"
                  ],
                  "properties": {
                    "draw_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mated_queries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "nonmated_queries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "fnir_at_rank_1": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fnir_at_rank_3": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fnir_at_rank_5": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fnir_at_rank_10": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fpir": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "subject_level_any_false_identification": {
                      "type": "object",
                      "required": [
                        "status",
                        "eligible_nonmated_subjects",
                        "subjects_with_any_false_identification",
                        "observed_rate",
                        "exact_one_sided_upper_bound",
                        "alpha",
                        "confidence_method",
                        "assumptions"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "NO_VALIDATION_THRESHOLD_INCONCLUSIVE",
                            "NO_ELIGIBLE_NONMATED_SUBJECTS",
                            "CONDITIONAL_SUBJECT_CLUSTER_BOUND"
                          ]
                        },
                        "eligible_nonmated_subjects": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "subjects_with_any_false_identification": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "observed_rate": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        },
                        "exact_one_sided_upper_bound": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        },
                        "alpha": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1
                        },
                        "confidence_method": {
                          "const": "one_sided_exact_clopper_pearson_binomial_upper_bound"
                        },
                        "assumptions": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": true
                }
              },
              "validation_metrics_by_stratum": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "stratum",
                    "metrics"
                  ],
                  "properties": {
                    "stratum": {
                      "type": "string"
                    },
                    "metrics": {
                      "$ref": "#/$defs/metrics"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "test_metrics_by_stratum": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "stratum",
                    "metrics"
                  ],
                  "properties": {
                    "stratum": {
                      "type": "string"
                    },
                    "metrics": {
                      "$ref": "#/$defs/metrics"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          },
          "frozen_reference_threshold_scaling": {
            "type": "object",
            "required": [
              "reference_gallery_size",
              "threshold",
              "test_metrics",
              "test_metrics_by_stratum",
              "test_crossed_bootstrap_ci95",
              "per_gallery_draw_test_metrics"
            ],
            "properties": {
              "reference_gallery_size": {
                "type": "integer",
                "minimum": 2
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "test_metrics": {
                "$ref": "#/$defs/metrics"
              },
              "test_crossed_bootstrap_ci95": {
                "$ref": "#/$defs/intervals"
              },
              "per_gallery_draw_test_metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "draw_id",
                    "mated_queries",
                    "nonmated_queries",
                    "fpir",
                    "subject_level_any_false_identification"
                  ],
                  "properties": {
                    "draw_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mated_queries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "nonmated_queries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "fnir_at_rank_1": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fnir_at_rank_3": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fnir_at_rank_5": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fnir_at_rank_10": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fpir": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "subject_level_any_false_identification": {
                      "type": "object",
                      "required": [
                        "status",
                        "eligible_nonmated_subjects",
                        "subjects_with_any_false_identification",
                        "observed_rate",
                        "exact_one_sided_upper_bound",
                        "alpha",
                        "confidence_method",
                        "assumptions"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "NO_VALIDATION_THRESHOLD_INCONCLUSIVE",
                            "NO_ELIGIBLE_NONMATED_SUBJECTS",
                            "CONDITIONAL_SUBJECT_CLUSTER_BOUND"
                          ]
                        },
                        "eligible_nonmated_subjects": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "subjects_with_any_false_identification": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "observed_rate": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        },
                        "exact_one_sided_upper_bound": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        },
                        "alpha": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1
                        },
                        "confidence_method": {
                          "const": "one_sided_exact_clopper_pearson_binomial_upper_bound"
                        },
                        "assumptions": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": true
                }
              },
              "test_metrics_by_stratum": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "stratum",
                    "metrics"
                  ],
                  "properties": {
                    "stratum": {
                      "type": "string"
                    },
                    "metrics": {
                      "$ref": "#/$defs/metrics"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          },
          "validation_metrics_at_frozen_threshold": {
            "$ref": "#/$defs/metrics"
          },
          "validation_metrics_at_frozen_threshold_by_stratum": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stratum",
                "metrics"
              ],
              "properties": {
                "stratum": {
                  "type": "string"
                },
                "metrics": {
                  "$ref": "#/$defs/metrics"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "task_utility_evidence_present": {
      "const": false
    },
    "official_conformance_evidence_present": {
      "const": false
    },
    "overall_release_gate": {
      "const": "NOT_EVALUATED_CROSSED_GALLERY_EVIDENCE_IS_NOT_RELEASE_CERTIFICATION"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requested_bootstrap_replicates": {
      "type": "integer",
      "minimum": 100
    },
    "per_draw_subject_risk_bound_policy": {
      "const": "exact one-sided Clopper-Pearson with Bonferroni alpha 0.05 / draw_count within each gallery-size and threshold-policy family; assumes independent representative subjects conditional on each realized gallery"
    },
    "per_draw_subject_risk_bound_alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "required": [
        "query_draw_observations",
        "mated_query_draw_observations",
        "nonmated_query_draw_observations",
        "false_identifications",
        "fnir_at_rank_1",
        "fnir_at_rank_3",
        "fnir_at_rank_5",
        "fnir_at_rank_10",
        "fpir"
      ],
      "properties": {
        "query_draw_observations": {
          "type": "integer",
          "minimum": 0
        },
        "mated_query_draw_observations": {
          "type": "integer",
          "minimum": 0
        },
        "nonmated_query_draw_observations": {
          "type": "integer",
          "minimum": 0
        },
        "false_identifications": {
          "type": "integer",
          "minimum": 0
        },
        "fnir_at_rank_1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fnir_at_rank_3": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fnir_at_rank_5": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fnir_at_rank_10": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fpir": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "interval": {
      "type": "object",
      "required": [
        "low",
        "high",
        "valid_replicates"
      ],
      "properties": {
        "low": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "high": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "valid_replicates": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "intervals": {
      "type": "object",
      "required": [
        "method",
        "coverage_validation_status",
        "fnir_at_rank_1",
        "fnir_at_rank_3",
        "fnir_at_rank_5",
        "fnir_at_rank_10",
        "fpir"
      ],
      "properties": {
        "method": {
          "const": "crossed_query_subject_and_gallery_draw_cluster_percentile_bootstrap"
        },
        "coverage_validation_status": {
          "const": "KNOWN_SPARSE_EVENT_UNDERCOVERAGE_DO_NOT_USE_FOR_CERTIFICATION"
        },
        "fnir_at_rank_1": {
          "$ref": "#/$defs/interval"
        },
        "fnir_at_rank_3": {
          "$ref": "#/$defs/interval"
        },
        "fnir_at_rank_5": {
          "$ref": "#/$defs/interval"
        },
        "fnir_at_rank_10": {
          "$ref": "#/$defs/interval"
        },
        "fpir": {
          "$ref": "#/$defs/interval"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

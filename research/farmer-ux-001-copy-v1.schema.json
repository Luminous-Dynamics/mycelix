{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/farmer-ux-001-copy-v1.schema.json",
  "title": "Farmer UX-001 state and microcopy deck",
  "description": "Structural format for English copy hypotheses associated with explicit user-facing states. Not localization or usability qualification.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "tracking_issue",
    "principles",
    "states"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "english_copy_hypothesis_for_local_user_testing"
    },
    "tracking_issue": {
      "type": "string",
      "format": "uri"
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "state_family",
          "headline",
          "body",
          "primary_action",
          "secondary_actions",
          "must_not_imply"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "state_family": {
            "enum": [
              "sync",
              "evidence",
              "spatial",
              "service",
              "commercial",
              "privacy",
              "access"
            ]
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "primary_action": {
            "type": "string",
            "minLength": 1
          },
          "secondary_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "must_not_imply": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

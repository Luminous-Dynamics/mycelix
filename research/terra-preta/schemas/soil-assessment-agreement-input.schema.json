{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic soil assessment agreement scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "indicators",
    "weight_profiles",
    "hard_guardrails",
    "alternatives"
  ],
  "properties": {
    "schema_version": {
      "const": "soil-assessment-agreement-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "indicators": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "indicator_id",
          "function_group",
          "unit",
          "direction",
          "reference_min",
          "reference_max",
          "threshold_value",
          "threshold_relation"
        ],
        "properties": {
          "indicator_id": {
            "type": "string",
            "minLength": 1
          },
          "function_group": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "higher_is_better",
              "lower_is_better"
            ]
          },
          "reference_min": {
            "type": "number"
          },
          "reference_max": {
            "type": "number"
          },
          "threshold_value": {
            "type": "number"
          },
          "threshold_relation": {
            "enum": [
              "minimum",
              "maximum"
            ]
          }
        }
      }
    },
    "weight_profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "weights"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "weights": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "indicator_id",
                "weight"
              ],
              "properties": {
                "indicator_id": {
                  "type": "string",
                  "minLength": 1
                },
                "weight": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "hard_guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "guardrail_id",
          "indicator_id",
          "status",
          "authority"
        ],
        "properties": {
          "guardrail_id": {
            "type": "string",
            "minLength": 1
          },
          "indicator_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "synthetic_fixture"
          },
          "minimum_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "maximum_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternative_id",
          "independence_group_id",
          "measurements"
        ],
        "properties": {
          "alternative_id": {
            "type": "string",
            "minLength": 1
          },
          "independence_group_id": {
            "type": "string",
            "minLength": 1
          },
          "measurements": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "indicator_id",
                "value",
                "standard_error"
              ],
              "properties": {
                "indicator_id": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "standard_error": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}

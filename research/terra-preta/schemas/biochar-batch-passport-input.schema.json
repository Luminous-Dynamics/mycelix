{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/terra-preta/schemas/biochar-batch-passport-input.schema.json",
  "title": "Synthetic biochar batch passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "quality_profile",
    "batch"
  ],
  "properties": {
    "schema_version": {
      "const": "biochar-batch-passport-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_product_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "quality_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_sha256",
        "authority",
        "jurisdiction",
        "end_use",
        "status",
        "effective_from",
        "require_accredited_labs",
        "non_biogenic_co_processing_allowed",
        "minimum_temperature_c",
        "minimum_residence_time_min",
        "minimum_sampling_increments",
        "minimum_retention_sample_volume_l",
        "analyte_criteria"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "end_use": {
          "enum": [
            "agricultural_soil",
            "forest_soil",
            "materials",
            "other"
          ]
        },
        "status": {
          "const": "synthetic_fixture_not_certification"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_until": {
          "type": "string",
          "format": "date"
        },
        "require_accredited_labs": {
          "type": "boolean"
        },
        "non_biogenic_co_processing_allowed": {
          "type": "boolean"
        },
        "minimum_temperature_c": {
          "type": "number",
          "minimum": 0
        },
        "minimum_residence_time_min": {
          "type": "number",
          "minimum": 0
        },
        "minimum_sampling_increments": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_retention_sample_volume_l": {
          "type": "number",
          "minimum": 0
        },
        "analyte_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "analyte_id",
              "unit",
              "basis",
              "method_id",
              "direction",
              "limit"
            ],
            "properties": {
              "analyte_id": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "const": "dry_matter"
              },
              "method_id": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "maximum",
                  "minimum"
                ]
              },
              "limit": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "production_unit_id",
        "production_start",
        "production_end",
        "intended_end_use",
        "non_biogenic_co_processed",
        "feedstock_lots",
        "process",
        "mass_accounting",
        "sampling",
        "laboratory_results",
        "carbon_removal_claim_requested",
        "agronomic_suitability_claim_requested"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "production_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "production_start": {
          "type": "string",
          "format": "date-time"
        },
        "production_end": {
          "type": "string",
          "format": "date-time"
        },
        "intended_end_use": {
          "enum": [
            "agricultural_soil",
            "forest_soil",
            "materials",
            "other"
          ]
        },
        "non_biogenic_co_processed": {
          "type": "boolean"
        },
        "feedstock_lots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lot_id",
              "feedstock_type",
              "dry_mass_kg",
              "origin_status",
              "prior_use",
              "contamination_status",
              "ecological_retention_status",
              "source_record_sha256"
            ],
            "properties": {
              "lot_id": {
                "type": "string",
                "minLength": 1
              },
              "feedstock_type": {
                "type": "string",
                "minLength": 1
              },
              "dry_mass_kg": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "origin_status": {
                "enum": [
                  "documented",
                  "unknown",
                  "restricted"
                ]
              },
              "prior_use": {
                "type": "string",
                "minLength": 1
              },
              "contamination_status": {
                "enum": [
                  "screened",
                  "unknown",
                  "flagged"
                ]
              },
              "ecological_retention_status": {
                "enum": [
                  "approved_residual",
                  "removal_approved",
                  "unknown",
                  "not_assessed"
                ]
              },
              "source_record_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_record_sha256",
            "common_conditions_verified",
            "temperature_target_c",
            "temperature_min_c",
            "temperature_max_c",
            "residence_time_min",
            "oxygen_control_method",
            "production_unit_id",
            "run_count"
          ],
          "properties": {
            "process_record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "common_conditions_verified": {
              "type": "boolean"
            },
            "temperature_target_c": {
              "type": "number",
              "minimum": 0
            },
            "temperature_min_c": {
              "type": "number",
              "minimum": 0
            },
            "temperature_max_c": {
              "type": "number",
              "minimum": 0
            },
            "residence_time_min": {
              "type": "number",
              "minimum": 0
            },
            "oxygen_control_method": {
              "type": "string",
              "minLength": 1
            },
            "production_unit_id": {
              "type": "string",
              "minLength": 1
            },
            "run_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "mass_accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dry_feedstock_input_kg",
            "biochar_output_kg",
            "other_co_product_output_kg",
            "mass_accounting_record_sha256"
          ],
          "properties": {
            "dry_feedstock_input_kg": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "biochar_output_kg": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "other_co_product_output_kg": {
              "type": "number",
              "minimum": 0
            },
            "mass_accounting_record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sampling_plan_id",
            "sampling_method",
            "representative_sampling_confirmed",
            "homogenized_before_sampling",
            "increment_count",
            "sample_id",
            "sample_seal_id",
            "custody_record_sha256",
            "laboratory_sample_id",
            "sample_sha256",
            "retention_sample_volume_l",
            "retention_until"
          ],
          "properties": {
            "sampling_plan_id": {
              "type": "string",
              "minLength": 1
            },
            "sampling_method": {
              "type": "string",
              "minLength": 1
            },
            "representative_sampling_confirmed": {
              "type": "boolean"
            },
            "homogenized_before_sampling": {
              "type": "boolean"
            },
            "increment_count": {
              "type": "integer",
              "minimum": 0
            },
            "sample_id": {
              "type": "string",
              "minLength": 1
            },
            "sample_seal_id": {
              "type": "string",
              "minLength": 1
            },
            "custody_record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "laboratory_sample_id": {
              "type": "string",
              "minLength": 1
            },
            "sample_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "retention_sample_volume_l": {
              "type": "number",
              "minimum": 0
            },
            "retention_until": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "laboratory_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "analyte_id",
              "result_qualifier",
              "measured_value",
              "unit",
              "basis",
              "method_id",
              "laboratory_id",
              "accreditation_status",
              "accreditation_scope",
              "detection_limit",
              "quantification_limit",
              "expanded_uncertainty",
              "replicate_count",
              "lab_report_sha256"
            ],
            "properties": {
              "analyte_id": {
                "type": "string",
                "minLength": 1
              },
              "result_qualifier": {
                "enum": [
                  "quantified",
                  "below_lod",
                  "below_loq"
                ]
              },
              "measured_value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "dry_matter",
                  "as_received",
                  "other"
                ]
              },
              "method_id": {
                "type": "string",
                "minLength": 1
              },
              "laboratory_id": {
                "type": "string",
                "minLength": 1
              },
              "accreditation_status": {
                "enum": [
                  "accredited",
                  "not_accredited",
                  "unknown"
                ]
              },
              "accreditation_scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "detection_limit": {
                "type": "number",
                "minimum": 0
              },
              "quantification_limit": {
                "type": "number",
                "minimum": 0
              },
              "expanded_uncertainty": {
                "type": "number",
                "minimum": 0
              },
              "replicate_count": {
                "type": "integer",
                "minimum": 1
              },
              "lab_report_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "result_qualifier": {
                      "const": "quantified"
                    }
                  },
                  "required": [
                    "result_qualifier"
                  ]
                },
                "then": {
                  "properties": {
                    "measured_value": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "result_qualifier": {
                      "enum": [
                        "below_lod",
                        "below_loq"
                      ]
                    }
                  },
                  "required": [
                    "result_qualifier"
                  ]
                },
                "then": {
                  "properties": {
                    "measured_value": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "carbon_removal_claim_requested": {
          "type": "boolean"
        },
        "agronomic_suitability_claim_requested": {
          "type": "boolean"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic NIR screening and referral bake-off report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_version",
    "fixture_status",
    "scenario_id",
    "input_sha256",
    "sample_count",
    "referral_capacity",
    "policies",
    "controls",
    "interpretation_boundary"
  ],
  "properties": {
    "audit_version": {
      "const": "0.1.0"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "referral_capacity": {
      "type": "integer",
      "minimum": 0
    },
    "policies": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "referral_count",
          "referral_fraction",
          "nir_screening_count",
          "confirmatory_cost",
          "total_cost",
          "false_positive_count",
          "false_negative_count",
          "weighted_decision_loss",
          "errors_after_referral",
          "loss_regret_vs_all_reference",
          "loss_regret_vs_hindsight_oracle",
          "selection_sha256",
          "deterministic_replay_pass"
        ],
        "properties": {
          "policy_id": {
            "enum": [
              "nir_only",
              "all_reference",
              "random_fixed_budget",
              "fixed_uncertainty_threshold",
              "uncertainty_rank",
              "applicability_domain",
              "decision_risk_rank",
              "perfect_information_hindsight_oracle"
            ]
          },
          "referral_count": {
            "type": "integer",
            "minimum": 0
          },
          "referral_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "nir_screening_count": {
            "type": "integer",
            "minimum": 0
          },
          "confirmatory_cost": {
            "type": "number",
            "minimum": 0
          },
          "total_cost": {
            "type": "number",
            "minimum": 0
          },
          "false_positive_count": {
            "type": "integer",
            "minimum": 0
          },
          "false_negative_count": {
            "type": "integer",
            "minimum": 0
          },
          "weighted_decision_loss": {
            "type": "number",
            "minimum": 0
          },
          "errors_after_referral": {
            "type": "integer",
            "minimum": 0
          },
          "loss_regret_vs_all_reference": {
            "type": "number"
          },
          "loss_regret_vs_hindsight_oracle": {
            "type": "number"
          },
          "selection_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "deterministic_replay_pass": {
            "const": true
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_mutation_selection_invariant",
        "hidden_truth_not_used_by_selectors",
        "capacity_pass",
        "deterministic_replay_pass"
      ],
      "properties": {
        "truth_mutation_selection_invariant": {
          "const": true
        },
        "hidden_truth_not_used_by_selectors": {
          "const": true
        },
        "capacity_pass": {
          "const": true
        },
        "deterministic_replay_pass": {
          "const": true
        }
      }
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic soil event capture policy evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_version",
    "fixture_status",
    "scenario_id",
    "policy_submission_sha256",
    "evaluator_truth_sha256",
    "policy_count",
    "policies",
    "controls",
    "interpretation_boundary"
  ],
  "properties": {
    "audit_version": {
      "const": "0.1.0"
    },
    "fixture_status": {
      "const": "synthetic_event_capture_score_not_empirical"
    },
    "scenario_id": {
      "type": "string"
    },
    "policy_submission_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_truth_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_count": {
      "type": "integer",
      "minimum": 1
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "policy_family",
          "policy_schedule_sha256",
          "sample_count",
          "sample_cost_units",
          "sample_budget_pass",
          "out_of_event_sample_count",
          "false_trigger_count",
          "events_detected",
          "event_count",
          "missed_event_count",
          "events",
          "policy_role"
        ],
        "properties": {
          "policy_id": {
            "type": "string"
          },
          "policy_family": {
            "type": "string"
          },
          "policy_schedule_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sample_count": {
            "type": "integer",
            "minimum": 0
          },
          "sample_cost_units": {
            "type": "number",
            "minimum": 0
          },
          "sample_budget_pass": {
            "type": "boolean"
          },
          "out_of_event_sample_count": {
            "type": "integer",
            "minimum": 0
          },
          "false_trigger_count": {
            "type": "integer",
            "minimum": 0
          },
          "events_detected": {
            "type": "integer",
            "minimum": 0
          },
          "event_count": {
            "type": "integer",
            "minimum": 1
          },
          "missed_event_count": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "event_detected",
                "detection_time_hours",
                "detection_delay_hours",
                "true_peak_value",
                "true_peak_time_hours",
                "sampled_peak_value",
                "sampled_peak_time_hours",
                "absolute_peak_error",
                "true_pulse_burden_anomaly_unit_hours",
                "sampled_pulse_burden_anomaly_unit_hours",
                "absolute_pulse_burden_error",
                "relative_pulse_burden_error",
                "event_sample_count",
                "sampled_max_inter_observation_gap_hours",
                "pulse_burden_status"
              ],
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "event_detected": {
                  "type": "boolean"
                },
                "detection_time_hours": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "detection_delay_hours": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "true_peak_value": {
                  "type": "number"
                },
                "true_peak_time_hours": {
                  "type": "number"
                },
                "sampled_peak_value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "sampled_peak_time_hours": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "absolute_peak_error": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "true_pulse_burden_anomaly_unit_hours": {
                  "type": "number",
                  "minimum": 0
                },
                "sampled_pulse_burden_anomaly_unit_hours": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "absolute_pulse_burden_error": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "relative_pulse_burden_error": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "event_sample_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "sampled_max_inter_observation_gap_hours": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "pulse_burden_status": {
                  "enum": [
                    "qualified_integral",
                    "missing_event_boundary",
                    "gap_exceeded"
                  ]
                }
              }
            }
          },
          "policy_role": {
            "enum": [
              "candidate",
              "evaluator_only_reference"
            ]
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_input_has_no_truth_values",
        "exact_timestamp_sampling_only",
        "no_interpolation_or_nearest_neighbor",
        "separate_policy_and_evaluator_digests",
        "no_aggregate_policy_score"
      ],
      "properties": {
        "policy_input_has_no_truth_values": {
          "const": true
        },
        "exact_timestamp_sampling_only": {
          "const": true
        },
        "no_interpolation_or_nearest_neighbor": {
          "const": true
        },
        "separate_policy_and_evaluator_digests": {
          "const": true
        },
        "no_aggregate_policy_score": {
          "const": true
        }
      }
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}

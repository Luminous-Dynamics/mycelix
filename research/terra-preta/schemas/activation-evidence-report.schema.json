{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "activation-evidence-report.schema.json",
  "title": "Hydraulic activation evidence admission report",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_version", "fixture_status", "scenario_id", "input_sha256", "assertion_count", "confirmed_active_count", "confirmed_inactive_count", "unassessed_count", "results", "controls", "interpretation_boundary"],
  "properties": {
    "audit_version": { "const": "activation-evidence-audit-v0.1" },
    "fixture_status": { "const": "synthetic_only_not_empirical_evidence" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assertion_count": { "type": "integer", "minimum": 1 },
    "confirmed_active_count": { "type": "integer", "minimum": 0 },
    "confirmed_inactive_count": { "type": "integer", "minimum": 0 },
    "unassessed_count": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "asserted_state", "admission_status", "qualifying_active_evidence_ids", "qualifying_inactive_evidence_ids", "reasons"],
        "properties": {
          "edge_id": { "type": "string", "minLength": 1 },
          "asserted_state": { "enum": ["active", "inactive", "unassessed"] },
          "admission_status": { "enum": ["confirmed_active", "confirmed_inactive", "unassessed"] },
          "qualifying_active_evidence_ids": { "type": "array", "items": { "type": "string" } },
          "qualifying_inactive_evidence_ids": { "type": "array", "items": { "type": "string" } },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_observation_required_for_confirmed_hydraulic_state", "structural_image_cannot_confirm_hydraulic_activation", "model_prediction_cannot_confirm_hydraulic_activation", "inactivity_requires_event_coverage_and_detection_bound", "conflicting_direct_evidence_abstains", "specimen_event_and_registered_3d_edge_support_required", "synthetic_only_claim_ceiling"],
      "properties": {
        "direct_observation_required_for_confirmed_hydraulic_state": { "const": true },
        "structural_image_cannot_confirm_hydraulic_activation": { "const": true },
        "model_prediction_cannot_confirm_hydraulic_activation": { "const": true },
        "inactivity_requires_event_coverage_and_detection_bound": { "const": true },
        "conflicting_direct_evidence_abstains": { "const": true },
        "specimen_event_and_registered_3d_edge_support_required": { "const": true },
        "synthetic_only_claim_ceiling": { "const": true }
      }
    },
    "interpretation_boundary": { "type": "string", "minLength": 1 }
  }
}
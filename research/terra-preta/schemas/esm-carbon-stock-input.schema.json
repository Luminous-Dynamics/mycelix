{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic layered-core SOC stock comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "experimental_unit",
    "method_basis",
    "reference_fine_earth_mass_mg_ha",
    "rounds"
  ],
  "properties": {
    "schema_version": {
      "const": "esm-carbon-stock-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "experimental_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimental_unit_id",
        "independence_group_id",
        "core_role"
      ],
      "properties": {
        "experimental_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "independence_group_id": {
          "type": "string",
          "minLength": 1
        },
        "core_role": {
          "const": "nested_spatial_subsample_not_independent_treatment_replicate"
        }
      }
    },
    "method_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soc_unit",
        "bulk_density_basis",
        "coarse_fragment_basis",
        "soc_method",
        "bulk_density_method",
        "coarse_fragment_method",
        "profile_area_basis"
      ],
      "properties": {
        "soc_unit": {
          "const": "g_C_per_kg_dry_fine_earth"
        },
        "bulk_density_basis": {
          "const": "g_cm3_dry_fine_earth_excluding_coarse_fragments"
        },
        "coarse_fragment_basis": {
          "const": "volume_fraction_of_total_core"
        },
        "soc_method": {
          "type": "string",
          "minLength": 1
        },
        "bulk_density_method": {
          "type": "string",
          "minLength": 1
        },
        "coarse_fragment_method": {
          "type": "string",
          "minLength": 1
        },
        "profile_area_basis": {
          "const": "per_hectare"
        }
      }
    },
    "reference_fine_earth_mass_mg_ha": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round_id",
          "date",
          "round_role",
          "cores"
        ],
        "properties": {
          "round_id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "round_role": {
            "enum": [
              "baseline",
              "follow_up"
            ]
          },
          "cores": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "core_id",
                "layers"
              ],
              "properties": {
                "core_id": {
                  "type": "string",
                  "minLength": 1
                },
                "layers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "depth_top_cm",
                      "depth_bottom_cm",
                      "soc_g_per_kg_fine_earth",
                      "fine_earth_bulk_density_g_cm3",
                      "coarse_fragment_volume_fraction"
                    ],
                    "properties": {
                      "depth_top_cm": {
                        "type": "number",
                        "minimum": 0
                      },
                      "depth_bottom_cm": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "soc_g_per_kg_fine_earth": {
                        "type": "number",
                        "minimum": 0
                      },
                      "fine_earth_bulk_density_g_cm3": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "coarse_fragment_volume_fraction": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMaximum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

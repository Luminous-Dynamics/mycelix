{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic SOC stock remeasurement scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "config",
    "unit_semantics",
    "baseline_profile",
    "followup_profile",
    "amendment_inputs",
    "source_attribution_status"
  ],
  "properties": {
    "schema_version": {
      "const": "soc-stock-esm-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_accounting_depth_m"
      ],
      "properties": {
        "fixed_accounting_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "unit_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bulk_density_basis",
        "soc_concentration_unit",
        "coarse_fragment_basis",
        "stock_unit"
      ],
      "properties": {
        "bulk_density_basis": {
          "const": "oven_dry_fine_earth_mass_per_fine_earth_volume"
        },
        "soc_concentration_unit": {
          "const": "g_C_per_kg_dry_fine_earth"
        },
        "coarse_fragment_basis": {
          "const": "coarse_fragment_volume_fraction_of_total_core_volume"
        },
        "stock_unit": {
          "const": "Mg_C_per_ha"
        }
      }
    },
    "baseline_profile": {
      "$ref": "#/$defs/profile"
    },
    "followup_profile": {
      "$ref": "#/$defs/profile"
    },
    "amendment_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "material_name",
          "applied_date",
          "dry_matter_mg_per_ha",
          "carbon_concentration_g_per_kg_dry_matter"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1
          },
          "material_name": {
            "type": "string",
            "minLength": 1
          },
          "applied_date": {
            "type": "string",
            "format": "date"
          },
          "dry_matter_mg_per_ha": {
            "type": "number",
            "minimum": 0
          },
          "carbon_concentration_g_per_kg_dry_matter": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "source_attribution_status": {
      "const": "unresolved_bulk_soc_does_not_identify_native_vs_amendment_carbon"
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "plot_id",
        "measurement_date",
        "measurement_method",
        "reference_method_id",
        "lab_batch_id",
        "source_sha256",
        "layers"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "plot_id": {
          "type": "string",
          "minLength": 1
        },
        "measurement_date": {
          "type": "string",
          "format": "date"
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1
        },
        "reference_method_id": {
          "type": "string",
          "minLength": 1
        },
        "lab_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer_id",
              "top_depth_m",
              "bottom_depth_m",
              "fine_earth_bulk_density_kg_m3",
              "coarse_fragment_volume_fraction",
              "soc_concentration_g_c_per_kg",
              "bulk_density_standard_error_kg_m3",
              "coarse_fragment_fraction_standard_error",
              "soc_standard_error_g_c_per_kg"
            ],
            "properties": {
              "layer_id": {
                "type": "string",
                "minLength": 1
              },
              "top_depth_m": {
                "type": "number",
                "minimum": 0
              },
              "bottom_depth_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fine_earth_bulk_density_kg_m3": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "coarse_fragment_volume_fraction": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "soc_concentration_g_c_per_kg": {
                "type": "number",
                "minimum": 0
              },
              "bulk_density_standard_error_kg_m3": {
                "type": "number",
                "minimum": 0
              },
              "coarse_fragment_fraction_standard_error": {
                "type": "number",
                "minimum": 0
              },
              "soc_standard_error_g_c_per_kg": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic evaluator-only soil event truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "trace_id",
    "baseline_value",
    "detection_threshold_above_baseline",
    "time_resolution_hours",
    "samples",
    "pulses"
  ],
  "properties": {
    "schema_version": {
      "const": "soil-event-truth-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic_evaluator_only"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_value": {
      "type": "number"
    },
    "detection_threshold_above_baseline": {
      "type": "number",
      "minimum": 0
    },
    "time_resolution_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time_hours",
          "response_value"
        ],
        "properties": {
          "time_hours": {
            "type": "number"
          },
          "response_value": {
            "type": "number"
          }
        }
      }
    },
    "pulses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pulse_id",
          "start_hours",
          "end_hours",
          "minimum_detected_samples"
        ],
        "properties": {
          "pulse_id": {
            "type": "string",
            "minLength": 1
          },
          "start_hours": {
            "type": "number"
          },
          "end_hours": {
            "type": "number"
          },
          "minimum_detected_samples": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}

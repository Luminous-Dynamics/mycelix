{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terra Preta spectral dataset profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "dataset_source",
    "sample_id_column",
    "properties",
    "spectral_column_prefix",
    "spectral_axis_unit",
    "spectral_axis_descending",
    "spectral_regions",
    "expected_nir_to_mir_gap_cm1",
    "spectral_value_semantics",
    "sample_support",
    "georeferenced_sample_count",
    "georeferenced_sample_count_is_subset",
    "notes"
  ],
  "properties": {
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_doi",
        "zenodo_version_doi",
        "zenodo_record_id",
        "version",
        "filename",
        "publisher_md5_reference",
        "expected_sample_rows",
        "license_status",
        "retrieval_sha256"
      ],
      "properties": {
        "article_doi": {
          "type": "string",
          "minLength": 1
        },
        "zenodo_version_doi": {
          "type": "string",
          "minLength": 1
        },
        "zenodo_record_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "publisher_md5_reference": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "expected_sample_rows": {
          "type": "integer",
          "minimum": 1
        },
        "license_status": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sample_id_column": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "column",
          "unit",
          "reference_method"
        ],
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "reference_method": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "spectral_column_prefix": {
      "type": "string",
      "minLength": 1
    },
    "spectral_axis_unit": {
      "enum": [
        "cm-1"
      ]
    },
    "spectral_axis_descending": {
      "type": "boolean"
    },
    "spectral_regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region_id",
          "minimum_cm1",
          "maximum_cm1",
          "instrument"
        ],
        "properties": {
          "region_id": {
            "type": "string",
            "minLength": 1
          },
          "minimum_cm1": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maximum_cm1": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "instrument": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_nir_to_mir_gap_cm1": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "spectral_value_semantics": {
      "type": "string",
      "minLength": 1
    },
    "sample_support": {
      "type": "string",
      "minLength": 1
    },
    "georeferenced_sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "georeferenced_sample_count_is_subset": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

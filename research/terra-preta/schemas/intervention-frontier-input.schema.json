{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/terra-preta/schemas/intervention-frontier-input.schema.json",
  "title": "Synthetic regenerative soil intervention frontier scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "frontier_contract",
    "outcome_definitions",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "intervention-frontier-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_agronomic_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "frontier_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_authority",
        "threshold_status"
      ],
      "properties": {
        "threshold_authority": {
          "type": "string",
          "minLength": 1
        },
        "threshold_status": {
          "const": "synthetic_fixture_only"
        }
      }
    },
    "outcome_definitions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome_id",
          "unit",
          "direction",
          "hard_guardrail_status"
        ],
        "properties": {
          "outcome_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "maximize",
              "minimize",
              "target_range"
            ]
          },
          "target_min": {
            "type": "number"
          },
          "target_max": {
            "type": "number"
          },
          "hard_minimum": {
            "type": "number"
          },
          "hard_maximum": {
            "type": "number"
          },
          "hard_guardrail_status": {
            "enum": [
              "not_set",
              "synthetic_fixture_only"
            ]
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "candidate_class",
          "domain_status",
          "critical_evidence_status",
          "product_quality_status",
          "sourcing_status",
          "outcomes"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_class": {
            "enum": [
              "no_action",
              "management",
              "compost",
              "biochar",
              "mineral_amendment",
              "water_management",
              "other"
            ]
          },
          "domain_status": {
            "enum": [
              "in_domain",
              "out_of_domain",
              "unassessed"
            ]
          },
          "critical_evidence_status": {
            "enum": [
              "complete",
              "incomplete",
              "adverse"
            ]
          },
          "product_quality_status": {
            "enum": [
              "not_applicable",
              "profile_pass",
              "profile_fail",
              "unknown"
            ]
          },
          "sourcing_status": {
            "enum": [
              "approved",
              "not_applicable",
              "unknown",
              "prohibited"
            ]
          },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome_id",
                "lower_bound",
                "upper_bound"
              ],
              "properties": {
                "outcome_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lower_bound": {
                  "type": "number"
                },
                "upper_bound": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}

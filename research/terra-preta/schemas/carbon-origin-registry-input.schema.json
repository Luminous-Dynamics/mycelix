{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic biochar and soil carbon registry overlap scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "registry_manifest_sha256",
    "application_records",
    "registry_entries",
    "soc_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "carbon-origin-registry-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "registry_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "application_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application_record_id",
          "batch_id",
          "field_id",
          "spatial_overlap_group_id",
          "geometry_sha256",
          "application_date",
          "applied_biochar_carbon_mg_c",
          "batch_passport_sha256",
          "application_record_sha256"
        ],
        "properties": {
          "application_record_id": {
            "type": "string",
            "minLength": 1
          },
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "spatial_overlap_group_id": {
            "type": "string",
            "minLength": 1
          },
          "geometry_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "application_date": {
            "type": "string",
            "format": "date"
          },
          "applied_biochar_carbon_mg_c": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "batch_passport_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "application_record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "registry_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry_entry_id",
          "carbon_tranche_id",
          "sink_type",
          "field_id",
          "spatial_overlap_group_id",
          "geometry_sha256",
          "claim_period_start",
          "claim_period_end",
          "credited_mg_c",
          "status",
          "methodology_id",
          "methodology_version",
          "evidence_sha256"
        ],
        "properties": {
          "registry_entry_id": {
            "type": "string",
            "minLength": 1
          },
          "carbon_tranche_id": {
            "type": "string",
            "minLength": 1
          },
          "sink_type": {
            "enum": [
              "biochar_batch_cdr",
              "soil_soc_stock_cdr"
            ]
          },
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "spatial_overlap_group_id": {
            "type": "string",
            "minLength": 1
          },
          "geometry_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "application_date": {
            "type": "string",
            "format": "date"
          },
          "claim_period_start": {
            "type": "string",
            "format": "date"
          },
          "claim_period_end": {
            "type": "string",
            "format": "date"
          },
          "credited_mg_c": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "status": {
            "enum": [
              "active",
              "retired",
              "withdrawn",
              "rejected"
            ]
          },
          "methodology_id": {
            "type": "string",
            "minLength": 1
          },
          "methodology_version": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "sink_type": {
                  "const": "biochar_batch_cdr"
                }
              },
              "required": [
                "sink_type"
              ]
            },
            "then": {
              "required": [
                "batch_id",
                "application_date"
              ]
            }
          }
        ]
      }
    },
    "soc_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "project_id",
        "field_id",
        "spatial_overlap_group_id",
        "geometry_sha256",
        "spatial_relationship_status",
        "period_start",
        "period_end",
        "gross_soc_stock_change_mg_c",
        "stock_basis",
        "esm_method_id",
        "esm_method_version",
        "esm_reference_fine_earth_mass_mg_ha",
        "esm_report_sha256",
        "declared_biochar_correction_mg_c",
        "pyc_evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "field_id": {
          "type": "string",
          "minLength": 1
        },
        "spatial_overlap_group_id": {
          "type": "string",
          "minLength": 1
        },
        "geometry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "spatial_relationship_status": {
          "enum": [
            "exact_overlap_group_resolved",
            "unknown"
          ]
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "gross_soc_stock_change_mg_c": {
          "type": "number"
        },
        "stock_basis": {
          "const": "equivalent_soil_mass"
        },
        "esm_method_id": {
          "type": "string",
          "minLength": 1
        },
        "esm_method_version": {
          "type": "string",
          "minLength": 1
        },
        "esm_reference_fine_earth_mass_mg_ha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "esm_report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "declared_biochar_correction_mg_c": {
          "type": "number",
          "minimum": 0
        },
        "pyc_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_measured",
                "total_pyrogenic_only",
                "source_unresolved"
              ]
            },
            "measured_total_pyc_mg_c": {
              "type": "number",
              "minimum": 0
            },
            "measurement_method": {
              "type": "string",
              "minLength": 1
            },
            "measurement_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "total_pyrogenic_only",
                      "source_unresolved"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "measured_total_pyc_mg_c",
                  "measurement_method",
                  "measurement_sha256"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "not_measured"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "measured_total_pyc_mg_c"
                      ]
                    },
                    {
                      "required": [
                        "measurement_method"
                      ]
                    },
                    {
                      "required": [
                        "measurement_sha256"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}

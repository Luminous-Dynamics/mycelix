{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic event sampling policy evaluation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "sampling_contract",
    "latent_truth",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "const": "event-sampling-evaluator-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_policy_evaluator_not_field_data"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "sampling_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_start_hours",
        "baseline_end_hours",
        "event_start_hours",
        "event_end_hours",
        "pulse_start_hours",
        "pulse_end_hours",
        "maximum_event_sample_gap_hours",
        "minimum_pulse_departure",
        "sensor_energy_wh_per_sample",
        "maximum_samples_per_policy",
        "maximum_energy_wh_per_policy"
      ],
      "properties": {
        "baseline_start_hours": {
          "type": "number"
        },
        "baseline_end_hours": {
          "type": "number"
        },
        "event_start_hours": {
          "type": "number"
        },
        "event_end_hours": {
          "type": "number"
        },
        "pulse_start_hours": {
          "type": "number"
        },
        "pulse_end_hours": {
          "type": "number"
        },
        "maximum_event_sample_gap_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_pulse_departure": {
          "type": "number",
          "minimum": 0
        },
        "sensor_energy_wh_per_sample": {
          "type": "number",
          "minimum": 0
        },
        "maximum_samples_per_policy": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_energy_wh_per_policy": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "latent_truth": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "truth_id",
          "time_hours",
          "response_value",
          "forcing_value"
        ],
        "properties": {
          "truth_id": {
            "type": "string",
            "minLength": 1
          },
          "time_hours": {
            "type": "number"
          },
          "response_value": {
            "type": "number"
          },
          "forcing_value": {
            "type": "number"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "policy_class",
          "evaluation_role",
          "sample_actions"
        ],
        "properties": {
          "policy_id": {
            "type": "string",
            "minLength": 1
          },
          "policy_class": {
            "enum": [
              "fixed_cadence",
              "forcing_triggered",
              "adaptive_from_past",
              "high_rate_oracle"
            ]
          },
          "evaluation_role": {
            "enum": [
              "deployable_candidate",
              "evaluation_ceiling_only"
            ]
          },
          "sample_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sample_id",
                "decision_time_hours",
                "sample_time_hours",
                "action_mode",
                "decision_basis_observation_ids",
                "reason_code"
              ],
              "properties": {
                "sample_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_time_hours": {
                  "type": "number"
                },
                "sample_time_hours": {
                  "type": "number"
                },
                "action_mode": {
                  "enum": [
                    "precommitted",
                    "adaptive_from_past"
                  ]
                },
                "decision_basis_observation_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reason_code": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic sensor observation and derived indicator lineage scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "instruments",
    "sensor_observations",
    "reference_assays",
    "derived_estimates"
  ],
  "properties": {
    "schema_version": {
      "const": "soil-sensor-lineage-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument_id",
          "manufacturer_model",
          "serial_id",
          "firmware_version",
          "calibration_id",
          "calibration_sha256"
        ],
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer_model": {
            "type": "string",
            "minLength": 1
          },
          "serial_id": {
            "type": "string",
            "minLength": 1
          },
          "firmware_version": {
            "type": "string",
            "minLength": 1
          },
          "calibration_id": {
            "type": "string",
            "minLength": 1
          },
          "calibration_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "sensor_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "physical_sample_id",
          "independence_group_id",
          "instrument_id",
          "modality",
          "signal_type",
          "signal_unit",
          "measurement_semantics",
          "calibration_id",
          "acquired_at",
          "sample_preparation",
          "sample_moisture_status",
          "measurement_geometry",
          "raw_artifact",
          "qa_status",
          "replicate_group_id"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "physical_sample_id": {
            "type": "string",
            "minLength": 1
          },
          "independence_group_id": {
            "type": "string",
            "minLength": 1
          },
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "modality": {
            "enum": [
              "vis_nir_spectroscopy",
              "mir_spectroscopy",
              "xrf",
              "libS",
              "electrical_conductivity",
              "moisture_probe",
              "other"
            ]
          },
          "signal_type": {
            "type": "string",
            "minLength": 1
          },
          "signal_unit": {
            "type": "string",
            "minLength": 1
          },
          "measurement_semantics": {
            "const": "direct_sensor_signal"
          },
          "calibration_id": {
            "type": "string",
            "minLength": 1
          },
          "acquired_at": {
            "type": "string",
            "format": "date-time"
          },
          "sample_preparation": {
            "type": "string",
            "minLength": 1
          },
          "sample_moisture_status": {
            "type": "string",
            "minLength": 1
          },
          "measurement_geometry": {
            "type": "string",
            "minLength": 1
          },
          "raw_artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "sha256",
              "byte_size"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_size": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "qa_status": {
            "enum": [
              "pass",
              "flagged",
              "rejected",
              "unknown"
            ]
          },
          "replicate_group_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reference_assays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assay_id",
          "physical_sample_id",
          "independence_group_id",
          "target_property",
          "value",
          "unit",
          "method",
          "extraction_basis",
          "depth_min_m",
          "depth_max_m",
          "standard_error",
          "role",
          "laboratory_id",
          "batch_id"
        ],
        "properties": {
          "assay_id": {
            "type": "string",
            "minLength": 1
          },
          "physical_sample_id": {
            "type": "string",
            "minLength": 1
          },
          "independence_group_id": {
            "type": "string",
            "minLength": 1
          },
          "target_property": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "extraction_basis": {
            "type": "string",
            "minLength": 1
          },
          "depth_min_m": {
            "type": "number",
            "minimum": 0
          },
          "depth_max_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "standard_error": {
            "type": "number",
            "minimum": 0
          },
          "role": {
            "enum": [
              "calibration_reference",
              "independent_validation_reference"
            ]
          },
          "laboratory_id": {
            "type": "string",
            "minLength": 1
          },
          "batch_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "derived_estimates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "estimate_id",
          "physical_sample_id",
          "independence_group_id",
          "target_property",
          "unit",
          "value",
          "standard_error",
          "measurement_semantics",
          "input_observation_ids",
          "model",
          "assessment_status",
          "reference_assay_id"
        ],
        "properties": {
          "estimate_id": {
            "type": "string",
            "minLength": 1
          },
          "physical_sample_id": {
            "type": "string",
            "minLength": 1
          },
          "independence_group_id": {
            "type": "string",
            "minLength": 1
          },
          "target_property": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "standard_error": {
            "type": "number",
            "minimum": 0
          },
          "measurement_semantics": {
            "const": "derived_prediction"
          },
          "input_observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model_id",
              "model_sha256",
              "preprocessing_sha256",
              "training_sample_ids",
              "training_independence_group_ids",
              "calibration_reference_assay_ids",
              "domain_status"
            ],
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "model_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "preprocessing_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "training_sample_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "training_independence_group_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "calibration_reference_assay_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "domain_status": {
                "enum": [
                  "in_domain",
                  "out_of_domain",
                  "unassessed"
                ]
              }
            }
          },
          "assessment_status": {
            "enum": [
              "candidate_unqualified",
              "abstain"
            ]
          },
          "reference_assay_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

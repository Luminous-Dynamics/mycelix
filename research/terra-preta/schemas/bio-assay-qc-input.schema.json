{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic potential enzyme activity assay QC scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "acceptance_profile",
    "assays"
  ],
  "properties": {
    "schema_version": {
      "const": "bio-assay-qc-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "method_id",
        "method_version",
        "method_profile_sha256",
        "status",
        "minimum_calibration_r_squared",
        "spike_recovery_min_percent",
        "spike_recovery_max_percent",
        "matrix_recovery_min_percent",
        "matrix_recovery_max_percent",
        "maximum_uncorrected_quench_percent"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        },
        "method_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "synthetic_fixture"
        },
        "minimum_calibration_r_squared": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spike_recovery_min_percent": {
          "type": "number",
          "minimum": 0
        },
        "spike_recovery_max_percent": {
          "type": "number",
          "minimum": 0
        },
        "matrix_recovery_min_percent": {
          "type": "number",
          "minimum": 0
        },
        "matrix_recovery_max_percent": {
          "type": "number",
          "minimum": 0
        },
        "maximum_uncorrected_quench_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "assays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assay_id",
          "sample_id",
          "experimental_unit_id",
          "independence_group_id",
          "evidence_class",
          "analyte",
          "measurement_method",
          "method_id",
          "method_version",
          "method_profile_sha256",
          "unit",
          "normalization_basis",
          "reported_rate",
          "reported_rate_standard_error",
          "substrate",
          "substrate_concentration",
          "assay_ph",
          "assay_temperature_c",
          "incubation_minutes",
          "calibration",
          "blanks",
          "matrix_controls",
          "saturation_detected",
          "sample_sha256"
        ],
        "properties": {
          "assay_id": {
            "type": "string",
            "minLength": 1
          },
          "sample_id": {
            "type": "string",
            "minLength": 1
          },
          "experimental_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "independence_group_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "const": "potential_activity"
          },
          "analyte": {
            "type": "string",
            "minLength": 1
          },
          "measurement_method": {
            "type": "string",
            "minLength": 1
          },
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "method_version": {
            "type": "string",
            "minLength": 1
          },
          "method_profile_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "normalization_basis": {
            "const": "dry_soil_mass"
          },
          "reported_rate": {
            "type": "number"
          },
          "reported_rate_standard_error": {
            "type": "number",
            "minimum": 0
          },
          "substrate": {
            "type": "string",
            "minLength": 1
          },
          "substrate_concentration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "assay_ph": {
            "type": "number",
            "minimum": 0,
            "maximum": 14
          },
          "assay_temperature_c": {
            "type": "number"
          },
          "incubation_minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "calibration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "curve_id",
              "slope",
              "intercept",
              "r_squared",
              "signal_min",
              "signal_max",
              "sample_signal"
            ],
            "properties": {
              "curve_id": {
                "type": "string",
                "minLength": 1
              },
              "slope": {
                "type": "number"
              },
              "intercept": {
                "type": "number"
              },
              "r_squared": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "signal_min": {
                "type": "number"
              },
              "signal_max": {
                "type": "number"
              },
              "sample_signal": {
                "type": "number"
              }
            }
          },
          "blanks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "substrate_only_blank_signal",
              "matrix_blank_signal",
              "sample_blank_signal"
            ],
            "properties": {
              "substrate_only_blank_signal": {
                "type": "number"
              },
              "matrix_blank_signal": {
                "type": "number"
              },
              "sample_blank_signal": {
                "type": "number"
              }
            }
          },
          "matrix_controls": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spike_recovery_percent",
              "matrix_spike_recovery_percent",
              "optical_quench_percent",
              "quench_correction_applied",
              "correction_method_id",
              "correction_method_sha256"
            ],
            "properties": {
              "spike_recovery_percent": {
                "type": "number",
                "minimum": 0
              },
              "matrix_spike_recovery_percent": {
                "type": "number",
                "minimum": 0
              },
              "optical_quench_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "quench_correction_applied": {
                "type": "boolean"
              },
              "correction_method_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "correction_method_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "saturation_detected": {
            "type": "boolean"
          },
          "sample_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/terra-preta/schemas/root-channel-inventory-input.schema.json",
  "title": "Synthetic root-channel pathway inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "observation_support",
    "nodes",
    "pathways",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "const": "root-channel-inventory-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "method",
        "source_sha256",
        "geometry_sha256",
        "resolution_m",
        "crs"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "planar_2d",
            "volumetric_3d"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "geometry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resolution_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crs": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "coordinates_m"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "coordinates_m": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "pathways": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pathway_id",
          "origin_class",
          "origin_evidence_status",
          "connectivity_evidence_status",
          "start_node_id",
          "end_node_id",
          "length_m",
          "mean_diameter_m",
          "tortuosity",
          "depth_min_m",
          "depth_max_m",
          "root_flow_expressions",
          "root_flow_expression_evidence_status"
        ],
        "properties": {
          "pathway_id": {
            "type": "string",
            "minLength": 1
          },
          "origin_class": {
            "enum": [
              "live_root_channel",
              "legacy_root_channel",
              "abiotic_crack",
              "textural_finger",
              "faunal_burrow",
              "other",
              "unknown"
            ]
          },
          "origin_evidence_status": {
            "enum": [
              "directly_observed_root",
              "historical_root_trace",
              "morphology_only",
              "unresolved",
              "synthetic_truth",
              "not_applicable"
            ]
          },
          "connectivity_evidence_status": {
            "enum": [
              "observed_3d",
              "projected_2d_only",
              "model_inferred",
              "not_assessed",
              "synthetic_truth_3d"
            ]
          },
          "start_node_id": {
            "type": "string",
            "minLength": 1
          },
          "end_node_id": {
            "type": "string",
            "minLength": 1
          },
          "length_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mean_diameter_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "tortuosity": {
            "type": "number",
            "minimum": 1
          },
          "depth_min_m": {
            "type": "number",
            "minimum": 0
          },
          "depth_max_m": {
            "type": "number",
            "minimum": 0
          },
          "root_flow_expressions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "shallow_root_network_dominated",
                "vertical_root_controlled",
                "interface_guided",
                "legacy_root_biopore_dominated"
              ]
            }
          },
          "root_flow_expression_evidence_status": {
            "enum": [
              "directly_observed_3d",
              "directly_observed_2d",
              "historical_trace",
              "model_inferred",
              "synthetic_truth",
              "unresolved",
              "not_applicable"
            ]
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "elapsed_days",
          "pathway_states"
        ],
        "properties": {
          "elapsed_days": {
            "type": "number",
            "minimum": 0
          },
          "pathway_states": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pathway_id",
                "root_occupancy_state"
              ],
              "properties": {
                "pathway_id": {
                  "type": "string",
                  "minLength": 1
                },
                "root_occupancy_state": {
                  "enum": [
                    "occupied",
                    "partially_occupied",
                    "unoccupied_legacy",
                    "not_applicable",
                    "not_observed"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}

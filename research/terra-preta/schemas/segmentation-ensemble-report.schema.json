{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segmentation-ensemble-report.schema.json",
  "title": "Segmentation uncertainty graph ensemble report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_version",
    "fixture_status",
    "scenario_id",
    "input_sha256",
    "image_sha256",
    "variant_count",
    "reference_variant_id",
    "node_catalog_count",
    "edge_catalog_count",
    "source_count",
    "sink_count",
    "node_presence",
    "edge_presence",
    "variant_results",
    "terminal_pair_results",
    "pairwise_edge_jaccard",
    "interpretation_boundary"
  ],
  "properties": {
    "audit_version": {
      "const": "segmentation-ensemble-audit-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "variant_count": {
      "type": "integer",
      "minimum": 2
    },
    "reference_variant_id": {
      "type": "string",
      "minLength": 1
    },
    "node_catalog_count": {
      "type": "integer",
      "minimum": 2
    },
    "edge_catalog_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_count": {
      "type": "integer",
      "minimum": 1
    },
    "sink_count": {
      "type": "integer",
      "minimum": 1
    },
    "node_presence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "present_variant_count",
          "total_variant_count",
          "sensitivity_frequency"
        ],
        "properties": {
          "feature_id": {
            "type": "string"
          },
          "present_variant_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_variant_count": {
            "type": "integer",
            "minimum": 1
          },
          "sensitivity_frequency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "edge_presence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "present_variant_count",
          "total_variant_count",
          "sensitivity_frequency"
        ],
        "properties": {
          "feature_id": {
            "type": "string"
          },
          "present_variant_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_variant_count": {
            "type": "integer",
            "minimum": 1
          },
          "sensitivity_frequency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "variant_results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "alpha_percent",
          "perturbation_label",
          "present_node_count",
          "present_edge_count",
          "connected_component_count",
          "cycle_rank",
          "connected_terminal_pair_count",
          "node_count_relative_change_from_reference",
          "edge_count_relative_change_from_reference",
          "component_count_relative_change_from_reference",
          "cycle_rank_relative_change_from_reference"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "alpha_percent": {
            "type": "integer"
          },
          "perturbation_label": {
            "type": "string"
          },
          "present_node_count": {
            "type": "integer",
            "minimum": 1
          },
          "present_edge_count": {
            "type": "integer",
            "minimum": 0
          },
          "connected_component_count": {
            "type": "integer",
            "minimum": 1
          },
          "cycle_rank": {
            "type": "integer",
            "minimum": 0
          },
          "connected_terminal_pair_count": {
            "type": "integer",
            "minimum": 0
          },
          "node_count_relative_change_from_reference": {
            "type": [
              "number",
              "null"
            ]
          },
          "edge_count_relative_change_from_reference": {
            "type": [
              "number",
              "null"
            ]
          },
          "component_count_relative_change_from_reference": {
            "type": [
              "number",
              "null"
            ]
          },
          "cycle_rank_relative_change_from_reference": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "terminal_pair_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_node_id",
          "sink_node_id",
          "connected_variant_count",
          "total_variant_count",
          "sensitivity_frequency",
          "stability_class"
        ],
        "properties": {
          "source_node_id": {
            "type": "string"
          },
          "sink_node_id": {
            "type": "string"
          },
          "connected_variant_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_variant_count": {
            "type": "integer",
            "minimum": 1
          },
          "sensitivity_frequency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "stability_class": {
            "enum": [
              "stable_connected",
              "stable_disconnected",
              "segmentation_sensitive"
            ]
          }
        }
      }
    },
    "pairwise_edge_jaccard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_count",
        "minimum",
        "maximum",
        "mean"
      ],
      "properties": {
        "pair_count": {
          "type": "integer",
          "minimum": 1
        },
        "minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/research/terra-preta/schemas/spectral-screening-referral-input.schema.json",
  "title": "Synthetic NIR screening and confirmatory referral scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "evidence_class",
    "scenario_id",
    "config",
    "screen_candidates",
    "evaluator_only"
  ],
  "properties": {
    "schema_version": {
      "const": "spectral-screening-referral-v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only_not_empirical_evidence"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referral_capacity",
        "nir_screening_cost",
        "confirmatory_test_cost",
        "seed",
        "fixed_uncertainty_threshold"
      ],
      "properties": {
        "referral_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "nir_screening_cost": {
          "type": "number",
          "minimum": 0
        },
        "confirmatory_test_cost": {
          "type": "number",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "fixed_uncertainty_threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "screen_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "property_id",
          "predicted_mean",
          "predictive_sd",
          "decision_threshold",
          "positive_if_above",
          "in_domain",
          "false_positive_loss",
          "false_negative_loss"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1
          },
          "property_id": {
            "type": "string",
            "minLength": 1
          },
          "predicted_mean": {
            "type": "number"
          },
          "predictive_sd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "decision_threshold": {
            "type": "number"
          },
          "positive_if_above": {
            "type": "boolean"
          },
          "in_domain": {
            "type": "boolean"
          },
          "false_positive_loss": {
            "type": "number",
            "minimum": 0
          },
          "false_negative_loss": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "evaluator_only": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_by_sample_id",
        "reference_assumed_perfect_for_synthetic_fixture"
      ],
      "properties": {
        "truth_by_sample_id": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample_id",
              "true_value"
            ],
            "properties": {
              "sample_id": {
                "type": "string",
                "minLength": 1
              },
              "true_value": {
                "type": "number"
              }
            }
          }
        },
        "reference_assumed_perfect_for_synthetic_fixture": {
          "const": true
        }
      }
    }
  }
}

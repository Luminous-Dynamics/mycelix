{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Luminous-Dynamics/mycelix/main/research/terra-preta/tools/prediction-audit/prediction-report.schema.json",
  "title": "Terra Preta grouped prediction audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_version",
    "input_label",
    "input_sha256",
    "observations",
    "independent_groups",
    "bootstrap_seed",
    "nominal_interval_coverage",
    "candidate",
    "baseline",
    "relative_mae_improvement",
    "improvement_cluster_bootstrap_95pct",
    "warnings",
    "interpretation_boundary"
  ],
  "properties": {
    "audit_version": { "const": "0.1.0" },
    "input_label": { "type": "string", "minLength": 1 },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observations": { "type": "integer", "minimum": 1 },
    "independent_groups": { "type": "integer", "minimum": 2 },
    "bootstrap_seed": { "type": "integer", "minimum": 0 },
    "nominal_interval_coverage": { "const": 0.9 },
    "candidate": { "$ref": "#/$defs/metrics" },
    "baseline": { "$ref": "#/$defs/metrics" },
    "relative_mae_improvement": { "type": ["number", "null"] },
    "improvement_cluster_bootstrap_95pct": {
      "oneOf": [
        { "$ref": "#/$defs/bootstrap_interval" },
        { "type": "null" }
      ]
    },
    "warnings": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "interpretation_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "mae",
        "rmse",
        "bias_prediction_minus_actual",
        "empirical_interval_coverage",
        "mean_interval_width",
        "mean_interval_score"
      ],
      "properties": {
        "observations": { "type": "integer", "minimum": 1 },
        "mae": { "type": "number", "minimum": 0 },
        "rmse": { "type": "number", "minimum": 0 },
        "bias_prediction_minus_actual": { "type": "number" },
        "empirical_interval_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "mean_interval_width": { "type": ["number", "null"], "minimum": 0 },
        "mean_interval_score": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "bootstrap_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_level",
        "replicates_requested",
        "replicates_valid",
        "relative_mae_improvement_lower",
        "relative_mae_improvement_upper",
        "excludes_zero"
      ],
      "properties": {
        "confidence_level": { "const": 0.95 },
        "replicates_requested": { "type": "integer", "minimum": 1 },
        "replicates_valid": { "type": "integer", "minimum": 1 },
        "relative_mae_improvement_lower": { "type": "number" },
        "relative_mae_improvement_upper": { "type": "number" },
        "excludes_zero": { "type": "boolean" }
      }
    }
  }
}

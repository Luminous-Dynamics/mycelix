{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Luminous-Dynamics/mycelix/main/research/terra-preta/tools/nutrient-budget-audit/nutrient-budget-input.schema.json",
  "title": "Terra Preta elemental nutrient boundary budget input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "study_id",
    "site_id",
    "experimental_unit_id",
    "treatment_arm_id",
    "comparator_arm_id",
    "element",
    "unit_basis",
    "source_sha256",
    "period",
    "control_volume",
    "stock_pool_partition_review",
    "boundary_flux_review",
    "inputs",
    "outputs",
    "storage_start",
    "storage_end",
    "availability_indicators",
    "internal_transfers"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "experimental_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "treatment_arm_id": {
      "type": "string",
      "minLength": 1
    },
    "comparator_arm_id": {
      "type": "string",
      "minLength": 1
    },
    "element": {
      "enum": [
        "N",
        "P",
        "K"
      ]
    },
    "unit_basis": {
      "const": "kg_element_per_ha"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date"
      ],
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "control_volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area_ha",
        "top_depth_cm",
        "bottom_depth_cm",
        "boundary_description"
      ],
      "properties": {
        "area_ha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "top_depth_cm": {
          "type": "number",
          "minimum": 0
        },
        "bottom_depth_cm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "boundary_description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow_input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow_output"
      }
    },
    "storage_start": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/storage_pool"
      }
    },
    "storage_end": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/storage_pool"
      }
    },
    "availability_indicators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/availability_indicator"
      }
    },
    "stock_pool_partition_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutually_exclusive",
        "boundary_stocks_covered",
        "review_ref"
      ],
      "properties": {
        "mutually_exclusive": {
          "type": "boolean"
        },
        "boundary_stocks_covered": {
          "type": "boolean"
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "boundary_flux_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_relevant_fluxes_accounted_for",
        "review_ref",
        "unmeasured_pathways"
      ],
      "properties": {
        "all_relevant_fluxes_accounted_for": {
          "type": "boolean"
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        },
        "unmeasured_pathways": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pathway",
              "reason"
            ],
            "properties": {
              "pathway": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "internal_transfers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/internal_transfer"
      }
    }
  },
  "$defs": {
    "flow_common": {
      "type": "object",
      "required": [
        "flow_id",
        "amount_kg_element_per_ha",
        "standard_uncertainty_kg_element_per_ha",
        "method",
        "evidence_ref"
      ],
      "properties": {
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "amount_kg_element_per_ha": {
          "type": "number",
          "minimum": 0
        },
        "standard_uncertainty_kg_element_per_ha": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "flow_input": {
      "allOf": [
        {
          "$ref": "#/$defs/flow_common"
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "category"
          ],
          "properties": {
            "flow_id": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "enum": [
                "fertilizer",
                "organic_amendment",
                "irrigation",
                "atmospheric_deposition",
                "biological_fixation",
                "weathering",
                "seed_input",
                "other_declared"
              ]
            },
            "amount_kg_element_per_ha": {
              "type": "number",
              "minimum": 0
            },
            "standard_uncertainty_kg_element_per_ha": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "flow_output": {
      "allOf": [
        {
          "$ref": "#/$defs/flow_common"
        },
        {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "category"
          ],
          "properties": {
            "flow_id": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "enum": [
                "harvest_export",
                "leaching",
                "runoff",
                "erosion",
                "gaseous_loss",
                "other_declared"
              ]
            },
            "amount_kg_element_per_ha": {
              "type": "number",
              "minimum": 0
            },
            "standard_uncertainty_kg_element_per_ha": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "storage_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_id",
        "compartment",
        "stock_kg_element_per_ha",
        "standard_uncertainty_kg_element_per_ha",
        "method",
        "evidence_ref"
      ],
      "properties": {
        "pool_id": {
          "type": "string",
          "minLength": 1
        },
        "compartment": {
          "enum": [
            "soil",
            "standing_biomass",
            "retained_residue"
          ]
        },
        "stock_kg_element_per_ha": {
          "type": "number",
          "minimum": 0
        },
        "standard_uncertainty_kg_element_per_ha": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "availability_indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicator_id",
        "name",
        "value",
        "unit",
        "depth_top_cm",
        "depth_bottom_cm",
        "method",
        "evidence_ref"
      ],
      "properties": {
        "indicator_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "depth_top_cm": {
          "type": "number",
          "minimum": 0
        },
        "depth_bottom_cm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "internal_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transfer_id",
        "category",
        "source_pool_id",
        "destination_pool_id",
        "amount_kg_element_per_ha",
        "standard_uncertainty_kg_element_per_ha",
        "method",
        "evidence_ref"
      ],
      "properties": {
        "transfer_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "mineralization",
            "immobilization",
            "sorption",
            "desorption",
            "root_uptake",
            "residue_return",
            "other_declared"
          ]
        },
        "source_pool_id": {
          "type": "string",
          "minLength": 1
        },
        "destination_pool_id": {
          "type": "string",
          "minLength": 1
        },
        "amount_kg_element_per_ha": {
          "type": "number",
          "minimum": 0
        },
        "standard_uncertainty_kg_element_per_ha": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

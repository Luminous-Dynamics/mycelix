{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terra Preta adaptive pairwise scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_class", "scenario_id", "seed", "budget_cost_units", "strata", "actions", "pair_relations"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "data_class": { "const": "synthetic_known_truth" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "budget_cost_units": { "type": "integer", "minimum": 1 },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stratum_id", "minimum_selected_actions"],
        "properties": {
          "stratum_id": { "type": "string", "minLength": 1 },
          "minimum_selected_actions": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "stratum_id", "cost_units", "eligible", "exclusion_reason", "predicted_standalone_value", "synthetic_truth_standalone_value"],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "stratum_id": { "type": "string", "minLength": 1 },
          "cost_units": { "type": "integer", "minimum": 1 },
          "eligible": { "type": "boolean" },
          "exclusion_reason": { "type": ["string", "null"] },
          "predicted_standalone_value": { "type": "number", "minimum": 0, "maximum": 1 },
          "synthetic_truth_standalone_value": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "pair_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_a", "action_b", "estimated_interaction", "synthetic_truth_interaction"],
        "properties": {
          "action_a": { "type": "string", "minLength": 1 },
          "action_b": { "type": "string", "minLength": 1 },
          "estimated_interaction": { "type": "number", "minimum": -1, "maximum": 1 },
          "synthetic_truth_interaction": { "type": "number", "minimum": -1, "maximum": 1 }
        }
      }
    }
  }
}

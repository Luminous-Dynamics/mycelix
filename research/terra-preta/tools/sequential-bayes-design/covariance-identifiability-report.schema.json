{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terra Preta covariance identifiability report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_class",
    "scenario_id",
    "scenario_sha256",
    "status",
    "true_variance_component_order",
    "true_variance_components",
    "design_count",
    "design_summaries",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "data_class": {
      "const": "synthetic-known-truth"
    },
    "scenario_id": {
      "type": "string"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "synthetic_covariance_identifiability_reference_only"
    },
    "true_variance_component_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "true_variance_components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "design_count": {
      "type": "integer",
      "minimum": 1
    },
    "design_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "design_id",
          "observation_count",
          "structural_rank",
          "component_count",
          "gram_condition_number",
          "fully_identifiable",
          "individually_identifiable",
          "recovery_status",
          "recovered_variance_components",
          "relative_fit_residual"
        ],
        "properties": {
          "design_id": {
            "type": "string"
          },
          "observation_count": {
            "type": "integer",
            "minimum": 1
          },
          "structural_rank": {
            "type": "integer",
            "minimum": 0
          },
          "component_count": {
            "const": 4
          },
          "gram_condition_number": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "fully_identifiable": {
            "type": "boolean"
          },
          "individually_identifiable": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "recovery_status": {
            "enum": [
              "exact_synthetic_recovery",
              "structurally_non_identifiable"
            ]
          },
          "recovered_variance_components": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            }
          },
          "relative_fit_residual": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
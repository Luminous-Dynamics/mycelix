{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terra Preta covariance identifiability synthetic scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_class",
    "scenario_id",
    "true_variance_components",
    "designs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "data_class": {
      "const": "synthetic-known-truth"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "true_variance_components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "designs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "design_id",
          "observations"
        ],
        "properties": {
          "design_id": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observation_id",
                "modality"
              ],
              "properties": {
                "observation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "modality": {
                  "type": "string",
                  "minLength": 1
                },
                "physical_support_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "batch_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "instrument_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
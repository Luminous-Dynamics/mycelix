{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact state parameter assimilation comparison scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_class",
    "scenario_id",
    "variables",
    "prior_mean",
    "prior_covariance",
    "observation_ids",
    "observation_matrix",
    "observation_noise_covariance",
    "observed_values",
    "ensemble_sizes",
    "replicates_per_size",
    "seed"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "data_class": {
      "const": "synthetic-known-truth"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variable_id",
          "role",
          "unit"
        ],
        "properties": {
          "variable_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "physical_state",
              "hydraulic_parameter",
              "exchange_parameter",
              "measurement_bias",
              "other_nuisance"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prior_mean": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "prior_covariance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number"
        }
      }
    },
    "observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observation_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number"
        }
      }
    },
    "observation_noise_covariance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number"
        }
      }
    },
    "observed_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "ensemble_sizes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 3
      }
    },
    "replicates_per_size": {
      "type": "integer",
      "minimum": 2
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    }
  }
}
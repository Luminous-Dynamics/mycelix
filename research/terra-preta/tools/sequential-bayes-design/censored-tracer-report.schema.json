{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Censored tracer observation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_class",
    "scenario_id",
    "scenario_sha256",
    "status",
    "observed_ct_value",
    "detection_limit",
    "upper_quantification_limit",
    "conditional_models",
    "censored_bins",
    "binned_shannon_information_nats",
    "binned_sibson_information_nats",
    "below_detection_posterior",
    "missing_at_random_posterior",
    "incorrect_zero_substitution_posterior",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "data_class": {
      "const": "synthetic-known-truth"
    },
    "scenario_id": {
      "type": "string"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "synthetic_censored_tracer_observation_reference_only"
    },
    "observed_ct_value": {
      "type": "number"
    },
    "detection_limit": {
      "type": "number"
    },
    "upper_quantification_limit": {
      "type": "number"
    },
    "conditional_models": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "posterior_weight_after_ct",
          "tracer_conditional_mean",
          "tracer_conditional_standard_deviation"
        ],
        "properties": {
          "model_id": {
            "type": "string"
          },
          "posterior_weight_after_ct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "tracer_conditional_mean": {
            "type": "number"
          },
          "tracer_conditional_standard_deviation": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "censored_bins": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome_id",
          "model_probabilities",
          "prior_predictive_probability"
        ],
        "properties": {
          "outcome_id": {
            "type": "string"
          },
          "model_probabilities": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "prior_predictive_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "binned_shannon_information_nats": {
      "type": "number",
      "minimum": 0
    },
    "binned_sibson_information_nats": {
      "type": "number",
      "minimum": 0
    },
    "below_detection_posterior": {
      "$ref": "#/$defs/posterior"
    },
    "missing_at_random_posterior": {
      "$ref": "#/$defs/posterior"
    },
    "incorrect_zero_substitution_posterior": {
      "$ref": "#/$defs/posterior"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "posterior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ids",
        "weights",
        "log_evidence"
      ],
      "properties": {
        "model_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "weights": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "log_evidence": {
          "type": "number"
        }
      }
    }
  }
}
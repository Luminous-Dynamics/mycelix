{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracer sensor threshold design scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_class",
    "scenario_id",
    "model_ids",
    "posterior_weights",
    "predictive_means",
    "predictive_variances",
    "sensor_options",
    "budget_units",
    "sibson_alpha",
    "kl_radius_nats",
    "minimum_alpha",
    "alpha_bisection_iterations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "data_class": {
      "const": "synthetic-known-truth"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "model_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "posterior_weights": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "predictive_means": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number"
      }
    },
    "predictive_variances": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "sensor_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "cost_units",
          "eligible",
          "bin_boundaries"
        ],
        "properties": {
          "sensor_id": {
            "type": "string",
            "minLength": 1
          },
          "cost_units": {
            "type": "integer",
            "minimum": 0
          },
          "eligible": {
            "type": "boolean"
          },
          "bin_boundaries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "budget_units": {
      "type": "integer",
      "minimum": 0
    },
    "sibson_alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "kl_radius_nats": {
      "type": "number",
      "minimum": 0
    },
    "minimum_alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 0.99999999
    },
    "alpha_bisection_iterations": {
      "type": "integer",
      "minimum": 1
    }
  }
}
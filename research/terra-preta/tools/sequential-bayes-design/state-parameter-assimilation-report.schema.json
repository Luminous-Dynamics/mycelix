{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State parameter exact oracle vs EnKF reference report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_class",
    "scenario_id",
    "scenario_sha256",
    "status",
    "exact_posterior_mean",
    "exact_posterior_covariance",
    "exact_log_marginal_likelihood",
    "ensemble_size_summaries",
    "runs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "data_class": {
      "const": "synthetic-known-truth"
    },
    "scenario_id": {
      "type": "string"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "synthetic_exact_oracle_vs_ensemble_kalman_reference"
    },
    "exact_posterior_mean": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "exact_posterior_covariance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number"
        }
      }
    },
    "exact_log_marginal_likelihood": {
      "type": "number"
    },
    "ensemble_size_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ensemble_size",
          "replicate_count",
          "mean_posterior_mean_rmse",
          "posterior_mean_rmse_standard_error",
          "mean_posterior_covariance_relative_error",
          "posterior_covariance_relative_error_standard_error"
        ],
        "properties": {
          "ensemble_size": {
            "type": "integer",
            "minimum": 3
          },
          "replicate_count": {
            "type": "integer",
            "minimum": 2
          },
          "mean_posterior_mean_rmse": {
            "type": "number",
            "minimum": 0
          },
          "posterior_mean_rmse_standard_error": {
            "type": "number",
            "minimum": 0
          },
          "mean_posterior_covariance_relative_error": {
            "type": "number",
            "minimum": 0
          },
          "posterior_covariance_relative_error_standard_error": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ensemble_size",
          "replicate_index",
          "seed",
          "posterior_mean_rmse",
          "posterior_covariance_relative_frobenius_error"
        ],
        "properties": {
          "ensemble_size": {
            "type": "integer",
            "minimum": 3
          },
          "replicate_index": {
            "type": "integer",
            "minimum": 0
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "posterior_mean_rmse": {
            "type": "number",
            "minimum": 0
          },
          "posterior_covariance_relative_frobenius_error": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
  "fault_scenarios": [
    {
      "id": "single_primary_feeder_loss",
      "failed_nodes": ["grid_feeder_primary"],
      "expected_failed_service_sinks": [],
      "expected_interpretation": "Backup feeder preserves structural viability. This does not prove sufficient electrical capacity or an actual transfer mechanism."
    },
    {
      "id": "telemetry_loss_manual_fallback",
      "failed_nodes": ["telemetry_network"],
      "expected_failed_service_sinks": [],
      "expected_interpretation": "Manual control preserves the declared control-capability dependency. This does not establish staffing availability or safe manual operation."

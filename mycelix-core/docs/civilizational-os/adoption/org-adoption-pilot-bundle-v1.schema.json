{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/mycelix-core/docs/civilizational-os/adoption/org-adoption-pilot-bundle-v1.schema.json",
  "title": "Mycelix Organization Adoption Pilot Proof Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "profile_id",
    "pilot_id",
    "created_at_utc",
    "relationship_status",
    "relationship_claim_guard",
    "data_classification",
    "effects_mode",
    "claim_ceiling",
    "nonclaims",
    "comparison",
    "input_manifest",
    "evidence_claims",
    "metrics",
    "negative_controls",
    "export_test",
    "rollback_test",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pilot_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "relationship_status": {
      "const": "not_recorded"
    },
    "relationship_claim_guard": {
      "const": "No partnership, customer relationship, endorsement, or integration is implied by this bundle."
    },
    "data_classification": {
      "enum": [
        "synthetic",
        "public_permitted",
        "private_authorized"
      ]
    },
    "effects_mode": {
      "const": "disabled"
    },
    "claim_ceiling": {
      "enum": [
        "SyntheticReferenceOnly",
        "ReadOnlyPilotOnly",
        "ExternallyQualifiedPilot"
      ]
    },
    "nonclaims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 500
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate",
        "measurement_profile_id",
        "hardware_profile_id",
        "window_start_utc",
        "window_end_utc"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/comparisonArm"
        },
        "candidate": {
          "$ref": "#/$defs/comparisonArm"
        },
        "measurement_profile_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "hardware_profile_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "window_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "window_end_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "input_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_classification",
        "rights_disposition",
        "source_entries",
        "events",
        "manifest_sha256"
      ],
      "properties": {
        "data_classification": {
          "enum": [
            "synthetic",
            "public_permitted",
            "private_authorized"
          ]
        },
        "rights_disposition": {
          "enum": [
            "synthetic_no_external_rights_required",
            "permitted_public_use",
            "authorized_private_use"
          ]
        },
        "source_entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/sourceEntry"
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/evidenceClaim"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 3,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/negativeControl"
      }
    },
    "export_test": {
      "$ref": "#/$defs/exportTest"
    },
    "rollback_test": {
      "$ref": "#/$defs/rollbackTest"
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "comparisonArm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_id",
        "version",
        "implementation_sha256",
        "input_manifest_sha256",
        "resource_budget_sha256",
        "authority_budget_sha256"
      ],
      "properties": {
        "implementation_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resource_budget_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_budget_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_kind",
        "source_revision",
        "content_sha256",
        "rights_disposition",
        "record_ids"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{2,180}$"
        },
        "source_kind": {
          "enum": [
            "synthetic_fixture",
            "public_standard",
            "public_organization_source",
            "authorized_private_source"
          ]
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rights_disposition": {
          "enum": [
            "synthetic_no_external_rights_required",
            "permitted_public_use",
            "authorized_private_use"
          ]
        },
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,100}$"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "event_type",
        "subject_id",
        "occurred_at_utc",
        "recorded_at_utc",
        "source_id",
        "disposition"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,100}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "enum": [
            "scan_observation",
            "shipping",
            "receiving",
            "acceptance",
            "physical_delivery_measurement",
            "correction",
            "dispute"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "occurred_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "disposition": {
          "enum": [
            "observed",
            "asserted",
            "accepted_by_receiver",
            "corrected",
            "disputed",
            "unknown"
          ]
        },
        "supersedes_event_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{1,100}$"
        }
      }
    },
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_type",
        "disposition",
        "evidence_refs",
        "explanation"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,100}$"
        },
        "claim_type": {
          "enum": [
            "event_lineage_preserved",
            "receiving_observed",
            "acceptance_recorded",
            "physical_delivery_verified",
            "regulatory_compliance",
            "product_authenticity",
            "other"
          ]
        },
        "disposition": {
          "enum": [
            "supported_within_fixture",
            "indeterminate",
            "unsupported"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,100}$"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "unit",
        "comparison_rule",
        "baseline_value",
        "candidate_value",
        "disposition"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,100}$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "comparison_rule": {
          "enum": [
            "candidate_gte_baseline",
            "candidate_gt_baseline",
            "candidate_lte_baseline",
            "candidate_zero",
            "informational"
          ]
        },
        "baseline_value": {
          "type": "number"
        },
        "candidate_value": {
          "type": "number"
        },
        "disposition": {
          "enum": [
            "pass",
            "fail",
            "indeterminate"
          ]
        }
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "attack",
        "expected_disposition",
        "observed_disposition",
        "passed"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,100}$"
        },
        "attack": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "expected_disposition": {
          "enum": [
            "rejected_duplicate",
            "rejected_subject_mismatch",
            "claim_indeterminate",
            "rejected_digest_mismatch",
            "rejected_missing_rights",
            "rejected_unauthorized_effect"
          ]
        },
        "observed_disposition": {
          "enum": [
            "rejected_duplicate",
            "rejected_subject_mismatch",
            "claim_indeterminate",
            "rejected_digest_mismatch",
            "rejected_missing_rights",
            "rejected_unauthorized_effect",
            "accepted_incorrectly"
          ]
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "exportTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "expected_sha256",
        "observed_sha256",
        "round_trip_matches"
      ],
      "properties": {
        "performed": {
          "const": true
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "round_trip_matches": {
          "const": true
        }
      }
    },
    "rollbackTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "result",
        "retained_external_effects"
      ],
      "properties": {
        "performed": {
          "const": true
        },
        "result": {
          "const": "rollback_completed"
        },
        "retained_external_effects": {
          "const": false
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "evaluator_id",
        "evaluator_sha256",
        "bundle_scope"
      ],
      "properties": {
        "disposition": {
          "const": "ReferenceFixtureConforms"
        },
        "evaluator_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "evaluator_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundle_scope": {
          "const": "synthetic_reference_fixture_only"
        }
      }
    }
  }
}

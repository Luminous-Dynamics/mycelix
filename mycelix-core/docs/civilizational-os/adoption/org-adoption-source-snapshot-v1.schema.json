{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/mycelix-core/docs/civilizational-os/adoption/org-adoption-source-snapshot-v1.schema.json",
  "title": "Mycelix organization source snapshot manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "profile_id",
    "captured_at_utc",
    "claim_ceiling",
    "sources",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "claim_ceiling": {
      "const": "SourceSnapshotOnly"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_url",
        "source_kind",
        "source_title",
        "retrieved_at_utc",
        "capture_state",
        "source_revision",
        "content_sha256",
        "content_artifact_path",
        "rights_disposition",
        "integrity_method",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_kind": {
          "enum": [
            "official_organization_site",
            "official_standard",
            "official_repository",
            "official_documentation",
            "official_report",
            "official_product_page",
            "other_official_source"
          ]
        },
        "source_title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "capture_state": {
          "enum": [
            "content_bytes_captured",
            "exact_revision_pinned",
            "reference_only",
            "unavailable",
            "rights_or_terms_blocked"
          ]
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_artifact_path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^source-artifacts/[a-z0-9][a-z0-9._-]{1,180}$"
        },
        "rights_disposition": {
          "enum": [
            "permitted_public_use",
            "authorized_private_use",
            "metadata_only",
            "not_reviewed",
            "blocked"
          ]
        },
        "integrity_method": {
          "enum": [
            "sha256_raw_bytes",
            "immutable_source_revision",
            "metadata_only",
            "none"
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capture_state": {
                "const": "content_bytes_captured"
              }
            },
            "required": [
              "capture_state"
            ]
          },
          "then": {
            "properties": {
              "content_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "content_artifact_path": {
                "type": "string",
                "pattern": "^source-artifacts/[a-z0-9][a-z0-9._-]{1,180}$"
              },
              "integrity_method": {
                "const": "sha256_raw_bytes"
              },
              "rights_disposition": {
                "enum": [
                  "permitted_public_use",
                  "authorized_private_use"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capture_state": {
                "const": "exact_revision_pinned"
              }
            },
            "required": [
              "capture_state"
            ]
          },
          "then": {
            "properties": {
              "source_revision": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "const": null
              },
              "content_artifact_path": {
                "const": null
              },
              "integrity_method": {
                "const": "immutable_source_revision"
              },
              "rights_disposition": {
                "enum": [
                  "permitted_public_use",
                  "authorized_private_use",
                  "metadata_only"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capture_state": {
                "const": "reference_only"
              }
            },
            "required": [
              "capture_state"
            ]
          },
          "then": {
            "properties": {
              "source_revision": {
                "const": null
              },
              "content_sha256": {
                "const": null
              },
              "content_artifact_path": {
                "const": null
              },
              "integrity_method": {
                "enum": [
                  "metadata_only",
                  "none"
                ]
              },
              "rights_disposition": {
                "enum": [
                  "not_reviewed",
                  "metadata_only"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capture_state": {
                "const": "unavailable"
              }
            },
            "required": [
              "capture_state"
            ]
          },
          "then": {
            "properties": {
              "source_revision": {
                "const": null
              },
              "content_sha256": {
                "const": null
              },
              "content_artifact_path": {
                "const": null
              },
              "integrity_method": {
                "const": "none"
              },
              "rights_disposition": {
                "enum": [
                  "not_reviewed",
                  "metadata_only"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capture_state": {
                "const": "rights_or_terms_blocked"
              }
            },
            "required": [
              "capture_state"
            ]
          },
          "then": {
            "properties": {
              "content_sha256": {
                "const": null
              },
              "content_artifact_path": {
                "const": null
              },
              "integrity_method": {
                "const": "none"
              },
              "rights_disposition": {
                "const": "blocked"
              },
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}

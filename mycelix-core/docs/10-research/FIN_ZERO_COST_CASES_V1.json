{
  "schema_version": "fin-zero-cost-cases/1",
  "status": "synthetic reference fixtures; not production data and not a payment authorization",
  "units": "All money values are integer minor units. Exchange rates are exact rational numbers of destination minor units per source minor unit.",
  "cost_formula": {
    "spread_cost_destination_minor": "max(0, reference_recipient_amount_minor - quoted_recipient_amount_minor)",
    "payer_fee_conversion": "ceil((platform_fee_source_minor + sender_fee_source_minor + rail_fee_source_minor) * rate_numerator / rate_denominator)",
    "total_known_cost_destination_minor": "spread_cost_destination_minor + converted payer fees + recipient_fee_destination_minor + intermediary_fee_destination_minor",
    "rounding": "ceil only for source-side fee conversion; do not use binary floating point",
    "limit": "A known quote-cost calculation is not proof of settlement, legal authority, availability, or sustainability."
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/mycelix-civic/schemas/evidence-constraint-v1.schema.json",
  "title": "Mycelix Civic evidence constraint v1",
  "description": "Author-bound, append-only pairwise governance constraint over two Civic evidence records. The authority receipt digest is a reference commitment, not a signature.",
  "oneOf": [
    {
      "$ref": "#/$defs/createInput"
    },
    {
      "$ref": "#/$defs/record"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "relation": {
      "enum": [
        "MustLink",
        "CannotLink"
      ]
    },
    "reason": {
      "enum": [
        "Contradiction",
        "Supersession",
        "ScopeConflict",
        "PrivacyConflict",
        "DependencyRequires",
        "PolicyRequires",
        "DuplicateClaim"
      ]
    },
    "timestampMicros": {
      "type": "integer"
    },
    "validUntil": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestampMicros"
        },
        {
          "type": "null"
        }
      ]
    },
    "createInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "left_evidence_id",
        "right_evidence_id",
        "relation",
        "reason",
        "authority_receipt_sha256",
        "constraint_policy_sha256",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "left_evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "right_evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "relation": {
          "$ref": "#/$defs/relation"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "authority_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "constraint_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "valid_from": {
          "$ref": "#/$defs/timestampMicros"
        },
        "valid_until": {
          "$ref": "#/$defs/validUntil"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "left_evidence_id",
        "right_evidence_id",
        "relation",
        "reason",
        "issuer",
        "authority_receipt_sha256",
        "constraint_policy_sha256",
        "valid_from",
        "valid_until",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "left_evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "right_evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "relation": {
          "$ref": "#/$defs/relation"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^did:mycelix:.+$"
        },
        "authority_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "constraint_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "valid_from": {
          "$ref": "#/$defs/timestampMicros"
        },
        "valid_until": {
          "$ref": "#/$defs/validUntil"
        },
        "created_at": {
          "$ref": "#/$defs/timestampMicros"
        }
      }
    }
  }
}

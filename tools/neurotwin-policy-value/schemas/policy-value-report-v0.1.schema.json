{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/tools/neurotwin-policy-value/schemas/policy-value-report-v0.1.schema.json",
  "title": "NeuroTwin Aggregate Policy Value Report v0.1",
  "description": "Aggregate-only output from the two-arm randomized policy-value reference. Contains no observation keys, row-level scores or identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "n",
    "outcome_direction",
    "estimator",
    "uncertainty",
    "candidate_policy",
    "comparator_policy",
    "candidate_minus_comparator",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "neurotwin-policy-value-report-v0.1" },
    "n": { "type": "integer", "minimum": 20 },
    "outcome_direction": { "const": "higher_is_better" },
    "estimator": { "const": "augmented_inverse_probability_weighted" },
    "uncertainty": { "const": "empirical_influence_function_normal_approximation_95pct" },
    "candidate_policy": { "$ref": "#/$defs/policy_estimate" },
    "comparator_policy": { "$ref": "#/$defs/policy_estimate" },
    "candidate_minus_comparator": { "$ref": "#/$defs/policy_difference" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3, "maxLength": 512 }
    }
  },
  "$defs": {
    "policy_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dr_value",
        "dr_standard_error",
        "dr_ci95_lower",
        "dr_ci95_upper",
        "ipw_value",
        "matches_assigned",
        "coverage",
        "effective_sample_size",
        "max_inverse_probability_weight"
      ],
      "properties": {
        "dr_value": { "type": "number" },
        "dr_standard_error": { "type": "number", "minimum": 0 },
        "dr_ci95_lower": { "type": "number" },
        "dr_ci95_upper": { "type": "number" },
        "ipw_value": { "type": "number" },
        "matches_assigned": { "type": "integer", "minimum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "effective_sample_size": { "type": "number", "exclusiveMinimum": 0 },
        "max_inverse_probability_weight": { "type": "number", "minimum": 1 }
      }
    },
    "policy_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dr_value_difference",
        "paired_standard_error",
        "ci95_lower",
        "ci95_upper"
      ],
      "properties": {
        "dr_value_difference": { "type": "number" },
        "paired_standard_error": { "type": "number", "minimum": 0 },
        "ci95_lower": { "type": "number" },
        "ci95_upper": { "type": "number" }
      }
    }
  }
}
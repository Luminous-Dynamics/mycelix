{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/tools/neurotwin-policy-value/schemas/multiarm-policy-value-report-v0.1.schema.json",
  "title": "NeuroTwin Aggregate Multi-arm Policy Value Report v0.1",
  "description": "Aggregate-only multi-arm randomized policy evaluation. No participant identifiers or row-level scores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","n","estimator","uncertainty","arms","candidate_policy","comparator_policy","candidate_minus_comparator","arm_support","limitations"],
  "properties": {
    "schema_version": { "const": "neurotwin-multiarm-policy-value-report-v0.1" },
    "n": { "type": "integer", "minimum": 20 },
    "estimator": { "const": "augmented_inverse_probability_weighted" },
    "uncertainty": { "const": "empirical_influence_function_normal_approximation_95pct" },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
    },
    "candidate_policy": { "$ref": "#/$defs/policy_estimate" },
    "comparator_policy": { "$ref": "#/$defs/policy_estimate" },
    "candidate_minus_comparator": { "$ref": "#/$defs/policy_difference" },
    "arm_support": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/arm_support" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3, "maxLength": 512 }
    }
  },
  "$defs": {
    "policy_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value","standard_error","ci95_lower","ci95_upper","ipw_value","matched_count","coverage","effective_sample_size","maximum_inverse_probability_weight"],
      "properties": {
        "value": { "type": "number" },
        "standard_error": { "type": "number", "minimum": 0 },
        "ci95_lower": { "type": "number" },
        "ci95_upper": { "type": "number" },
        "ipw_value": { "type": "number" },
        "matched_count": { "type": "integer", "minimum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "effective_sample_size": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_inverse_probability_weight": { "type": "number", "minimum": 1 }
      }
    },
    "policy_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_difference","paired_standard_error","ci95_lower","ci95_upper"],
      "properties": {
        "value_difference": { "type": "number" },
        "paired_standard_error": { "type": "number", "minimum": 0 },
        "ci95_lower": { "type": "number" },
        "ci95_upper": { "type": "number" }
      }
    },
    "arm_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm","randomized_assignments","candidate_policy_selections","candidate_observed_matches","comparator_policy_selections","comparator_observed_matches"],
      "properties": {
        "arm": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "randomized_assignments": { "type": "integer", "minimum": 0 },
        "candidate_policy_selections": { "type": "integer", "minimum": 0 },
        "candidate_observed_matches": { "type": "integer", "minimum": 0 },
        "comparator_policy_selections": { "type": "integer", "minimum": 0 },
        "comparator_observed_matches": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.luminousdynamics.io/schemas/payment-outcome-matched-runs-v1.schema.json",
  "title": "Payment outcome matched runs v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "external_effects_enabled",
    "cohort",
    "runs"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.payment-outcome-matched-runs/v1"
    },
    "status": {
      "const": "synthetic_illustrative_only"
    },
    "external_effects_enabled": {
      "const": false
    },
    "cohort": {
      "$ref": "#/$defs/cohort"
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "task_corpus_digest",
        "profile_digest",
        "observation_start",
        "observation_end",
        "jurisdiction",
        "currency",
        "amount_band",
        "payer_segment",
        "payee_segment",
        "rail_profile",
        "task_mix_digest"
      ],
      "properties": {
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "task_corpus_digest": {
          "$ref": "#/$defs/digest"
        },
        "profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "observation_start": {
          "type": "string",
          "format": "date"
        },
        "observation_end": {
          "type": "string",
          "format": "date"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount_band": {
          "type": "string",
          "minLength": 1
        },
        "payer_segment": {
          "type": "string",
          "minLength": 1
        },
        "payee_segment": {
          "type": "string",
          "minLength": 1
        },
        "rail_profile": {
          "type": "string",
          "minLength": 1
        },
        "task_mix_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_attempts",
        "recipient_available",
        "terminal_failures",
        "unknown_outcomes",
        "not_dispatched_or_cancelled",
        "returned_or_reversed",
        "duplicate_effects",
        "false_finality_promotions",
        "unexplained_reconciliation_deltas",
        "unauthorised_secondary_data_uses",
        "essential_service_denials_for_unrelated_consent_refusal",
        "total_all_in_cost_minor_units",
        "cost_currency",
        "operator_minutes_per_1000_attempts",
        "user_task_attempts",
        "user_task_successes",
        "active_merchants_in_cohort",
        "eligible_merchants_in_cohort",
        "payer_fee_minor_units",
        "merchant_fee_minor_units",
        "fx_cost_minor_units",
        "cashout_fee_minor_units",
        "returns_disputes_cost_minor_units",
        "provider_network_cost_minor_units",
        "p50_initiation_to_available_ms",
        "p95_initiation_to_available_ms",
        "p99_initiation_to_available_ms",
        "delivery_latency_population",
        "delivery_latency_observations",
        "delivery_latency_missing"
      ],
      "properties": {
        "eligible_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "recipient_available": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_failures": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_outcomes": {
          "type": "integer",
          "minimum": 0
        },
        "not_dispatched_or_cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "returned_or_reversed": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_effects": {
          "type": "integer",
          "minimum": 0
        },
        "false_finality_promotions": {
          "type": "integer",
          "minimum": 0
        },
        "unexplained_reconciliation_deltas": {
          "type": "integer",
          "minimum": 0
        },
        "unauthorised_secondary_data_uses": {
          "type": "integer",
          "minimum": 0
        },
        "essential_service_denials_for_unrelated_consent_refusal": {
          "type": "integer",
          "minimum": 0
        },
        "total_all_in_cost_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "cost_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "p95_initiation_to_available_ms": {
          "type": "integer",
          "minimum": 0
        },
        "operator_minutes_per_1000_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "user_task_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "user_task_successes": {
          "type": "integer",
          "minimum": 0
        },
        "active_merchants_in_cohort": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_merchants_in_cohort": {
          "type": "integer",
          "minimum": 1
        },
        "payer_fee_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "merchant_fee_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "fx_cost_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "cashout_fee_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "returns_disputes_cost_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "provider_network_cost_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "p50_initiation_to_available_ms": {
          "type": "integer",
          "minimum": 0
        },
        "p99_initiation_to_available_ms": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_latency_population": {
          "const": "recipient_available_only"
        },
        "delivery_latency_observations": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_latency_missing": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "provider_class",
        "label",
        "metrics"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "provider_class": {
          "enum": [
            "incumbent_bank_rail",
            "conventional_adapter",
            "mycelix_candidate"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        }
      }
    }
  }
}

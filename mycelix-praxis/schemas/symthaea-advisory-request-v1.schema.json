{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/symthaea-advisory-request-v1.schema.json",
  "title": "Praxis Symthaea Advisory Request v1",
  "description": "Strict minimized request body for an optional Symthaea learning suggestion. The BLAKE3 digest is computed over the exact serialized body and conveyed separately in authenticated transport metadata; it is intentionally not a body field. Runtime policy enforces the 16 KiB serialized-body cap and validates identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_nonce",
    "model_id",
    "model_version",
    "skill_id",
    "curriculum_revision",
    "allowed_actions",
    "allowed_reasons",
    "allowed_content_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_nonce": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$",
      "description": "Fresh opaque 128-bit nonce generated by the host-only adapter from the operating system's cryptographic random source. Each new exchange receives a new value; this is not authentication."
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]{1,160}$"
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]{1,160}$"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]{1,160}$"
    },
    "curriculum_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]{1,160}$"
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "offer_hint",
          "offer_worked_example",
          "offer_alternate_explanation",
          "invite_retrieval_practice",
          "invite_spaced_review",
          "ask_for_self_explanation",
          "offer_transfer_problem",
          "suggest_craft_project",
          "offer_break",
          "no_suggestion"
        ]
      }
    },
    "allowed_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "learner_requested_help",
          "repeated_incorrect_attempts",
          "review_due",
          "transfer_not_demonstrated",
          "ready_for_application",
          "learner_requested_break",
          "insufficient_evidence",
          "no_change"
        ]
      }
    },
    "allowed_content_ids": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]{1,160}$"
      }
    }
  }
}

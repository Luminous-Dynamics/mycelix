{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:cyber-evidence-request-catalog:v2",
  "title": "Praxis Cyber Evidence Request Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "benchmark_id": {
      "const": "PRAXIS-CYBER-ACQ-001"
    },
    "benchmark_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Scenario"
      }
    }
  },
  "$defs": {
    "Authority": {
      "type": "string",
      "enum": [
        "read_only_telemetry",
        "incident_commander"
      ]
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "identity_session_audit",
        "endpoint_context",
        "token_use_audit",
        "sensor_health",
        "shared_egress_summary",
        "effective_route_table",
        "policy_deployment_receipt",
        "build_provenance",
        "registry_snapshot",
        "runtime_artifact_receipt",
        "retrieved_content_lineage",
        "tool_invocation_audit",
        "export_effect_receipt",
        "endpoint_action_receipt"
      ]
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "domain",
        "hypotheses",
        "requests"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "hypotheses": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Request"
          }
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "source_kind",
        "purpose",
        "required_authority",
        "cost_units",
        "latency_bound_minutes"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required_authority": {
          "$ref": "#/$defs/Authority"
        },
        "cost_units": {
          "type": "integer",
          "minimum": 1
        },
        "latency_bound_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Domain": {
      "type": "string",
      "enum": [
        "identity_access",
        "network_configuration",
        "supply_chain_provenance",
        "ai_tool_boundaries",
        "endpoint_response_telemetry"
      ]
    }
  }
}

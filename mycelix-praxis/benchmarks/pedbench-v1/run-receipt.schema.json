{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/praxis-pedbench-run-receipt-v1.schema.json",
  "title": "Praxis PedBench Run Receipt v1",
  "description": "Reproducible, evidence-bounded record for one pedagogical benchmark evaluation. This schema records metrics but does not certify teaching efficacy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "dataset_digest_sha256",
    "split",
    "started_at",
    "completed_at",
    "model",
    "execution",
    "system_policy_digest_blake3",
    "rubric_digest_blake3",
    "case_results",
    "aggregate_metrics",
    "claim_level",
    "limitations",
    "independent_evaluation",
    "confirmatory_replication"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "praxis-pedbench-v1"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "split": {
      "enum": [
        "development",
        "public_test",
        "held_out_test"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "model_version"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "weights_digest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "endpoint_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantization": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_protocol_digest_blake3",
        "decoding",
        "tool_policy",
        "assistance_policy"
      ],
      "properties": {
        "prompt_protocol_digest_blake3": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "top_p",
            "max_output_tokens"
          ],
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "top_p": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tool_policy": {
          "type": "string",
          "minLength": 1
        },
        "assistance_policy": {
          "enum": [
            "hint_level_1",
            "progressive_hints",
            "worked_solution_allowed",
            "unrestricted",
            "case_specific"
          ]
        }
      }
    },
    "system_policy_digest_blake3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rubric_digest_blake3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_run_digest_blake3": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "replication_run_digest_blake3": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "held_out_split_digest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "independent_evaluator": {
      "type": [
        "string",
        "null"
      ]
    },
    "independent_evaluation": {
      "type": "boolean"
    },
    "confirmatory_replication": {
      "type": "boolean"
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "input_digest_blake3",
          "output_digest_blake3",
          "scores",
          "annotation_state"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "input_digest_blake3": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_digest_blake3": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scores": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rating",
                "annotator_count"
              ],
              "properties": {
                "rating": {
                  "enum": [
                    "pass",
                    "partial",
                    "fail",
                    "not_applicable"
                  ]
                },
                "annotator_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "adjudicated": {
                  "type": "boolean"
                },
                "rationale": {
                  "type": "string"
                }
              }
            }
          },
          "critical_vetoes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "annotation_state": {
            "enum": [
              "unreviewed",
              "single_review",
              "dual_review",
              "adjudicated"
            ]
          }
        }
      }
    },
    "aggregate_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "value",
          "unit",
          "cases_scored"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "cases_scored": {
            "type": "integer",
            "minimum": 1
          },
          "confidence_interval_95": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "lower",
              "upper",
              "method"
            ],
            "properties": {
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "baseline_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "difference_from_baseline": {
            "type": [
              "number",
              "null"
            ]
          },
          "paired_comparison": {
            "type": "boolean"
          }
        }
      }
    },
    "claim_level": {
      "enum": [
        "diagnostic_only",
        "candidate_improvement",
        "confirmatory_improvement",
        "state_of_the_art"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_level": {
            "const": "confirmatory_improvement"
          }
        },
        "required": [
          "claim_level"
        ]
      },
      "then": {
        "properties": {
          "split": {
            "const": "held_out_test"
          },
          "independent_evaluation": {
            "const": true
          },
          "confirmatory_replication": {
            "const": true
          }
        },
        "required": [
          "baseline_run_digest_blake3",
          "replication_run_digest_blake3",
          "held_out_split_digest_sha256",
          "independent_evaluator"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "claim_level": {
            "const": "state_of_the_art"
          }
        },
        "required": [
          "claim_level"
        ]
      },
      "then": {
        "properties": {
          "split": {
            "const": "held_out_test"
          },
          "independent_evaluation": {
            "const": true
          },
          "confirmatory_replication": {
            "const": true
          }
        },
        "required": [
          "baseline_run_digest_blake3",
          "replication_run_digest_blake3",
          "held_out_split_digest_sha256",
          "independent_evaluator"
        ]
      }
    }
  ]
}

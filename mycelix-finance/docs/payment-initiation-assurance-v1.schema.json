{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.luminousdynamics.io/schemas/payment-initiation-assurance-v1.schema.json",
  "title": "Payment initiation assurance corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "status",
    "as_of",
    "external_effects_enabled",
    "execution_enabled",
    "qr_plus_profile",
    "rulebook_references",
    "required_lifecycle_order",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.payment-initiation-assurance-corpus/v1"
    },
    "corpus_id": {
      "const": "PAYMENT-INITIATION-ADVERSARIAL-SYNTHETIC-V1"
    },
    "status": {
      "const": "synthetic_reference_only"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "external_effects_enabled": {
      "const": false
    },
    "execution_enabled": {
      "const": false
    },
    "qr_plus_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "state",
        "execution_rail",
        "pilot_state",
        "source_url"
      ],
      "properties": {
        "version": {
          "const": "1.2"
        },
        "state": {
          "const": "published_standard"
        },
        "execution_rail": {
          "const": "selected_provider_rail"
        },
        "pilot_state": {
          "enum": [
            "unverified_future_milestone",
            "operationally_verified"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "rulebook_references": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_lifecycle_order": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "expected",
        "input",
        "dispatch_allowed",
        "required_evidence",
        "negative_controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^QR-PI-[0-9]{3}$"
        },
        "category": {
          "enum": [
            "qr_payload_parsed_only",
            "verified_payee_presented",
            "payee_substitution",
            "amount_after_confirmation",
            "static_qr_no_amount",
            "currency_scale_substitution",
            "expired_dynamic_qr",
            "exact_scan_replay",
            "same_nonce_changed_fingerprint",
            "untrusted_display_name",
            "stale_directory_result",
            "invalid_provider_signature",
            "wrong_provider_audience",
            "resolution_rate_limit",
            "user_cancel_before_dispatch",
            "payment_timeout_unknown",
            "provider_accepted_without_settlement",
            "standard_published_pilot_unverified",
            "recipient_mismatch_requires_new_consent"
          ]
        },
        "expected": {
          "enum": [
            "parsed_unverified",
            "awaiting_payer_authorisation",
            "rejected",
            "requires_payer_amount",
            "idempotent_same_intent",
            "conflict",
            "awaiting_provider_resolution",
            "indeterminate_unverified",
            "throttled",
            "cancelled_no_effect",
            "indeterminate_same_operation_id",
            "provider_accepted_not_settled",
            "standard_published_pilot_unverified",
            "reauthorisation_required"
          ]
        },
        "input": {
          "type": "object"
        },
        "dispatch_allowed": {
          "const": false
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

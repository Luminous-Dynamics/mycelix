{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/sa-payment-rtp-link-corpus-v1.schema.json",
  "title": "Mycelix RTP-to-payment correlation corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "status",
    "as_of",
    "jurisdiction",
    "purpose",
    "external_effects_enabled",
    "source_register",
    "profiles",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.sa-payment-rtp-link/v1"
    },
    "corpus_id": {
      "const": "SA-PAYMENT-RTP-LINK-SYNTHETIC-V1"
    },
    "status": {
      "const": "synthetic_reference_only"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "const": "ZA"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "external_effects_enabled": {
      "const": false
    },
    "source_register": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 24,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "title",
        "url",
        "observed_on",
        "evidence_class",
        "supports",
        "does_not_support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "does_not_support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "jurisdiction",
        "scheme",
        "topology",
        "participants",
        "message_versions",
        "payment_message_versions",
        "status_message_versions",
        "security_profile",
        "observed_on",
        "source_refs",
        "admission"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 2
        },
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "message_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payment_message_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status_message_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security_profile": {
          "type": "string",
          "minLength": 1
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "admission": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_message_type",
        "request_message_id",
        "request_digest",
        "amount_minor_units",
        "currency",
        "requester_participant",
        "payer_participant",
        "end_to_end_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "request_message_type": {
          "const": "pain.013.001.12"
        },
        "request_message_id": {
          "type": "string",
          "minLength": 1
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "amount_minor_units": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "requester_participant": {
          "type": "string",
          "minLength": 1
        },
        "payer_participant": {
          "type": "string",
          "minLength": 1
        },
        "end_to_end_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "stage",
        "actor_role",
        "participant_id",
        "message_type",
        "message_id",
        "original_request_id",
        "request_digest",
        "payment_instruction_id",
        "end_to_end_id",
        "transaction_id",
        "status_code",
        "status_semantics",
        "amount_minor_units",
        "currency",
        "authentication_state",
        "authority_state",
        "evidence_types"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "enum": [
            "payee",
            "payer",
            "payee_rtp_service_provider",
            "payer_rtp_service_provider",
            "creditor_agent",
            "debtor_agent",
            "clearing_operator",
            "settlement_operator",
            "scheme_operator",
            "unknown"
          ]
        },
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "message_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "payment_instruction_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_to_end_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transaction_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_semantics": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount_minor_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "authentication_state": {
          "enum": [
            "valid",
            "invalid",
            "revoked",
            "unknown"
          ]
        },
        "authority_state": {
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "evidence_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_type",
        "profile_id",
        "request",
        "events",
        "expected_state",
        "expected_disposition",
        "negative_controls"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^RTP-LINK-[0-9]{3}$"
        },
        "scenario_type": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "expected_state": {
          "enum": [
            "request_only",
            "accepted_no_instruction",
            "instruction_created",
            "transfer_unmatched",
            "transfer_pending",
            "transfer_status_only",
            "transfer_rejected",
            "recipient_available",
            "settled_final",
            "ambiguous_link",
            "quarantined",
            "cancel_after_instruction",
            "one_transfer_idempotent",
            "status_unmatched"
          ]
        },
        "expected_disposition": {
          "type": "string",
          "minLength": 1
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

    {
      "id": "CAPITEC_RTP_FAQ_2026",
      "authority": "Capitec Bank",
      "title": "PayShap Request FAQ",
      "url": "https://www.capitecbank.co.za/were-here-to-help/faqs/",
      "published_on": null,
      "observed_on": "2026-11-04",
      "evidence_class": "official_provider_faq_snapshot",
      "supports": [
        "Two requests per 24 hours to any South African bank, scoped to the requester account.",
        "Request amount limited to R100 per transaction; sender may be charged no fee while payer fees are disclosed.",
        "Other banks may apply lower limits, which the sender is told to check with the receiver."
      ],
      "does_not_support": [
        "A limit of two requests per recipient rather than across the requester account.",
        "A universal PayShap limit across participants.",
        "A fixed receiving-bank lower limit without the receiver's current product terms."
      ]
    },
    {
      "id": "CAPITEC_RTP_PRODUCT_2026",
      "authority": "Capitec Bank",
      "title": "PayShap Request product page",
      "url": "https://www.capitecbank.co.za/personal/transact/payshap-request/",
      "published_on": null,
      "observed_on": "2026-11-04",
      "evidence_class": "official_current_product_page_snapshot",
      "supports": [
        "R100 per request and two transactions every 24 hours to a combined R200.",
        "A verified cellphone number / ShapID is used in the described app journey."
      ],
      "does_not_support": [
        "Limits for other participants.",
        "A legal identity or collection mandate from ShapID validation."
      ]
    },
    {
      "id": "ABSA_PAYSHAP_REQUEST_2026",
      "authority": "Absa Bank",
      "title": "PayShap Request product and FAQ",
      "url": "https://www.absa.co.za/self-service/digital-banking-services/digital-ways-to-pay/payshap-request/",
      "published_on": null,
      "observed_on": "2026-11-04",
      "evidence_class": "official_provider_product_page_snapshot",
      "supports": [
        "Unlimited daily outbound requests, but no more than five to the same recipient per day.",
        "Inbound requests have no total daily cap, but no more than five from the same sender per day.",
        "On-us account-number maximum R5,000,000; on-us ShapID maximum R3,000; off-us maximum R50,000 subject to receiving participant lower limit.",
        "Absa-sent requests expire after 45 days; partial payment is available when AMI is enabled."
      ],
      "does_not_support": [
        "A single generic amount limit independent of on-us account, on-us ShapID or off-us route.",
        "A calendar-day or rolling-24-hour interpretation where page only says per day.",
        "A universal lower-limit value for every receiving bank."
      ]
    },
    {
      "id": "NEDBANK_PAYSHAP_REQUEST_2026",
      "authority": "Nedbank",
      "title": "PayShap Request FAQs",
      "url": "https://personal.nedbank.co.za/bank/digital-banking/needs/payments/payshap/payshap-request-faqs.html",
      "published_on": null,
      "observed_on": "2026-11-04",
      "evidence_class": "official_provider_faq_snapshot",
      "supports": [
        "R50,000 maximum per request per day, subject to lower limits at other banks.",
        "No daily limit on the number of PayShap Requests a customer can send or pay.",
        "Default expiry is 14 days; sender can select a date between today and 45 days from creation.",
        "Declined requests close and cannot later be accepted."
      ],
      "does_not_support": [
        "An unlimited amount per transaction or no monetary limit.",
        "A daily request-count cap not published by the provider.",
        "A universal expiry or count rule across participants."
      ]
    }

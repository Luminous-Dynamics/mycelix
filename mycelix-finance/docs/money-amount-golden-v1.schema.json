{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.luminousdynamics.io/schemas/money-amount-golden-v1.schema.json",
  "title": "MoneyAmountV1 golden conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "positive_vectors",
    "negative_vectors",
    "arithmetic_vectors",
    "exact_json_roundtrip",
    "subtraction_vectors"
  ],
  "properties": {
    "positive_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/positive"
      }
    },
    "negative_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/negative"
      }
    },
    "arithmetic_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/arithmetic"
      }
    },
    "exact_json_roundtrip": {
      "type": "string",
      "minLength": 1
    },
    "subtraction_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/arithmetic"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.:-]{0,127}$"
    },
    "minor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "positive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "minor_units",
        "parsed_u64",
        "positive"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "minor_units": {
          "$ref": "#/$defs/minor"
        },
        "parsed_u64": {
          "type": "string"
        },
        "positive": {
          "type": "boolean"
        }
      }
    },
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "minor_units",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "minor_units": {
          "type": "string"
        },
        "expected": {
          "enum": [
            "InvalidEnvelope",
            "InvalidProfileId",
            "InvalidMinorUnits",
            "NonCanonicalMinorUnits",
            "OutOfRange",
            "ProfileMismatch",
            "Overflow",
            "Underflow",
            "UnsupportedProfile"
          ]
        }
      }
    },
    "arithmetic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "left_profile",
        "left",
        "right_profile",
        "right"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "left_profile": {
          "$ref": "#/$defs/profile"
        },
        "left": {
          "$ref": "#/$defs/minor"
        },
        "right_profile": {
          "$ref": "#/$defs/profile"
        },
        "right": {
          "$ref": "#/$defs/minor"
        },
        "expected": {
          "type": "string"
        },
        "expected_error": {
          "enum": [
            "ProfileMismatch",
            "Overflow",
            "UnsupportedProfile",
            "Underflow"
          ]
        }
      }
    }
  }
}

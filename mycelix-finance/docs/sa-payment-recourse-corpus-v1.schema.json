{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/sa-payment-recourse-corpus-v1.schema.json",
  "title": "Mycelix South African Payment Recourse Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "status",
    "as_of",
    "created_on",
    "jurisdiction",
    "purpose",
    "external_effects_enabled",
    "source_register",
    "profiles",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.sa-payment-recourse/v1"
    },
    "corpus_id": {
      "const": "ZA-SA-PAYMENT-RECOURSE-SYNTHETIC-V1"
    },
    "status": {
      "const": "synthetic_reference_only"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "const": "ZA"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "external_effects_enabled": {
      "const": false
    },
    "source_register": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "title",
        "url",
        "observed_on",
        "evidence_class",
        "supports",
        "does_not_support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "does_not_support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remedy_type",
        "availability",
        "authority_owner",
        "time_window_state",
        "window_seconds",
        "source_refs",
        "notes"
      ],
      "properties": {
        "remedy_type": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "enum": [
            "supported",
            "best_efforts",
            "voluntary_only",
            "not_supported_per_source",
            "unknown"
          ]
        },
        "authority_owner": {
          "type": "string",
          "minLength": 1
        },
        "time_window_state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "window_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "jurisdiction",
        "instrument",
        "rail",
        "participant",
        "product_scope",
        "channel_scope",
        "observed_on",
        "effective_from",
        "effective_to",
        "temporal_qualification",
        "source_refs",
        "remedy_capabilities"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^ZA-[A-Z0-9-]+-V1$"
        },
        "jurisdiction": {
          "const": "ZA"
        },
        "instrument": {
          "enum": [
            "domestic_credit_transfer",
            "authorised_debit_collection",
            "card_purchase",
            "cross_border_credit_transfer"
          ]
        },
        "rail": {
          "type": "string",
          "minLength": 1
        },
        "participant": {
          "type": "string",
          "minLength": 1
        },
        "product_scope": {
          "type": "string",
          "minLength": 1
        },
        "channel_scope": {
          "type": "string",
          "minLength": 1
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "temporal_qualification": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "remedy_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "event_type",
        "actor_role",
        "authority_state",
        "evidence_types",
        "amount_minor_units",
        "reconciled"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EV-[0-9]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "enum": [
            "payer",
            "recipient",
            "payer_psp",
            "beneficiary_psp",
            "scheme_operator",
            "merchant",
            "case_manager",
            "regulator",
            "third_party",
            "unknown"
          ]
        },
        "authority_state": {
          "enum": [
            "valid",
            "invalid",
            "unknown",
            "not_applicable"
          ]
        },
        "evidence_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "amount_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "reconciled": {
          "type": "boolean"
        },
        "return_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "closure_disposition": {
          "enum": [
            "open",
            "closed_with_return",
            "closed_without_return",
            "closed_unresolved"
          ]
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_type",
        "profile_id",
        "claim_amount_minor_units",
        "currency",
        "events",
        "expected_effect",
        "expected_disposition",
        "actual_returned_minor_units",
        "case_disposition",
        "required_evidence",
        "negative_controls"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^SA-REC-[0-9]{3}$"
        },
        "scenario_type": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_amount_minor_units": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "ZAR"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "expected_effect": {
          "enum": [
            "no_recovery",
            "request_only",
            "funds_located_not_returned",
            "funds_held_not_returned",
            "unresolved_possible_effect",
            "partial_return",
            "full_return"
          ]
        },
        "expected_disposition": {
          "enum": [
            "preserve_unresolved_no_promise",
            "do_not_promote_to_recovery",
            "record_successor_return",
            "route_to_correct_remedy",
            "reject_unauthorised_action",
            "retain_residual_loss",
            "quarantine_policy_uncertainty"
          ]
        },
        "actual_returned_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "case_disposition": {
          "enum": [
            "open",
            "closed_with_return",
            "closed_without_return",
            "closed_unresolved"
          ]
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/sa-payment-alias-lifecycle-v1.schema.json",
  "title": "Mycelix South African alias lifecycle corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "status",
    "as_of",
    "external_effects_enabled",
    "dispatch_enabled",
    "source_register",
    "profiles",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.sa-payment-alias-lifecycle/v1"
    },
    "corpus_id": {
      "const": "ZA-SHAPID-LIFECYCLE-SYNTHETIC-V1"
    },
    "status": {
      "const": "synthetic_reference_only"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "external_effects_enabled": {
      "const": false
    },
    "dispatch_enabled": {
      "const": false
    },
    "source_register": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 24,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "title",
        "url",
        "observed_on",
        "evidence_class",
        "supports",
        "does_not_support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "authority": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "evidence_class": {
          "type": "string"
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "does_not_support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "jurisdiction",
        "participant",
        "alias_namespace",
        "product_scope",
        "channel_scope",
        "observed_on",
        "effective_from",
        "effective_to",
        "default_alias_policy",
        "phone_change_policy",
        "ownership_policy",
        "reassignment_policy",
        "cooling_off_seconds",
        "source_refs",
        "admission"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string"
        },
        "participant": {
          "type": "string"
        },
        "alias_namespace": {
          "type": "string"
        },
        "product_scope": {
          "type": "string"
        },
        "channel_scope": {
          "type": "string"
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "default_alias_policy": {
          "type": "string"
        },
        "phone_change_policy": {
          "type": "string"
        },
        "ownership_policy": {
          "type": "string"
        },
        "reassignment_policy": {
          "type": "string"
        },
        "cooling_off_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "admission": {
          "type": "string"
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias_id",
        "namespace",
        "generation",
        "participant_id",
        "beneficiary_commitment"
      ],
      "properties": {
        "alias_id": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "enum": [
            "primary_shapid",
            "bank_qualified_shapid",
            "shap_name",
            "synthetic_alias"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "beneficiary_commitment": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "event_type",
        "actor",
        "participant_id",
        "authority_state",
        "generation",
        "beneficiary_commitment",
        "directory_epoch",
        "freshness",
        "valid_until",
        "evidence_types"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EV-[0-9]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "participant_id": {
          "type": "string"
        },
        "authority_state": {
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "beneficiary_commitment": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "directory_epoch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown",
            null
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_type",
        "profile_id",
        "alias",
        "events",
        "expected_state",
        "resolution_allowed",
        "requires_new_payer_consent",
        "dispatch_allowed",
        "required_evidence",
        "negative_controls"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^SHAPID-[0-9]{3}$"
        },
        "scenario_type": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "alias": {
          "$ref": "#/$defs/alias"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "expected_state": {
          "enum": [
            "active_resolved",
            "change_pending_quarantine",
            "revoked",
            "reassignment_quarantine",
            "ownership_unverified",
            "reauthorisation_required",
            "default_conflict",
            "conflict",
            "policy_claim_unqualified",
            "stale",
            "rate_limited",
            "fingerprint_conflict",
            "historical_binding_only",
            "rebind_required"
          ]
        },
        "resolution_allowed": {
          "type": "boolean"
        },
        "requires_new_payer_consent": {
          "type": "boolean"
        },
        "dispatch_allowed": {
          "const": false
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

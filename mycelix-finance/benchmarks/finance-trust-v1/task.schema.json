{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-trust-task-v1.0.0.json",
  "title": "FIN-TRUST candidate task corpus v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "dataset_version",
    "split",
    "generated_on",
    "tasks"
  ],
  "properties": {
    "benchmark_id": {
      "const": "FIN-TRUST-BENCH"
    },
    "dataset_version": {
      "const": "1.0.0"
    },
    "split": {
      "const": "public_s0"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "tasks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision",
        "source_type",
        "authority",
        "entity_id",
        "currency",
        "recorded_at",
        "valid_from",
        "valid_to",
        "locator",
        "content",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "qualified_source",
            "asserted_unverified",
            "disputed",
            "observation_only",
            "untrusted_content"
          ]
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "document_id",
            "location"
          ],
          "properties": {
            "kind": {
              "enum": [
                "page",
                "sheet_cell",
                "row",
                "transaction",
                "message",
                "field"
              ]
            },
            "document_id": {
              "type": "string"
            },
            "location": {
              "type": "string"
            }
          }
        },
        "content": {
          "type": "object"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "assertion",
        "purpose",
        "materiality",
        "decision_critical",
        "description"
      ],
      "properties": {
        "requirement_id": {
          "type": "string"
        },
        "assertion": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "materiality": {
          "enum": [
            "low",
            "moderate",
            "material",
            "critical"
          ]
        },
        "decision_critical": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "text"
      ],
      "properties": {
        "speaker": {
          "enum": [
            "user",
            "system_context",
            "follow_up"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "scenario_class",
        "prompt",
        "context",
        "sources",
        "requirements",
        "known_unknowns",
        "conversation"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^FTB-[0-9]{3}$"
        },
        "scenario_class": {
          "enum": [
            "missing_authority",
            "resolved_follow_up",
            "exact_replay",
            "source_conflict",
            "missing_fx_profile",
            "wrong_entity",
            "settlement_finality",
            "historical_frontier",
            "population_completeness",
            "prompt_injection"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity_id",
            "period_start",
            "period_end",
            "knowledge_at",
            "currency",
            "accounting_policy_id"
          ],
          "properties": {
            "entity_id": {
              "type": "string"
            },
            "period_start": {
              "type": "string",
              "format": "date"
            },
            "period_end": {
              "type": "string",
              "format": "date"
            },
            "knowledge_at": {
              "type": "string",
              "format": "date-time"
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "accounting_policy_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "known_unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unknown_id",
              "decision_critical",
              "affects"
            ],
            "properties": {
              "unknown_id": {
                "type": "string"
              },
              "decision_critical": {
                "type": "boolean"
              },
              "affects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "conversation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/turn"
          }
        }
      }
    }
  }
}

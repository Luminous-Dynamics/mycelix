{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-trust-oracle-v1.1.0.json",
  "title": "FIN-TRUST evaluator oracle v1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "dataset_version",
    "visibility",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "FIN-TRUST-BENCH"
    },
    "dataset_version": {
      "const": "1.1.0"
    },
    "visibility": {
      "const": "evaluator_only_public_s0_not_blind"
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "disposition",
          "required_question_ids",
          "forbidden_question_ids",
          "required_source_ids",
          "required_binding_requirements",
          "expected_journal_entries",
          "unresolved_ids",
          "must_not_claim_complete",
          "expected_statement_lines",
          "required_question_specs",
          "expected_evidence_bindings",
          "expected_requirement_assessments",
          "expected_population_assessments"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "deliver",
              "clarify",
              "abstain",
              "escalate"
            ]
          },
          "required_question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_binding_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_journal_entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry_id",
                "entity_id",
                "period",
                "currency",
                "policy_id",
                "debit_minor",
                "credit_minor",
                "source_ids"
              ],
              "properties": {
                "entry_id": {
                  "type": "string"
                },
                "entity_id": {
                  "type": "string"
                },
                "period": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "policy_id": {
                  "type": "string"
                },
                "debit_minor": {
                  "type": "string"
                },
                "credit_minor": {
                  "type": "string"
                },
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "unresolved_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_not_claim_complete": {
            "type": "boolean"
          },
          "expected_statement_lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line_id",
                "amount_minor"
              ],
              "properties": {
                "line_id": {
                  "type": "string"
                },
                "amount_minor": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          },
          "required_question_specs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question_id",
                "target",
                "resolves"
              ],
              "properties": {
                "question_id": {
                  "type": "string"
                },
                "target": {
                  "enum": [
                    "user",
                    "approver",
                    "bank",
                    "accounting_owner",
                    "source_system",
                    "professional_reviewer"
                  ]
                },
                "resolves": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "expected_evidence_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_id",
                "evidence_id",
                "source_id",
                "revision",
                "sha256",
                "locator",
                "recorded_at",
                "origin_group_ref",
                "evidence_class",
                "polarity",
                "purpose_fit",
                "source_authentication",
                "source_authority",
                "temporal_fit",
                "transformation_state"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string"
                },
                "evidence_id": {
                  "type": "string"
                },
                "source_id": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "locator": {
                  "type": "string"
                },
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "origin_group_ref": {
                  "type": "string"
                },
                "evidence_class": {
                  "enum": [
                    "source_document",
                    "delivery_record",
                    "bank_record",
                    "external_confirmation",
                    "management_report",
                    "approval_record",
                    "valuation_report",
                    "parsed_extraction",
                    "management_representation",
                    "other"
                  ]
                },
                "polarity": {
                  "enum": [
                    "supports",
                    "contradicts",
                    "neutral",
                    "duplicate",
                    "derived"
                  ]
                },
                "purpose_fit": {
                  "type": "boolean"
                },
                "source_authentication": {
                  "enum": [
                    "qualified",
                    "unqualified",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "source_authority": {
                  "enum": [
                    "qualified",
                    "unqualified",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "temporal_fit": {
                  "enum": [
                    "within_reporting_period",
                    "outside_reporting_period",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "transformation_state": {
                  "enum": [
                    "original_preserved",
                    "derived_with_lineage",
                    "derived_without_lineage",
                    "altered_or_conflicted",
                    "unknown"
                  ]
                }
              }
            }
          },
          "expected_requirement_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_id",
                "disposition",
                "reason_codes",
                "evidence_refs"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string"
                },
                "disposition": {
                  "enum": [
                    "supported_within_declared_scope",
                    "contradicted",
                    "insufficient_evidence",
                    "indeterminate",
                    "not_applicable_with_rationale",
                    "needs_authorized_review"
                  ]
                },
                "reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "expected_population_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_id",
                "scope_status",
                "expected_count",
                "observed_count",
                "population_ref"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string"
                },
                "scope_status": {
                  "enum": [
                    "qualified",
                    "gap",
                    "unknown",
                    "not_required"
                  ]
                },
                "expected_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "observed_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "population_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-acc-reference-verifier-report-v0.1.json",
  "title": "FIN-ACC Reference Verifier Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema",
    "benchmark_id",
    "dataset_version",
    "status",
    "claim_scope",
    "schema_validation",
    "digests",
    "toolchain",
    "network_access_during_verification",
    "case_count",
    "cases",
    "report_schema_validation"
  ],
  "properties": {
    "report_schema": { "const": "fin-acc-reference-verifier.report.v0.1" },
    "benchmark_id": { "type": ["string", "null"] },
    "dataset_version": { "type": ["string", "null"] },
    "status": { "enum": ["PASS", "FAIL"] },
    "claim_scope": { "const": "synthetic_smoke_corpus_consistency_and_independent_reconstruction_only" },
    "schema_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft", "passed", "errors"],
      "properties": {
        "draft": { "const": "2020-12" },
        "passed": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_sha256",
        "schema_sha256",
        "protocol_sha256",
        "verifier_source_sha256",
        "report_schema_sha256"
      ],
      "properties": {
        "corpus_sha256": { "$ref": "#/$defs/sha256" },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "verifier_source_sha256": { "$ref": "#/$defs/sha256" },
        "report_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "toolchain": { "type": "string" },
    "network_access_during_verification": { "const": false },
    "case_count": { "type": "integer", "minimum": 0 },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseResult" }
    },
    "report_schema_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "errors"],
      "properties": {
        "passed": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "checks", "canonical_journal_sha256"],
      "properties": {
        "case_id": { "type": "string" },
        "status": { "enum": ["PASS", "FAIL"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invariant", "passed", "detail"],
            "properties": {
              "invariant": { "type": "string" },
              "passed": { "type": "boolean" },
              "detail": { "type": "string" }
            }
          }
        },
        "canonical_journal_sha256": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}

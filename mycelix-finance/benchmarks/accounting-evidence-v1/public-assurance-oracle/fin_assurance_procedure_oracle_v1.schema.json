{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-assure-procedure-oracle-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "dataset_version",
    "visibility",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "FIN-ASSURE-PROCEDURE"
    },
    "dataset_version": {
      "const": "1.0.0"
    },
    "visibility": {
      "const": "public_reference_oracle_not_blind_holdout"
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "expected_terminal_state",
          "reason_codes",
          "blocks_unqualified_signoff"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^FAP-[0-9]{3}$"
          },
          "expected_terminal_state": {
            "enum": [
              "addressed_with_qualified_evidence",
              "addressed_with_explicit_limitation",
              "exception_requires_resolution",
              "insufficient_evidence",
              "procedure_not_performed",
              "not_applicable_with_authorized_rationale",
              "human_judgment_required"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks_unqualified_signoff": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

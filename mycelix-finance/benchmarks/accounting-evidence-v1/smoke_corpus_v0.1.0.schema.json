{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-acc-evidence-smoke-v0.1.0.json",
  "title": "FIN-ACC Evidence Benchmark Smoke Corpus v0.1",
  "type": "object",
  "required": [
    "benchmark_id",
    "dataset_version",
    "generated_on",
    "status",
    "profile",
    "entities",
    "counterparties",
    "account_catalog",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "const": "FIN-ACC-EVIDENCE-SMOKE"
    },
    "dataset_version": {
      "type": "string"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "synthetic_smoke_fixtures_not_a_benchmark_result"
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "currency",
        "minor_unit_scale",
        "amount_encoding",
        "ledger_sign_convention",
        "tax_scope",
        "accounting_policy_id",
        "accounting_policy_revision",
        "effective_from",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "minor_unit_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "amount_encoding": {
          "const": "canonical_nonnegative_decimal_integer_strings"
        },
        "ledger_sign_convention": {
          "type": "string"
        },
        "tax_scope": {
          "type": "string"
        },
        "accounting_policy_id": {
          "type": "string"
        },
        "accounting_policy_revision": {
          "type": "string"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "legal_name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          }
        }
      }
    },
    "counterparties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "legal_name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          }
        }
      }
    },
    "account_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "class",
          "normal_side"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "class": {
            "enum": [
              "asset",
              "liability",
              "equity",
              "income",
              "expense"
            ]
          },
          "normal_side": {
            "enum": [
              "debit",
              "credit"
            ]
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "class",
          "title",
          "purpose",
          "opening_trial_balance",
          "documents",
          "expected_dispositions",
          "expected_journal",
          "expected_close"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string"
          },
          "class": {
            "enum": [
              "positive_control",
              "idempotency_adversarial",
              "entity_boundary_adversarial",
              "evidence_gap_adversarial"
            ]
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "opening_trial_balance": {
            "$ref": "#/$defs/balanceRows"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/document"
            }
          },
          "expected_dispositions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ingestion_id",
                "disposition",
                "reason_code"
              ],
              "additionalProperties": false,
              "properties": {
                "ingestion_id": {
                  "type": "string"
                },
                "disposition": {
                  "enum": [
                    "qualified_for_accounting_projection",
                    "qualified_settlement_observation",
                    "duplicate_no_op",
                    "quarantine",
                    "needs_evidence",
                    "indeterminate"
                  ]
                },
                "reason_code": {
                  "type": "string"
                }
              }
            }
          },
          "expected_journal": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/journalEntry"
            }
          },
          "expected_close": {
            "type": "object",
            "required": [
              "trial_balance",
              "total_debits_minor",
              "total_credits_minor",
              "statement_totals"
            ],
            "additionalProperties": false,
            "properties": {
              "trial_balance": {
                "$ref": "#/$defs/balanceRows"
              },
              "total_debits_minor": {
                "$ref": "#/$defs/amount"
              },
              "total_credits_minor": {
                "$ref": "#/$defs/amount"
              },
              "statement_totals": {
                "type": "object",
                "required": [
                  "total_assets_minor",
                  "total_liabilities_minor",
                  "total_equity_minor",
                  "net_profit_loss_minor"
                ],
                "additionalProperties": false,
                "properties": {
                  "total_assets_minor": {
                    "$ref": "#/$defs/amount"
                  },
                  "total_liabilities_minor": {
                    "$ref": "#/$defs/amount"
                  },
                  "total_equity_minor": {
                    "$ref": "#/$defs/amount"
                  },
                  "net_profit_loss_minor": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "balanceRows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "account_id",
          "debit_minor",
          "credit_minor"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string"
          },
          "debit_minor": {
            "$ref": "#/$defs/amount"
          },
          "credit_minor": {
            "$ref": "#/$defs/amount"
          }
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "document_kind",
        "entity_id",
        "counterparty_id",
        "currency",
        "date",
        "fingerprint_sha256",
        "ingestion_id",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string"
        },
        "document_kind": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "counterparty_id": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ingestion_id": {
          "type": "string"
        },
        "content": {
          "type": "object"
        }
      }
    },
    "journalEntry": {
      "type": "object",
      "required": [
        "entry_id",
        "effective_date",
        "entity_id",
        "currency_profile_id",
        "policy_id",
        "policy_revision",
        "source_document_refs",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "entity_id": {
          "type": "string"
        },
        "currency_profile_id": {
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "policy_revision": {
          "type": "string"
        },
        "source_document_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "account_id",
              "debit_minor",
              "credit_minor"
            ],
            "additionalProperties": false,
            "properties": {
              "account_id": {
                "type": "string"
              },
              "debit_minor": {
                "$ref": "#/$defs/amount"
              },
              "credit_minor": {
                "$ref": "#/$defs/amount"
              }
            }
          }
        }
      }
    }
  }
}

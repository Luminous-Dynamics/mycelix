{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-assurance-procedure-report-v1.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema",
    "benchmark_id",
    "dataset_version",
    "status",
    "claim_scope",
    "digests",
    "case_count",
    "passed_case_count",
    "errors",
    "cases"
  ],
  "properties": {
    "report_schema": {
      "const": "fin-assurance-procedure-report.v1"
    },
    "benchmark_id": {
      "const": "FIN-ASSURE-PROCEDURE"
    },
    "dataset_version": {
      "const": "1.1.0"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "claim_scope": {
      "const": "public_synthetic_procedure_coverage_and_stand_back_only_not_audit_assurance"
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_input_sha256",
        "candidate_schema_sha256",
        "public_oracle_sha256",
        "oracle_schema_sha256",
        "verifier_source_sha256"
      ],
      "properties": {
        "candidate_input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "public_oracle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "oracle_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verifier_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "passed_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "actual_terminal_state",
          "expected_terminal_state",
          "passed",
          "blocks_unqualified_signoff",
          "reason_codes",
          "expected_blocks_unqualified_signoff",
          "pair_results"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^FAP-[0-9]{3}$"
          },
          "actual_terminal_state": {
            "enum": [
              "addressed_with_qualified_evidence",
              "addressed_with_explicit_limitation",
              "exception_requires_resolution",
              "insufficient_evidence",
              "procedure_not_performed",
              "not_applicable_with_authorized_rationale",
              "human_judgment_required"
            ]
          },
          "expected_terminal_state": {
            "enum": [
              "addressed_with_qualified_evidence",
              "addressed_with_explicit_limitation",
              "exception_requires_resolution",
              "insufficient_evidence",
              "procedure_not_performed",
              "not_applicable_with_authorized_rationale",
              "human_judgment_required"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "blocks_unqualified_signoff": {
            "type": "boolean"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_blocks_unqualified_signoff": {
            "type": "boolean"
          },
          "pair_results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pair_id",
                "actual_terminal_state",
                "expected_terminal_state",
                "passed",
                "blocks_unqualified_signoff",
                "reason_codes"
              ],
              "properties": {
                "pair_id": {
                  "type": "string"
                },
                "actual_terminal_state": {
                  "enum": [
                    "addressed_with_qualified_evidence",
                    "addressed_with_explicit_limitation",
                    "exception_requires_resolution",
                    "insufficient_evidence",
                    "procedure_not_performed",
                    "not_applicable_with_authorized_rationale",
                    "human_judgment_required"
                  ]
                },
                "expected_terminal_state": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "blocks_unqualified_signoff": {
                  "type": "boolean"
                },
                "reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

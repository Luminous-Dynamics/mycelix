{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-acc-evidence-origin-input-v1.json",
  "title": "FIN-ACC evidence origin candidate input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "dataset_version",
    "status",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "FIN-ACC-EVIDENCE-ORIGIN"
    },
    "dataset_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "synthetic_provenance_graph_conformance_not_authenticity_proof"
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_type"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "node_type": {
          "enum": [
            "origin",
            "artifact",
            "transformation",
            "collection"
          ]
        },
        "issuer_namespace": {
          "type": "string"
        },
        "issuer_id": {
          "type": "string"
        },
        "system_namespace": {
          "type": "string"
        },
        "system_id": {
          "type": "string"
        },
        "entity_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_ref": {
          "type": "string"
        },
        "identity_state": {
          "enum": [
            "qualified",
            "unknown",
            "conflict",
            "not_applicable"
          ]
        },
        "identity_evidence_ref": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "fixture_digest_token": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transformation_kind": {
          "type": "string"
        },
        "recipe_ref": {
          "type": "string"
        },
        "collection_kind": {
          "type": "string"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "issued_by",
            "signed_by",
            "derived_from",
            "copied_from",
            "produced_by",
            "consumes",
            "depends_on_origin",
            "retrieved_via"
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_kind",
        "procedure_purpose",
        "proposition_ref",
        "evidence_artifacts",
        "nodes",
        "edges"
      ],
      "properties": {
        "assertion_kind": {
          "enum": [
            "existence_occurrence",
            "completeness",
            "rights_obligations",
            "accuracy_valuation_allocation",
            "cutoff",
            "classification",
            "presentation_disclosure",
            "authorization",
            "settlement_finality"
          ]
        },
        "procedure_purpose": {
          "type": "string",
          "minLength": 1
        },
        "proposition_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "task",
        "contract"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^EOG-[0-9]{3}$"
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/$defs/contract"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-journal-set-oracle-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "dataset_version",
    "visibility",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "FIN-JOURNAL-SET"
    },
    "dataset_version": {
      "const": "1.0.0"
    },
    "visibility": {
      "const": "public_reference_oracle_not_blind_holdout"
    },
    "cases": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "expected_disposition",
          "reason_codes",
          "blocks_complete"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^FJS-[0-9]{3}$"
          },
          "expected_disposition": {
            "enum": [
              "complete_exact_population_and_rollforward",
              "complete_with_authorized_nonposting",
              "incomplete_expected_population",
              "missing_journal_projection",
              "orphan_or_unauthorized_journal",
              "duplicate_economic_posting",
              "conflicting_journal_identity",
              "account_rollforward_conflict",
              "period_boundary_conflict",
              "unsupported_profile_or_unit",
              "source_frontier_unqualified",
              "stale_close_frontier",
              "indeterminate_requires_review"
            ]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "blocks_complete": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

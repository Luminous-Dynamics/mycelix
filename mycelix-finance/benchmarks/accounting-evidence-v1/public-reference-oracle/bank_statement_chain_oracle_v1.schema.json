{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-bank-statement-chain-oracle-v1.json",
  "title": "FIN-BANK-CHAIN public reference oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "dataset_version",
    "visibility",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "FIN-BANK-CHAIN"
    },
    "dataset_version": {
      "const": "1.0.0"
    },
    "visibility": {
      "const": "public_reference_oracle_not_blind_holdout"
    },
    "cases": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "expected_disposition",
          "reason_codes",
          "economic_observation_count"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^BSC-[0-9]{3}$"
          },
          "expected_disposition": {
            "enum": [
              "complete_contiguous",
              "complete_with_explicit_adjustment",
              "gap_unknown",
              "overlap_unresolved",
              "balance_conflict",
              "revision_conflict",
              "account_lineage_unknown",
              "profile_unsupported",
              "source_authentication_unqualified"
            ]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "economic_observation_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}

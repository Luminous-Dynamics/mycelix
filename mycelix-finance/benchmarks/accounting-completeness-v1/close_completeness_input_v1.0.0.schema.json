{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/fin-close-completeness-input-v1.0.0.json",
  "title": "Financial Close Completeness Candidate Input v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "dataset_version",
    "split",
    "claim_scope",
    "generated_on",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "FIN-CLOSE-COMPLETENESS-V1"
    },
    "dataset_version": {
      "const": "1.0.0"
    },
    "split": {
      "const": "public_development"
    },
    "claim_scope": {
      "const": "synthetic_source_population_completeness_behavior_only"
    },
    "generated_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "cases": {
      "type": "array",
      "minItems": 14,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "populationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_class",
        "close_context",
        "scope_manifest",
        "source_inventories",
        "observed_populations",
        "evidence_attestations"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^FCC-[0-9]{3}$"
        },
        "case_class": {
          "enum": [
            "material_omission",
            "late_arriving_evidence",
            "source_independence",
            "absence_vs_zero",
            "valid_non_applicability",
            "evidenced_zero_activity",
            "approved_scope_exclusion",
            "control_inventory_disagreement"
          ]
        },
        "close_context": {
          "$ref": "#/$defs/closeContext"
        },
        "scope_manifest": {
          "$ref": "#/$defs/scopeManifest"
        },
        "source_inventories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceInventory"
          }
        },
        "observed_populations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "evidence_attestations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attestation"
          }
        },
        "previous_close": {
          "$ref": "#/$defs/previousClose"
        }
      }
    },
    "closeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "reporting_boundary",
        "period_start",
        "period_end",
        "close_cutoff_at",
        "currency_profile_id",
        "trial_balance"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "reporting_boundary": {
          "enum": [
            "single_entity",
            "consolidated_group"
          ]
        },
        "period_start": {
          "$ref": "#/$defs/date"
        },
        "period_end": {
          "$ref": "#/$defs/date"
        },
        "close_cutoff_at": {
          "$ref": "#/$defs/dateTime"
        },
        "currency_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "trial_balance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_debits_minor",
            "total_credits_minor",
            "balanced"
          ],
          "properties": {
            "total_debits_minor": {
              "$ref": "#/$defs/minorUnitAmount"
            },
            "total_credits_minor": {
              "$ref": "#/$defs/minorUnitAmount"
            },
            "balanced": {
              "const": true
            }
          }
        }
      }
    },
    "minorUnitAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "scopeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "revision",
        "declared_population_ids",
        "scope_exclusions"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "declared_population_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/populationId"
          }
        },
        "scope_exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exclusion"
          }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "disposition",
        "reason_code",
        "rationale",
        "evidence_id",
        "approved_by_role",
        "approved_at"
      ],
      "properties": {
        "population_id": {
          "$ref": "#/$defs/populationId"
        },
        "disposition": {
          "enum": [
            "not_applicable",
            "out_of_scope"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_by_role": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_id",
        "source_kind",
        "evidence_class",
        "authority_class",
        "captured_at",
        "period_start",
        "period_end",
        "items",
        "independence_group_id"
      ],
      "properties": {
        "inventory_id": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "bank_account_register",
            "supplier_master",
            "customer_master",
            "consolidation_perimeter",
            "payroll_roster",
            "inventory_location_register",
            "related_party_register",
            "bank_confirmation_register"
          ]
        },
        "evidence_class": {
          "enum": [
            "bank",
            "accounts_payable",
            "accounts_receivable",
            "subsidiary",
            "payroll",
            "inventory",
            "related_party"
          ]
        },
        "authority_class": {
          "enum": [
            "system_of_record",
            "external_independent",
            "authorized_management",
            "model_generated",
            "unknown"
          ]
        },
        "captured_at": {
          "$ref": "#/$defs/dateTime"
        },
        "period_start": {
          "$ref": "#/$defs/date"
        },
        "period_end": {
          "$ref": "#/$defs/date"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inventoryItem"
          }
        },
        "independence_group_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "evidence_class",
        "source_system_id",
        "boundary_status",
        "materiality_band",
        "required_independent_sources",
        "basis_evidence_id"
      ],
      "properties": {
        "population_id": {
          "$ref": "#/$defs/populationId"
        },
        "evidence_class": {
          "enum": [
            "bank",
            "accounts_payable",
            "accounts_receivable",
            "subsidiary",
            "payroll",
            "inventory",
            "related_party"
          ]
        },
        "source_system_id": {
          "type": "string",
          "minLength": 1
        },
        "boundary_status": {
          "enum": [
            "in_scope",
            "not_applicable",
            "out_of_scope"
          ]
        },
        "materiality_band": {
          "enum": [
            "immaterial",
            "low",
            "material",
            "high",
            "not_applicable"
          ]
        },
        "required_independent_sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "basis_evidence_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "population_id",
        "source_system_id",
        "independence_group_id",
        "relationship",
        "status",
        "coverage_start",
        "coverage_end",
        "captured_at",
        "observed_item_count"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "population_id": {
          "$ref": "#/$defs/populationId"
        },
        "source_system_id": {
          "type": "string",
          "minLength": 1
        },
        "independence_group_id": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "primary",
            "mirror",
            "independent"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "conflicting",
            "unknown"
          ]
        },
        "coverage_start": {
          "$ref": "#/$defs/date"
        },
        "coverage_end": {
          "$ref": "#/$defs/date"
        },
        "captured_at": {
          "$ref": "#/$defs/dateTime"
        },
        "observed_item_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "population_id",
        "evidence_type",
        "authority_class",
        "independence_group_id",
        "effective_start",
        "effective_end",
        "captured_at",
        "approved_by_role",
        "source_ref"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "population_id": {
          "$ref": "#/$defs/populationId"
        },
        "evidence_type": {
          "enum": [
            "no_employees_attestation",
            "zero_activity_statement",
            "scope_exclusion_approval",
            "late_arriving_document"
          ]
        },
        "authority_class": {
          "enum": [
            "system_of_record",
            "external_independent",
            "authorized_management",
            "model_generated",
            "unknown"
          ]
        },
        "independence_group_id": {
          "type": "string",
          "minLength": 1
        },
        "effective_start": {
          "$ref": "#/$defs/date"
        },
        "effective_end": {
          "$ref": "#/$defs/date"
        },
        "captured_at": {
          "$ref": "#/$defs/dateTime"
        },
        "approved_by_role": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "previousClose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "close_id",
        "closed_at",
        "receipt_ref"
      ],
      "properties": {
        "close_id": {
          "type": "string",
          "minLength": 1
        },
        "closed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "receipt_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

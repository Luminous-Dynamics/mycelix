{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mycelix-accounting-policy-projection-verification-report-v1.0.0.json",
  "title": "Mycelix Accounting Policy Projection Verification Report v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "claim_ceiling",
    "graph_case_id",
    "graph_sha256",
    "projection_count",
    "distinct_policy_digest_count",
    "distinct_projector_digest_count",
    "projections"
  ],
  "properties": {
    "report_id": {
      "const": "MYCELIX-POLICY-PROJECTION-VERIFICATION-S0"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "claim_ceiling": {
      "const": "binding_provenance_and_ledger_invariants_only_not_accounting_policy_correctness"
    },
    "graph_case_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projection_count": {
      "type": "integer",
      "minimum": 2
    },
    "distinct_policy_digest_count": {
      "type": "integer",
      "minimum": 2
    },
    "distinct_projector_digest_count": {
      "type": "integer",
      "minimum": 2
    },
    "projections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/projection"
      }
    }
  },
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "policy_profile_ref",
        "policy_version",
        "policy_sha256",
        "projector_version",
        "projector_sha256",
        "projection_state",
        "event_decision_count",
        "journal_entry_count",
        "journal_line_count",
        "blocking_unresolved_item_count",
        "unapproved_decision_critical_assumption_present",
        "validation_state"
      ],
      "properties": {
        "projection_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projector_version": {
          "type": "string",
          "minLength": 1
        },
        "projector_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projection_state": {
          "enum": [
            "complete_for_review",
            "needs_review",
            "indeterminate",
            "not_projected"
          ]
        },
        "event_decision_count": {
          "type": "integer",
          "minimum": 0
        },
        "journal_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "journal_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_unresolved_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "unapproved_decision_critical_assumption_present": {
          "type": "boolean"
        },
        "validation_state": {
          "const": "structurally_and_provenance_valid_for_independent_review"
        }
      }
    }
  }
}

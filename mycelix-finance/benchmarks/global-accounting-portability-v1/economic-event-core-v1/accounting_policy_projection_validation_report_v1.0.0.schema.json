{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mycelix-accounting-policy-projection-validation-report-v1.0.0.json",
  "title": "Mycelix Accounting Policy Projection Validation Report v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "schema_version",
    "claim_ceiling",
    "graph_sha256",
    "projection_count",
    "all_graph_bindings_match",
    "projections"
  ],
  "properties": {
    "report_id": {
      "const": "MYCELIX-POLICY-PROJECTION-VALIDATION-S0"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "claim_ceiling": {
      "const": "graph_binding_provenance_and_journal_invariant_validation_not_accounting_policy_correctness"
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projection_count": {
      "type": "integer",
      "minimum": 1
    },
    "all_graph_bindings_match": {
      "const": true
    },
    "projections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/projection"
      }
    }
  },
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "policy_profile_ref",
        "policy_sha256",
        "projector_id",
        "projector_sha256",
        "projection_state",
        "event_decision_count",
        "recognized_decision_count",
        "journal_entry_count",
        "journal_line_count",
        "balanced_entry_count",
        "unresolved_item_count",
        "blocking_unresolved_count",
        "assumption_count",
        "unresolved_critical_assumption_count"
      ],
      "properties": {
        "projection_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projector_id": {
          "type": "string",
          "minLength": 1
        },
        "projector_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projection_state": {
          "enum": [
            "complete_for_review",
            "needs_review",
            "indeterminate",
            "not_projected"
          ]
        },
        "event_decision_count": {
          "type": "integer",
          "minimum": 0
        },
        "recognized_decision_count": {
          "type": "integer",
          "minimum": 0
        },
        "journal_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "journal_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "balanced_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_unresolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "assumption_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_critical_assumption_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/finance-platform-adapter-envelope-v1.0.0.json",
  "title": "Mycelix Finance Platform Adapter Envelope v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "contract_version",
    "claim_ceiling",
    "requested_knowledge_at",
    "source_snapshot",
    "capability_coverage",
    "objects",
    "relationships",
    "field_mappings",
    "effects"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{3,100}$"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "claim_ceiling": {
      "const": "synthetic_adapter_mapping_conformance_only_not_vendor_certification_or_business_authority"
    },
    "requested_knowledge_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "source_snapshot": {
      "$ref": "#/$defs/sourceSnapshot"
    },
    "capability_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "field_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldMapping"
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_family",
        "tenant_namespace",
        "connector_id",
        "export_revision",
        "observed_at",
        "capture_state",
        "payload_sha256"
      ],
      "properties": {
        "system_family": {
          "enum": [
            "onetrust",
            "bigid",
            "microsoft_purview",
            "blackline",
            "workiva",
            "synthetic_other"
          ]
        },
        "tenant_namespace": {
          "type": "string",
          "minLength": 1
        },
        "connector_id": {
          "type": "string",
          "minLength": 1
        },
        "export_revision": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "capture_state": {
          "enum": [
            "complete",
            "partial",
            "truncated",
            "inaccessible",
            "fixture_only"
          ]
        },
        "payload_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "status",
        "scope_ref",
        "observed_at"
      ],
      "properties": {
        "capability_id": {
          "enum": [
            "asset_discovery",
            "personal_data_classification",
            "data_transfer_relationships",
            "actor_access_principals",
            "relationship_data_elements",
            "purpose_context",
            "subprocessor_directionality",
            "data_lineage",
            "source_revision",
            "journal_reconciliation",
            "journal_posting",
            "financial_disclosure_linking",
            "xbrl_tagging",
            "pagination_completeness"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "not_scanned",
            "not_configured",
            "inaccessible",
            "truncated",
            "unknown"
          ]
        },
        "scope_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref",
        "external_object_id",
        "object_namespace",
        "object_type",
        "object_revision"
      ],
      "properties": {
        "object_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{3,100}$"
        },
        "external_object_id": {
          "type": "string",
          "minLength": 1
        },
        "object_namespace": {
          "type": "string",
          "minLength": 1
        },
        "object_type": {
          "enum": [
            "organization",
            "person",
            "service_account",
            "legal_entity",
            "data_asset",
            "processing_activity",
            "purpose",
            "data_element",
            "dataset",
            "file",
            "journal_entry",
            "reconciliation",
            "disclosure",
            "other"
          ]
        },
        "object_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_ref",
        "source_object_ref",
        "target_object_ref",
        "direction",
        "relationship_type",
        "processing_activity_ref",
        "purpose_refs",
        "data_element_refs",
        "access_principal_refs",
        "evidence_refs",
        "upstream_origin_refs",
        "valid_from",
        "valid_to",
        "recorded_at"
      ],
      "properties": {
        "relationship_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{3,100}$"
        },
        "source_object_ref": {
          "type": "string"
        },
        "target_object_ref": {
          "type": "string"
        },
        "direction": {
          "const": "source_to_target"
        },
        "relationship_type": {
          "enum": [
            "transfers_data_to",
            "subprocessor_for",
            "accesses",
            "processes_for",
            "derived_from",
            "matches",
            "posts_to",
            "publishes_from",
            "lineage",
            "other"
          ]
        },
        "processing_activity_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "data_element_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "access_principal_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "upstream_origin_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "valid_from": {
          "type": "string",
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "canonical_path",
        "mapping_status",
        "transformation_ref",
        "loss_code",
        "recorded_at"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "canonical_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_status": {
          "enum": [
            "mapped_exact",
            "mapped_normalized",
            "unmapped",
            "unsupported",
            "ambiguous"
          ]
        },
        "transformation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "loss_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mapping_status": {
                "const": "mapped_exact"
              }
            },
            "required": [
              "mapping_status"
            ]
          },
          "then": {
            "properties": {
              "canonical_path": {
                "type": "string",
                "minLength": 1
              },
              "transformation_ref": {
                "type": "null"
              },
              "loss_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mapping_status": {
                "const": "mapped_normalized"
              }
            },
            "required": [
              "mapping_status"
            ]
          },
          "then": {
            "properties": {
              "canonical_path": {
                "type": "string",
                "minLength": 1
              },
              "transformation_ref": {
                "type": "string",
                "minLength": 1
              },
              "loss_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mapping_status": {
                "enum": [
                  "unmapped",
                  "unsupported",
                  "ambiguous"
                ]
              }
            },
            "required": [
              "mapping_status"
            ]
          },
          "then": {
            "properties": {
              "canonical_path": {
                "type": "null"
              },
              "loss_code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mycelix-recbench-bridge-oracle-v1.0.0.json",
  "title": "Mycelix RecBench Bridge Oracle v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "schema_version",
    "claim_ceiling",
    "dataset_binding",
    "expectations"
  ],
  "properties": {
    "bundle_id": {
      "const": "MYCELIX-RECBENCH-BRIDGE-S0-ORACLE"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "claim_ceiling": {
      "const": "synthetic_oracle_for_bridge_controls_not_model_performance"
    },
    "dataset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "tier",
        "generator_version",
        "seed",
        "config_sha256",
        "oracle_files_excluded"
      ],
      "properties": {
        "snapshot_id": {
          "const": "MYCELIX-RECBENCH-SMALL-SOURCE-2026-11-07"
        },
        "tier": {
          "const": "small"
        },
        "generator_version": {
          "const": "0.1.0"
        },
        "seed": {
          "const": 1042
        },
        "config_sha256": {
          "const": "d31d413456ea5364f74a0c355a6b41d81aee5ea37f9f4805a356bdfa7243fbc5"
        },
        "oracle_files_excluded": {
          "const": true
        }
      }
    },
    "expectations": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/expectation"
      }
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_ref",
        "match_kind",
        "ledger_record_refs",
        "settlement_record_refs",
        "payout_record_refs",
        "bank_record_refs",
        "currency",
        "matched_amount_minor",
        "fx_quote_ref",
        "allocations"
      ],
      "properties": {
        "match_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{3,120}$"
        },
        "match_kind": {
          "enum": [
            "ledger_to_settlement",
            "payout_to_bank",
            "payout_subset_to_bank"
          ]
        },
        "ledger_record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "settlement_record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "payout_record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "bank_record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "matched_amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "fx_quote_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_record_ref",
              "to_record_ref",
              "amount_minor",
              "currency"
            ],
            "properties": {
              "from_record_ref": {
                "type": "string"
              },
              "to_record_ref": {
                "type": "string"
              },
              "amount_minor": {
                "type": "integer",
                "minimum": 1
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          }
        }
      }
    },
    "duplicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duplicate_record_ref",
        "canonical_record_ref",
        "reason_code"
      ],
      "properties": {
        "duplicate_record_ref": {
          "type": "string"
        },
        "canonical_record_ref": {
          "type": "string"
        },
        "reason_code": {
          "const": "duplicate_feed_row_same_source_identity"
        }
      }
    },
    "reversal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reversal_record_ref",
        "original_record_ref",
        "reason_code"
      ],
      "properties": {
        "reversal_record_ref": {
          "type": "string"
        },
        "original_record_ref": {
          "type": "string"
        },
        "reason_code": {
          "const": "explicit_reversal_lineage"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_ref",
        "reason_code",
        "record_refs",
        "action",
        "expected_residual_minor",
        "details"
      ],
      "properties": {
        "exception_ref": {
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "unmatched_bank_movement",
            "ambiguous_match",
            "future_evidence_not_available",
            "unmatched_settlement_movement"
          ]
        },
        "record_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "action": {
          "enum": [
            "leave_unmatched",
            "route_to_review",
            "exclude_future_evidence"
          ]
        },
        "expected_residual_minor": {
          "type": [
            "integer",
            "null"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "matches",
        "duplicates",
        "reversals",
        "exceptions"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/match"
          }
        },
        "duplicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duplicate"
          }
        },
        "reversals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reversal"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          }
        }
      }
    }
  }
}

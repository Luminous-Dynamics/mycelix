{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/benchmark-source-evidence-v1.1.0.json",
  "title": "Mycelix External Benchmark Source Evidence v1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "schema_version",
    "captured_on",
    "captured_at",
    "supersedes_snapshot_id",
    "claim_ceiling",
    "sources"
  ],
  "properties": {
    "snapshot_id": {
      "const": "MYCELIX-ACCOUNTING-EXTERNAL-BENCHMARK-SNAPSHOT-2026-11-05T1939-SAST"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "captured_on": {
      "const": "2026-11-05"
    },
    "captured_at": {
      "const": "2026-11-05T19:39:00+02:00"
    },
    "supersedes_snapshot_id": {
      "const": "MYCELIX-ACCOUNTING-EXTERNAL-BENCHMARK-SNAPSHOT-2026-11-05"
    },
    "claim_ceiling": {
      "const": "public_source_metadata_snapshot_not_benchmark_reproduction_or_dataset_license"
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "metric_or_fact",
        "observed_value",
        "unit",
        "display_locator",
        "evidence_status",
        "interpretation"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{3,120}$"
        },
        "metric_or_fact": {
          "type": "string",
          "minLength": 3
        },
        "observed_value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "display_locator": {
          "type": "string",
          "minLength": 3
        },
        "evidence_status": {
          "enum": [
            "primary_paper_reported",
            "live_page_display_only",
            "methodology_page_display",
            "scope_description",
            "paper_limit_or_exclusion"
          ]
        },
        "interpretation": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "benchmark_id",
        "title",
        "source_role",
        "canonical_url",
        "observed_at",
        "publication_date",
        "source_state",
        "access",
        "source_bytes_archived",
        "source_bytes_sha256",
        "observations",
        "notes"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{3,120}$"
        },
        "benchmark_id": {
          "enum": [
            "APEX-ACCOUNTING",
            "FINBALANCE"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "source_role": {
          "enum": [
            "methodology_page",
            "research_paper",
            "live_leaderboard"
          ]
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "observed_at": {
          "const": "2026-11-05T19:39:00+02:00"
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_state": {
          "enum": [
            "current_methodology_snapshot",
            "paper_cohort_160_snapshot",
            "live_page_cohort_differs_from_paper_unreconciled",
            "primary_paper_snapshot"
          ]
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metadata_access",
            "scored_split_access",
            "redistribution_status",
            "note"
          ],
          "properties": {
            "metadata_access": {
              "enum": [
                "public"
              ]
            },
            "scored_split_access": {
              "enum": [
                "public_dev_subset_only",
                "closed_scored_set_authorized_access_required",
                "not_established_from_this_source"
              ]
            },
            "redistribution_status": {
              "enum": [
                "not_authorized_by_this_snapshot",
                "unknown_requires_terms_review"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 5
            }
          }
        },
        "source_bytes_archived": {
          "const": false
        },
        "source_bytes_sha256": {
          "type": "null"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}

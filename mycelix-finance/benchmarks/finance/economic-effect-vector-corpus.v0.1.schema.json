{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/mycelix-finance/benchmarks/finance/economic-effect-vector-corpus.v0.1.schema.json",
  "title": "FIN-EFFECT-004 Profile-Bound Economic Effect Vector Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "schema_version",
    "issue",
    "status",
    "composition",
    "aggregation_precedence",
    "cases",
    "metrics",
    "known_answer_vectors"
  ],
  "properties": {
    "benchmark": {
      "const": "FIN-EFFECT-004 Profile-Bound Economic Effect Vector Projection"
    },
    "schema_version": {
      "const": "0.1"
    },
    "issue": {
      "const": 6608
    },
    "status": {
      "const": "normative_adversarial_corpus_not_execution_evidence"
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_identity",
        "intent_fingerprint",
        "effect_identity",
        "projection",
        "no_new_operation_or_effect_identity_algorithm"
      ],
      "properties": {
        "operation_identity": {
          "const": "FIN-EFFECT-001 operation identity"
        },
        "intent_fingerprint": {
          "const": "FIN-EFFECT-001 immutable intent fingerprint"
        },
        "effect_identity": {
          "const": "FIN-EFFECT-001 role-and-owner effect identity"
        },
        "projection": {
          "const": "classify_effect_vector"
        },
        "no_new_operation_or_effect_identity_algorithm": {
          "const": true
        },
        "claim_profile_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "schema_version",
            "domain_separator",
            "derived_from"
          ],
          "properties": {
            "algorithm": {
              "const": "BLAKE3-256"
            },
            "schema_version": {
              "const": 1
            },
            "domain_separator": {
              "const": "mycelix:economic-claim-profile:v1\\0"
            },
            "derived_from": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "aggregation_precedence": {
      "const": [
        "Conflict",
        "Indeterminate",
        "Pending",
        "SupportedWithinDeclaredScope"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "required_roles",
          "setup",
          "stimulus",
          "expected",
          "assertion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VEC-[0-9]{3}$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "required_roles": {
            "type": "string",
            "minLength": 1
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "stimulus": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "SupportedWithinDeclaredScope",
              "Pending",
              "Indeterminate",
              "Conflict",
              "RejectedInput",
              "ByteIdenticalProjection"
            ]
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "target",
          "stage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M-VEC-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "absolute_safety_gate",
              "performance_after_safety"
            ]
          }
        }
      }
    },
    "known_answer_vectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vector_id",
          "name",
          "algorithm",
          "schema_version",
          "encoding",
          "inputs",
          "expected_hex"
        ],
        "properties": {
          "vector_id": {
            "const": "KAT-VEC-001"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "const": "BLAKE3-256"
          },
          "schema_version": {
            "const": 1
          },
          "encoding": {
            "type": "string",
            "minLength": 20
          },
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile_id",
              "claim_name",
              "operation_id_hex",
              "intent_fingerprint_hex",
              "required_effects"
            ],
            "properties": {
              "profile_id": {
                "const": "claim:bilateral-payment:v1"
              },
              "claim_name": {
                "const": "bilateral_payment_reconciled"
              },
              "operation_id_hex": {
                "const": "15a08e9c3bf2599c15b37cb700698aec1898cd4c66b15ebf5208568e4953f204"
              },
              "intent_fingerprint_hex": {
                "const": "6a52f1479b7a407d6de4f2650b61bf3203741c80e28f836db523f58625e62235"
              },
              "required_effects": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role",
                    "owner",
                    "effect_id_hex"
                  ],
                  "properties": {
                    "role": {
                      "enum": [
                        "beneficiary_claim",
                        "payer_debit"
                      ]
                    },
                    "owner": {
                      "type": "string",
                      "minLength": 1
                    },
                    "effect_id_hex": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          },
          "expected_hex": {
            "const": "5ad833aef24a53646218b7fbe43fb1d3314563b165a0233898e5a96b4e1f8e4c"
          }
        }
      }
    }
  }
}

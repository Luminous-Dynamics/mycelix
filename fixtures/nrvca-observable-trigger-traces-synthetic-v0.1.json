{
  "schema_version": "nrvca-observable-triggers/0.1",
  "status": "synthetic_test_contract",
  "purpose": "Synthetic known-answer tests for observable adaptive-policy triggers. Values, thresholds, lead times, costs and event traces are illustrative and uncalibrated; this fixture does not authorize or dispatch real infrastructure actions.",
  "action_authority": {
    "execution_mode": "recommendation_only",
    "automatic_dispatch_enabled": false,
    "decision_rights": "Triggers create audit events and recommendations only. An authorized operator must review and authorize any real action.",
    "missing_or_stale_data_policy": "Fail closed for automated recommendations; emit a data-quality/manual-review event. Do not substitute zero, last value, or normal operation.",
    "probability_policy": "No event or policy probability is inferred from trace counts."
  },
  "operational_clock": {
    "time_unit": "synthetic_step",
    "monotonic_required": true,
    "duplicate_evaluation_steps": "reject_trace",
    "freshness_rule": "Observation is usable only when quality_status=valid, value is non-null, unit matches, observation step is not after evaluation step, and age is no greater than the rule's max_age_steps."
  },
  "hard_contract": {
    "max_single_action_cost": 4,
    "cost_unit": "synthetic_cost_units",
    "requires_rule_version_in_audit": true,
    "requires_input_observation_id_in_audit": true,
    "requires_fallback_on_every_rule": true,
    "requires_lead_time_comparison": true
  },
  "indicators": [
    {
      "indicator_id": "source_availability_ratio",
      "unit": "ratio_0_to_1",

{
  "schema_version": "nrvca-shared-budget-arbitration/0.1",
  "status": "synthetic_test_contract",
  "purpose": "Known-answer tests for deterministic arbitration of concurrent action recommendations under shared budget and resource constraints. All costs, ranks, capacities and scenarios are illustrative, uncalibrated, and fictional.",
  "action_authority": {
    "execution_mode": "recommendation_only",
    "automatic_dispatch_enabled": false,
    "decision_rights": "The arbiter emits receipts only. An authorized operator must review and authorize any real action.",
    "no_probability_inference": true
  },
  "policy": {
    "budget": 4,
    "cost_unit": "synthetic_cost_units",
    "protected_policy_class": "protected_service_floor",
    "protected_class_atomic": true,
    "protected_class_infeasibility": "If eligible protected actions cannot all fit the budget or their required preconditions are missing, select nothing and require manual review. Do not substitute lower-priority actions.",
    "candidate_ordering": [
      "class_rank_ascending",
      "priority_rank_ascending",
      "action_id_ascending",
      "candidate_id_ascending"
    ],
    "optional_action_policy": "After protected actions are feasible and selected, consider discretionary candidates in deterministic order. Reject no candidate silently; preserve one terminal disposition and budget arithmetic.",
    "evaluation_order": [
      "validate_candidate_and_authoritative_cost",
      "check_protected_preconditions_and_bundle_feasibility",
      "select_protected_bundle",
      "for_each_discretionary_candidate_check_preconditions_then_resource_capacity_then_budget"
    ],
    "resource_conflicts": "Resource claims share a capacity pool; selections may not exceed any declared capacity."
  },
  "hard_contract": {
    "max_single_action_cost": 4,
    "budget_must_be_nonnegative_integer": true,
    "action_cost_is_authoritative": true,
    "one_terminal_disposition_per_candidate": true,
    "full_budget_receipt_required": true,
    "all_values_uncalibrated": true,
    "max_candidates_per_case": 10000
  },
  "resource_capacities": {
    "backup_system": 1,
    "tanker_fleet": 1,
    "repair_crews": 1,
    "storage_release_slot": 1
  },
  "actions": [

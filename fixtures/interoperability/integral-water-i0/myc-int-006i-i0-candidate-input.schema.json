{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminous-dynamics.org/schemas/mycelix/interoperability/myc-int-006i-i0-candidate-input.schema.json",
  "title": "MYC-INT-006I implementation-neutral I0 candidate input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "candidate_input_id",
    "candidate_input_version",
    "profile",
    "corpus_id",
    "corpus_version",
    "stimulus_id",
    "stimulus_version",
    "source_commitments",
    "subjects",
    "cases"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./myc-int-006i-i0-candidate-input.schema.json"
    },
    "candidate_input_id": {
      "type": "string",
      "const": "myc-int-i0-candidate-input"
    },
    "candidate_input_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "profile": {
      "type": "string",
      "const": "runtime-neutral-candidate-input-v1"
    },
    "corpus_id": {
      "type": "string",
      "const": "myc-int-006c-water-i0"
    },
    "corpus_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "stimulus_id": {
      "type": "string",
      "const": "myc-int-006e-water-i0-stimulus"
    },
    "stimulus_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source_commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_sha256", "stimulus_sha256"],
      "properties": {
        "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "stimulus_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/subjectId"},
      "additionalProperties": {"$ref": "#/$defs/subject"}
    },
    "cases": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^I0-[A-Z]+-[0-9]{3}$"},
      "additionalProperties": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "semanticRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "version"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "semantic_ref"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Resource",
            "Issue",
            "Observation",
            "ActorReport",
            "EvidenceBundle",
            "Alternative",
            "Objection",
            "Prediction",
            "Recommendation",
            "Decision",
            "ForeignDecision",
            "Authorization",
            "ImplementationAttempt",
            "ImplementationReceipt",
            "OutcomeObservation",
            "ReviewCandidate",
            "SupersedingDecisionCandidate",
            "Credential",
            "Certification",
            "DerivedSummary",
            "ForeignAuthority",
            "DeliveryReceipt"
          ]
        },
        "semantic_ref": {"$ref": "#/$defs/semanticRef"}
      }
    },
    "operation": {
      "type": "string",
      "enum": [
        "RecordLineage",
        "ExecuteRecommendation",
        "ImportForeignDecisionAsLocalAuthority",
        "UseCredentialAsAuthority",
        "DeliverImplementationAttempt",
        "ClassifyTimeoutOutcome",
        "AdmitStaleSchema",
        "AcceptExternalCertificationLocally",
        "TreatDerivedSummaryAsSourceFact",
        "ExecuteWithExpiredAuthorization",
        "RewriteHistoricalDecisionFromOutcome",
        "ProcessReorderedTransport",
        "CollapseSchemaQualifiedIdentity",
        "TranslateWithUndeclaredLoss",
        "ImportForeignAuthorityAsLocal",
        "ResolvePartitionByLastArrival",
        "PromotePredictionToObservation",
        "PromoteDeliveryReceiptToImplementationReceipt",
        "PromoteExecutionReceiptToDesiredOutcome"
      ]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "delivery_count": {"type": "integer", "minimum": 0},
        "semantic_attempt_count": {"type": "integer", "minimum": 0},
        "receiver_persistence": {"type": "string", "enum": ["possible", "known", "absent"]},
        "acknowledgement": {"type": "string", "enum": ["present", "missing"]},
        "sender_result": {"type": "string", "enum": ["success", "failure", "timeout"]},
        "delivery_order": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/subjectId"}
        },
        "total_order_promised": {"type": "boolean"},
        "partitioned": {"type": "boolean"},
        "reconnected": {"type": "boolean"},
        "proposed_resolution": {"type": "string", "enum": ["last_arrival_wins"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "status": {"type": "string", "enum": ["current", "expired", "revoked"]}
      }
    },
    "schemaCondition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "supplied_generation": {"type": "string", "minLength": 1},
        "required_generation": {"type": "string", "minLength": 1},
        "visible_identifier_equal": {"type": "boolean"},
        "source_schema_equal": {"type": "boolean"}
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "declared_loss": {"type": "boolean"},
        "actual_loss": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["source_schema", "provenance"]}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "subjects"],
      "properties": {
        "operation": {"$ref": "#/$defs/operation"},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/subjectId"}
        },
        "transport": {"$ref": "#/$defs/transport"},
        "authority": {"$ref": "#/$defs/authority"},
        "schema": {"$ref": "#/$defs/schemaCondition"},
        "translation": {"$ref": "#/$defs/translation"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.dev/schemas/constitutional-refinement-crosswalk.v2.schema.json",
  "title": "Mycelix Constitutional Refinement Crosswalk v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "crosswalk_id", "version", "status", "parent_crosswalk", "subjects",
    "inherited_relationships", "relationships", "pending_subjects", "non_claims"
  ],
  "properties": {
    "schema": {"const": "mycelix.constitutional-refinement-crosswalk.v2"},
    "crosswalk_id": {"const": "mycelix.constitutional-refinement-evidence.v2"},
    "version": {"const": "0.2.0"},
    "status": {"const": "draft"},
    "parent_crosswalk": {"$ref": "#/$defs/parentCrosswalk"},
    "subjects": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/subject"}
    },
    "inherited_relationships": {"$ref": "#/$defs/inheritedRelationships"},
    "relationships": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/relationship"}
    },
    "pending_subjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/pendingSubject"}
    },
    "non_claims": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parentCrosswalk": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_head", "verifier_head", "qualification_run_id", "artifact_digest", "manifest_path", "manifest_git_blob_sha"],
      "properties": {
        "semantic_head": {"$ref": "#/$defs/sha40"},
        "verifier_head": {"$ref": "#/$defs/sha40"},
        "qualification_run_id": {"type": "integer", "minimum": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_git_blob_sha": {"$ref": "#/$defs/sha40"}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "semantic_head", "verifier_head", "qualification_run_id", "artifact_digest", "evidence_status", "mapping_status", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "semantic_head": {"$ref": "#/$defs/sha40"},
        "verifier_head": {"$ref": "#/$defs/sha40"},
        "qualification_run_id": {"type": "integer", "minimum": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "evidence_status": {"const": "qualified"},
        "mapping_status": {"enum": ["inherited_qualified", "candidate", "unmapped"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "inheritedRelationships": {
      "type": "object", "additionalProperties": false,
      "required": ["source_subject_id", "source_crosswalk_semantic_head", "relationship_ids"],
      "properties": {
        "source_subject_id": {"const": "MYC-CONST-003B2"},
        "source_crosswalk_semantic_head": {"$ref": "#/$defs/sha40"},
        "relationship_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "sourceSide": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_head", "path", "git_blob_sha", "symbol"],
      "properties": {
        "semantic_head": {"$ref": "#/$defs/sha40"},
        "path": {"type": "string", "minLength": 1},
        "git_blob_sha": {"$ref": "#/$defs/sha40"},
        "symbol": {"type": "string", "minLength": 1},
        "metadata_fields": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "fieldMap": {
      "type": "object", "additionalProperties": false,
      "required": ["concrete", "formal"],
      "properties": {
        "concrete": {"type": "string", "minLength": 1},
        "formal": {"type": "string", "minLength": 1}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject_id", "mapping_status", "kind", "concrete", "formal", "field_map", "rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "mapping_status": {"const": "candidate"},
        "kind": {"const": "projection"},
        "concrete": {"$ref": "#/$defs/sourceSide"},
        "formal": {"$ref": "#/$defs/sourceSide"},
        "field_map": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/fieldMap"}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "pendingSubject": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "semantic_head", "verifier_head", "qualification_run_id", "status", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "semantic_head": {"$ref": "#/$defs/sha40"},
        "verifier_head": {"$ref": "#/$defs/sha40"},
        "qualification_run_id": {"type": "integer", "minimum": 1},
        "status": {"enum": ["queued", "in_progress", "prepared"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.example/schemas/constitutional-event-admission-repair-bridge.v1.schema.json",
  "title": "Mycelix Constitutional Event Admission Repair Bridge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "bridge_id", "version", "status", "activation_allowed", "provider_lane",
    "upstream_e1a", "repair_edges", "carried_forward_invariants", "migration_rule", "non_claims"
  ],
  "properties": {
    "schema": {"const": "mycelix.constitutional-event-admission-repair-bridge.v1"},
    "bridge_id": {"const": "MYC-CONST-003D1D-E1AR1"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["PendingRepairQualification", "QualifiedRepairBridge"]},
    "activation_allowed": {"type": "boolean"},
    "provider_lane": {"const": "EmitEvent"},
    "upstream_e1a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_head", "verifier_head", "qualification_run_id", "qualification_job_id", "artifact_id", "artifact_digest", "conclusion", "receipt_inspected"],
      "properties": {
        "semantic_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verifier_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "qualification_run_id": {"type": "integer", "minimum": 1},
        "qualification_job_id": {"type": "integer", "minimum": 1},
        "artifact_id": {"type": "integer", "minimum": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "conclusion": {"enum": ["success"]},
        "receipt_inspected": {"const": true}
      }
    },
    "repair_edges": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "old_semantic_head", "r1_semantic_head", "r1_verifier_head", "relation", "qualification_state", "qualification_receipt", "files"],
        "properties": {
          "dependency_id": {"enum": ["MYC-CONST-003D1C", "MYC-CONST-003D1D-E0"]},
          "old_semantic_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "r1_semantic_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "r1_verifier_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "relation": {"const": "PinnedRustfmtExactBytesRequired"},
          "qualification_state": {"enum": ["PreparedNotHostedQualified", "Qualified"]},
          "qualification_receipt": {"type": ["string", "null"]},
          "files": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "old_blob", "r1_blob"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "old_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "r1_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            }
          }
        }
      }
    },
    "carried_forward_invariants": {"type": "object", "additionalProperties": {"type": ["boolean", "string"]}},
    "migration_rule": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}

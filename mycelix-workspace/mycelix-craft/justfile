# Build WASM zomes
build:
    cargo build --workspace --target wasm32-unknown-unknown --release

# Run tests
test:
    cargo test --workspace

# Check (fast)
check:
    cargo check --workspace


# Run the standalone evidence-lineage reference core
core-evidence-lineage:
    cargo test --manifest-path Cargo.toml -p craft-evidence-lineage-v1

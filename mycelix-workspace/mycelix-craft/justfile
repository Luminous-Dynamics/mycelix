# Build WASM zomes
build:
    cargo build --workspace --target wasm32-unknown-unknown --release

# Run tests
test:
    cargo test --workspace

# Check (fast)
check:
    cargo check --workspace

# Run the pure Rust Craft reference policy cores
core-test:
    cargo test -p craft-guild-governance-v1 -p craft-economic-agreement-v1 -p craft-professional-assessment-authority-v1 -p craft-project-formation-v1

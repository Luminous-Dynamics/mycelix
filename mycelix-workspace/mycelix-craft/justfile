# Build WASM zomes
build:
    cargo build --workspace --target wasm32-unknown-unknown --release

# Run tests
test:
    cargo test --workspace

# Check (fast)
check:
    cargo check --workspace

# Run only the standalone work-evidence reference contract tests
test-work-evidence:
    cargo test -p craft-work-evidence-v1

# Check only the standalone work-evidence reference package
check-work-evidence:
    cargo check -p craft-work-evidence-v1

        "source_substitution",
        "digest_schema_substitution",
        "stale_policy",
        "authority_revocation",
        "common_cause",
        "out_of_domain",
        "unknown_execution_outcome",
        "incomplete_source_universe"
      ]
    },
    {
      "id": "efficiency",
      "metrics": [
        "throughput",
        "p50_latency",
        "p95_latency",
        "p99_latency",
        "peak_rss",
        "cpu_time",
        "bytes_read",
        "bytes_written",
        "index_size",
        "receipt_size",
        "replay_cost"
      ],
      "repetitions_min": 5,
      "cache_modes": [
        "cold",
        "warm"
      ],
      "scale_events": [
        1000,
        10000,
        100000,
        1000000,
        2400000,
        7000000,
        10000000
      ]
    },
    {
      "id": "interoperability",
      "metrics": [
        "ocel_2x_interchange",
        "scitt_receipt_reference",
        "offline_verification",
        "verifier_portability",
        "unsupported_semantics_reporting"
      ]
    },
    {
      "id": "epistemic_debt_and_observability",
      "metrics": [
        "unknown_detection_recall",
        "unsupported_certainty_rate",
        "time_to_detect_gap",
        "stale_gap_persistence",
        "duplicate_gap_rate",
        "claim_ceiling_constraint_accuracy",
        "mandatory_gap_block_rate",
        "budgeted_observability_regret"
      ],
      "scenarios": [
        "missing_not_at_random",
        "selective_adverse_event_omission",
        "late_evidence_after_frontier",
        "source_identifier_rotation",
        "signed_but_incomplete_feed",
        "disputed_source",
        "stale_source",
        "unavailable_required_source"
      ],
      "baselines": [
        "fixed_schedule",
        "random_safe",
        "expert_priority",
        "EIG_greedy",
        "EVSI_greedy",
        "constrained_portfolio",
        "budgeted_hindsight_upper_bound"
      ]
    },
    {
      "id": "meta_audit_of_inspection_policy",
      "metrics": [
        "policy_action_replay_completeness",
        "selection_bias_analysis",
        "off_policy_estimation_error",
        "support_positivity_violation_rate",
        "propensity_calibration",

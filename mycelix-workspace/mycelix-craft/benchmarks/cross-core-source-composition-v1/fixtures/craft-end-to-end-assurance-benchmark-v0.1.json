        "rare_region_inspection_coverage",
        "uninspected_residual_risk",
        "utility_per_review_hour",
        "policy_drift_detection_delay",
        "human_override_rate",
        "rollback_latency",
        "policy_version_change_traceability"
      ],
      "scenarios": [
        "historical_high_risk_only_selection",
        "rare_high_severity_reward_abandonment",
        "reviewer_outcomes_missing_not_at_random",
        "zero_propensity_critical_region",
        "unversioned_selection_policy_change",
        "adversarial_feature_manipulation_to_avoid_review",
        "feedback_loop_reinforces_visible_risk"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mycelix.craft.decision-identifiability.v0.1.schema.json",
  "title": "Craft Decision Identifiability Envelope V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "case_id",
    "coverage_basis",
    "actions",
    "fallback_action",
    "worlds"
  ],
  "properties": {
    "schema_id": {
      "const": "mycelix.craft.decision-identifiability.v0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "coverage_basis": {
      "enum": [
        "fixture_exhaustive",
        "declared_set",
        "not_evaluated"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fallback_action": {
      "type": "string",
      "minLength": 1
    },
    "worlds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "losses"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "losses": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "hard_violations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_basis": {
            "const": "fixture_exhaustive"
          }
        },
        "required": [
          "coverage_basis"
        ]
      },
      "then": {
        "required": [
          "fixture_digest"
        ]
      },
      "else": {
        "not": {
          "required": [
            "fixture_digest"
          ]
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mycelix.craft.world-envelope-cegar.v0.1.schema.json",
  "title": "Craft Finite-Domain World Envelope CEGAR V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "case_id",
    "scope_basis",
    "dimensions",
    "constraints",
    "actions",
    "worlds",
    "cells"
  ],
  "properties": {
    "schema_id": {
      "const": "mycelix.craft.world-envelope-cegar.v0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_basis": {
      "enum": [
        "fixture_exact",
        "declared_assumptions",
        "not_evaluated"
      ]
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "values"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "forbidden",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "forbidden": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "worlds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment",
          "losses"
        ],
        "properties": {
          "assignment": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "losses": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "hard_violations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fixed": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "unresolved_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope_basis": {
            "const": "fixture_exact"
          }
        },
        "required": [
          "scope_basis"
        ]
      },
      "then": {
        "required": [
          "fixture_digest"
        ]
      },
      "else": {
        "not": {
          "required": [
            "fixture_digest"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "unresolved_items": {
            "minItems": 1
          }
        },
        "required": [
          "unresolved_items"
        ]
      },
      "then": {
        "properties": {
          "scope_basis": {
            "const": "not_evaluated"
          }
        }
      }
    }
  ]
}

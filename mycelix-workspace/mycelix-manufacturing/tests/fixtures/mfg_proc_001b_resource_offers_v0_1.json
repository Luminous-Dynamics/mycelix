  "cases": [
    {
      "id": "MFG-PROC-001B-001",
      "description": "Well-formed provider offer remains DeclaredOnly; signature, refs, qualification, calendar and capacity need independent resolution",
      "mutations": [],
      "expected": {
        "offer_state": "DeclaredOnly",
        "capability_qualified": false,
        "calendar_available": false,
        "bookable": false,
        "reserved": false,
        "executed": false
      }
    },
    {
      "id": "MFG-PROC-001B-002",
      "description": "Published offer with declared capacity but no calendar reference is not bookable",
      "mutations": [
        {
          "op": "replace",
          "path": "/calendar_source_ref",
          "value": null
        }
      ],
      "expected": {

        "resource": "unavailable",
        "site": "unavailable",
        "process": "unavailable",
        "capability_profile": "unavailable"
      },
      "expected": {
        "offer_state": "Unresolved",
        "resource_resolved": false,
        "site_resolved": false,
        "process_resolved": false
      }
    },
    {
      "id": "MFG-PROC-001B-008",
      "description": "Validity interval expired even though provider leaves offer_state Published",

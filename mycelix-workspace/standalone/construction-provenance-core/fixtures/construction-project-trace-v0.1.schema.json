{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/construction-project-trace-v0.1.schema.json",
  "title": "Construction Project Authority and Custody Trace v0.1",
  "description": "Mycelix participant authority, material custody and manufacturing/inspection attestation trace. Engineering artifact semantics remain with source owners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "current_design_artifact_ref",
    "site_context_artifact_ref",
    "portfolio_alternative_artifact_ref",
    "artifact_references",
    "authority_assertions",
    "evidence_assertions",
    "approvals",
    "material_batches",
    "custody_receipts",
    "manufacturing_receipts",
    "inspections"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "current_design_artifact_ref": {
      "$ref": "#/$defs/id"
    },
    "site_context_artifact_ref": {
      "$ref": "#/$defs/nullable_id"
    },
    "portfolio_alternative_artifact_ref": {
      "$ref": "#/$defs/nullable_id"
    },
    "artifact_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external_artifact"
      }
    },
    "authority_assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authority_assertion"
      }
    },
    "evidence_assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_assertion"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participant_approval"
      }
    },
    "material_batches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material_batch"
      }
    },
    "custody_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/custody_receipt"
      }
    },
    "manufacturing_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manufacturing_receipt"
      }
    },
    "inspections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inspection_receipt"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "nullable_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "external_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "owner_system",
        "artifact_role",
        "revision_ref",
        "sha256"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/id"
        },
        "owner_system": {
          "$ref": "#/$defs/id"
        },
        "artifact_role": {
          "$ref": "#/$defs/id"
        },
        "revision_ref": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "authority_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "signer_id",
        "role",
        "scope_ref",
        "status",
        "available_at",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/id"
        },
        "signer_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "scope_ref": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked",
            "disputed",
            "unknown"
          ]
        },
        "available_at": {
          "$ref": "#/$defs/time"
        },
        "valid_from": {
          "$ref": "#/$defs/time"
        },
        "valid_until": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "evidence_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "subject_ref",
        "sha256",
        "status",
        "use_permission",
        "available_at",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/id"
        },
        "subject_ref": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "revoked",
            "disputed",
            "unknown"
          ]
        },
        "use_permission": {
          "type": "string",
          "enum": [
            "permitted",
            "prohibited",
            "unknown"
          ]
        },
        "available_at": {
          "$ref": "#/$defs/time"
        },
        "valid_from": {
          "$ref": "#/$defs/time"
        },
        "valid_until": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "approval_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "satisfied"
      ],
      "properties": {
        "condition_id": {
          "$ref": "#/$defs/id"
        },
        "satisfied": {
          "type": "boolean"
        }
      }
    },
    "participant_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "subject_artifact_ref",
        "supporting_artifact_refs",
        "authority_ref",
        "signer_id",
        "role",
        "scope_ref",
        "supersedes_approval_id",
        "decision",
        "conditions",
        "evidence_refs",
        "dissent_refs",
        "decided_at"
      ],
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/id"
        },
        "subject_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "supporting_artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "authority_ref": {
          "$ref": "#/$defs/id"
        },
        "signer_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "scope_ref": {
          "$ref": "#/$defs/id"
        },
        "supersedes_approval_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "decision": {
          "type": "string",
          "enum": [
            "affirmed",
            "objected",
            "deferred"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approval_condition"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "dissent_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "decided_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "material_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "supplier_party_id",
        "receiving_site_party_id",
        "material_description",
        "supplier_assertion",
        "certification_evidence_ref",
        "certification_scope_ref",
        "declared_at"
      ],
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "supplier_party_id": {
          "$ref": "#/$defs/id"
        },
        "receiving_site_party_id": {
          "$ref": "#/$defs/id"
        },
        "material_description": {
          "$ref": "#/$defs/id"
        },
        "supplier_assertion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "certification_evidence_ref": {
          "$ref": "#/$defs/nullable_id"
        },
        "certification_scope_ref": {
          "$ref": "#/$defs/nullable_id"
        },
        "declared_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "custody_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "batch_id",
        "from_party_id",
        "to_party_id",
        "predecessor_receipt_id",
        "evidence_ref",
        "occurred_at"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/id"
        },
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "from_party_id": {
          "$ref": "#/$defs/id"
        },
        "to_party_id": {
          "$ref": "#/$defs/id"
        },
        "predecessor_receipt_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "evidence_ref": {
          "$ref": "#/$defs/id"
        },
        "occurred_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "manufacturing_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturing_id",
        "design_artifact_ref",
        "material_batch_id",
        "manufacturing_artifact_ref",
        "component_artifact_ref",
        "authority_ref",
        "manufacturer_id",
        "role",
        "scope_ref",
        "evidence_refs",
        "manufactured_at"
      ],
      "properties": {
        "manufacturing_id": {
          "$ref": "#/$defs/id"
        },
        "design_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "material_batch_id": {
          "$ref": "#/$defs/id"
        },
        "manufacturing_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "component_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "authority_ref": {
          "$ref": "#/$defs/id"
        },
        "manufacturer_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "scope_ref": {
          "$ref": "#/$defs/id"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "manufactured_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "inspection_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspection_id",
        "manufacturing_id",
        "manufacturing_artifact_ref",
        "component_artifact_ref",
        "inspection_artifact_ref",
        "installation_artifact_ref",
        "as_built_artifact_ref",
        "authority_ref",
        "inspector_id",
        "role",
        "scope_ref",
        "evidence_refs",
        "claimed_outcome",
        "inspected_at"
      ],
      "properties": {
        "inspection_id": {
          "$ref": "#/$defs/id"
        },
        "manufacturing_id": {
          "$ref": "#/$defs/id"
        },
        "manufacturing_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "component_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "inspection_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "installation_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "as_built_artifact_ref": {
          "$ref": "#/$defs/id"
        },
        "authority_ref": {
          "$ref": "#/$defs/id"
        },
        "inspector_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "scope_ref": {
          "$ref": "#/$defs/id"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "claimed_outcome": {
          "type": "string",
          "enum": [
            "conforming",
            "nonconforming",
            "inconclusive"
          ]
        },
        "inspected_at": {
          "$ref": "#/$defs/time"
        }
      }
    }
  }
}

# mycelix-lawful-identity build recipes
set shell := ["bash", "-uc"]

default:
    @just --list

build:
    cargo build --workspace --target wasm32-unknown-unknown --release

test:
    cargo test --workspace

test-release:
    cargo test --workspace --release

pack-dna: build
    hc dna pack dna/ -o dna/mycelix_lawful_identity.dna

pack-happ: pack-dna
    hc app pack . -o mycelix-lawful-identity.happ

clean:
    cargo clean
    rm -f dna/*.dna *.happ

check:
    cargo check --workspace
    cargo clippy --workspace -- -D warnings

fmt:
    cargo fmt --all

deny:
    cargo deny check

conformance:
    python3 conformance/verify_scoped_verifier_run_v1.py

model-adversarial:
    python3 tests/protocol_model/settlement_conflict_model.py

validate-conductor-scenarios:
    python3 tests/conductor/validate_scenarios.py

conductor-contract-model:
    python3 tests/conductor/run_scenarios.py --adapter tests/conductor/model_adapter.py

evidence-tests:
    python3 -m unittest tests/conductor/test_evidence_manifest.py tests/conductor/test_real_conductor_adapter.py tests/conductor/test_release_evidence_index.py

conductor-contract-real adapter evidence_root:
    MYCELIX_CONDUCTOR_EVIDENCE_ROOT={{evidence_root}} python3 tests/conductor/run_scenarios.py --adapter {{adapter}} --require-real --evidence-root {{evidence_root}}

release-evidence adapter evidence_root:
    MYCELIX_REAL_CONDUCTOR_ADAPTER={{adapter}} MYCELIX_REAL_CONDUCTOR_EVIDENCE_ROOT={{evidence_root}} scripts/verify_release_evidence.sh

model-evidence:
    scripts/verify_model_evidence.sh

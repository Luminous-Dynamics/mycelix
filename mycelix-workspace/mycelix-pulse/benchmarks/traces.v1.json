    "strategies": [
      "preferred_single_path",
      "sequential_failover",
      "parallel_redundancy"
    ],
    "limitations": "Synthetic route eligibility, fixed latency/cost estimates, per-path success thresholds, shared deterministic outcomes within failure domains, and independent outcomes between domains. No RF propagation, interference, fragmentation, congestion, physical common-cause fault estimation, cryptography, real device power measurement, or authenticated-recipient receipt is modeled.",
    "failure_domain_id": "Paths with the same failure_domain_id share the same deterministic synthetic success draw; this models maximally correlated outcomes at equal success rates. Distinct IDs receive independent draws. It is a conservative toy correlation model, not a measured model of carrier or hardware failures."
  },

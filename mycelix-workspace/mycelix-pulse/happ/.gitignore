# Build artifacts
target/
**/target/

# Generated Holochain artefacts
*.wasm
*.dna

# Rust / cargo metadata
Cargo.lock
# Independently resolved application/tool packages qualified with --locked.
!backend-rs/Cargo.lock
!cli/Cargo.lock
# Standalone DNA package locks (canonical tree).
!dna/zomes/trust_filter/Cargo.lock
!dna/integrity/Cargo.lock
!dna/zomes/mail_messages/Cargo.lock
# Nested DNA mirror locks are also generated by the migration closure audit.
!dna/dna/integrity/Cargo.lock
!dna/dna/zomes/mail_messages/Cargo.lock
!dna/dna/zomes/trust_filter/Cargo.lock
*.profraw

# Node / web artifacts
node_modules/
dist/
.parcel-cache/
.vite/

# Python / virtualenv
.venv/
__pycache__/
*.pyc

# Misc
.DS_Store
.idea/

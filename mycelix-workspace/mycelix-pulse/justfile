# Mycelix Pulse canonical working-alpha commands.

set dotenv-load

default:
    @just --list

# Run the canonical Leptos application. A live conductor is expected on :8888.
dev:
    cd apps/leptos && trunk serve --address 127.0.0.1 --port 8117

# Compile the canonical browser application without rewriting tracked files.
check-ui:
    cargo check --manifest-path apps/leptos/Cargo.toml --locked

# Test versioned browser-safe protocol contracts.
test-protocol:
    cargo test --manifest-path crates/mail-leptos-types/Cargo.toml

# Shared Pulse V2 primitives: native behavior plus browser-target compilation.
test-crypto:
    cargo test --manifest-path ../mycelix-identity/crates/mycelix-crypto/Cargo.toml --features hybrid-rc pulse_v2
    cargo check --manifest-path ../mycelix-identity/crates/mycelix-crypto/Cargo.toml --target wasm32-unknown-unknown --features hybrid-rc

# Test the canonical Holochain coordinator workspace.
test-zomes:
    CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/var/tmp/mycelix-pulse-holochain-target} cargo test --manifest-path holochain/Cargo.toml --lib

# Fast canonical alpha gate. Formatting commands are checks and do not rewrite files.
check: fmt-check check-ui test-protocol test-crypto test-zomes

fmt-check:
    cargo fmt --manifest-path apps/leptos/Cargo.toml -- --check
    cargo fmt --manifest-path crates/mail-leptos-types/Cargo.toml -- --check
    cargo fmt --manifest-path holochain/Cargo.toml \
      -p contacts_integrity -p contacts \
      -p mail_profiles_integrity -p mail_profiles \
      -p mail_trust_integrity -p mail_trust \
      -p keys_integrity -p keys \
      -p mail_messages_integrity -p mail_messages \
      -- --check

# Build the browser bundle.
build-ui:
    cd apps/leptos && trunk build --release

# Build from holochain/ so its WASM getrandom backend configuration applies.
# Pack only after every zome WASM has been freshly produced. The release
# artifact is intentionally the restricted alpha DNA, not the broad
# experimental DNA in holochain/dna.
#
# `holochain/dna-alpha/dna.yaml` references static relative paths under
# `holochain/target/wasm32-unknown-unknown/release/`. Cargo, however, writes
# to `$CARGO_TARGET_DIR` (session-isolated per repo Rule 5 and reclaimed
# after ~48h) — those two locations silently diverge across sessions if
# nothing bridges them, which let a stale/dangling `holochain/target` symlink
# from a prior, now-reclaimed session pass `hc dna pack` without error while
# actually packing WASM that no longer matched the source (caught 2026-07-15).
# The explicit copy below makes packing correct regardless of what
# CARGO_TARGET_DIR resolves to for the session running this recipe.
build-dna:
    hc --version | rg -x 'holochain_cli 0\.6\.1'
    cd holochain && cargo build --release --target wasm32-unknown-unknown
    mkdir -p holochain/target/wasm32-unknown-unknown/release
    cp -f "${CARGO_TARGET_DIR:-holochain/target}"/wasm32-unknown-unknown/release/*.wasm holochain/target/wasm32-unknown-unknown/release/
    cd holochain && hc dna pack dna-alpha -o dna-alpha/mycelix_pulse_alpha.dna

build-happ: build-dna
    cd holochain && hc app pack . -o mycelix_pulse_alpha.happ

# Experimental SMTP gateway; not part of the working-alpha support claim.
test-smtp-experimental:
    cargo test --manifest-path crates/pulse-smtp-gateway/Cargo.toml

# Deterministic delivery proof. DNA must have been freshly packed first.
# Runs transport, negative-path, and restart-recovery evidence sequentially
# (--test-threads=1 — each spins up its own pair of conductors, so parallel
# runs would multiply memory/CPU pressure for no benefit). The outer timeout
# is deliberately generous (each test's own internal tokio::time::timeout is
# the real 1500s-per-test bound); this is only a belt-and-suspenders backstop
# against a hang that bypasses that timeout entirely.
test-delivery:
    test -n "${LIBCLANG_PATH:-}" || (echo "LIBCLANG_PATH is required; run inside nix develop" && exit 1)
    timeout 4800s env CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/var/tmp/mycelix-pulse-sweettest-target} cargo test --manifest-path tests/Cargo.toml --test sweettest_mail_security phase0_v2 -- --ignored --test-threads=1

# The fast half of test-delivery: transport + negative-paths, no restart
# (which Holochain's own test suite gates behind `slow_tests` — see the
# doc comment on phase0_v2_conductor_restart_recovery). Prefer this when
# you just need quick signal on the core send/verify/reject behavior.
test-delivery-fast:
    test -n "${LIBCLANG_PATH:-}" || (echo "LIBCLANG_PATH is required; run inside nix develop" && exit 1)
    timeout 3600s env CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/var/tmp/mycelix-pulse-sweettest-target} cargo test --manifest-path tests/Cargo.toml --test sweettest_mail_security -- --ignored --test-threads=1 phase0_v2_hybrid_pqc_transport phase0_v2_negative_paths

# Restart recovery in isolation. Deliberately not part of test-delivery-fast
# — inherently slow (see doc comment), give it a dedicated window.
test-delivery-restart:
    test -n "${LIBCLANG_PATH:-}" || (echo "LIBCLANG_PATH is required; run inside nix develop" && exit 1)
    timeout 3000s env CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/var/tmp/mycelix-pulse-sweettest-target} cargo test --manifest-path tests/Cargo.toml --test sweettest_mail_security phase0_v2_conductor_restart_recovery -- --ignored --test-threads=1

# Compatibility evidence for the readable V1 path; not the default alpha send.
test-v1-transport-compat:
    test -n "${LIBCLANG_PATH:-}" || (echo "LIBCLANG_PATH is required; run inside nix develop" && exit 1)
    timeout 420s env CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/var/tmp/mycelix-pulse-sweettest-target} cargo test --manifest-path tests/Cargo.toml --test sweettest_mail_security phase0_alice_sends_bob_receives -- --ignored --test-threads=1

# Compile the conductor evidence harness without requiring a packed DNA.
check-delivery-harness:
    CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/var/tmp/mycelix-pulse-sweettest-target} cargo test --manifest-path tests/Cargo.toml --test sweettest_mail_security --no-run

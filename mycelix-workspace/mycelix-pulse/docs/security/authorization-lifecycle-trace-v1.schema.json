{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pulse-authorization-lifecycle-trace-v1.schema.json",
  "title": "Pulse Authorization Lifecycle Runtime Trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_version",
    "profile_id",
    "trace_id",
    "scenario_id",
    "source_commit",
    "observer_id",
    "runtime",
    "events"
  ],
  "properties": {
    "trace_version": {
      "const": 1
    },
    "profile_id": {
      "const": "PULSE-AUTH-LIFECYCLE-QUAL-001"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{2}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observer_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holochain",
        "hdk",
        "hdi",
        "js_client",
        "dna_sha256",
        "wasm_sha256",
        "rustc",
        "hc_cli"
      ],
      "properties": {
        "holochain": {
          "type": "string",
          "minLength": 1
        },
        "hdk": {
          "type": "string",
          "minLength": 1
        },
        "hdi": {
          "type": "string",
          "minLength": 1
        },
        "js_client": {
          "type": "string",
          "minLength": 1
        },
        "dna_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "wasm_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rustc": {
          "type": "string",
          "minLength": 1
        },
        "hc_cli": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "scenario_event_id",
          "observed_index",
          "actor",
          "action",
          "logical_operation_id",
          "attempt_id",
          "attempt_number",
          "causal_predecessors",
          "host_grant_transition",
          "planes"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_event_id": {
            "type": "string",
            "pattern": "^e[1-9][0-9]*$"
          },
          "observed_index": {
            "type": "integer",
            "minimum": 0
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "logical_operation_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1
          },
          "causal_predecessors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "grant_action_hash": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "source_action_hash": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "host_grant_transition": {
            "enum": [
              "CREATED",
              "REVOKED",
              "UNCHANGED",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "observer_state_before_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "observer_state_after_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "planes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host_decision",
              "domain_result",
              "source_chain",
              "validator",
              "projection",
              "observer"
            ],
            "properties": {
              "host_decision": {
                "enum": [
                  "AUTHORIZED",
                  "UNAUTHORIZED",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "domain_result": {
                "enum": [
                  "EXECUTED",
                  "REJECTED",
                  "NOT_INVOKED",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "source_chain": {
                "enum": [
                  "ACTION_AUTHORED",
                  "NO_ACTION",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "validator": {
                "enum": [
                  "ACCEPTED",
                  "REJECTED",
                  "NOT_OBSERVED",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "projection": {
                "enum": [
                  "CURRENT",
                  "STALE",
                  "CONFLICTING",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "observer": {
                "enum": [
                  "ACKNOWLEDGED",
                  "NO_ACK",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              }
            }
          }
        }
      }
    }
  }
}

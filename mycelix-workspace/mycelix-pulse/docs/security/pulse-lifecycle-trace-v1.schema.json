{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pulse-lifecycle-trace-v1.schema.json",
  "title": "Pulse redacted authorization lifecycle trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "evidence_class",
    "source_commit",
    "conductor_build",
    "dna_hash",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "synthetic",
        "runtime_capture"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "conductor_build": {
      "type": "string",
      "minLength": 1
    },
    "dna_hash": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/grantIssuedEvent"
          },
          {
            "$ref": "#/$defs/grantRevokedEvent"
          },
          {
            "$ref": "#/$defs/claimAcceptedEvent"
          },
          {
            "$ref": "#/$defs/hostCallEvent"
          },
          {
            "$ref": "#/$defs/domainEffectEvent"
          },
          {
            "$ref": "#/$defs/projectionReadEvent"
          },
          {
            "$ref": "#/$defs/remoteSignalEvent"
          },
          {
            "$ref": "#/$defs/callerOutcomeEvent"
          }
        ]
      }
    }
  },
  "$defs": {
    "eventBase": {
      "type": "object",
      "required": [
        "seq",
        "event_id",
        "evidence_ref",
        "source"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "conductor_host",
            "source_chain",
            "observer",
            "remote_peer",
            "client",
            "coordinator",
            "synthetic"
          ]
        }
      }
    },
    "grantIssued": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_ref",
        "grant_action_hash",
        "grantor",
        "grantee",
        "assigned",
        "functions",
        "idempotency_key",
        "authority_index",
        "request_digest_sha256"
      ],
      "properties": {
        "grant_ref": {
          "type": "string",
          "minLength": 1
        },
        "grant_action_hash": {
          "type": "string",
          "minLength": 1
        },
        "grantor": {
          "type": "string",
          "minLength": 1
        },
        "grantee": {
          "type": "string",
          "minLength": 1
        },
        "assigned": {
          "type": "boolean"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "description": "Logical grant operation ID; uniqueness is scoped by the authenticated grantor, so the idempotency identity is (grantor, idempotency_key)."
        },
        "authority_index": {
          "type": "integer",
          "minimum": 1
        },
        "request_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 commitment to the canonical normalized request used for grant idempotency"
        }
      }
    },
    "grantRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_ref",
        "target_grant_action_hash",
        "actor",
        "revocation_action_hash",
        "authority_index"
      ],
      "properties": {
        "grant_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_grant_action_hash": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "revocation_action_hash": {
          "type": "string",
          "minLength": 1
        },
        "authority_index": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "claimAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_ref",
        "grant_action_hash",
        "recipient",
        "claim_action_hash"
      ],
      "properties": {
        "grant_ref": {
          "type": "string",
          "minLength": 1
        },
        "grant_action_hash": {
          "type": "string",
          "minLength": 1
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "claim_action_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hostCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "attempt_id",
        "grant_ref",
        "grant_action_hash",
        "caller",
        "function",
        "authority_index",
        "host_decision",
        "host_state_at_decision",
        "domain_decision",
        "projection_used_for_authorization"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "integer",
          "minimum": 1
        },
        "grant_ref": {
          "type": "string",
          "minLength": 1
        },
        "grant_action_hash": {
          "type": "string",
          "minLength": 1
        },
        "caller": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "authority_index": {
          "type": "integer",
          "minimum": 1
        },
        "host_decision": {
          "enum": [
            "authorized",
            "unauthorized",
            "unknown"
          ]
        },
        "host_state_at_decision": {
          "enum": [
            "active",
            "revoked",
            "absent",
            "unknown"
          ]
        },
        "domain_decision": {
          "enum": [
            "allow",
            "deny",
            "not_run",
            "unknown"
          ]
        },
        "projection_used_for_authorization": {
          "type": "boolean"
        }
      }
    },
    "domainEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "attempt_id",
        "effect_id",
        "action_hash"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "integer",
          "minimum": 1
        },
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "action_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectionRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_ref",
        "minimum_epoch",
        "observed_epoch",
        "projection_state",
        "checkpoint_used",
        "decision",
        "used_for_authorization"
      ],
      "properties": {
        "grant_ref": {
          "type": "string",
          "minLength": 1
        },
        "minimum_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "observed_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "projection_state": {
          "enum": [
            "active",
            "revoked",
            "conflicting",
            "unknown"
          ]
        },
        "checkpoint_used": {
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "trusted_active",
            "trusted_revoked",
            "unknown",
            "stale_advisory"
          ]
        },
        "used_for_authorization": {
          "type": "boolean"
        }
      }
    },
    "remoteSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "trust_class",
        "claimed_sender",
        "transport_sender",
        "backing_action_hash",
        "record_author",
        "verified_payload_sha256",
        "verifier_build",
        "trusted_state_mutation",
        "authorizes_operation"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "trust_class": {
          "enum": [
            "verified_record",
            "authenticated_peer_hint",
            "unverified_hint",
            "local_only",
            "unknown",
            "rejected"
          ]
        },
        "claimed_sender": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_sender": {
          "type": [
            "string",
            "null"
          ]
        },
        "backing_action_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "trusted_state_mutation": {
          "type": "boolean"
        },
        "authorizes_operation": {
          "type": "boolean"
        },
        "record_author": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "verified_payload_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifier_build": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "callerOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "attempt_id",
        "outcome"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "acknowledged",
            "unknown",
            "committed",
            "not_committed",
            "rejected"
          ]
        }
      }
    },
    "grantIssuedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "grant_issued"
            },
            "data": {
              "$ref": "#/$defs/grantIssued"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "grantRevokedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "grant_revoked"
            },
            "data": {
              "$ref": "#/$defs/grantRevoked"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "claimAcceptedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "claim_accepted"
            },
            "data": {
              "$ref": "#/$defs/claimAccepted"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "hostCallEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "host_call"
            },
            "data": {
              "$ref": "#/$defs/hostCall"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "domainEffectEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "domain_effect"
            },
            "data": {
              "$ref": "#/$defs/domainEffect"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "projectionReadEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "projection_read"
            },
            "data": {
              "$ref": "#/$defs/projectionRead"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "remoteSignalEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "remote_signal"
            },
            "data": {
              "$ref": "#/$defs/remoteSignal"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "callerOutcomeEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "caller_outcome"
            },
            "data": {
              "$ref": "#/$defs/callerOutcome"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}

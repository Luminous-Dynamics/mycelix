{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/mycelix-workspace/mycelix-pulse/docs/security/privacy-negative-controls.schema.json",
  "title": "Pulse Privacy Negative Controls v1",
  "description": "A plan for synthetic privacy tests and harness-sensitivity controls. A valid catalog is not an executed test result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "review_date",
    "execution_status",
    "scope",
    "execution_rule",
    "controls"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "type": "string", "minLength": 1 },
    "review_date": { "type": "string", "format": "date" },
    "execution_status": { "const": "planned_not_executed" },
    "scope": { "type": "string", "minLength": 1 },
    "execution_rule": { "type": "string", "minLength": 1 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "inventory_refs",
        "category",
        "precondition",
        "injected_condition",
        "observer_vantage",
        "expected_secure_result",
        "harness_sensitivity_gate",
        "on_failure",
        "claim_limit",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PULSE-PRIV-NC-[0-9]{3}$"
        },
        "name": { "type": "string", "minLength": 1 },
        "inventory_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^PULSE-META-[0-9]{3}$"
          }
        },
        "category": { "type": "string", "minLength": 1 },
        "precondition": { "type": "string", "minLength": 1 },
        "injected_condition": { "type": "string", "minLength": 1 },
        "observer_vantage": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_secure_result": { "type": "string", "minLength": 1 },
        "harness_sensitivity_gate": { "type": "string", "minLength": 1 },
        "on_failure": { "type": "string", "minLength": 1 },
        "claim_limit": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "not_run",
            "queued",
            "running",
            "passed",
            "failed",
            "skipped",
            "unavailable"
          ]
        }
      }
    }
  }
}

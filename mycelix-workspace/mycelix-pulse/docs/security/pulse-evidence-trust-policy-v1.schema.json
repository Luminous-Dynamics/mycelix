{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pulse-evidence-trust-policy-v1.schema.json",
  "title": "Pulse evidence trust policy v1",
  "description": "Out-of-band trust policy supplied to the signed-evidence verifier. This schema validates syntax only; authenticity/currentness is established by a detached DSSE policy signature and a separately provisioned relying-party root pin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "policy_version",
    "root_keyset_id",
    "policy_epoch",
    "keys"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyid",
          "public_key_hex",
          "roles",
          "predicate_types",
          "status"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "public_key_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Ed25519 public key. This v1 local verifier supports Ed25519 only."
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "host_authority",
                "action_author",
                "validator",
                "observer",
                "client_outcome",
                "independent_auditor"
              ]
            }
          },
          "predicate_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "status": {
            "enum": [
              "active",
              "revoked",
              "suspended"
            ]
          },
          "subject_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conductor_id",
              "agent_key_ref",
              "dna_hash",
              "cell_id",
              "integrity_wasm_sha256"
            ],
            "properties": {
              "conductor_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "agent_key_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "dna_hash": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "cell_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "integrity_wasm_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "description": "Required for host_authority, action_author, validator, observer and client_outcome keys. Binds an issuer key to one exact agent-specific conductor/cell identity."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "roles": {
                  "contains": {
                    "enum": [
                      "host_authority",
                      "action_author",
                      "validator",
                      "observer",
                      "client_outcome"
                    ]
                  }
                }
              },
              "required": [
                "roles"
              ]
            },
            "then": {
              "required": [
                "subject_binding"
              ]
            }
          }
        ]
      }
    },
    "root_keyset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic policy epoch pinned and authenticated by the relying party; this file's authenticity is established by the detached root DSSE envelope, not by this schema."
    }
  }
}

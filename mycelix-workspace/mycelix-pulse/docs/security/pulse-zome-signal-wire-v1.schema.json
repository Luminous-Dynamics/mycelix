  "$defs": {
    "hash": {
      "type": "string",
      "format": "holochain-hash-base64url",
      "contentEncoding": "base64url",
      "minLength": 50,
      "maxLength": 60,
      "description": "Portable JSON representation of a Holochain ActionHash or AgentPubKey. In the decoded JavaScript signal object this is a 39-byte Uint8Array."
    },
    "bytes": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 1,
      "maxLength": 87384,
      "description": "Portable JSON representation of a bounded Rust Vec<u8>; decoded JavaScript value is Uint8Array."
    },
    "timestamp": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Holochain Timestamp in microseconds, represented as a safe JS integer."
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "errorText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trustLevel": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "recommendation": {
      "type": "number"
    },
    "emailPriority": {
      "type": "string",
      "enum": [
        "Low",
        "Normal",
        "High",
        "Urgent"
      ]
    },
    "trustCategory": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Identity",
            "Communication",
            "FileSharing",
            "Scheduling",
            "Financial",
            "CredentialIssuer",
            "Organization",
            "Personal",
            "Professional"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Custom"
          ],
          "properties": {
            "Custom": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "byzantineFlagType": {
      "type": "string",
      "enum": [
        "SybilSuspicion",
        "CollusionPattern",
        "TrustVolatility",
        "InconsistentAttestations",
        "SelfDealing",
        "AttestationFarming"
      ]
    },
    "conflictType": {
      "type": "string",
      "enum": [
        "ConcurrentEdit",
        "DeleteUpdate",
        "ConcurrentMove",
        "CausalityViolation",
        "VersionMismatch"
      ]
    },
    "syncOpType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "EmailReceived",
            "EmailRead",
            "EmailDeleted",
            "EmailMoved",
            "EmailFlagged",
            "EmailLabeled",
            "FolderCreated",
            "FolderRenamed",
            "FolderDeleted",
            "FolderMoved",
            "DraftCreated",
            "DraftUpdated",
            "DraftDeleted",
            "DraftSent",
            "SettingChanged",
            "FilterCreated",
            "FilterUpdated",
            "FilterDeleted",
            "TrustAttestationCreated",
            "TrustAttestationRevoked",
            "ContactCreated",
            "ContactUpdated",
            "ContactDeleted"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Custom"
          ],
          "properties": {
            "Custom": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "conflictResolution": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Pending",
            "Merged",
            "BothKept"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "AutoResolved"
          ],
          "properties": {
            "AutoResolved": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy"
              ],
              "properties": {
                "strategy": {
                  "$ref": "#/$defs/shortText"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "LastWriterWins"
          ],
          "properties": {
            "LastWriterWins": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "winner"
              ],
              "properties": {
                "winner": {
                  "$ref": "#/$defs/hash"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ManualResolution"
          ],
          "properties": {
            "ManualResolution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resolver"
              ],
              "properties": {
                "resolver": {
                  "$ref": "#/$defs/hash"
                }
              }
            }
          }
        }
      ]
    },
    "networkType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "HolochainNative",
            "SmtpBridge",
            "MatrixBridge",
            "ActivityPubBridge",
            "XmppBridge",
            "OrganizationPrivate",
            "PublicOpen"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CustomBridge"
          ],
          "properties": {
            "CustomBridge": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "protocol"
              ],
              "properties": {
                "protocol": {
                  "$ref": "#/$defs/shortText"
                }
              }
            }
          }
        }
      ]
    },
    "emailStateUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_read",
        "is_starred",
        "is_archived",
        "is_trashed",
        "folders"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pulse-trust-policy-root-envelope-v1.schema.json",
  "title": "Pulse trust-policy root signature envelope v1",
  "description": "Detached DSSE-style Ed25519 signature over exact trust-policy bytes. Signature verification must happen before parsing the policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_type",
    "payload_base64",
    "signatures"
  ],
  "properties": {
    "payload_type": {
      "const": "application/vnd.pulse-trust-policy+json;version=1"
    },
    "payload_base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyid",
          "sig_base64"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "sig_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      }
    }
  }
}

          "grant_ref": "grant-A",
          "attempt": 1,
          "note": "Create a host-enforced Assigned grant bound to one grantee and a bounded function set."
        },
        {
          "id": "e2",
          "order": 2,
          "actor": "grantee",
          "action": "invoke_allowed_function",
          "request_id": "call-01",
          "grant_ref": "grant-A",

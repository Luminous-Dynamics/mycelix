{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/pulse-qualification-evidence-ledger-v1.schema.json",
  "title": "Pulse Qualification Evidence Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "ledger_version",
    "updated_at",
    "repository",
    "research_pr",
    "claim_levels",
    "statuses",
    "evidence",
    "next_gates",
    "global_claim_ceiling"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ledger_id": {
      "const": "PULSE-QUALIFICATION-EVIDENCE-LEDGER-001"
    },
    "ledger_version": {
      "const": "1.0.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "repository": {
      "const": "Luminous-Dynamics/mycelix"
    },
    "research_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url",
        "branch",
        "state",
        "merge_readiness",
        "evidence_subject_sha",
        "ledger_preparation_parent_sha",
        "base_branch",
        "base_sha_at_pr",
        "main_sha_at_comparison",
        "divergence_at_comparison",
        "divergence_note"
      ],
      "properties": {
        "number": {
          "const": 5771
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "branch": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "merge_readiness": {
          "type": "string"
        },
        "evidence_subject_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ledger_preparation_parent_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_branch": {
          "type": "string"
        },
        "base_sha_at_pr": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "main_sha_at_comparison": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "divergence_at_comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ahead_by",
            "behind_by",
            "merge_base"
          ],
          "properties": {
            "ahead_by": {
              "type": "integer",
              "minimum": 0
            },
            "behind_by": {
              "type": "integer",
              "minimum": 0
            },
            "merge_base": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "divergence_note": {
          "type": "string"
        }
      }
    },
    "claim_levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "claim_level",
          "status",
          "claim_ceiling"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "claim_level": {
            "enum": [
              "SOURCE_PRESENT",
              "STATIC_OR_STRUCTURAL_CHECK",
              "UNIT_TEST",
              "BOUNDED_MODEL_CHECK",
              "SYNTHETIC_BENCHMARK",
              "CRYPTOGRAPHIC_SYNTHETIC_EVIDENCE",
              "RUNTIME_CAPTURE",
              "MULTI_CONDUCTOR_RUNTIME",
              "PRODUCTION_QUALIFICATION"
            ]
          },
          "status": {
            "enum": [
              "PASS_FOR_EXACT_SUBJECT",
              "HISTORICAL_PASS",
              "SOURCE_ONLY_UNQUALIFIED",
              "PENDING_NO_JOB_EVIDENCE",
              "ACTION_REQUIRED_NO_JOB_EVIDENCE",
              "INCOMPLETE_BY_DESIGN",
              "SELECTED_NOT_QUALIFIED",
              "OPEN_RUNTIME_GATE"
            ]
          },
          "subject_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 20
          },
          "source_path": {
            "type": "string"
          },
          "source_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "workflow_run": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "number": {
                "type": "integer"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "state": {
                "type": "string"
              },
              "conclusion": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "job_id": {
            "type": "integer"
          },
          "artifact": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "zip_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "build": {
                "type": "string"
              },
              "jar_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "result": {
            "type": "object"
          },
          "pull_request": {
            "type": "string",
            "format": "uri"
          },
          "issue": {
            "type": "string",
            "format": "uri"
          },
          "known_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profile_pr": {
            "type": "string",
            "format": "uri"
          },
          "qualification_issue": {
            "type": "string",
            "format": "uri"
          },
          "target_tuple_from_profile": {
            "type": "object"
          },
          "model_result_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "next_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "gate"
        ],
        "properties": {
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "gate": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "global_claim_ceiling": {
      "type": "string",
      "minLength": 20
    }
  }
}

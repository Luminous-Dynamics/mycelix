  "synthetic_scenarios": [
    {
      "id": "STAY-001",
      "name": "happy_path_composite_stay",
      "faults": [],
      "expected_aggregate_state": "confirmed",
      "required_invariants": [
        "all_mandatory_components_have_provider_commitments",
        "manifest_confirmation_derived_from_provider_receipts"
      ]
    },
    {
      "id": "STAY-002",
      "name": "stale_availability_snapshot",
      "faults": [
        "availability_snapshot_expired_before_hold"
      ],
      "expected_aggregate_state": "pending_or_failed",
      "required_invariants": [
        "stale_snapshot_never_creates_hold_or_commitment"
      ]
    },
    {
      "id": "STAY-003",
      "name": "hold_expires_before_commit",
      "faults": [
        "provider_hold_ttl_elapsed"
      ],
      "expected_aggregate_state": "expired",
      "required_invariants": [
        "expired_hold_cannot_be_revived_by_client"
      ]
    },
    {
      "id": "STAY-004",
      "name": "partial_commit_accommodation_declines",
      "faults": [
        "berth_committed",
        "accommodation_commit_rejected"
      ],
      "expected_aggregate_state": "partially_confirmed",
      "required_invariants": [
        "partial_success_is_visible",
        "no_false_confirmed_manifest",
        "compensation_requires_provider_terms"
      ]
    },
    {
      "id": "STAY-005",
      "name": "duplicate_commit_retry",
      "faults": [
        "response_timeout_after_provider_commit",
        "same_idempotency_key_retried"
      ],
      "expected_aggregate_state": "confirmed_once",
      "required_invariants": [
        "one_provider_effect_for_same_key_and_payload",
        "different_payload_with_same_key_is_conflict"
      ]
    },
    {
      "id": "STAY-006",
      "name": "last_berth_concurrent_race",
      "faults": [
        "two_requests_for_capacity_one_resource"
      ],
      "expected_aggregate_state": "one_confirmed_one_rejected",
      "required_invariants": [
        "provider_capacity_never_overcommitted"
      ]
    },
    {
      "id": "STAY-007",
      "name": "provider_network_partition",
      "faults": [
        "provider_unreachable_after_commit_request"
      ],
      "expected_aggregate_state": "unknown_or_pending",
      "required_invariants": [
        "timeout_is_not_success_or_failure",
        "no_confirmed_manifest_without_receipt"
      ]
    },
    {
      "id": "STAY-008",
      "name": "provider_restart_and_reconciliation",
      "faults": [
        "provider_restart",
        "client_reconnects"
      ],
      "expected_aggregate_state": "reconciled_from_provider_receipt",
      "required_invariants": [
        "replay_is_idempotent",
        "provider_revision_and_receipt_identity_preserved"
      ]
    },
    {
      "id": "STAY-009",
      "name": "weather_closure_cancels_berth",
      "faults": [
        "provider_declares_weather_closure"
      ],
      "expected_aggregate_state": "partially_cancelled_or_cancelled",
      "required_invariants": [
        "provider_closure_not_bypassed_by_reciprocity",
        "route_safety_is_not_inferred_from_booking"
      ]
    },
    {
      "id": "STAY-010",
      "name": "vessel_dimensions_incompatible",
      "faults": [
        "vessel_draft_exceeds_offer_limit"
      ],
      "expected_aggregate_state": "infeasible",
      "required_invariants": [
        "incompatible_berth_never_confirmed",
        "missing_dimensions_remain_unknown"
      ]
    },
    {
      "id": "STAY-011",
      "name": "accessibility_constraint_no_match",
      "faults": [
        "required_accessibility_feature_unavailable"
      ],
      "expected_aggregate_state": "infeasible_or_needs_alternative",
      "required_invariants": [
        "accessibility_requirement_not_silently_dropped"
      ]
    },
    {
      "id": "STAY-012",
      "name": "destination_visitor_capacity_reached",
      "faults": [
        "policy_capacity_at_hard_limit"
      ],
      "expected_aggregate_state": "blocked_by_policy",
      "required_invariants": [
        "hard_policy_limit_not_optimizable_away"
      ]
    },
    {
      "id": "STAY-013",
      "name": "reciprocity_entitlement_revoked",
      "faults": [
        "entitlement_revoked_before_hold"
      ],
      "expected_aggregate_state": "price_requoted_or_rejected",
      "required_invariants": [
        "revoked_entitlement_not_applied_to_new_commitment"
      ]
    },
    {
      "id": "STAY-014",
      "name": "cancel_and_refund_reconciliation",
      "faults": [
        "cancellation_requested",
        "refund_effect_delayed"
      ],
      "expected_aggregate_state": "partially_cancelled_or_unknown_until_receipt",
      "required_invariants": [
        "refund_not_assumed_from_cancel_request",
        "financial_effects_idempotent"
      ]
    },
    {
      "id": "STAY-015",
      "name": "mandatory_fee_arithmetic",
      "faults": [
        "provider_quotes_multiple_fee_lines"
      ],
      "expected_aggregate_state": "confirmed_only_if_totals_reconcile",
      "required_invariants": [
        "integer_minor_unit_arithmetic",
        "all_mandatory_fees_disclosed_before_acceptance"
      ]
    },
    {
      "id": "STAY-016",
      "name": "private_itinerary_data_leak",
      "faults": [
        "public_projection_attempts_to_publish_exact_travel_plan"
      ],
      "expected_aggregate_state": "rejected_by_privacy_policy",
      "required_invariants": [
        "no_default_public_live_location_or_home_address",
        "selective_disclosure_is_purpose_bound"
      ]
    },
    {
      "id": "STAY-017",
      "name": "provider_revision_conflict",
      "faults": [
        "new_offer_revision_supersedes_cached_revision"
      ],
      "expected_aggregate_state": "needs_reconciliation",
      "required_invariants": [
        "superseded_revision_not_confirmed",
        "revision_lineage_preserved"
      ]
    },
    {
      "id": "STAY-018",
      "name": "sensitive_ecological_zone",
      "faults": [
        "resource_offer_intersects_policy_exclusion"

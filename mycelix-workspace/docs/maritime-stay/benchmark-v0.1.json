  "comparison_baselines": [
    {
      "id": "baseline:manual-siloed",
      "name": "Manual and siloed",
      "description": "Separate provider calls, email/phone coordination and independent bookings; operator records completion."
    },
    {
      "id": "baseline:berth-only",
      "name": "Berth booking only",
      "description": "Marina reservation confirmed without accommodation or shore-service composition."
    },
    {
      "id": "baseline:accommodation-only",
      "name": "Accommodation marketplace only",
      "description": "Accommodation is booked independently; berth and shore services remain outside the workflow."
    },
    {
      "id": "baseline:central-aggregator",
      "name": "Centralized aggregator",
      "description": "One coordinator owns a consolidated inventory projection and orchestrates provider confirmations."
    },
    {
      "id": "baseline:federated-provider-owned",
      "name": "Federated provider-owned protocol",
      "description": "Each provider retains source-of-truth inventory and issues its own holds, commitments and receipts; aggregate manifest is independently verified."
    }
  ],

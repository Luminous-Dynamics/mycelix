{"schema":"mycelix:web-attempt-lease-state-machine-corpus:v0.1","tracks_issue":2717,"parent_b1_product_head":"e36f65a4b90de6c9eb70bfe3404b510d991f6f4b","lease_profile":"mycelix:web-attempt-lease:v1","time_profile":"mycelix:web-attempt-lease-time:wall-clock-assertion:v1","authority_key_fields":["admission_commitment","attempt_id","execution_profile_id"],"states":["Absent","Prepared","Leased","Started","FinishedSuccess","FinishedFailure","AbortedBeforeStart","IndeterminateAfterCrash"],"terminal_states":["FinishedSuccess","FinishedFailure","AbortedBeforeStart","IndeterminateAfterCrash"],"safety_invariants":["a non-Clone process-local value is not persistent single-use authority","at most one active lease epoch may be current for an authority key","socket authority is emitted only after durable Started transition succeeds","Leased may be replaced after expiry only when no Started transition exists","Started never returns to Prepared or Leased under v1","wall-clock error may affect liveness but stale epoch/holder/lease token checks preserve no-double-start safety","failed or indeterminate network attempts remain consumed","terminal history cannot be rewritten by a different terminal outcome","storage errors and corruption fail closed","attempt_id alone is not the authority identity"],"cases":[{"id":"prepare-fresh","pre_state":"Absent","operation":{"kind":"ensure_prepared"},"result":{"kind":"Applied","post_state":"Prepared","epoch":0},"safety":"creates authority record but emits no lease token"},{"id":"prepare-idempotent-existing","pre_state":"Prepared(epoch=0)","operation":{"kind":"ensure_prepared"},"result":{"kind":"NoOp","post_state":"Prepared","epoch":0},"safety":"idempotent preparation does not mint a second authority"},{"id":"acquire-first-lease","pre_state":"Prepared(epoch=0)","operation":{"kind":"acquire_lease","holder":"H1","lease_id":"L1","issued_at_ms":1000,"expires_at_ms":2000},"result":{"kind":"Applied","post_state":"Leased","lease_epoch":1},"safety":"exactly one active lease token for epoch 1"},{"id":"concurrent-second-acquire-rejected","pre_state":"Leased(holder=H1,lease=L1,epoch=1)","operation":{"kind":"acquire_lease","holder":"H2","lease_id":"L2","issued_at_ms":1001,"expires_at_ms":2001},"result":{"kind":"Rejected","reason":"NotPreparedOrExpiredLease"},"safety":"persistence-level CAS must prevent double lease"},{"id":"start-valid-token","pre_state":"Leased(holder=H1,lease=L1,epoch=1)","operation":{"kind":"mark_started","holder":"H1","lease_id":"L1","lease_epoch":1,"started_at_ms":1100},"result":{"kind":"Applied","post_state":"Started","lease_epoch":1},"safety":"socket authority begins only after this durable transition succeeds"},{"id":"start-stale-holder-rejected","pre_state":"Leased(holder=H1,lease=L1,epoch=1)","operation":{"kind":"mark_started","holder":"H2","lease_id":"L1","lease_epoch":1,"started_at_ms":1100},"result":{"kind":"Rejected","reason":"LeaseTokenMismatch"},"safety":"holder substitution cannot start"},{"id":"start-stale-lease-id-rejected","pre_state":"Leased(holder=H1,lease=L1,epoch=1)","operation":{"kind":"mark_started","holder":"H1","lease_id":"L0","lease_epoch":1,"started_at_ms":1100},"result":{"kind":"Rejected","reason":"LeaseTokenMismatch"},"safety":"lease id substitution cannot start"},{"id":"start-stale-epoch-rejected","pre_state":"Leased(holder=H1,lease=L1,epoch=2)","operation":{"kind":"mark_started","holder":"H1","lease_id":"L1","lease_epoch":1,"started_at_ms":1100},"result":{"kind":"Rejected","reason":"LeaseTokenMismatch"},"safety":"old epoch token cannot start"},{"id":"finish-success","pre_state":"Started(holder=H1,lease=L1,epoch=1)","operation":{"kind":"finish_success","holder":"H1","lease_id":"L1","lease_epoch":1,"outcome_ref":"tcp-observation:success:A"},"result":{"kind":"Applied","post_state":"FinishedSuccess"},"safety":"terminal; never re-leasable"},{"id":"finish-failure","pre_state":"Started(holder=H1,lease=L1,epoch=1)","operation":{"kind":"finish_failure","holder":"H1","lease_id":"L1","lease_epoch":1,"outcome_ref":"tcp-observation:failure:A"},"result":{"kind":"Applied","post_state":"FinishedFailure"},"safety":"failed network attempt remains consumed"},{"id":"abort-before-start","pre_state":"Leased(holder=H1,lease=L1,epoch=1)","operation":{"kind":"abort_before_start","holder":"H1","lease_id":"L1","lease_epoch":1,"reason_ref":"operator-cancel:A"},"result":{"kind":"Applied","post_state":"AbortedBeforeStart"},"safety":"explicit abort is terminal; retry needs a new attempt lineage"},{"id":"expired-lease-reacquire","pre_state":"Leased(holder=H1,lease=L1,epoch=1,expires_at_ms=2000)","operation":{"kind":"reacquire_expired_lease","observed_now_ms":2000,"holder":"H2","lease_id":"L2","issued_at_ms":2000,"expires_at_ms":3000},"result":{"kind":"Applied","post_state":"Leased","lease_epoch":2},"safety":"recovery allowed only because no Started state exists"},{"id":"expired-lease-cannot-start","pre_state":"Leased(holder=H1,lease=L1,epoch=1,expires_at_ms=2000)","operation":{"kind":"mark_started","holder":"H1","lease_id":"L1","lease_epoch":1,"started_at_ms":2000},"result":{"kind":"Rejected","reason":"LeaseExpired"},"safety":"an expired holder cannot begin a network side effect even if no replacement lease has yet been acquired"},{"id":"old-token-after-reacquire-rejected","pre_state":"Leased(holder=H2,lease=L2,epoch=2)","operation":{"kind":"mark_started","holder":"H1","lease_id":"L1","lease_epoch":1,"started_at_ms":2100},"result":{"kind":"Rejected","reason":"LeaseTokenMismatch"},"safety":"clock-forward premature expiry cannot let old holder start later"},{"id":"forward-clock-safe","pre_state":"Leased(holder=H1,lease=L1,epoch=1,expires_at_ms=2000)","operation":{"kind":"reacquire_expired_lease","observed_now_ms":9000000,"holder":"H2","lease_id":"L2","issued_at_ms":9000000,"expires_at_ms":9001000},"result":{"kind":"Applied","post_state":"Leased","lease_epoch":2},"safety":"bad forward wall clock can hurt liveness/fairness but stale token CAS preserves no-double-start safety"},{"id":"rollback-clock-delays-recovery","pre_state":"Leased(holder=H1,lease=L1,epoch=1,expires_at_ms=2000)","operation":{"kind":"reacquire_expired_lease","observed_now_ms":1500,"holder":"H2","lease_id":"L2","issued_at_ms":1500,"expires_at_ms":2500},"result":{"kind":"Rejected","reason":"LeaseNotExpiredUnderNamedTimeProfile"},"safety":"clock rollback delays recovery; it cannot resurrect or duplicate authority"},{"id":"started-never-reacquires-after-expiry","pre_state":"Started(holder=H1,lease=L1,epoch=1,started_at_ms=1100)","operation":{"kind":"reacquire_expired_lease","observed_now_ms":9999999,"holder":"H2","lease_id":"L2","issued_at_ms":9999999,"expires_at_ms":10000999},"result":{"kind":"Rejected","reason":"StartedIsConsumed"},"safety":"wall-clock expiry never resets Started"},{"id":"started-crash-becomes-indeterminate","pre_state":"Started(holder=H1,lease=L1,epoch=1)","operation":{"kind":"recover_after_crash","recovery_ref":"worker-recovery:A"},"result":{"kind":"Applied","post_state":"IndeterminateAfterCrash"},"safety":"ambiguous post-start crash is terminal under v1"},{"id":"indeterminate-never-reacquires","pre_state":"IndeterminateAfterCrash(epoch=1)","operation":{"kind":"reacquire_expired_lease","observed_now_ms":9999999,"holder":"H2","lease_id":"L2","issued_at_ms":9999999,"expires_at_ms":10000999},"result":{"kind":"Rejected","reason":"TerminalState"},"safety":"manual recovery needs separately named authority"},{"id":"terminal-finish-idempotent-same-outcome","pre_state":"FinishedFailure(outcome_ref=tcp-observation:failure:A)","operation":{"kind":"finish_failure","holder":"H1","lease_id":"L1","lease_epoch":1,"outcome_ref":"tcp-observation:failure:A"},"result":{"kind":"NoOp","post_state":"FinishedFailure"},"safety":"persistence retry may be idempotent for exactly the same terminal evidence"},{"id":"terminal-finish-conflict-rejected","pre_state":"FinishedFailure(outcome_ref=tcp-observation:failure:A)","operation":{"kind":"finish_success","holder":"H1","lease_id":"L1","lease_epoch":1,"outcome_ref":"tcp-observation:success:B"},"result":{"kind":"Rejected","reason":"TerminalOutcomeConflict"},"safety":"later write cannot rewrite history"},{"id":"prepare-after-terminal-does-not-reset","pre_state":"FinishedSuccess(outcome_ref=tcp-observation:success:A)","operation":{"kind":"ensure_prepared"},"result":{"kind":"NoOp","post_state":"FinishedSuccess"},"safety":"prepare is idempotent, not a reset primitive"},{"id":"same-attempt-different-commitment-distinct-key","pre_state":"Record(key=commitment:A,attempt=X,profile=P)","operation":{"kind":"derive_authority_key","admission_commitment":"B","attempt_id":"X","execution_profile":"P"},"result":{"kind":"DistinctAuthorityKey"},"safety":"attempt id alone is not the authority identity"},{"id":"same-commitment-different-attempt-distinct-key","pre_state":"Record(key=commitment:A,attempt=X,profile=P)","operation":{"kind":"derive_authority_key","admission_commitment":"A","attempt_id":"Y","execution_profile":"P"},"result":{"kind":"DistinctAuthorityKey"},"safety":"new explicit acquisition attempt has distinct authority lineage"},{"id":"same-commitment-attempt-different-profile-distinct-key","pre_state":"Record(key=commitment:A,attempt=X,profile=P1)","operation":{"kind":"derive_authority_key","admission_commitment":"A","attempt_id":"X","execution_profile":"P2"},"result":{"kind":"DistinctAuthorityKey"},"safety":"execution profile substitution cannot reuse a lease"},{"id":"storage-error-on-start-fails-closed","pre_state":"Leased(holder=H1,lease=L1,epoch=1)","operation":{"kind":"mark_started","simulated_store_result":"IoError"},"result":{"kind":"Error","socket_authority_emitted":false},"safety":"no successful durable Started transition means no socket operation"},{"id":"corrupt-record-fails-closed","pre_state":"CorruptOrUnparseable","operation":{"kind":"acquire_lease","holder":"H1","lease_id":"L1"},"result":{"kind":"Error","lease_token_emitted":false},"safety":"corruption cannot reset or mint authority"}]}

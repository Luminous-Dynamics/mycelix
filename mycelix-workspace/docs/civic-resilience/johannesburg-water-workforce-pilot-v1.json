          "repair performed",
          "problem resolved"
        ]
      },
      {
        "state": "RepairClaimed",
        "meaning": "An identified actor claims repair/work completion",
        "does_not_imply": [
          "independent verification",
          "external case closure",
          "restored service"
        ]
      },
      {
        "state": "IndependentlyVerified",
        "meaning": "A suitably independent verifier recorded a bounded check and evidence",
        "does_not_imply": [
          "utility's authoritative status updated",
          "universal service restored beyond verified scope"
        ]
      },
      {
        "state": "ExternalStatusObserved",
        "meaning": "A status was observed from an identified external issuer/channel at a timestamp",
        "does_not_imply": [
          "status remains current",
          "same status applies to another source reference"
        ]
      },
      {
        "state": "ReopenedOrDisputed",
        "meaning": "Contradictory evidence, repeat fault, or correction requires renewed review",
        "does_not_imply": [
          "original evidence deleted"
        ]
      }
    ],

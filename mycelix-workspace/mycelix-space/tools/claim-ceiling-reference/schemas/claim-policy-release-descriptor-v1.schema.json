{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.luminousdynamics.io/schemas/claim-policy-release-descriptor-v1.schema.json",
  "title": "Mycelix Claim Policy Release Descriptor V1",
  "description": "Application metadata carried in an authenticated policy-distribution target. This schema does not authenticate the target or verify signatures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "audience",
    "version",
    "revocation_epoch",
    "target_profile_sha256",
    "policy_profile_schema_sha256",
    "issued_at_unix_seconds",
    "expires_at_unix_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix.claim-policy-release-descriptor.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "target_profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_profile_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issued_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_unix_seconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}

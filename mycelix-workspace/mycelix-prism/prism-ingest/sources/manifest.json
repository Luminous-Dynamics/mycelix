      "authority": "WikipediaSummary",
      "endpoint": "https://en.wikipedia.org/api/rest_v1/page/summary/{title-segment}",
      "method": "GET",
      "request_headers": [],
      "request_body_bytes": 0,
      "redirects": "deny",
      "success_body_limit_bytes": 2097152,
      "error_body_limit_bytes": 65536,
      "timeout_seconds": 10,
      "provenance": "Wikipedia page summary REST API; each claim records the article title in its source field"
    },

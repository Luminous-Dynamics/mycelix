{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/south-african-payment-interop-v1.schema.json",
  "title": "Mycelix South African Payments Interoperability Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "status",
    "created_on",
    "as_of",
    "jurisdiction",
    "purpose",
    "profile_rule",
    "external_effects_enabled",
    "source_register",
    "systems",
    "scenarios",
    "function_allocation",
    "milestones"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.sa-payments-interop/v1"
    },
    "corpus_id": {
      "const": "ZA-SA-PAYMENTS-SYNTHETIC-V1"
    },
    "status": {
      "const": "synthetic_reference_only"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "const": "ZA"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "profile_rule": {
      "type": "string",
      "minLength": 1
    },
    "external_effects_enabled": {
      "const": false
    },
    "source_register": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "systems": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "function_allocation": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/function_allocation"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "title",
        "url",
        "observed_on",
        "evidence_class",
        "supports",
        "does_not_support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_on": {
          "type": "string",
          "format": "date"
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "does_not_support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "name",
        "lifecycle_state",
        "scope",
        "evidence_refs",
        "confirmed_claims",
        "unknowns",
        "adapter_admission_requirements"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_state": {
          "enum": [
            "current",
            "transitioning",
            "planned_or_in_development",
            "programme_enabler"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "confirmed_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adapter_admission_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "condition",
        "event_sequence",
        "expected_disposition",
        "dispatch_decision",
        "expected_financial_effect",
        "required_evidence",
        "negative_controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SA-PAY-[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "event_sequence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_disposition": {
          "enum": [
            "reject_before_dispatch",
            "require_authority_evidence",
            "quarantine_or_reject",
            "observe_without_finality",
            "profile_requalification_required",
            "resolve_existing_operation",
            "indeterminate_no_blind_retry",
            "append_successor_event",
            "privacy_reject_or_redact",
            "require_authority_evidence",
            "profile_requalification_required"
          ]
        },
        "dispatch_decision": {
          "enum": [
            "deny",
            "hold_for_evidence",
            "eligible_only_under_profile"
          ]
        },
        "expected_financial_effect": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "function_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organisation",
        "effective_on",
        "functions",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "organisation": {
          "type": "string",
          "minLength": 1
        },
        "effective_on": {
          "type": "string",
          "format": "date"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "initiative",
        "status",
        "source_refs",
        "observed_on",
        "description",
        "completion_evidence_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SA-MILESTONE-[0-9]{3}$"
        },
        "initiative": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed_at_source",
            "announced_target"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "completion_evidence_required": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_by": {
          "type": "string",
          "format": "date"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "target_window": {
          "type": "string",
          "minLength": 1
        },
        "target_start": {
          "type": "string",
          "format": "date"
        },
        "target_end": {
          "type": "string",
          "format": "date"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "completed_at_source"
            }
          },
          "required": [
            "effective_from",
            "effective_by",
            "outcome"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "announced_target"
            }
          },
          "required": [
            "target_window",
            "target_start",
            "target_end"
          ]
        }
      ]
    }
  }
}

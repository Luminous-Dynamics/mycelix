{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/sa-payment-rtp-corpus-v1.schema.json",
  "title": "Mycelix South African Request-to-Pay Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "status",
    "created_on",
    "as_of",
    "jurisdiction",
    "purpose",
    "external_effects_enabled",
    "source_register",
    "profiles",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "mycelix.sa-payment-rtp/v1"
    },
    "corpus_id": {
      "const": "ZA-SA-PAYMENT-RTP-SYNTHETIC-V1"
    },
    "status": {
      "const": "synthetic_reference_only"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "const": "ZA"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "external_effects_enabled": {
      "const": false
    },
    "source_register": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 24,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "title",
        "url",
        "observed_on",
        "evidence_class",
        "supports",
        "does_not_support"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "does_not_support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "jurisdiction",
        "service",
        "participant",
        "product_scope",
        "channel_scope",
        "profile_version",
        "observed_on",
        "effective_from",
        "effective_to",
        "temporal_state",
        "max_request_minor_units",
        "max_requests_per_24h",
        "max_combined_request_minor_units_per_24h",
        "fee_state",
        "fee_note",
        "source_refs",
        "admission"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+-V1$"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 2
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "participant": {
          "type": "string",
          "minLength": 1
        },
        "product_scope": {
          "type": "string",
          "minLength": 1
        },
        "channel_scope": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "temporal_state": {
          "type": "string",
          "minLength": 1
        },
        "max_request_minor_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_requests_per_24h": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_combined_request_minor_units_per_24h": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fee_state": {
          "type": "string",
          "minLength": 1
        },
        "fee_note": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "admission": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_version",
        "profile_id",
        "requester_identity",
        "payer_identity",
        "beneficiary_identity",
        "amount_minor_units",
        "currency",
        "reference",
        "purpose",
        "fee_minor_units",
        "expiry_at",
        "issued_at",
        "channel",
        "request_digest"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "request_version": {
          "type": "integer",
          "minimum": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "requester_identity": {
          "type": "string",
          "minLength": 1
        },
        "payer_identity": {
          "type": "string",
          "minLength": 1
        },
        "beneficiary_identity": {
          "type": "string",
          "minLength": 1
        },
        "amount_minor_units": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "fee_minor_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "expiry_at": {
          "type": "string",
          "format": "date-time"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "event_type",
        "actor_role",
        "authority_state",
        "request_digest",
        "accepted_request_digest",
        "instruction_id",
        "observed_at",
        "receipt_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EV-[0-9]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "enum": [
            "requester",
            "payer",
            "payer_psp",
            "payee_psp",
            "beneficiary_psp",
            "system",
            "merchant",
            "unknown"
          ]
        },
        "authority_state": {
          "enum": [
            "valid",
            "invalid",
            "unknown",
            "not_applicable"
          ]
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "accepted_request_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "instruction_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_type",
        "request",
        "events",
        "expected_outcome",
        "expected_financial_effect",
        "required_evidence",
        "negative_controls"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^SA-RTP-[0-9]{3}$"
        },
        "scenario_type": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "expected_outcome": {
          "enum": [
            "request_only",
            "declined",
            "expired",
            "cancelled",
            "instruction_created",
            "outcome_unknown",
            "recipient_available",
            "rejected_by_limit",
            "rejected_by_profile",
            "quarantined_for_requalification"
          ]
        },
        "expected_financial_effect": {
          "enum": [
            "none",
            "payment_instruction_only",
            "recipient_available_observed"
          ]
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

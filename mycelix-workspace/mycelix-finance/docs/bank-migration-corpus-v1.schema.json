{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/bank-migration-corpus-v1.schema.json",
  "title": "Mycelix Synthetic Bank Migration Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "status",
    "currency_representation",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix.bank-migration-corpus.v1"
    },
    "corpus_id": {
      "const": "BANK-MIGRATION-SYNTHETIC-V1"
    },
    "status": {
      "const": "synthetic_reference_only"
    },
    "currency_representation": {
      "const": "integer_minor_units"
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "input",
        "expected",
        "controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BM-[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        },
        "expected": {
          "type": "string",
          "enum": [
            "accept_import_and_reconcile",
            "idempotent_no_second_effect",
            "quarantine_conflict",
            "indeterminate_incomplete_scope",
            "append_correction_and_reconcile",
            "reject_instrument_substitution",
            "quarantine_unknown_status",
            "reject_semantic_promotion",
            "reject_scope_substitution",
            "rollback_permitted",
            "indeterminate_no_blind_retry",
            "indeterminate_temporal_scope"
          ]
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

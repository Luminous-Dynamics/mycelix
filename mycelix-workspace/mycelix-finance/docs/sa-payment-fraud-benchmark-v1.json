  "metric_definitions": [
    {
      "metric_id": "FRAUD_TRANSACTIONS_PER_PAYMENT",
      "numerator": "independently_confirmed_fraud_payment_count",
      "denominator": "recipient_available_payment_count",
      "unit": "ratio",
      "must_report_by": [
        "count",
        "value",
        "instrument",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "FRAUD_LOSS_BASIS_POINTS",
      "numerator": "confirmed_fraud_loss_minor_units",
      "denominator": "total_recipient_available_value_minor_units",
      "unit": "basis_points",
      "must_report_by": [
        "count",
        "value",
        "instrument",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "PRECISION_AT_REVIEW_CAPACITY",
      "numerator": "confirmed_fraud_cases_within_review_queue",
      "denominator": "all_reviewed_alerts_within_fixed_capacity",
      "unit": "ratio",
      "must_report_by": [
        "review_capacity",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "RECALL_AT_FIXED_FALSE_POSITIVE_RATE",
      "numerator": "confirmed_fraud_cases_detected",
      "denominator": "all_confirmed_fraud_cases",
      "unit": "ratio",
      "must_report_by": [
        "fixed_fpr",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "VALUE_WEIGHTED_RECALL",
      "numerator": "confirmed_fraud_value_flagged_before_effect",
      "denominator": "total_confirmed_fraud_value",
      "unit": "ratio",
      "must_report_by": [
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "VALUE_REIMBURSEMENT_RATE",
      "numerator": "actually_reimbursed_or_recovered_minor_units",
      "denominator": "eligible_claim_value_minor_units",
      "unit": "ratio",
      "must_report_by": [
        "eligibility_policy_version",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "RESIDUAL_CUSTOMER_LOSS",
      "numerator": "eligible_confirmed_loss_minor_units_minus_recovered_minor_units",
      "denominator": "eligible_confirmed_loss_minor_units",
      "unit": "ratio",
      "must_report_by": [
        "eligibility_policy_version",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "FALSE_POSITIVE_APPEAL_REVERSAL_RATE",
      "numerator": "appeals_upheld_or_blocks_reversed",
      "denominator": "appeals_concluded",
      "unit": "ratio",
      "must_report_by": [
        "merchant_size",
        "formality",
        "accessibility_modality",
        "cohort"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "DECISION_LATENCY_P95",
      "numerator": "95th_percentile_decision_latency",
      "denominator": "not_applicable",
      "unit": "milliseconds",
      "must_report_by": [
        "decision_stage",
        "hardware_profile",
        "cohort"
      ],
      "label_window_required": false
    },
    {
      "metric_id": "CASE_DISPOSITION_TIME_P95",
      "numerator": "95th_percentile_report_to_disposition_time",
      "denominator": "not_applicable",
      "unit": "hours",
      "must_report_by": [
        "eligible_case_type",
        "cohort",
        "time_window"
      ],
      "label_window_required": false
    },
    {
      "metric_id": "AUTOMATED_DECISION_COVERAGE",
      "numerator": "eligible_decision_opportunities_resolved_automatically_without_abstention",
      "denominator": "all_eligible_automated_decision_opportunities",
      "unit": "ratio",
      "must_report_by": [
        "coverage_threshold",
        "language_id",
        "accessibility_modality",
        "merchant_size",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "SELECTIVE_RISK_AT_FIXED_COVERAGE",
      "numerator": "incorrect_or_unsupported_automated_decisions_at_fixed_coverage",
      "denominator": "all_non_abstained_automated_decisions_at_fixed_coverage",
      "unit": "ratio",
      "must_report_by": [
        "fixed_coverage",
        "language_id",
        "accessibility_modality",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    },
    {
      "metric_id": "COUNTERFACTUAL_EQUIVALENCE_CONSISTENCY",
      "numerator": "adjudicated_equivalent_pairs_with_consistent_safe_dispositions",
      "denominator": "all_adjudicated_equivalent_counterfactual_pairs",
      "unit": "ratio",
      "must_report_by": [
        "pair_class",
        "language_id",
        "accessibility_modality",
        "cohort"
      ],
      "label_window_required": false
    },
    {
      "metric_id": "MATERIAL_CHANGE_RECONFIRMATION_SENSITIVITY",
      "numerator": "material_change_pairs_that_invalidate_prior_acceptance_or_require_new_confirmation",
      "denominator": "all_adjudicated_material_change_pairs",
      "unit": "ratio",
      "must_report_by": [
        "material_field",
        "language_id",
        "accessibility_modality",
        "cohort"
      ],
      "label_window_required": false
    },
    {
      "metric_id": "SUBGROUP_CALIBRATION_ERROR",
      "numerator": "expected_calibration_error_for_the_named_subgroup",
      "denominator": "not_applicable",
      "unit": "basis_points",
      "must_report_by": [
        "language_id",
        "accessibility_modality",
        "merchant_size",
        "cohort",
        "time_window"
      ],
      "label_window_required": true
    }
  ],
  "evaluation_contract": {
    "temporal_cutoff_required": true,
    "time_split_required": true,
    "entity_grouped_holdout_required": true,
    "random_row_split_only_prohibited": true,
    "feature_leakage_after_outcome_prohibited": true,
    "freeze_policy_and_label_versions": true,
    "unresolved_and_unlabelled_cases_retained": true,
    "cross_jurisdiction_transfer_claims_prohibited": true,
    "single_composite_score_prohibited": true,
    "default_raw_cross_participant_pii_exchange": false,
    "model_baselines": [
      "rules_only",
      "calibrated_tabular",
      "temporal_sequence",
      "temporal_graph",
      "privacy_preserving_federated_graph",
      "human_review_workflow"
    ],
    "group_keys": [
      "account",
      "requester",
      "merchant",
      "credential_or_device",
      "campaign"
    ],
    "prevalence_stress_basis_points": [

      1,
      2,
      5,
      10,
      39,
      100
    ],
    "provisional_hot_path_p99_target_ms": 100,
    "provisional_latency_target_claim_ceiling": "engineering target only; not a South African scheme SLA or a legal requirement",
    "required_subgroup_dimensions": [
      "merchant_size",
      "merchant_formality",
      "payer_channel",
      "accessibility_modality",
      "new_vs_known_payee",
      "participant",
      "payment_amount_band",
      "language_id"
    ],
    "no_live_provider_data": true,
    "no_production_deployment_claim": true,
    "selective_prediction_required": true,
    "selective_prediction_stress_coverage_basis_points": [
      5000,
      7500,
      9000,
      9500
    ],
    "abstention_actions": [
      "human_review",
      "request_additional_evidence",
      "warning_with_payer_choice_preserved"
    ],
    "counterfactual_equivalence_tests_required": true,
    "material_change_reconfirmation_tests_required": true,
    "language_and_modality_stratification_required": true,
    "native_language_adjudication_required": true,
    "distinct_sign_language_presentation_required": true,
    "no_language_performance_claim_without_adjudicated_holdout": true,

{
  "schema": "mycelix.sa-payment-fraud-benchmark/v1",
  "manifest_id": "ZA-SA-PAYMENT-FRAUD-BENCHMARK-V1",
  "status": "benchmark_protocol_and_public_comparators",
  "as_of": "2026-11-04",
  "jurisdiction": "ZA",
  "external_effects_enabled": false,
  "purpose": "Define a denominator-safe, privacy-preserving evaluation protocol for South African instant-payment/RTP risk controls and their downstream customer outcomes.",
  "sources": [
    {
      "id": "OPEN_BANKING_FRAUD_MONITOR_2026",
      "authority": "Open Banking Ltd (UK)",
      "title": "Open Banking Payments Fraud Monitor – June 2026 Edition",
      "url": "https://www.openbanking.org.uk/insights/open-banking-payments-fraud-monitor-june-2026-edition/",
      "published_on": "2026-07-08",
      "observed_on": "2026-11-04",
      "evidence_class": "industry_aggregate_fraud_monitor",
      "supports": [
        "For 2025, the monitor reports around one fraudulent Open Banking payment per 6,000 Open Banking payments, compared with about one per 2,500 across the wider UK payments industry.",
        "APP fraud accounted for more than two-thirds of reported Open Banking-related fraud cases.",
        "The monitor includes account providers representing more than 60% of Open Banking payment volume.",
        "The report says app-authenticated journeys and variable recurring payments show lower fraud rates than browser-authenticated journeys and single immediate payments."
      ],
      "does_not_support": [
        "A South African PayShap/PayShap Request fraud rate.",
        "A request-level spam rate or merchant-level false-positive rate.",
        "A direct comparison with synthetic data or a different payment-product mix."
      ]
    },
    {
      "id": "PSR_APP_REIMBURSEMENT_DASHBOARD_Q1_2026",
      "authority": "UK Payment Systems Regulator",
      "title": "APP scams reimbursement dashboard for Q1 2026",
      "url": "https://www.psr.org.uk/information-for-consumers/app-scams-reimbursement-dashboard/",
      "published_on": "2026-07-30",
      "observed_on": "2026-11-04",
      "evidence_class": "regulator_reimbursement_and_case_outcome_aggregate",
      "supports": [
        "For 7 October 2024 to 31 March 2026, the PSR reports 88% (£316m) of APP scam losses within the in-scope population reimbursed.",
        "The PSR reports 438,300 claims reported and 301,500 in scope during that 18-month period.",
        "It reports 82% of claims closed within five business days and 98% within 35 business days.",
        "The closure-time metric includes claims reimbursed and claims rejected as outside policy definitions."
      ],
      "does_not_support": [
        "An 88% reimbursement rate across all reported claims or all payment types.",
        "A South African statutory or scheme reimbursement obligation.",
        "A claim that all cases must be resolved within five days."
      ]
    },
    {
      "id": "PAYUK_APP_REIMBURSEMENT_POLICY",
      "authority": "Pay.UK",
      "title": "APP Authorised Push Payment Reimbursement Policy",
      "url": "https://www.wearepay.uk/app-authorised-push-payment-reimbursement-policy/",
      "published_on": null,
      "observed_on": "2026-11-04",
      "evidence_class": "official_scheme_operator_reimbursement_policy",
      "supports": [
        "In-scope Faster Payments PSPs are required to reimburse eligible APP fraud victims within five working days.",
        "Receiving PSPs are required to share the cost of fraud losses with sending PSPs."
      ],
      "does_not_support": [
        "South African participant, statutory or contractual rules.",
        "A 50:50 split unless a separate source in the applicable rules confirms the exact allocation.",
        "A guarantee that all payment disputes or civil disputes qualify."
      ]
    },
    {
      "id": "SYNSEPA_PUBLIC_SYNTHETIC_DATASET",
      "authority": "EpiphanyTech / SEPAGen project",
      "title": "SynSEPA: A Synthetic SEPA Instant Payment Dataset for APP Fraud Detection Research",
      "url": "https://huggingface.co/datasets/EpiphanyTech/SynSEPA",
      "published_on": null,
      "observed_on": "2026-11-04",
      "evidence_class": "public_synthetic_research_dataset",
      "supports": [
        "Dataset card reports approximately 1.84 million synthetic SEPA transactions, 10,000 synthetic accounts, 7,112 fraud-labelled transactions, and four APP fraud typologies.",
        "Dataset card reports a 0.39% fraud-labelled share, calibrated against EBA-ECB 2025 statistics.",
        "The dataset card documents limitations: all data synthetic, no device/session signals, simplified IBANs that do not pass Mod-97, and a single 2024 simulation year."
      ],
      "does_not_support": [
        "Real-world fraud prevalence or production model performance.",
        "Ground-truth realism beyond its disclosed synthetic generation and calibration.",
        "A fully realistic device, session, authentication or issuer-trust signal set."
      ]
    },
    {
      "id": "HARBI_EDGE_FEDERATED_GRAPH_FRAUD_SURVEY_2026",
      "authority": "Ahmed Harbi, Discover Computing / Springer Nature",
      "title": "Edge-deployed graph learning for real-time telecom and financial fraud detection: a systematic survey and reference architecture",
      "url": "https://doi.org/10.1007/s10791-026-10570-7",
      "published_on": "2026-11-03",
      "observed_on": "2026-11-04",
      "evidence_class": "peer_reviewed_systematic_survey_and_telecom_cdr_pilot",
      "supports": [
        "The survey organises 22 studies around graph representation, temporal handling, edge/federated deployment, class imbalance and auditability.",
        "It reports a three-silo federated pilot on telecom call-detail records, with F1 0.8622, AUC 0.9263 and precision 0.9364.",
        "It argues that combined graph, temporal, edge/federated, class-imbalance and auditability requirements remain under-integrated in the surveyed literature."
      ],
      "does_not_support": [
        "The reported telecom CDR F1/AUC/precision as payment-fraud SOTA.",
        "A measured Mycelix advantage over payment fraud systems.",
        "A 100 ms RTP decision SLA or South African regulatory requirement."
      ]
    },
    {
      "id": "SOUTH_AFRICA_CONSTITUTION_SECTION_6_2026",
      "authority": "Republic of South Africa",
      "title": "Constitution of the Republic of South Africa, 1996, Section 6 (current text)",
      "url": "https://www.saflii.org/content/Constitution-of-the-Republic-of-South-Africa_1996.html",
      "published_on": "2026-06-26",
      "observed_on": "2026-11-04",
      "evidence_class": "current_jurisdictional_constitutional_text",
      "supports": [
        "The current Section 6(1) list contains 12 official languages, including South African Sign Language.",
        "The current text records the amendment as effective from 26 June 2026.",
        "Section 6(2) recognises historically diminished use of indigenous languages and directs practical and positive measures to elevate status and advance use.",
        "Section 6(4) states that all official languages must enjoy parity of esteem and be treated equitably."
      ],
      "does_not_support": [
        "Any bank's or payment scheme's actual language availability or quality.",
        "A measured fraud-model performance level in any language or modality.",
        "That South African Sign Language can be evaluated as a written language or replaced by captions."
      ]
    }
  ],

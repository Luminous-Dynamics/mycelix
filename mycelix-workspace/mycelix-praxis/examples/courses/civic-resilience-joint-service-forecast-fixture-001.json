{
  "benchmark_id": "PRAXIS-NRES-009-JOINT-SERVICE-FORECAST-001",
  "schema_version": "1.0.0",
  "status": "synthetic-demonstration-for-review",
  "evaluation_split": "public-development-only",
  "active_in_curriculum": false,
  "title": "Joint Service-Breach Distribution Verification",
  "purpose": "Evaluate categorical predictive distributions over combinations of critical-service breaches, with proper marginal, joint-state, energy, variogram and pairwise co-breach scores.",
  "scope_limits": [
    "All service combinations, probabilities, and observations in this fixture are fictional development data.",
    "The fixture is not a real outage frequency estimate, operational forecast, or public-service readiness assessment.",
    "The evaluator verifies a supplied joint distribution; it does not generate cascading failures or infer causal dependencies.",
    "A marginally calibrated forecast can still have an incorrect dependence structure.",
    "The public fixture is not a held-out test set and must not be used to claim calibrated real-world risk.",
    "A single observed vector per case is not sufficient to establish stable calibration."
  ],
  "service_catalog": [
    {
      "service_id": "electricity_supply",
      "bit_index": 0,
      "unit": "binary-breach-indicator"
    },
    {
      "service_id": "communications_access",
      "bit_index": 1,
      "unit": "binary-breach-indicator"
    },
    {
      "service_id": "water_service_continuity",
      "bit_index": 2,
      "unit": "binary-breach-indicator"
    },
    {
      "service_id": "health_logistics_continuity",
      "bit_index": 3,
      "unit": "binary-breach-indicator"
    }
  ],
  "protocol": {
    "forecast_origin_hour": 0,
    "forecast_horizon_hours": 24,
    "state_encoding": "bit i corresponds exactly to service_catalog item whose bit_index=i; one means a breach occurred at least once during the horizon",
    "state_count": 16,
    "probability_sum_tolerance": 1e-12,
    "log_score_rule": "negative natural logarithm of probability assigned to the observed joint state; zero assigned probability yields infinite loss reported as null with an explicit count",
    "multiclass_brier_rule": "sum over all 16 states of (forecast_probability - observed_one_hot_probability)^2",
    "energy_score_rule": "E||X-y||_2 - 0.5 E||X-X'||_2 for the complete discrete joint distribution",
    "variogram_score_rule": "mean across all unordered service pairs of (P(X_i != X_j) - 1[y_i != y_j])^2",
    "pairwise_joint_brier_rule": "mean across all unordered service pairs of (P(X_i=1,X_j=1) - 1[y_i=1,y_j=1])^2",
    "aggregation_rule": "report marginal, pairwise, joint-state, energy and variogram scores separately; no compensating composite score"
  },

  "estimands": {
    "primary": {
      "id": "case_weighted_mean_paired_score_difference",
      "definition": "E[sum_i_in_g d_i] / E[n_g]",
      "sample_estimator": "sum_g D_g / sum_g n_g",
      "bootstrap_recompute": "resample complete independent top-level units; recompute ratio of sums"
    },
    "secondary": {
      "id": "cluster_weighted_mean_paired_score_difference",
      "definition": "E[D_g / n_g]",
      "warning": "Distinct from the case-weighted estimand; never substitute silently."
    }
  },
  "record_hierarchy": [
    "forecast_case",
    "event_id",
    "dependence_cluster_id",
    "independent_sampling_block"
  ],
  "scoring": {
    "primary": "binary_brier_loss_difference",
    "sign_convention": "candidate_minus_reference; negative favours candidate",
    "paired_case_requirement": true,
    "analytic_conditional_expectation": "E[(p-Y)^2 | q] = (p-q)^2 + q(1-q)",
    "no_row_or_model_repooling": true
  },

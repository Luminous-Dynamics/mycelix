{
  "benchmark_id": "PRAXIS-NRES-007-CASCADE-RECOVERY-001",
  "schema_version": "1.0.0",
  "status": "synthetic-demonstration-for-review",
  "evaluation_split": "public-development-only",
  "active_in_curriculum": false,
  "title": "Cascading Disruption and Service Recovery Trajectories",
  "purpose": "Demonstrate a deterministic, non-compensatory evaluation of time-varying public-service availability under a shared synthetic disruption sequence.",
  "scope_limits": [
    "All values, dependencies, disruptions and resource amounts are fictional development data.",
    "This fixture is not an operational contingency plan, public warning, infrastructure vulnerability assessment or real-world municipal estimate.",
    "The comparison is descriptive and is not a randomized, causal or policy-effect estimate.",
    "A dependency edge is a declared benchmark assumption, not a claim about the actual architecture of any place or provider.",
    "Interpolated deficit area is a declared numerical convention between samples; it does not establish continuous observation.",
    "Recovery is observed only within the declared sample horizon; no post-horizon persistence is inferred.",
    "No participant, household or natural-person identity is represented or scored."
  ],
  "protocol": {
    "time_unit": "hours",
    "availability_unit": "percent",
    "horizon_hours": 72,
    "sample_hours": [
      0,
      6,
      12,
      18,
      24,
      36,
      48,
      72
    ],
    "interpolation_rule": "piecewise-linear interpolation between adjacent samples only for deficit-area integration",
    "deficit_area_rule": "integrate max(0, service_floor_percent - availability_percent) over time",
    "deficit_area_unit": "percentage_point_hours",
    "sustained_recovery_rule": "earliest sampled hour at which the service is at or above its floor and every subsequent sample through the horizon remains at or above its floor",
    "recovery_limit": "observed sample horizon only; a null recovery hour means sustained recovery was not observed by the horizon",
    "pair_comparison_rule": "all scenario profiles must reference the same frozen shock_sequence_id; contrasts describe fixture differences and are not causal effects"
  },
  "resource_limits": {
    "planning_points_available": 300,
    "responder_hours_available": 240
  },

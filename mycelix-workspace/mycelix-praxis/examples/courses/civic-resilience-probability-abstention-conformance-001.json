    },
    {
      "case_id": "NEG-11",
      "name": "Unqualified abstention reason mismatch",
      "mutation": "Set conflicting_sources with reason=model_uncertainty",
      "expected_disposition": "reject-abstention-reason-mismatch"
    },
    {
      "case_id": "NEG-12",
      "name": "Composite score injection",
      "mutation": "Add overall_resilience_score to root object",
      "expected_disposition": "reject-composite-score"
    },
    {
      "case_id": "NEG-13",
      "name": "Non-string abstention reason on forecast",
      "mutation": "Set candidate_output.abstention_reason to a number while action=forecast",
      "expected_disposition": "reject-invalid-explicit-null-reason"
    },
    {
      "case_id": "NEG-14",
      "name": "Missing explicit null reason on forecast",
      "mutation": "Remove candidate_output.abstention_reason from a forecast output",
      "expected_disposition": "reject-missing-null-reason"
    },
    {
      "case_id": "NEG-15",

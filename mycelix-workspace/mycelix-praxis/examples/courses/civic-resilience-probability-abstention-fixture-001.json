{
  "benchmark_id": "PRAXIS-NRES-008-PROBABILITY-ABSTENTION-001",
  "schema_version": "1.0.0",
  "status": "synthetic-demonstration-for-review",
  "evaluation_split": "public-development-only",
  "active_in_curriculum": false,
  "title": "Probability Calibration and Evidence-Qualified Abstention",
  "purpose": "Evaluate binary service-floor breach probability forecasts, proper scoring, calibration diagnostics and mandatory abstention under missing, conflicting or unsupported inputs.",
  "scope_limits": [
    "Every case, event outcome and calibration-reference count is fictional public-development data.",
    "A successful evaluation establishes fixture consistency and metric reproducibility only; it does not estimate real outage probabilities.",
    "Qualification states are supplied scenario labels, not a legal, institutional or factual adjudication.",
    "No forecast or abstention is an operational instruction or a grant of civic/emergency authority.",
    "Public development cases are not held-out or confirmatory data; no model should be tuned and evaluated on this fixture as independent evidence.",
    "The calibration cohort is an aggregate synthetic reference rate; it does not establish a population base rate.",
    "Distribution-free coverage claims are not made; exchangeability and distribution-shift assumptions require explicit study."
  ],

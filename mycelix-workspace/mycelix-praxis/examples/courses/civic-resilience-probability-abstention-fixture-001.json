  "protocol": {
    "forecast_target": "minimum service availability falls strictly below the service floor at least once during the 24-hour forecast horizon",
    "forecast_origin_hour": 0,
    "forecast_horizon_hours": 24,
    "probability_bins": [
      0,
      0.2,
      0.4,
      0.6,
      0.8,
      1
    ],
    "bin_convention": "lower-inclusive and upper-exclusive; the final bin includes probability 1.0",
    "log_loss_epsilon": 0.000001,
    "proper_scores": [
      "brier_score",
      "log_loss"
    ],
    "baseline_rule": "reference event probability = calibration_reference.breach_count / calibration_reference.sample_count; Brier skill = 1 - candidate Brier / reference Brier on the same issued cases",
    "calibration_diagnostic": "fixed-bin expected calibration error (ECE), descriptive only and not a proper score",
    "abstention_rule": "forecast only when qualification_state=qualified; missing_critical_input, conflicting_sources and unsupported_distribution_shift require abstention",
    "optional_abstention_rule": "a qualified case may abstain only with abstention_reason=model_uncertainty; count it against eligible-case coverage",
    "selective_confidence_thresholds": [
      0,
      0.25,
      0.5,
      0.75
    ]
  },
  "calibration_reference": {
    "sample_count": 20,
    "breach_count": 10,
    "status": "synthetic-public-development-reference",
    "description": "Aggregate fictional calibration cohort used only to define a climatology baseline for the public example."
  },

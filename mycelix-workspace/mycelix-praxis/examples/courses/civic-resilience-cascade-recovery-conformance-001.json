    },
    {
      "case_id": "NEG-02",
      "name": "Non-monotonic sample time",
      "mutation": "Change one point hour so it precedes the previous point",
      "expected_disposition": "reject-time-grid-mismatch"
    },
    {
      "case_id": "NEG-03",
      "name": "Missing service trajectory",
      "mutation": "Remove one required service from one scenario",
      "expected_disposition": "reject-service-coverage-gap"
    },
    {
      "case_id": "NEG-04",
      "name": "Different shock sequence",
      "mutation": "Change one scenario shock_sequence_id",
      "expected_disposition": "reject-unmatched-shock-pair"
    },
    {
      "case_id": "NEG-05",
      "name": "Dangling dependency",
      "mutation": "Reference a prerequisite service absent from the service catalog",
      "expected_disposition": "reject-dangling-dependency"
    },
    {
      "case_id": "NEG-06",
      "name": "Duplicate dependency edge",
      "mutation": "Add a second edge with the same prerequisite_service_id, dependent_service_id and relationship",
      "expected_disposition": "reject-duplicate-dependency-edge"
    },
    {
      "case_id": "NEG-07",
      "name": "Composite score injection",
      "mutation": "Add overall_resilience_score to the fixture",
      "expected_disposition": "reject-compensating-score"
    },
    {
      "case_id": "NEG-08",
      "name": "Resource overrun",
      "mutation": "Set committed responder hours above available hours",
      "expected_disposition": "reject-resource-limit-overrun"
    },
    {
      "case_id": "NEG-09",
      "name": "Duplicate service trajectory",
      "mutation": "Add a second trajectory with an existing service_id",
      "expected_disposition": "reject-duplicate-service-trajectory"
    },
    {
      "case_id": "NEG-10",
      "name": "Wrong sample count",
      "mutation": "Remove one time sample from a trajectory",
      "expected_disposition": "reject-sample-grid-mismatch"
    },
    {
      "case_id": "NEG-11",
      "name": "Unsupported dependency assertion status",
      "mutation": "Set dependency edge assertion_status to an unrecognized value",
      "expected_disposition": "reject-unsupported-assertion-status"
    }
  ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/praxis-benchmark-run-integrity/v1/mutation_matrix.schema.json",
  "title": "Praxis benchmark run-integrity mutation matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"const": "PRAXIS-BENCHMARK-RUN-INTEGRITY-001"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "mutation", "expected", "test_name"],
      "properties": {
        "id": {"type": "string", "pattern": "^RUN-[0-9]{3}$"},
        "kind": {"enum": ["positive_control", "negative_control", "metamorphic_control", "verifier_self_audit"]},
        "mutation": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "test_name": {"type": "string", "pattern": "^[a-z0-9_]+$"}
      }
    }
  }
}

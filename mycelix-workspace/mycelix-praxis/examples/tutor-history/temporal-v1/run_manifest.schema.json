{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/praxis-benchmark-run-integrity/v1/run_manifest.schema.json",
  "title": "Praxis benchmark run identity and artifact-access manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integrity_protocol_id",
    "benchmark_id",
    "run_id",
    "split_id",
    "split_role",
    "split_manifest_blake3",
    "trajectory_ids",
    "system",
    "sampling",
    "execution_environment_blake3",
    "candidate_schema_blake3",
    "observation_manifest_blake3",
    "oracle_blake3",
    "scorer_blake3",
    "verifier_blake3",
    "protocol_blake3",
    "mutation_matrix_blake3",
    "evaluator_revision",
    "predictions_blake3",
    "candidate_visible_artifact_ids",
    "evaluator_only_artifact_ids",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "integrity_protocol_id": {
      "const": "PRAXIS-BENCHMARK-RUN-INTEGRITY-001"
    },
    "benchmark_id": {
      "const": "PRAXIS-TUTOR-TEMPORAL-EVIDENCE-001"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "split_id": {
      "type": "string",
      "minLength": 1
    },
    "split_role": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "split_manifest_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "trajectory_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "system": {
      "$ref": "#/$defs/system"
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "execution_environment_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "candidate_schema_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "observation_manifest_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "oracle_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "scorer_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "verifier_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "protocol_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "mutation_matrix_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "evaluator_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "predictions_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "candidate_visible_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluator_only_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "blake3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "system_revision",
        "model_config_blake3",
        "prompt_config_blake3",
        "policy_gate_blake3",
        "advisor_mode",
        "advisor_artifact_blake3",
        "advisor_output_blake3"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "system_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "model_config_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "prompt_config_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "policy_gate_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "advisor_mode": {
          "enum": [
            "baseline",
            "symthaea_assisted"
          ]
        },
        "advisor_artifact_blake3": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "advisor_output_blake3": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature_milli",
        "top_p_milli",
        "max_output_tokens",
        "seed"
      ],
      "properties": {
        "temperature_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "top_p_milli": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "audience",
        "digest_blake3"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "observation_manifest",
            "observation_schema",
            "candidate_policy",
            "oracle",
            "split_assignments",
            "scorer",
            "verifier",
            "benchmark_protocol",
            "mutation_matrix",
            "advisor_output"
          ]
        },
        "audience": {
          "enum": [
            "candidate_visible",
            "evaluator_only"
          ]
        },
        "digest_blake3": {
          "$ref": "#/$defs/blake3"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/praxis-tutor-history/v1/observations.schema.json",
  "title": "Praxis tutor history observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "PRAXIS-TUTOR-HISTORY-001"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "counterfactual_group",
        "observations"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "counterfactual_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "sequence",
        "skill_id",
        "task_context",
        "correctness",
        "assistance",
        "origin"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "skill_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "correctness": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "assistance": {
          "enum": [
            "none",
            "hint",
            "partial_solution",
            "full_solution",
            "unknown"
          ]
        },
        "origin": {
          "enum": [
            "recorded_attempt",
            "educator_observation",
            "imported_summary",
            "derived_estimate"
          ]
        }
      }
    }
  }
}

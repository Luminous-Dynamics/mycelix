  "source_references": [
    {
      "id": "IMO-AIS-CARRIAGE",
      "url": "https://www.imo.org/en/ourwork/safety/pages/ais.aspx",
      "relevance": "Carriage applies to specified ship categories; certain exemptions exist."
    },
    {
      "id": "FAA-RADAR-LIMITATIONS",
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap4_section_5.html",
      "relevance": "Radar can be limited by terrain, earth curvature, propagation, clutter, target reflectivity and other factors."
    },
    {
      "id": "FAA-ADS-B-LIMITATIONS",
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap4_section_5.html",
      "relevance": "ADS-B does not show unequipped or failed aircraft; cockpit display is not collision avoidance."
    }
  ],
  "states": {
    "OBSERVED_PRESENT": "A source emitted a positive observation; this is not identity or truth adjudication.",
    "NOT_OBSERVED_WITHIN_DECLARED_COVERAGE": "No positive observation was emitted by this source within the pinned scope and window, and a qualified source-coverage assertion is complete/current for that scope. This is not physical absence.",
    "UNOBSERVABLE": "The source is outside validated modality, class, geometry or environment applicability.",
    "COVERAGE_UNKNOWN": "Coverage evidence is missing, stale, incomplete, contradictory or not independently qualified.",
    "FEED_UNAVAILABLE": "Source or feed failure/gap prevents a full-window observation claim.",
    "NOT_EQUIPPED_OR_NOT_REQUIRED": "The expected cooperative emission is not applicable to the declared source/equipment class.",
    "STALE": "Observation or coverage evidence is stale relative to the declared currentness cutoff.",
    "WITHHELD_OR_RESTRICTED": "Data is unavailable for the declared rights/purpose; infer no physical state.",
    "CONFLICT": "Qualified assertions conflict without an adjudicating source.",
    "NOT_APPLICABLE": "The modality is not designed or intended to observe the event class."
  },
  "required_invariants": [
    "No observation is not a negative by default.",
    "Coverage-qualified non-observation is a source-scoped observation claim, not a physical-absence claim.",
    "Unknown, missing, stale, failed, partial, withheld and unequipped states never become a negative.",
    "The scope and time window must be explicit and bound to exact source/profile and coverage assertion revisions.",
    "A full-window negative is prohibited when any subinterval is uncovered or unavailable.",
    "Rights and purpose gates precede any evidence availability claim.",
    "No majority vote can erase source-specific observability limitations.",
    "No model may infer pilot, crew, vessel-master, remote-operator identity, location, intent or wrongdoing."
  ],
  "precedence": [
    "WITHHELD_OR_RESTRICTED when rights/purpose do not permit access",
    "NOT_EQUIPPED_OR_NOT_REQUIRED when expected cooperative source emission is not applicable",
    "FEED_UNAVAILABLE when a known feed failure/gap breaks the declared observation interval",
    "COVERAGE_UNKNOWN when coverage is missing, stale, incomplete or unqualified",
    "UNOBSERVABLE when the source is known outside validated applicability or has a known blind sub-scope",
    "CONFLICT when qualified source assertions disagree and cannot be adjudicated",
    "OBSERVED_PRESENT when a positive observation exists",
    "NOT_OBSERVED_WITHIN_DECLARED_COVERAGE only when all preconditions pass and the observation set is empty"
  ],
  "metrics": {
    "false_negative_evidence_promotion_rate": "Fraction of oracle-unknown/unobservable/unavailable cases incorrectly emitted as NOT_OBSERVED_WITHIN_DECLARED_COVERAGE.",
    "negative_claim_overreach_rate": "Fraction of source-scoped non-observation outputs expanded into physical-absence, universal-scope or intent claims.",
    "coverage_qualification_precision": "Correctly qualified coverage assertions divided by all system outputs that claim coverage-qualified observation.",
    "coverage_gap_detection_recall": "Oracle-known uncovered intervals correctly preserved as gaps divided by all oracle-known uncovered intervals.",
    "correct_unknown_rate": "Correct coverage/source/equipment/rights unknown dispositions divided by all oracle cases requiring non-negative uncertainty.",
    "positive_detection_metrics": "Detection metrics only where independent event truth and a valid observation-exposure denominator are supplied.",
    "matched_coverage_risk": "Compare candidate and baseline at identical scoped windows and coverage strata; no claim from unlike exposure."
  },
  "hard_gates": {
    "false_negative_evidence_promotions": 0,
    "physical_absence_overclaims": 0,
    "unobservable_promoted_to_negative": 0,
    "partial_window_promoted_to_full_window_negative": 0,
    "restricted_source_used_for_unapproved_purpose": 0,
    "privacy_or_authority_boundary_violations": 0
  },

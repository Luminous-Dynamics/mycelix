  "metrics_definitions": {
    "probability_of_detection": "Positive source observations divided by independently confirmed eligible events during valid source observation exposure; undefined if the eligible exposure denominator is zero.",
    "probability_of_false_alarm": "False event clusters or alerts per predeclared eligible source-hour/exposure unit; report raw alerts and deduplicated event groups.",
    "score_calibration": "Agreement between a predicted probability for a declared claim and independent Bernoulli outcomes in the declared sampling frame.",
    "coverage_calibration": "Agreement between declared probability of observation eligibility and independently stewarded realized exposure, stratified by abstract scope/condition cell.",
    "evidence_confidence": "Provenance, rights, freshness, completeness, dependency and receipt quality; never a probability of physical truth."
  },
  "required_outputs": [
    "per-source and fused Pd with Wilson or exact intervals",
    "Pfa per eligible exposure and per event cluster",
    "Brier score, Brier Skill Score versus prevalence baseline, log loss, calibration intercept and slope",
    "reliability bins with definitions, support counts and uncertainty intervals",
    "coverage calibration by abstract condition cell",
    "risk-coverage/abstention curves and selective risk",
    "missingness and observation-exposure table",
    "dependency-group/common-mode analysis and leave-one-dependency-group-out results",
    "all failed, incomplete and abstained runs with exact code/config/input/split digests"
  ],
  "hard_gates": {
    "unknown_or_no_exposure_promoted_to_zero_detections": 0,
    "model_score_promoted_to_coverage_probability": 0,

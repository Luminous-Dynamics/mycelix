{
  "policy_version": "0.1.0",
  "purpose": "Civilian, read-only, evidence-qualified situational awareness for UAS, maritime and civil aviation.",
  "canonicalization": {
    "encoding": "UTF-8",
    "digest_algorithm": "SHA-256",
    "json_payload_serialization": "RFC 8785 JSON Canonicalization Scheme",
    "digest_format": "sha256:<64 lowercase hexadecimal characters>",
    "digest_semantics": {
      "field_allowlist_digest": "SHA-256 over the exact UTF-8 bytes of this field-policy artifact.",
      "payload_digest": "SHA-256 over RFC 8785 canonical JSON bytes of domain_extension.payload.",
      "envelope_content_digest": "SHA-256 over RFC 8785 canonical JSON bytes of the entire envelope object after removing the lineage member; this avoids self-reference and binds all source, time, claim, quality, dependency, spatial and governance fields."
    }
  },
  "common_envelope_allowlist": [
    "schema_version",
    "envelope_id",
    "domain",
    "event_class",
    "source",
    "timestamps",
    "claim",
    "quality",
    "dependence",
    "spatial_context",
    "governance",
    "lineage",
    "domain_extension"
  ],
  "domain_extension_allowlists": {
    "uas": [
      "synthetic",
      "fixture_id",
      "reported_class",
      "classification_status"
    ],
    "maritime": [
      "synthetic",
      "fixture_id",
      "reported_status",
      "identity_status",
      "ais_is_source_assertion",
      "position_payload_withheld"
    ],
    "civil_aviation": [
      "synthetic",
      "fixture_id",
      "hazard_type",
      "severity",
      "source_confirmation",
      "declared_integration_class",
      "authority_owner"
    ]
  },
  "prohibited_field_families": [
    "personal_identity_contact_home_address_or_personal_device_identifiers",
    "pilot_crew_controller_remote_operator_identity_or_precise_personal_location",
    "private_communications_voice_recordings_raw_audio_raw_video_or_biometrics",
    "weapons_interceptors_effectors_mitigation_jamming_spoofing_or_takeover",
    "targeting_engagement_fire_control_hostile_intent_or_threat_classification",
    "vessel_navigation_commands_aircraft_flight_controls_atc_commands_vts_instructions_or_actuation",
    "unapproved_exact_geometry_or_trajectory_not_required_for_the_declared_safety_purpose"
  ],
  "preflight_requirements": [
    "known_schema_revision",
    "verified_domain_allowlist_digest",
    "declared_purpose_and_approved_rights_basis",
    "source_integrity_and_authentication_state_recorded",
    "event_time_and_receipt_time_separate",
    "clock_quality_and_uncertainty_recorded",
    "calibration_freshness_and_source_health_explicit",
    "common_mode_dependency_groups_recorded_or_explicitly_unknown",
    "domain_geometry_precision_approved_for_purpose",
    "no_prohibited_fields_or_control_interfaces",
    "all_rejections_quarantines_and_abstentions_retained_in_run_census"
  ],
  "failure_states": {
    "unknown_schema_or_unrecognized_field": "REJECTED",
    "missing_or_unapproved_rights_basis": "QUARANTINED",
    "prohibited_personal_or_control_field": "REJECTED",
    "unverified_source_or_clock": "UNRESOLVED_OR_ABSTAIN",
    "missing_independent_split_group": "NOT_CONFIRMATORY",
    "incomplete_or_conflicted_evidence": "INCOMPARABLE_OR_ABSTAIN"
  },
  "operational_constraints": {
    "read_only": true,
    "connects_to_control_plane": false,
    "authorizes_action": false,
    "replaces_certified_safety_system": false,
    "uses_personal_operator_geolocation": false
  },
  "claim_value_allowlists": {
    "uas": {
      "sensor_reported_object_class": [
        "reported_class",
        "classification_status"
      ]
    },
    "maritime": {
      "ais_reported_navigation_status": [
        "reported_status",
        "identity_status"
      ]
    },
    "civil_aviation": {
      "weather_hazard_report": [
        "hazard_type",
        "severity",
        "source_confirmation"
      ]
    }
  },
  "claim_value_constraints": {
    "v0.1": "claim.value must be a scalar or a flat object whose keys are explicitly listed for (domain, claim_type); nested objects and arrays are rejected until a domain-specific value schema is registered."
  },
  "domain_extension_schemas": {
    "uas": {
      "schema_uri": "urn:luminous-dynamics:gcpn:uas:0.1.0",
      "schema_revision": "0.1.0"
    },
    "maritime": {
      "schema_uri": "urn:luminous-dynamics:gcpn:maritime:0.1.0",
      "schema_revision": "0.1.0"
    },
    "civil_aviation": {
      "schema_uri": "urn:luminous-dynamics:gcpn:civil-aviation:0.1.0",
      "schema_revision": "0.1.0"
    }
  }
}

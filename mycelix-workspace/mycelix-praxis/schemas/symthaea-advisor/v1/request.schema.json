{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/praxis-symthaea-advisor/v1/request.schema.json",
  "title": "Praxis Symthaea Advisor Request v1",
  "description": "Privacy-minimized advisory input. No direct learner identifier or raw learner history is required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "request_id",
    "advisory_consent_granted",
    "policy_profile",
    "goal",
    "evidence_snapshot",
    "evidence_sufficiency",
    "displacement_risk",
    "human_support_must_be_preserved",
    "accessibility_requirements",
    "assessment_policy",
    "preferred_actions",
    "support_options"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "PRAXIS-SYMTHAEA-ADVISOR-001"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "advisory_consent_granted": {
      "const": true
    },
    "policy_profile": {
      "$ref": "#/$defs/policy_profile"
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "evidence_snapshot": {
      "$ref": "#/$defs/evidence_snapshot"
    },
    "evidence_sufficiency": {
      "type": "string",
      "enum": [
        "sufficient",
        "partial",
        "insufficient",
        "conflicting"
      ]
    },
    "displacement_risk": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "material",
        "unknown"
      ]
    },
    "human_support_must_be_preserved": {
      "type": "boolean"
    },
    "accessibility_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment_policy": {
      "type": "string",
      "enum": [
        "not_applicable",
        "permits_scaffolding",
        "prohibits_ai_assistance",
        "unknown"
      ]
    },
    "preferred_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "support_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/support_option"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "ai_hint_then_retrieval",
        "retrieval_practice",
        "human_support",
        "peer_collaboration",
        "educator_copilot",
        "accessibility_adaptation",
        "offline_fallback",
        "ask_clarifying_question",
        "abstain_and_escalate",
        "no_intervention"
      ]
    },
    "policy_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_capability_id",
        "summary"
      ],
      "properties": {
        "target_capability_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "snapshot_digest_blake3",
        "captured_at",
        "evidence_items"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_digest_blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "epistemic_status",
        "summary"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "learner_goal",
            "independent_attempt",
            "assisted_attempt",
            "progress_summary",
            "support_availability",
            "course_policy",
            "accessibility_requirement",
            "learner_preference",
            "study_context",
            "other"
          ]
        },
        "epistemic_status": {
          "type": "string",
          "enum": [
            "observed",
            "learner_reported",
            "derived",
            "hypothesis"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "support_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "available",
        "accessible_for_context",
        "policy_permitted",
        "basis_evidence_refs"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "available": {
          "type": "boolean"
        },
        "accessible_for_context": {
          "type": "boolean"
        },
        "policy_permitted": {
          "type": "boolean"
        },
        "basis_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

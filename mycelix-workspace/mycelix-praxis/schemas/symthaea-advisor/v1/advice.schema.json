{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/praxis-symthaea-advisor/v1/advice.schema.json",
  "title": "Praxis Symthaea Advisor Response v1",
  "description": "Advisory response only. It cannot create mastery, credential, policy, or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "request_id",
    "request_digest_blake3",
    "advisor_build",
    "policy_profile",
    "disposition",
    "selected_action",
    "alternative_actions",
    "evidence_refs",
    "uncertainty",
    "rationale",
    "clarifying_questions",
    "limitations",
    "effect_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "PRAXIS-SYMTHAEA-ADVISOR-001"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "request_digest_blake3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "advisor_build": {
      "$ref": "#/$defs/advisor_build"
    },
    "policy_profile": {
      "$ref": "#/$defs/policy_profile"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "recommend",
        "clarify",
        "abstain"
      ]
    },
    "selected_action": {
      "$ref": "#/$defs/action"
    },
    "alternative_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainty": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "clarifying_questions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effect_mode": {
      "const": "advisory_only"
    }
  },
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "ai_hint_then_retrieval",
        "retrieval_practice",
        "human_support",
        "peer_collaboration",
        "educator_copilot",
        "accessibility_adaptation",
        "offline_fallback",
        "ask_clarifying_question",
        "abstain_and_escalate",
        "no_intervention"
      ]
    },
    "advisor_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_commit",
        "feature_profile",
        "feature_profile_digest_blake3"
      ],
      "properties": {
        "repository": {
          "const": "Luminous-Dynamics/symthaea"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "feature_profile": {
          "type": "string",
          "minLength": 1
        },
        "feature_profile_digest_blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

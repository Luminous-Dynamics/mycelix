{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:nres:015:bt1:bounded-bulk-tail:v1",
  "title": "Praxis NRES-015 BT1 Bounded Bulk-Tail Credal Reference",
  "type": "object",
  "required": ["benchmark_id", "schema_version", "status", "evaluation_split", "active_in_curriculum", "support_state_count", "bulk_state_ids", "bulk_selection_basis", "profiles", "guardrails"],
  "properties": {
    "benchmark_id": {"const": "PRAXIS-NRES-015-BT1-BOUNDED-BULK-TAIL-001"},
    "schema_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "status": {"const": "synthetic-demonstration-for-review"},
    "evaluation_split": {"const": "public-development-only"},
    "active_in_curriculum": {"const": false},
    "support_state_count": {"type": "integer", "minimum": 2, "maximum": 4096},
    "bulk_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "bulk_selection_basis": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile_id", "bulk_conditional_probabilities", "bulk_state_losses", "bulk_tv_radius", "tail_mass_lower", "tail_mass_upper", "tail_loss_upper_bound", "tail_bound_basis"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "bulk_conditional_probabilities": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "bulk_state_losses": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
          "bulk_tv_radius": {"type": "number", "minimum": 0, "maximum": 1},
          "tail_mass_lower": {"type": "number", "minimum": 0, "maximum": 0.5},
          "tail_mass_upper": {"type": "number", "minimum": 0, "maximum": 0.5},
          "tail_loss_upper_bound": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
          "tail_bound_basis": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "guardrails": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
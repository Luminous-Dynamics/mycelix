{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:nres:014:split-conformal-wasserstein-radius:v1",
  "title": "Praxis NRES-014 Split-Conformal Wasserstein Radius Calibration Fixture",
  "type": "object",
  "required": [
    "benchmark_id",
    "schema_version",
    "status",
    "evaluation_split",
    "active_in_curriculum",
    "source",
    "service_catalog",
    "protocol",
    "calibration_blocks",
    "development_evaluation_blocks",
    "expected_calibration",
    "expected_development_diagnostic",
    "interpretation_guardrails",
    "expected_population_correction"
  ],
  "properties": {
    "benchmark_id": {
      "const": "PRAXIS-NRES-014-SPLIT-CONFORMAL-WASSERSTEIN-RADIUS-001"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "synthetic-demonstration-for-review"
    },
    "evaluation_split": {
      "const": "public-development-only"
    },
    "active_in_curriculum": {
      "const": false
    },
    "source": {
      "type": "object",
      "required": [
        "benchmark_id",
        "fixture_path",
        "fixture_git_blob_sha1"
      ],
      "properties": {
        "benchmark_id": {
          "const": "PRAXIS-NRES-009-JOINT-SERVICE-FORECAST-001"
        },
        "fixture_path": {
          "type": "string",
          "minLength": 1
        },
        "fixture_git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": true
    },
    "service_catalog": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "service_id",
          "bit_index",
          "unit"
        ],
        "properties": {
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "bit_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "unit": {
            "const": "binary-breach-indicator"
          }
        },
        "additionalProperties": true
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "method",
        "target_miscoverage",
        "target_marginal_coverage",
        "calibration_unit",
        "calibration_block_count",
        "development_block_count",
        "block_size",
        "state_count",
        "quantile_rule",
        "tie_rule",
        "score_definition",
        "coverage_claim",
        "coverage_limit",
        "assumptions",
        "ground_metric",
        "numerical_method",
        "population_correction_delta",
        "population_correction_assumption"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "target_miscoverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "target_marginal_coverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "calibration_unit": {
          "type": "string",
          "minLength": 1
        },
        "calibration_block_count": {
          "type": "integer",
          "minimum": 1
        },
        "development_block_count": {
          "type": "integer",
          "minimum": 0
        },
        "block_size": {
          "type": "integer",
          "minimum": 1
        },
        "state_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 64
        },
        "quantile_rule": {
          "type": "string",
          "minLength": 1
        },
        "tie_rule": {
          "type": "string",
          "minLength": 1
        },
        "score_definition": {
          "type": "string",
          "minLength": 1
        },
        "coverage_claim": {
          "type": "string",
          "minLength": 1
        },
        "coverage_limit": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ground_metric": {
          "type": "object",
          "required": [
            "name",
            "service_change_weights",
            "definition"
          ],
          "properties": {
            "name": {
              "const": "weighted_hamming"
            },
            "service_change_weights": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "definition": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "numerical_method": {
          "type": "string",
          "minLength": 1
        },
        "population_correction_delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "population_correction_assumption": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "calibration_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "development_evaluation_blocks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "expected_calibration": {
      "type": "object",
      "required": [
        "score_count",
        "target_marginal_coverage",
        "one_based_order_statistic_rank",
        "sorted_scores",
        "calibrated_radius",
        "radius_is_finite"
      ],
      "properties": {
        "score_count": {
          "type": "integer",
          "minimum": 1
        },
        "target_marginal_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "one_based_order_statistic_rank": {
          "type": "integer",
          "minimum": 1
        },
        "sorted_scores": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "calibrated_radius": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "radius_is_finite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "expected_development_diagnostic": {
      "type": "object",
      "required": [
        "evaluation_blocks",
        "covered_blocks",
        "empirical_coverage",
        "interpretation"
      ],
      "properties": {
        "evaluation_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "covered_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "empirical_coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "interpretation_guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_population_correction": {
      "type": "object",
      "required": [
        "delta",
        "tv_sampling_error_upper_bound",
        "metric_diameter",
        "w1_sampling_error_upper_bound",
        "corrected_population_radius",
        "is_vacuous",
        "combined_marginal_coverage_lower_bound",
        "interpretation"
      ],
      "properties": {
        "delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "tv_sampling_error_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_diameter": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "w1_sampling_error_upper_bound": {
          "type": "number",
          "minimum": 0
        },
        "corrected_population_radius": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "is_vacuous": {
          "type": "boolean"
        },
        "combined_marginal_coverage_lower_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "block_id",
        "source_family_id",
        "forecast_template_source_case_id",
        "forecast_distribution",
        "observed_breach_masks",
        "evaluator_empirical_distribution",
        "nonconformity_score_w1"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "source_family_id": {
          "type": "string",
          "minLength": 1
        },
        "forecast_template_source_case_id": {
          "type": "string",
          "minLength": 1
        },
        "forecast_distribution": {
          "type": "array",
          "minItems": 4,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "state_mask",
              "probability"
            ],
            "properties": {
              "state_mask": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        },
        "observed_breach_masks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "evaluator_empirical_distribution": {
          "type": "array",
          "minItems": 4,
          "maxItems": 64,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "nonconformity_score_w1": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "overall_resilience_score"
        ]
      },
      {
        "required": [
          "composite_score"
        ]
      },
      {
        "required": [
          "leaderboard_score"
        ]
      },
      {
        "required": [
          "personal_suitability_score"
        ]
      },
      {
        "required": [
          "political_affiliation"
        ]
      },
      {
        "required": [
          "loyalty_score"
        ]
      }
    ]
  }
}

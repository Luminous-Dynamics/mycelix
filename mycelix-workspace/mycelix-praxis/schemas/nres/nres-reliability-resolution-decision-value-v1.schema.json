{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:nres:011:decision-value:v1",
  "title": "Praxis NRES-011 Reliability, Resolution and Decision Value Fixture",
  "description": "Structural profile for forecast reliability/resolution diagnostics and threshold-based decision-loss evaluation under declared importance-sampled scenarios. Cross-field and policy checks are enforced by the Rust evaluator.",
  "type": "object",
  "required": [
    "benchmark_id",
    "schema_version",
    "status",
    "evaluation_split",
    "active_in_curriculum",
    "source_fixture",
    "target",
    "sampling_design",
    "calibration_reference",
    "decision_profiles",
    "protocol",
    "evaluation_cases",
    "interpretation_guardrails"
  ],
  "properties": {
    "benchmark_id": {
      "const": "PRAXIS-NRES-011-RELIABILITY-RESOLUTION-DECISION-VALUE-001"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "synthetic-demonstration-for-review"
    },
    "evaluation_split": {
      "const": "public-development-only"
    },
    "active_in_curriculum": {
      "const": false
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source_fixture": {
      "type": "object",
      "required": [
        "benchmark_id",
        "source_description"
      ],
      "properties": {
        "benchmark_id": {
          "const": "PRAXIS-NRES-010-TAIL-SHIFT-ROBUSTNESS-001"
        },
        "source_description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": [
        "quantity",
        "unit",
        "threshold",
        "event_definition",
        "horizon_hours"
      ],
      "properties": {
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "const": "normalized-service-deficit-hours"
        },
        "threshold": {
          "const": 48
        },
        "event_definition": {
          "type": "string",
          "minLength": 1
        },
        "horizon_hours": {
          "const": 72
        }
      },
      "additionalProperties": true
    },
    "sampling_design": {
      "type": "object",
      "required": [
        "status",
        "strata",
        "weight_formula",
        "expected_total_weight_per_regime",
        "design_note"
      ],
      "properties": {
        "status": {
          "const": "synthetic-stratified-importance-sampling-demonstration"
        },
        "strata": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "sampling_stratum",
              "proposal_probability",
              "target_probability"
            ],
            "properties": {
              "sampling_stratum": {
                "enum": [
                  "routine",
                  "tail_enriched"
                ]
              },
              "proposal_probability": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "target_probability": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        },
        "weight_formula": {
          "type": "string",
          "minLength": 1
        },
        "expected_total_weight_per_regime": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "design_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "calibration_reference": {
      "type": "object",
      "required": [
        "sample_count",
        "exceedance_count",
        "exceedance_probability",
        "status",
        "description"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "exceedance_count": {
          "type": "integer",
          "minimum": 0
        },
        "exceedance_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "const": "synthetic-training-reference"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "decision_profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "readiness_cost",
          "event_loss_without_action",
          "event_loss_with_action",
          "deferral_cost",
          "decision_threshold_probability",
          "cost_unit"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "readiness_cost": {
            "type": "number",
            "minimum": 0
          },
          "event_loss_without_action": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "event_loss_with_action": {
            "type": "number",
            "minimum": 0
          },
          "deferral_cost": {
            "type": "number",
            "minimum": 0
          },
          "decision_threshold_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cost_unit": {
            "const": "normalized-planning-loss-units"
          }
        },
        "additionalProperties": true
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "forecast_origin_hour",
        "forecast_horizon_hours",
        "exceedance_threshold",
        "probability_bins",
        "bin_convention",
        "brier_decomposition",
        "decision_rule",
        "decision_cost",
        "baseline_policies",
        "value_rule",
        "abstention_rule",
        "aggregation_rule"
      ],
      "properties": {
        "forecast_origin_hour": {
          "type": "number",
          "minimum": 0
        },
        "forecast_horizon_hours": {
          "const": 72
        },
        "exceedance_threshold": {
          "const": 48
        },
        "probability_bins": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "bin_convention": {
          "type": "string",
          "minLength": 1
        },
        "brier_decomposition": {
          "type": "string",
          "minLength": 1
        },
        "decision_rule": {
          "type": "string",
          "minLength": 1
        },
        "decision_cost": {
          "type": "string",
          "minLength": 1
        },
        "baseline_policies": {
          "type": "array",
          "minItems": 4,
          "items": {
            "enum": [
              "always_no_action",
              "always_prepare",
              "training_climatology",
              "perfect_information_oracle"
            ]
          }
        },
        "value_rule": {
          "type": "string",
          "minLength": 1
        },
        "abstention_rule": {
          "type": "string",
          "minLength": 1
        },
        "aggregation_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "evaluation_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "source_case_id",
          "regime_id",
          "sampling_stratum",
          "proposal_stratum_probability",
          "target_stratum_probability",
          "forecast_origin_hour",
          "forecast_horizon_hours",
          "evaluator",
          "candidate_output"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source_case_id": {
            "type": "string",
            "minLength": 1
          },
          "regime_id": {
            "enum": [
              "in_distribution",
              "temporal_shift",
              "structural_dependency_shift",
              "evidence_degradation"
            ]
          },
          "sampling_stratum": {
            "enum": [
              "routine",
              "tail_enriched"
            ]
          },
          "proposal_stratum_probability": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "target_stratum_probability": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "forecast_origin_hour": {
            "type": "number",
            "minimum": 0
          },
          "forecast_horizon_hours": {
            "const": 72
          },
          "evaluator": {
            "type": "object",
            "required": [
              "observed_normalized_service_deficit_hours",
              "qualification_state",
              "review_fallback_action"
            ],
            "properties": {
              "observed_normalized_service_deficit_hours": {
                "type": "number",
                "minimum": 0
              },
              "qualification_state": {
                "enum": [
                  "qualified",
                  "missing_critical_input",
                  "conflicting_sources",
                  "unsupported_distribution_shift"
                ]
              },
              "review_fallback_action": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "prepare",
                  "no_action",
                  null
                ]
              }
            },
            "additionalProperties": true
          },
          "candidate_output": {
            "type": "object",
            "required": [
              "action",
              "predicted_exceedance_probability",
              "abstention_reason"
            ],
            "properties": {
              "action": {
                "enum": [
                  "forecast",
                  "abstain"
                ]
              },
              "predicted_exceedance_probability": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "abstention_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "interpretation_guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "overall_resilience_score"
        ]
      },
      {
        "required": [
          "composite_score"
        ]
      },
      {
        "required": [
          "personal_suitability_score"
        ]
      }
    ]
  }
}

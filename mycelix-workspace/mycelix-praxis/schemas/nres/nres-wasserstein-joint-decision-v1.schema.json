{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:nres:013:wasserstein-joint-decision:v1",
  "title": "Praxis NRES-013 Wasserstein Joint Decision Fixture",
  "description": "Structural schema for finite-support Wasserstein ambiguity over complete joint service-failure states; cross-field lineage and numerical invariants are enforced by the evaluator.",
  "type": "object",
  "required": [
    "benchmark_id",
    "schema_version",
    "status",
    "evaluation_split",
    "active_in_curriculum",
    "source",
    "service_catalog",
    "protocol",
    "radius_levels",
    "action_catalog",
    "decision_profiles",
    "evaluation_cases",
    "golden_expectations",
    "interpretation_guardrails"
  ],
  "properties": {
    "benchmark_id": {
      "const": "PRAXIS-NRES-013-WASSERSTEIN-JOINT-DECISION-001"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "synthetic-demonstration-for-review"
    },
    "evaluation_split": {
      "const": "public-development-only"
    },
    "active_in_curriculum": {
      "const": false
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "benchmark_id",
        "fixture_path",
        "fixture_git_blob_sha1",
        "source_case_count",
        "linkage_rule"
      ],
      "properties": {
        "benchmark_id": {
          "const": "PRAXIS-NRES-009-JOINT-SERVICE-FORECAST-001"
        },
        "fixture_path": {
          "type": "string",
          "minLength": 1
        },
        "fixture_git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_case_count": {
          "type": "integer",
          "minimum": 1
        },
        "linkage_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "service_catalog": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "service_id",
          "bit_index",
          "unit"
        ],
        "properties": {
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "bit_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "unit": {
            "const": "binary-breach-indicator"
          }
        },
        "additionalProperties": true
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "forecast_origin_hour",
        "forecast_horizon_hours",
        "state_count",
        "probability_sum_tolerance",
        "state_encoding",
        "ground_metric",
        "ambiguity_set",
        "radius_interpretation",
        "robust_dual",
        "decision_rule",
        "action_loss",
        "resource_rule",
        "tie_break",
        "aggregation_rule"
      ],
      "properties": {
        "forecast_origin_hour": {
          "type": "number",
          "minimum": 0
        },
        "forecast_horizon_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "state_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 64
        },
        "probability_sum_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.000001
        },
        "state_encoding": {
          "type": "string"
        },
        "ground_metric": {
          "type": "object",
          "required": [
            "name",
            "service_change_weights",
            "definition"
          ],
          "properties": {
            "name": {
              "const": "weighted_hamming"
            },
            "service_change_weights": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "definition": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "ambiguity_set": {
          "type": "string"
        },
        "radius_interpretation": {
          "type": "string"
        },
        "robust_dual": {
          "type": "string"
        },
        "decision_rule": {
          "type": "string"
        },
        "action_loss": {
          "type": "string"
        },
        "resource_rule": {
          "type": "string"
        },
        "tie_break": {
          "type": "string"
        },
        "aggregation_rule": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "radius_levels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "radius_level_id",
          "wasserstein_radius"
        ],
        "properties": {
          "radius_level_id": {
            "type": "string",
            "minLength": 1
          },
          "wasserstein_radius": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "action_catalog": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "resource_units",
          "prepared_service_mask"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "resource_units": {
            "type": "number",
            "minimum": 0
          },
          "prepared_service_mask": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "additionalProperties": true
      }
    },
    "decision_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "max_resource_units",
          "resource_unit_cost",
          "service_breach_costs",
          "prepared_residual_fraction"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "max_resource_units": {
            "type": "number",
            "minimum": 0
          },
          "resource_unit_cost": {
            "type": "number",
            "minimum": 0
          },
          "service_breach_costs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "prepared_residual_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "evaluation_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "source_case_id",
          "radius_level_id",
          "wasserstein_radius",
          "evaluator",
          "candidate_output"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source_case_id": {
            "type": "string",
            "minLength": 1
          },
          "radius_level_id": {
            "type": "string",
            "minLength": 1
          },
          "wasserstein_radius": {
            "type": "number",
            "minimum": 0
          },
          "evaluator": {
            "type": "object",
            "required": [
              "observed_breach_mask"
            ],
            "properties": {
              "observed_breach_mask": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "candidate_output": {
            "type": "object",
            "required": [
              "forecast_distribution"
            ],
            "properties": {
              "forecast_distribution": {
                "type": "array",
                "minItems": 4,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "required": [
                    "state_mask",
                    "probability"
                  ],
                  "properties": {
                    "state_mask": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 63
                    },
                    "probability": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "golden_expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "radius_level_id",
          "nominal_point_mean_realized_cost",
          "wasserstein_expected_mean_realized_cost",
          "wasserstein_minimax_regret_mean_realized_cost",
          "wasserstein_expected_mean_upper_bound",
          "wasserstein_minimax_regret_mean_upper_bound",
          "mean_perfect_information_cost"
        ],
        "additionalProperties": true
      }
    },
    "interpretation_guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "overall_resilience_score"
        ]
      },
      {
        "required": [
          "composite_score"
        ]
      },
      {
        "required": [
          "leaderboard_score"
        ]
      },
      {
        "required": [
          "personal_suitability_score"
        ]
      },
      {
        "required": [
          "political_affiliation"
        ]
      },
      {
        "required": [
          "loyalty_score"
        ]
      }
    ]
  }
}

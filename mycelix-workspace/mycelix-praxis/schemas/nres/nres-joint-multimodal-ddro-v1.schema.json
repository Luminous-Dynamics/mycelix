{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:nres:016:ex4:joint-multimodal-ddro:v1",
  "title": "Praxis NRES-016 EX4 Joint Multimodal Decision-Dependent Ambiguity",
  "type": "object",
  "required": [
    "benchmark_id",
    "schema_version",
    "status",
    "evaluation_split",
    "active_in_curriculum",
    "horizon_stages",
    "persistent_modes",
    "risk_contract",
    "information_contract",
    "information_states",
    "candidate_integrity_contract",
    "guardrails"
  ],
  "properties": {
    "benchmark_id": {
      "const": "PRAXIS-NRES-016-EX4-JOINT-MULTIMODAL-DDRO-001"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "protocol-template-for-review"
    },
    "evaluation_split": {
      "const": "public-development-only"
    },
    "active_in_curriculum": {
      "const": false
    },
    "horizon_stages": {
      "type": "integer",
      "minimum": 2,
      "maximum": 12
    },
    "persistent_modes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_contract": {
      "type": "object",
      "required": [
        "risk_confidence_level",
        "risk_aversion_lambda",
        "one_period_map",
        "nesting"
      ],
      "properties": {
        "risk_confidence_level": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "risk_aversion_lambda": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "one_period_map": {
          "const": "(1-lambda)*Expectation+lambda*CVaR_alpha"
        },
        "nesting": {
          "const": "nested-conditional-by-observable-information-state"
        }
      },
      "additionalProperties": false
    },
    "information_contract": {
      "type": "object",
      "required": [
        "policy_input",
        "observable_history",
        "hidden_mode_handling",
        "nonanticipativity_rule"
      ],
      "properties": {
        "policy_input": {
          "const": "observable-history-only"
        },
        "observable_history": {
          "type": "string",
          "minLength": 1
        },
        "hidden_mode_handling": {
          "const": "not-directly-observed-unless-emitted-by-an-observation"
        },
        "nonanticipativity_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "information_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "information_state_id",
          "stage",
          "observable_history",
          "service_levels",
          "resource_balances",
          "actions"
        ],
        "properties": {
          "information_state_id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "integer",
            "minimum": 0
          },
          "observable_history": {
            "type": "object",
            "required": [
              "observations",
              "prior_actions"
            ],
            "properties": {
              "observations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "stage",
                    "values"
                  ],
                  "properties": {
                    "stage": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "values": {
                      "type": "object",
                      "minProperties": 1,
                      "propertyNames": {
                        "not": {
                          "enum": [
                            "scenario_id",
                            "scenario_label",
                            "latent_scenario_id",
                            "future_scenario_id",
                            "future_shock",
                            "hidden_outcome",
                            "future_outcome",
                            "true_future_state",
                            "oracle_label",
                            "clairvoyant_state",
                            "mode_id",
                            "latent_mode",
                            "latent_mode_id",
                            "hidden_mode",
                            "hidden_mode_id",
                            "true_mode"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              },
              "prior_actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "service_levels": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "resource_balances": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "action_id",
                "fixed_cost",
                "resource_use",
                "ambiguity_family_id",
                "joint_ambiguity_candidates"
              ],
              "properties": {
                "action_id": {
                  "type": "string",
                  "minLength": 1
                },
                "fixed_cost": {
                  "type": "number",
                  "minimum": 0
                },
                "resource_use": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "ambiguity_family_id": {
                  "type": "string",
                  "minLength": 1
                },
                "joint_ambiguity_candidates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/jointCandidate"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "candidate_integrity_contract": {
      "type": "object",
      "required": [
        "candidate_is_indivisible",
        "mode_probability_vector",
        "within_mode_kernels",
        "coupling_provenance",
        "action_dependence_freeze"
      ],
      "properties": {
        "candidate_is_indivisible": {
          "const": true
        },
        "mode_probability_vector": {
          "type": "string",
          "minLength": 1
        },
        "within_mode_kernels": {
          "type": "string",
          "minLength": 1
        },
        "coupling_provenance": {
          "type": "string",
          "minLength": 1
        },
        "action_dependence_freeze": {
          "const": "before-confirmatory-evaluation"
        }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "jointCandidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "mode_probability_vector",
        "within_mode_kernels",
        "joint_coupling_basis",
        "candidate_family_id",
        "freeze_sha256"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "mode_probability_vector": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "within_mode_kernels": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "outcome_id",
                "probability",
                "stage_cost",
                "next_information_state_id",
                "observation"
              ],
              "properties": {
                "outcome_id": {
                  "type": "string",
                  "minLength": 1
                },
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "stage_cost": {
                  "type": "number",
                  "minimum": 0
                },
                "next_information_state_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observation": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "stage",
                        "values"
                      ],
                      "properties": {
                        "stage": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "values": {
                          "type": "object",
                          "minProperties": 1,
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "observation_likelihoods": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "joint_coupling_basis": {
          "type": "string",
          "minLength": 1
        },
        "candidate_family_id": {
          "type": "string",
          "minLength": 1
        },
        "freeze_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
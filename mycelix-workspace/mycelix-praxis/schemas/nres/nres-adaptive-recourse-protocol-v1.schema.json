{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:nres:016:adaptive-recourse-protocol:v1",
  "title": "Praxis NRES-016 Adaptive Recourse Protocol",
  "type": "object",
  "required": [
    "benchmark_id",
    "schema_version",
    "status",
    "evaluation_split",
    "active_in_curriculum",
    "research_question",
    "horizon_contract",
    "state_definition",
    "resource_ledgers",
    "information_structure",
    "decision_dependent_uncertainty",
    "risk_contract",
    "hard_constraints",
    "candidate_methods",
    "shift_families",
    "reporting_metrics",
    "confirmatory_targets",
    "guardrails"
  ],
  "properties": {
    "benchmark_id": {"const": "PRAXIS-NRES-016-ADAPTIVE-RECOURSE-001"},
    "schema_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "status": {"const": "protocol-template-for-review"},
    "evaluation_split": {"const": "public-development-only"},
    "active_in_curriculum": {"const": false},
    "research_question": {"type": "string", "minLength": 1},
    "horizon_contract": {
      "type": "object",
      "required": ["stage_indexing", "minimum_stages", "terminal_state", "replanning_rule"],
      "properties": {
        "stage_indexing": {"const": "zero-based-finite-horizon"},
        "minimum_stages": {"type": "integer", "minimum": 2},
        "maximum_stages": {"type": "integer", "minimum": 2},
        "terminal_state": {"type": "string", "minLength": 1},
        "replanning_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "state_definition": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["field", "semantics", "observable_status"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "semantics": {"type": "string", "minLength": 1},
          "observable_status": {"enum": ["observed", "partially-observed", "latent", "derived"]}
        },
        "additionalProperties": true
      }
    },
    "resource_ledgers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["resource_type", "conservation_rule", "replenishment_semantics", "nonnegative"],
        "properties": {
          "resource_type": {"type": "string", "minLength": 1},
          "conservation_rule": {"type": "string", "minLength": 1},
          "replenishment_semantics": {"type": "string", "minLength": 1},
          "nonnegative": {"const": true}
        },
        "additionalProperties": true
      }
    },
    "information_structure": {
      "type": "object",
      "required": ["policy_input", "nonanticipativity_rule", "history_identity", "negative_controls"],
      "properties": {
        "policy_input": {"const": "observable-history-only"},
        "nonanticipativity_rule": {"type": "string", "minLength": 1},
        "history_identity": {"type": "string", "minLength": 1},
        "negative_controls": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "decision_dependent_uncertainty": {
      "type": "object",
      "required": ["enabled", "allowed_action_effects", "causal_evidence_rule", "freeze_before_confirmatory"],
      "properties": {
        "enabled": {"const": true},
        "allowed_action_effects": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "causal_evidence_rule": {"type": "string", "minLength": 1},
        "freeze_before_confirmatory": {"const": true}
      },
      "additionalProperties": true
    },
    "risk_contract": {
      "type": "object",
      "required": ["primary_dynamic_risk", "static_cvar_distinguished", "ambiguity_order", "service_floor_rule"],
      "properties": {
        "primary_dynamic_risk": {"enum": ["nested-conditional-cvar", "rectangular-stagewise-dro", "explicit-pathwise-constraints"]},
        "static_cvar_distinguished": {"const": true},
        "ambiguity_order": {"type": "string", "minLength": 1},
        "service_floor_rule": {"const": "non-compensatory-per-service-per-stage"}
      },
      "additionalProperties": true
    },
    "hard_constraints": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_methods": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["method_id", "description", "information_admissible"],
        "properties": {
          "method_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "information_admissible": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "shift_families": {
      "type": "array",
      "minItems": 7,
      "items": {"type": "string", "minLength": 1}
    },
    "reporting_metrics": {
      "type": "array",
      "minItems": 12,
      "items": {"type": "string", "minLength": 1}
    },
    "confirmatory_targets": {
      "type": "object",
      "required": [
        "exact_oracle_tolerance",
        "nonanticipativity_violation_count_max",
        "transition_invariant_pass_rate",
        "feasible_fixture_hard_violations_max",
        "minimum_regret_improvement",
        "paired_confidence_level",
        "nominal_cost_noninferiority"
      ],
      "properties": {
        "exact_oracle_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "nonanticipativity_violation_count_max": {"const": 0},
        "transition_invariant_pass_rate": {"const": 1.0},
        "feasible_fixture_hard_violations_max": {"const": 0},
        "minimum_regret_improvement": {"type": "number", "minimum": 0, "maximum": 1},
        "paired_confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "maximum": 1},
        "nominal_cost_noninferiority": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "guardrails": {
      "type": "array",
      "minItems": 6,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {"required": ["overall_resilience_score"]},
      {"required": ["composite_score"]},
      {"required": ["personal_suitability_score"]},
      {"required": ["political_affiliation"]},
      {"required": ["loyalty_score"]}
    ]
  }
}
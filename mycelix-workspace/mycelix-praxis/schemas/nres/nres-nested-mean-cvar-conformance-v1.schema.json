    "invalid_input_controls": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 1}},
    "boundary_cases": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}},
    "round_trip_requirements": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "non_claims": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
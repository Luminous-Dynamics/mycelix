{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:nres:016:ex1:nested-mean-cvar-conformance:v1",
  "title": "Praxis NRES-016 EX1 Nested Mean-CVaR Conformance Corpus",
  "type": "object",
  "required": [

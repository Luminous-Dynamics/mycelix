  "properties": {
    "benchmark_id": {"const": "PRAXIS-NRES-016-EX1-NESTED-MEAN-CVAR-CONFORMANCE-001"},
    "schema_version": {"const": "1.0.0"},
    "evaluation_split": {"const": "public-development-only"},

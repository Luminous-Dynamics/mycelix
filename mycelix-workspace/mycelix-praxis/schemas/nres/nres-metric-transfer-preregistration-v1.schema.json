{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mycelix:praxis:nres:015:metric-transfer-preregistration:v1",
  "title": "Praxis NRES-015 Metric Transfer and Bulk-Tail Preregistration",
  "type": "object",
  "required": [
    "benchmark_id",
    "schema_version",
    "status",
    "evaluation_split",
    "active_in_curriculum",
    "research_question",
    "split_roles",
    "custody_protocol",
    "candidate_methods",
    "metric_learning_protocol",
    "bulk_tail_protocol",
    "calibration_protocol",
    "shift_families",
    "reporting_metrics",
    "confirmatory_targets",
    "guardrails"
  ],
  "properties": {
    "benchmark_id": {
      "const": "PRAXIS-NRES-015-METRIC-TRANSFER-PREREG-001"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "protocol-template-for-review"
    },
    "evaluation_split": {
      "const": "public-development-only"
    },
    "active_in_curriculum": {
      "const": false
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "split_roles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "role",
          "purpose",
          "source_family_disjoint",
          "outcome_visibility"
        ],
        "properties": {
          "role": {
            "enum": [
              "training",
              "validation",
              "calibration",
              "public_development",
              "confirmatory_hidden"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "source_family_disjoint": {
            "const": true
          },
          "outcome_visibility": {
            "enum": [
              "visible_to_training_team",
              "visible_for_public_development",
              "custodian_only_until_lock"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "custody_protocol": {
      "type": "object",
      "required": [
        "unit_of_partition",
        "family_id_policy",
        "manifest_commitment",
        "hidden_outcome_policy",
        "freeze_record",
        "limits"
      ],
      "properties": {
        "unit_of_partition": {
          "const": "independent-source-family"
        },
        "family_id_policy": {
          "type": "string",
          "minLength": 1
        },
        "manifest_commitment": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hidden_outcome_policy": {
          "type": "string",
          "minLength": 1
        },
        "freeze_record": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "candidate_methods": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "method_id",
          "description",
          "trainable",
          "requires_calibration"
        ],
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "trainable": {
            "type": "boolean"
          },
          "requires_calibration": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "metric_learning_protocol": {
      "type": "object",
      "required": [
        "allowed_metric_families",
        "metric_validity_properties",
        "normalization_rule",
        "training_loss_profile_count_min",
        "heldout_loss_profile_count_min",
        "freeze_before_calibration",
        "forbidden_leakage"
      ],
      "properties": {
        "allowed_metric_families": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metric_validity_properties": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "normalization_rule": {
          "type": "string",
          "minLength": 1
        },
        "training_loss_profile_count_min": {
          "type": "integer",
          "minimum": 1
        },
        "heldout_loss_profile_count_min": {
          "type": "integer",
          "minimum": 1
        },
        "freeze_before_calibration": {
          "const": true
        },
        "forbidden_leakage": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "bulk_tail_protocol": {
      "type": "object",
      "required": [
        "bulk_definition",
        "contamination_model",
        "tail_bound_requirement",
        "unbounded_loss_rule",
        "vacuity_reporting"
      ],
      "properties": {
        "bulk_definition": {
          "type": "string",
          "minLength": 1
        },
        "contamination_model": {
          "type": "string",
          "minLength": 1
        },
        "tail_bound_requirement": {
          "type": "string",
          "minLength": 1
        },
        "unbounded_loss_rule": {
          "type": "string",
          "minLength": 1
        },
        "vacuity_reporting": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "calibration_protocol": {
      "type": "object",
      "required": [
        "calibration_unit",
        "block_dependence_rule",
        "population_law_assumption",
        "coverage_outputs",
        "importance_weight_outputs",
        "federated_privacy_rule"
      ],
      "properties": {
        "calibration_unit": {
          "const": "source-family-block"
        },
        "block_dependence_rule": {
          "type": "string",
          "minLength": 1
        },
        "population_law_assumption": {
          "type": "string",
          "minLength": 1
        },
        "coverage_outputs": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "importance_weight_outputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "federated_privacy_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "shift_families": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reporting_metrics": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confirmatory_targets": {
      "type": "object",
      "required": [
        "primary_estimand",
        "minimum_regret_improvement",
        "paired_confidence_level",
        "nominal_cost_noninferiority",
        "familywise_source_custody",
        "no_composite_score"
      ],
      "properties": {
        "primary_estimand": {
          "type": "string",
          "minLength": 1
        },
        "minimum_regret_improvement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "paired_confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "maximum": 1
        },
        "nominal_cost_noninferiority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "familywise_source_custody": {
          "const": true
        },
        "no_composite_score": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "guardrails": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "overall_resilience_score"
        ]
      },
      {
        "required": [
          "composite_score"
        ]
      },
      {
        "required": [
          "personal_suitability_score"
        ]
      },
      {
        "required": [
          "political_affiliation"
        ]
      },
      {
        "required": [
          "loyalty_score"
        ]
      }
    ]
  }
}

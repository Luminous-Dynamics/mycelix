{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/temporal-compute-placement-v0.1.schema.json",
  "title": "Temporal Compute Placement Problem v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workers", "tasks"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "workers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/worker" } },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "operator_id", "region_id", "failure_domain_id", "cpu_millis", "memory_mib", "gpu_slots", "cpu_price_microusd_per_vcpu_hour", "gpu_price_microusd_per_slot_hour"],
      "properties": {
        "worker_id": { "type": "string", "minLength": 1 },
        "operator_id": { "type": "string", "minLength": 1 },
        "region_id": { "type": "string", "minLength": 1 },
        "failure_domain_id": { "type": "string", "minLength": 1 },
        "cpu_millis": { "type": "integer", "minimum": 1 },
        "memory_mib": { "type": "integer", "minimum": 1 },
        "gpu_slots": { "type": "integer", "minimum": 0 },
        "cpu_price_microusd_per_vcpu_hour": { "type": "integer", "minimum": 0 },
        "gpu_price_microusd_per_slot_hour": { "type": "integer", "minimum": 0 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "permitted_regions", "input_region", "input_bytes", "cpu_millis", "memory_mib", "gpu_slots", "start_ms", "end_ms"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "permitted_regions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "input_region": { "type": "string", "minLength": 1 },
        "input_bytes": { "type": "integer", "minimum": 0 },
        "cpu_millis": { "type": "integer", "minimum": 1 },
        "memory_mib": { "type": "integer", "minimum": 1 },
        "gpu_slots": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

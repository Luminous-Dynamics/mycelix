{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/black-hole-evidence-manifest-v1.schema.json",
  "title": "Black-Hole Scientific Evidence Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","schema_version","case_id","epistemic_status","claims","sources","data_artifacts","software","workflow","physical_conventions","uncertainty","verification","claim_ceiling"],
  "properties": {
    "schema": {"const": "luminous.black-hole-evidence-manifest"},
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "epistemic_status": {"type": "string", "enum": ["established_theory","analytic_derivation","published_observation","published_inference","simulation_result","computational_reproduction","independent_replication","hypothesis","contested_interpretation","inconclusive","retracted"]},
    "claims": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["claim_id","statement","claim_class","scope"],"properties":{"claim_id":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},"claim_class":{"type":"string","enum":["component_extraction","observable_estimate","physical_interpretation","theory_prediction","simulation_validation","law_test","software_performance"]},"scope":{"type":"string","minLength":1},"supersedes_claim_id":{"type":["string","null"]},"contradicting_claim_ids":{"type":"array","items":{"type":"string"}}}}},
    "sources": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["source_id","source_type","title","locator","version_or_date"],"properties":{"source_id":{"type":"string","minLength":1},"source_type":{"type":"string","enum":["publication","preprint","data_release","software","protocol","catalog_entry"]},"title":{"type":"string","minLength":1},"authors":{"type":"array","items":{"type":"string"}},"doi":{"type":["string","null"]},"arxiv":{"type":["string","null"]},"locator":{"type":"string","format":"uri"},"version_or_date":{"type":"string","minLength":1},"publication_status":{"type":"string","enum":["published","accepted","preprint","dataset_release","software_release"]}}}},
    "data_artifacts": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["artifact_id","source_id","locator","media_type","availability","checksums"],"properties":{"artifact_id":{"type":"string","minLength":1},"source_id":{"type":"string","minLength":1},"locator":{"type":"string","format":"uri"},"media_type":{"type":"string","minLength":1},"license":{"type":["string","null"]},"availability":{"type":"string","enum":["public","controlled","embargoed","unavailable"]},"file_name":{"type":["string","null"]},"release_version":{"type":["string","null"]},"checksums":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["algorithm","digest"],"properties":{"algorithm":{"type":"string","enum":["sha256","blake3","md5"]},"digest":{"type":"string","pattern":"^[0-9a-fA-F]+$"}}}}}}},
    "software": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["software_id","repository","revision","license"],"properties":{"software_id":{"type":"string","minLength":1},"repository":{"type":"string","format":"uri"},"revision":{"type":"string","minLength":1},"release":{"type":["string","null"]},"license":{"type":"string","minLength":1},"dirty_worktree":{"type":"boolean"}}}},
    "workflow": {"type":"object","additionalProperties":false,"required":["protocol_reference","configuration_digest","command_or_entrypoint"],"properties":{"protocol_reference":{"type":"string","minLength":1},"preregistration_locator":{"type":["string","null"],"format":"uri"},"configuration_digest":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},"command_or_entrypoint":{"type":"string","minLength":1},"random_seed":{"type":["integer","null"]},"data_conditioning":{"type":["string","null"]}}},
    "physical_conventions": {"type":"object","additionalProperties":false,"required":["units_system","metric_signature","coordinate_chart","time_convention"],"properties":{"units_system":{"type":"string","enum":["SI","geometrized","mixed_explicit"]},"metric_signature":{"type":"string","enum":["-+++","+---","not_applicable"]},"coordinate_chart":{"type":"string","minLength":1},"coordinate_order":{"type":"array","items":{"type":"string"}},"time_convention":{"type":"string","minLength":1},"spin_convention":{"type":["string","null"]},"waveform_mode":{"type":["array","null"],"items":{"type":"integer"},"minItems":2,"maxItems":2}}},
    "parameter_summary": {"type":"object","description":"Summary only; preserve full paired posterior samples as a separately hashed artifact.","additionalProperties":true},
    "uncertainty": {"type":"object","additionalProperties":false,"required":["statistical","numerical","calibration","model_form","data_quality"],"properties":{"statistical":{"type":["string","null"]},"numerical":{"type":["string","null"]},"calibration":{"type":["string","null"]},"model_form":{"type":["string","null"]},"data_quality":{"type":["string","null"]},"posterior_artifact_id":{"type":["string","null"]}}},
    "verification": {"type":"object","additionalProperties":false,"required":["status","protocol_reference","results"],"properties":{"status":{"type":"string","enum":["not_attempted","in_progress","reproduced","replicated","failed","inconclusive","disputed"]},"protocol_reference":{"type":"string","minLength":1},"verifier_identity":{"type":["string","null"]},"verifier_revision":{"type":["string","null"]},"results":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["check_id","outcome","summary"],"properties":{"check_id":{"type":"string","minLength":1},"outcome":{"type":"string","enum":["supports","does_not_support","inconclusive"]},"summary":{"type":"string","minLength":1},"result_artifact_id":{"type":["string","null"]}}}}}},
    "claim_ceiling": {"type":"string","minLength":1}
  }
}
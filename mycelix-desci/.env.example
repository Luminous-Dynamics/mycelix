# API authentication. Generate a high-entropy secret; do not commit the real value.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=https://identity.example.org
JWT_AUDIENCE=mycelix-desci-api

# Canonical scientific event, authority-receipt, mirror, and publication-outbox storage.
# "postgres" is the production-oriented multi-process path. "file" remains the
# deterministic reference backend; "memory" is simulation only.
DESCI_SCIENTIFIC_EVENT_BACKEND=postgres
DESCI_POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DESCI_POSTGRES_URL=postgres://mycelix:${DESCI_POSTGRES_PASSWORD}@postgres:5432/mycelix_desci
DESCI_POSTGRES_MAX_CONNECTIONS=16
DESCI_POSTGRES_ACQUIRE_TIMEOUT_SECONDS=10
# Set false when migrations are applied by a separate deployment job.
DESCI_POSTGRES_AUTO_MIGRATE=false
# Production authority writes require a short-lived externally signed lease.
# Expiration is strict: clock-skew allowance never extends expires_at.
DESCI_REQUIRE_AUTHORITY_WRITE_FENCING=true
DESCI_AUTHORITY_DEPLOYMENT_ID=mycelix-desci-production
DESCI_AUTHORITY_WRITE_LEASE_FILE=./runtime/authority/current-write-lease.json
DESCI_AUTHORITY_WRITE_LEASE_TRUST_FILE=./config/authority-write-lease-trust.json
DESCI_AUTHORITY_WRITE_LEASE_CLOCK_SKEW_SECONDS=30
# Used only when DESCI_SCIENTIFIC_EVENT_BACKEND=file
DESCI_SCIENTIFIC_EVENT_PATH=./data/scientific-events

# Append-only actor/key/role authority. PostgreSQL deployments should first
# bootstrap file journals offline, then atomically import them with
# credential-authority-import-postgres before starting the API.
DESCI_CREDENTIAL_REGISTRY_BACKEND=postgres
# Used only when DESCI_CREDENTIAL_REGISTRY_BACKEND=file
DESCI_CREDENTIAL_REGISTRY_PATH=./data/scientific-credentials.json
DESCI_CREDENTIAL_BOOTSTRAP_TRUST_FILE=./config/credential-bootstrap-trust.json
DESCI_MIN_CREDENTIAL_REGISTRY_ADMINS=2

# Threshold governance over every non-genesis credential mutation. Initialize
# this journal after registering at least the configured minimum administrators.
DESCI_CREDENTIAL_GOVERNANCE_BACKEND=postgres
# Used only when DESCI_CREDENTIAL_GOVERNANCE_BACKEND=file
DESCI_CREDENTIAL_GOVERNANCE_PATH=./data/scientific-credential-governance.json
# Require the latest published checkpoint to be witnessed by this many distinct organizations.
# Set to 0 only for development or before external witnesses have been enrolled.
DESCI_MIN_CHECKPOINT_WITNESS_ORGANIZATIONS=2
# Require signed, currently valid mirror observations from distinct organizations.
DESCI_MIN_CHECKPOINT_MIRROR_ORGANIZATIONS=2

# Receipt-time authority evidence and credential-acceptance timestamps. The
# domain-separated service key must contain 32 raw bytes or 64 hex characters,
# must be distinct from every actor key, and should be mode 0600.
DESCI_AUTHORITY_RECEIPT_SIGNING_KEY_FILE=./config/authority-receipt-signing.key
DESCI_SCIENTIFIC_AUTHORITY_AUDIT_PATH=./data/scientific-authority
# Optional JSON array of historical trusted receipt public keys for key rotation.
# DESCI_AUTHORITY_RECEIPT_TRUST_FILE=./config/authority-receipt-trust.json
# Durable delivery envelopes may use either a local mode-0600 Ed25519 seed
# or the Unix-domain remote signer below. Configure exactly one mechanism.
# The key must differ from actor, receipt, epoch, witness, and lease keys.
DESCI_AUTHORITY_OUTBOX_SIGNING_KEY_FILE=./config/authority-outbox-signing.key
# DESCI_AUTHORITY_OUTBOX_SIGNER_SOCKET=/run/authority-signer/outbox.sock
# DESCI_AUTHORITY_OUTBOX_SIGNER_KEY_ID=pkcs11:slot-7:outbox
# DESCI_AUTHORITY_OUTBOX_SIGNER_PUBLIC_KEY=<64-hex-character-ed25519-public-key>
# DESCI_AUTHORITY_OUTBOX_SIGNER_TIMEOUT_MILLIS=5000
# Optional at-least-once publication endpoint for committed SQL outbox rows.
# Receivers must deduplicate using the Idempotency-Key or X-Mycelix-Outbox-Id header.
# DESCI_AUTHORITY_OUTBOX_WEBHOOK_URL=https://archive.example.org/mycelix/outbox
# DESCI_AUTHORITY_OUTBOX_WORKER_ID=mycelix-api-primary
# DESCI_AUTHORITY_OUTBOX_ALLOW_INSECURE_HTTP=false
# DESCI_AUTHORITY_OUTBOX_BATCH_SIZE=50
# DESCI_AUTHORITY_OUTBOX_LEASE_SECONDS=60
# DESCI_AUTHORITY_OUTBOX_POLL_MILLIS=1000
# Optional readiness gates. Zero disables the corresponding gate.
DESCI_MAX_PENDING_AUTHORITY_OUTBOX=1000
DESCI_MAX_AUTHORITY_OUTBOX_AGE_SECONDS=3600

# Governed PostgreSQL primary epochs. PostgreSQL deployments should remain
# unready until an initial threshold-authorized epoch is published. Independent
# delivery witnesses should acknowledge the immutable epoch publication.
DESCI_REQUIRE_AUTHORITY_DATABASE_EPOCH=true
DESCI_MIN_DATABASE_EPOCH_ACK_ORGANIZATIONS=2

# Only a contiguous pre-v0.5 prefix may be acknowledged. Unsafe post-cutover receipt gaps always block readiness.
DESCI_ALLOW_UNATTESTED_AUTHORITY_HISTORY=false

# Legacy mutable writes are disabled by default. Enable only during a bounded migration window.
DESCI_ENABLE_LEGACY_MUTATIONS=false

# Compatibility claim storage remains separate from the canonical event log.
DESCI_STORAGE_BACKEND=memory

PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8106
RUST_LOG=mycelix_api=info,tower_http=info

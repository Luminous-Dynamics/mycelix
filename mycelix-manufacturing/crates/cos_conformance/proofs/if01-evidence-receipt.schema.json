{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IF01 Formal Evidence Receipt",
  "type": "object",
  "required": ["obligation_ids","artifact_path","artifact_identity","source_commit","build_identity","runner_image","os","solver","solver_version","command","expected_result","actual_result","timestamp","status","claim_ceiling","excluded_claims"],
  "properties": {
    "obligation_ids": {"type":"array","minItems":1,"items":{"type":"string","pattern":"^IF01-FV-[0-9]{3}$"}},
    "artifact_path": {"type":"string","minLength":1},
    "artifact_identity": {"type":"string","minLength":1},
    "source_commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "build_identity": {"type":"string"},
    "runner_image": {"type":"string"},
    "os": {"type":"string"},
    "solver": {"type":"string"},
    "solver_version": {"type":"string"},
    "command": {"type":"string"},
    "output_digest": {"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "expected_result": {"type":"string"},
    "actual_result": {"type":"string","minLength":1},
    "timestamp": {"type":"string","format":"date-time"},
    "status": {"enum":["BoundedExecutableWitness","FormallyClosed","Failed","Unknown"]},
    "claim_ceiling": {"type":"string"},
    "excluded_claims": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}

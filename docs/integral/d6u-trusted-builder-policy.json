{
  "policy_version": 1,
  "workflow_name": "D6U Holochain 0.7 Runtime Qualification",
  "workflow_path": ".github/workflows/d6u-runtime-qualification.yml",
  "artifact_name_prefix": "d6u-runtime-evidence-",
  "claim_ceiling": "ReferenceModelOnly",
  "runtime": {
    "holochain": "0.7.0",
    "hdk": "0.7.0",
    "hdi": "0.8.0"
  },
  "unsupported_reference_cases": [
    "wire-signature-valid",
    "nonce-stale",
    "payload-mutation"
  ],
  "record_fields": [
    "status",
    "source_commit",
    "workflow_run_id",
    "workflow_run_attempt",
    "workflow_execution_commit_sha",
    "workflow_execution_ref",
    "attestation_status",
    "workflow_sha",
    "d6s2_manifest_git_blob_sha",
    "d6s2_fixture_git_blob_sha",
    "d6s2_authority_ledger_schema",
    "d6s1_corpus_sha256",
    "test_log_sha256",
    "manifest_version",
    "manifest_git_blob_sha",
    "evidence_verifier_git_blob_sha",
    "lock_verifier_git_blob_sha",
    "case_coverage",
    "supplemental_coverage",
    "application_check_coverage",
    "case_outcome_classes",
    "runtime",
    "hdk",
    "hdi",
    "rust",
    "rust_verbose_commit",
    "cargo",
    "cargo_lock_sha256",
    "test",
    "supported_cases",
    "unsupported_cases",
    "claim_ceiling"
  ],
  "cases": {
    "canonical-payload-accepted": {"outcome": "accepted", "zome_reached": true},
    "authorized-semantic-rejection": {"outcome": "semantic-rejected", "zome_reached": true},
    "wire-signature-invalid": {"outcome": "authentication-failed", "zome_reached": false},
    "author-grant": {"outcome": "accepted", "zome_reached": true},
    "valid-capability": {"outcome": "accepted", "zome_reached": true},
    "wrong-capability": {"outcome": "authorization-failed", "zome_reached": false},
    "revoked-capability": {"outcome": "authorization-failed", "zome_reached": false},
    "provenance-mismatch": {"outcome": "authorization-failed", "zome_reached": false},
    "nonce-replay": {"outcome": "authorization-failed", "zome_reached": false},
    "expired-invocation": {"outcome": "authorization-failed", "zome_reached": false},
    "wrong-zome": {"outcome": "routing-failed", "zome_reached": false},
    "wrong-function": {"outcome": "routing-failed", "zome_reached": false},
    "wrong-cell": {"outcome": "routing-failed", "zome_reached": false},
    "blocked-provenance": {"outcome": "authorization-failed", "zome_reached": false}
  },
  "supplemental_substrate": {
    "future-expiry-rejection": "Future",
    "wrong-zome-routing": "Zome not found: Zome 'wrong-zome' not found",
    "wrong-function-routing": "Attempted to call a zome function that doesn't exist: Zome: coordinator Fn no_such_function",
    "wrong-cell-routing": "CellMissing("
  },
  "application_check": {
    "id": "probe-local-d6s-commitment-mutation",
    "fragment": "result=d6s-commitment-mismatch;zome-reached=true"
  },
  "lock_packages": {
    "holochain": "0.7.0",
    "hdk": "0.7.0",
    "hdi": "0.8.0",
    "holochain_keystore": "0.7.0",
    "holochain_nonce": "0.7.0",
    "holochain_serialized_bytes": "0.0.57",
    "holochain_types": "0.7.0"
  },
  "lock_source": "registry+https://github.com/rust-lang/crates.io-index"
}

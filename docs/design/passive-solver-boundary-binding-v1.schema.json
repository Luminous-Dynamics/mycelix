{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/passive-solver-boundary-binding-v1.json",
  "title": "Mycelix Passive Solver Boundary Binding Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_digest",
    "port_id",
    "interface_digest",
    "solver_boundary",
    "adapter_id",
    "external_boundary_handle",
    "candidate_geometry_digest",
    "candidate_mesh_digest",
    "boundary_patch_digest",
    "semantic_status",
    "solver_binding_verified",
    "physical_transport_unproven"
  ],
  "properties": {
    "schema_version": {
      "const": "passive-solver-boundary-binding-v1"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "port_id": {
      "type": "integer",
      "minimum": 0
    },
    "interface_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "solver_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "id"],
      "properties": {
        "domain": {
          "enum": [
            "Mechanical",
            "Fluidic",
            "Thermal",
            "Acoustic",
            "Electromagnetic",
            "Optical",
            "Chemical"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "external_boundary_handle": {
      "type": "string",
      "minLength": 1
    },
    "candidate_geometry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_mesh_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundary_patch_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_status": {
      "const": "SolverBoundaryBinding"
    },
    "solver_binding_verified": {
      "const": true
    },
    "physical_transport_unproven": {
      "const": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

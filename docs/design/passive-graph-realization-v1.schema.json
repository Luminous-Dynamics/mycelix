{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/passive-graph-realization-v1.json",
  "title": "Mycelix Passive Functional-Graph Realization Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_digest",
    "graph_digest",
    "candidate_geometry_digest",
    "status",
    "declared_flow_paths",
    "connected_paths",
    "disconnected_paths",
    "invalid_paths",
    "path_results",
    "unexpected_flow_connectivity",
    "physical_transport_unproven"
  ],
  "properties": {
    "schema_version": {
      "const": "passive-graph-realization-v1"
    },
    "artifact_digest": {
      "type": "string",
      "minLength": 1
    },
    "graph_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_geometry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "InvalidGraph",
        "NoFlowPathsDeclared",
        "AllDeclaredPathsConnected",
        "TopologyDivergence",
        "PartialRealization",
        "NoDeclaredPathsConnected"
      ]
    },
    "declared_flow_paths": {
      "type": "integer",
      "minimum": 0
    },
    "connected_paths": {
      "type": "integer",
      "minimum": 0
    },
    "disconnected_paths": {
      "type": "integer",
      "minimum": 0
    },
    "invalid_paths": {
      "type": "integer",
      "minimum": 0
    },
    "path_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_port",
          "to_port",
          "status",
          "physical_transport_unproven"
        ],
        "properties": {
          "from_port": {
            "type": "integer",
            "minimum": 0
          },
          "to_port": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "Connected",
              "Disconnected",
              "InvalidGraph",
              "InvalidMesh",
              "UndeclaredPath",
              "AnchorNotRepresented",
              "AmbiguousAnchor",
              "BoundaryPolicyRejected"
            ]
          },
          "from_component": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "to_component": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "physical_transport_unproven": {
            "const": true
          }
        }
      }
    },
    "physical_transport_unproven": {
      "const": true
    },
    "solver_evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "manufacturability_evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unexpected_flow_connectivity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_port",
          "to_port",
          "component"
        ],
        "properties": {
          "from_port": {
            "type": "integer",
            "minimum": 0
          },
          "to_port": {
            "type": "integer",
            "minimum": 0
          },
          "component": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}

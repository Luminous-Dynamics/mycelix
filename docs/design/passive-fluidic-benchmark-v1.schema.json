{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/passive-fluidic-benchmark-v1.json",
  "title": "Mycelix Passive Fluidic Benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_digest",
    "topology_digest",
    "backend",
    "operating_point",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "passive-fluidic-benchmark-v1"
    },
    "artifact_digest": {
      "type": "string",
      "minLength": 1
    },
    "topology_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Exact",
            "ReducedOrder",
            "Surrogate",
            "Measurement"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operating_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density_kg_m3",
        "viscosity_pa_s",
        "forward_flow_rate_m3_s",
        "reverse_flow_rate_m3_s",
        "relative_flow_mismatch",
        "max_relative_flow_mismatch"
      ],
      "properties": {
        "density_kg_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "viscosity_pa_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hydraulic_diameter_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "forward_flow_rate_m3_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reverse_flow_rate_m3_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "relative_flow_mismatch": {
          "type": "number",
          "minimum": 0
        },
        "max_relative_flow_mismatch": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward_pressure_drop_pa",
        "reverse_pressure_drop_pa",
        "diodicity",
        "valid_paired_comparison"
      ],
      "properties": {
        "forward_pressure_drop_pa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reverse_pressure_drop_pa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "diodicity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "valid_paired_comparison": {
          "type": "boolean"
        },
        "convergence_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manufacturability_evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "verification_evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "measurement_evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

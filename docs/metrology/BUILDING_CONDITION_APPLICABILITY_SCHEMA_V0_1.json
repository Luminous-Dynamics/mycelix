{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mycelix Building Condition Applicability Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "classification",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix.building-condition-applicability-corpus/0.1"
    },
    "corpus_id": {
      "const": "BUILDING-CONDITION-APPLICABILITY-CORPUS-V0.1"
    },
    "classification": {
      "const": "synthetic_condition_applicability_cases"
    },
    "claim_ceiling": {
      "const": "synthetic_condition_envelope_match_only"
    },
    "cases": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "description",
        "record",
        "expected_disposition"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^CCA-[0-9]{3}$"
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "observations"
          ],
          "properties": {
            "profile": {
              "$ref": "#/$defs/profile"
            },
            "observations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/observation"
              }
            }
          }
        },
        "expected_disposition": {
          "enum": [
            "WITHIN_DECLARED_ENVELOPE",
            "OUTSIDE_DECLARED_ENVELOPE",
            "INDETERMINATE_BOUNDARY_OVERLAP",
            "MISSING_REQUIRED_CONDITION",
            "NOT_COMPARABLE",
            "EXPIRED_OR_INVALIDATED",
            "REJECTED_FOR_DECLARED_PURPOSE"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "profile_revision",
        "domain_id",
        "classification",
        "claim_ceiling",
        "subject_instrument_id",
        "sample_tick",
        "timebase_id",
        "clock_epoch_id",
        "spatial_scope_id",
        "dimensions"
      ],
      "properties": {
        "schema_version": {
          "const": "mycelix.building-condition-profile/0.1"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_revision": {
          "type": "string",
          "minLength": 1
        },
        "domain_id": {
          "enum": [
            "thermal-environment",
            "water-closed-conduit",
            "ac-power-quality-50hz",
            "pm25-monitoring"
          ]
        },
        "classification": {
          "const": "synthetic_condition_applicability_profile"
        },
        "claim_ceiling": {
          "const": "synthetic_condition_envelope_match_only"
        },
        "subject_instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_tick": {
          "type": "integer"
        },
        "timebase_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "spatial_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dimension"
          }
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "kind",
        "quantity_kind",
        "unit",
        "minimum",
        "maximum",
        "allowed_values",
        "method_id",
        "method_revision",
        "critical"
      ],
      "properties": {
        "dimension_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "numeric_range",
            "categorical"
          ]
        },
        "quantity_kind": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "method_revision": {
          "type": "string",
          "minLength": 1
        },
        "critical": {
          "const": true
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "value",
        "unit",
        "uncertainty_value",
        "uncertainty_unit",
        "source_kind",
        "source_id",
        "source_state",
        "source_receipt_id",
        "calibration_state",
        "rights_state",
        "quality_state",
        "method_id",
        "method_revision",
        "profile_id",
        "profile_revision",
        "timebase_id",
        "clock_epoch_id",
        "valid_from_tick",
        "valid_to_tick",
        "spatial_scope_id"
      ],
      "properties": {
        "dimension_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "uncertainty_unit": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "reference_instrument",
            "verified_configuration"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_state": {
          "enum": [
            "independently_admitted",
            "provider_assertion",
            "unknown"
          ]
        },
        "source_receipt_id": {
          "type": "string"
        },
        "calibration_state": {
          "enum": [
            "current",
            "expired",
            "unknown",
            "not_applicable"
          ]
        },
        "rights_state": {
          "enum": [
            "authorized",
            "revoked",
            "unknown"
          ]
        },
        "quality_state": {
          "enum": [
            "valid",
            "stale",
            "device_fault",
            "out_of_range",
            "unknown"
          ]
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "method_revision": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_revision": {
          "type": "string",
          "minLength": 1
        },
        "timebase_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_from_tick": {
          "type": "integer"
        },
        "valid_to_tick": {
          "type": "integer"
        },
        "spatial_scope_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/MYC_DIR_FABRIC_REFERENCE_BENCHMARK_V0_1.schema.json",
  "title": "Mycelix Directory Fabric reference benchmark preregistration v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "status",
    "claim_ceiling",
    "source_binding",
    "repetition_protocol",
    "corpus_binding",
    "workload_profiles",
    "metrics",
    "fault_schedules",
    "comparators",
    "dependency_cut_profiles",
    "causal_cut_corpus_binding",
    "graph_proof_workload_profiles",
    "effect_fence_profiles",
    "postgres_effect_owner_profiles",
    "effect_surface_inventory_profiles",
    "queue_worker_profiles",
    "queue_worker_corpus_binding"
  ],
  "properties": {
    "profile": {
      "const": "MYC-DIR-FABRIC-REFERENCE-BENCHMARK-0.1"
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "preregistered_not_executed"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 30
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_at_execution",
        "bind_each_sample_to_exact_commit",
        "no_moving_branch_references"
      ],
      "properties": {
        "required_at_execution": {
          "type": "array",
          "minItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "bind_each_sample_to_exact_commit": {
          "const": true
        },
        "no_moving_branch_references": {
          "const": true
        }
      }
    },
    "repetition_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_repetitions_minimum",
        "load_generation",
        "report_per_run",
        "raw_samples_required",
        "do_not_average_percentiles_across_runs",
        "separate_real_and_simulated_peers",
        "include_warm_and_cold_cache_profiles",
        "include_overload_and_recovery"
      ],
      "properties": {
        "independent_repetitions_minimum": {
          "type": "integer",
          "minimum": 10
        },
        "load_generation": {
          "const": "open_loop"
        },
        "report_per_run": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "p50",
              "p95",
              "p99",
              "maximum",
              "offered_rate",
              "accepted_rate",
              "error_rate"
            ]
          }
        },
        "raw_samples_required": {
          "const": true
        },
        "do_not_average_percentiles_across_runs": {
          "const": true
        },
        "separate_real_and_simulated_peers": {
          "const": true
        },
        "include_warm_and_cold_cache_profiles": {
          "const": true
        },
        "include_overload_and_recovery": {
          "const": true
        }
      }
    },
    "corpus_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_path",
        "declared_scenario_count",
        "expected_decision_counts",
        "held_out_corpus_required",
        "independent_oracle_required"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "schema_path": {
          "type": "string"
        },
        "declared_scenario_count": {
          "const": 30
        },
        "expected_decision_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ALLOW",
            "DENY",
            "INDETERMINATE"
          ],
          "properties": {
            "ALLOW": {
              "const": 5
            },
            "DENY": {
              "const": 14
            },
            "INDETERMINATE": {
              "const": 11
            }
          }
        },
        "held_out_corpus_required": {
          "const": true
        },
        "independent_oracle_required": {
          "const": true
        }
      }
    },
    "workload_profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "principals",
          "relationship_edges",
          "real_conductors_min",
          "real_conductors_max",
          "purpose"
        ],
        "properties": {
          "id": {
            "enum": [
              "smoke",
              "development",
              "qualification",
              "stress"
            ]
          },
          "principals": {
            "type": "integer",
            "minimum": 1
          },
          "relationship_edges": {
            "type": "integer",
            "minimum": 0
          },
          "real_conductors_min": {
            "type": "integer",
            "minimum": 1
          },
          "real_conductors_max": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layer",
          "metric",
          "unit",
          "statistic",
          "workload_profile",
          "target",
          "gate",
          "measurement_state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "layer": {
            "type": "string",
            "minLength": 2
          },
          "metric": {
            "type": "string",
            "minLength": 10
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "statistic": {
            "type": "string",
            "minLength": 2
          },
          "workload_profile": {
            "enum": [
              "smoke",
              "development",
              "qualification",
              "stress",
              "all"
            ]
          },
          "target": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operator",
                  "value"
                ],
                "properties": {
                  "operator": {
                    "enum": [
                      "==",
                      "<=",
                      "<",
                      ">=",
                      ">"
                    ]
                  },
                  "value": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "gate": {
            "enum": [
              "non_compensable",
              "performance_target",
              "report_only"
            ]
          },
          "measurement_state": {
            "const": "not_measured"
          }
        }
      }
    },
    "fault_schedules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "comparators": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "consistency_profile"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "scope": {
            "type": "string",
            "minLength": 10
          },
          "consistency_profile": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "dependency_cut_profiles": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": false,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dependencies",
          "includes_explicit_denies",
          "includes_revocation_dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "dependencies": {
            "type": "integer",
            "minimum": 1
          },
          "includes_explicit_denies": {
            "const": true
          },
          "includes_revocation_dependencies": {
            "const": true
          }
        }
      }
    },
    "causal_cut_corpus_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_path",
        "declared_scenario_count",
        "expected_decision_counts",
        "unique_scenario_ids_required",
        "independent_closure_completeness_oracle_required",
        "effect_owner_history_oracle_required"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "schema_path": {
          "type": "string"
        },
        "declared_scenario_count": {
          "const": 24
        },
        "expected_decision_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ALLOW",
            "DENY",
            "INDETERMINATE"
          ],
          "properties": {
            "ALLOW": {
              "const": 8
            },
            "DENY": {
              "const": 4
            },
            "INDETERMINATE": {
              "const": 12
            }
          }
        },
        "unique_scenario_ids_required": {
          "const": true
        },
        "independent_closure_completeness_oracle_required": {
          "const": true
        },
        "effect_owner_history_oracle_required": {
          "const": true
        }
      }
    },
    "graph_proof_workload_profiles": {
      "type": "array",
      "minItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "benchmark",
              "fact_table_rows",
              "query_families",
              "additional_query_families",
              "purpose"
            ],
            "properties": {
              "id": {
                "const": "ldbc_snb_interactive_comparator"
              },
              "benchmark": {
                "type": "string"
              },
              "fact_table_rows": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "query_families": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "type": "string"
                }
              },
              "additional_query_families": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "purpose": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "benchmark",
              "fact_table_rows",
              "query_families",
              "additional_query_families",
              "purpose"
            ],
            "properties": {
              "id": {
                "const": "directory_authority_graph"
              },
              "benchmark": {
                "type": "string"
              },
              "fact_table_rows": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "query_families": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "type": "string"
                }
              },
              "additional_query_families": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "purpose": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "benchmark",
              "authority_roots",
              "dependency_cut_sizes",
              "purpose"
            ],
            "properties": {
              "id": {
                "const": "multi_realm_graph_federation"
              },
              "benchmark": {
                "type": "string"
              },
              "authority_roots": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "dependency_cut_sizes": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "effect_fence_profiles": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "effect_owners",
          "atomic_mutation_guard",
          "strict_completion_requires_all_owner_acks",
          "purpose"
        ],
        "properties": {
          "id": {
            "enum": [
              "single_owner_atomic_mutation",
              "multi_owner_all_ack",
              "non_fenceable_external_adapter"
            ]
          },
          "effect_owners": {
            "type": "integer",
            "minimum": 1
          },
          "atomic_mutation_guard": {
            "type": "boolean"
          },
          "strict_completion_requires_all_owner_acks": {
            "const": true
          },
          "purpose": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "postgres_effect_owner_profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "postgres_major_versions",
          "writer_concurrency",
          "object_count",
          "isolation_profile",
          "synchronous_commit",
          "purpose"
        ],
        "properties": {
          "id": {
            "enum": [
              "pg_parallel_writer_read_committed",
              "pg_revocation_barrier_contention",
              "pg_commit_unknown_idempotency_replay",
              "pg_synchronous_failover_fence_recovery",
              "pg_worker_claim_reassignment_race"
            ]
          },
          "postgres_major_versions": {
            "type": "array",
            "minItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                15,
                16,
                17,
                18,
                19
              ]
            }
          },
          "writer_concurrency": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "object_count": {
            "type": "integer",
            "minimum": 1
          },
          "isolation_profile": {
            "enum": [
              "READ COMMITTED",
              "SERIALIZABLE"
            ]
          },
          "synchronous_commit": {
            "enum": [
              "on",
              "off_negative_control"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "effect_surface_inventory_profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route_counts",
          "owner_counts",
          "inventory_churn_per_minute",
          "purpose"
        ],
        "properties": {
          "id": {
            "enum": [
              "effect_inventory_small",
              "effect_inventory_enterprise",
              "effect_inventory_churn",
              "caep_signal_fanout"
            ]
          },
          "route_counts": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "owner_counts": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "inventory_churn_per_minute": {
            "type": "integer",
            "minimum": 0
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "queue_worker_profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "messages_per_second",
          "worker_count",
          "backlog_messages",
          "command_age_seconds",
          "purpose"
        ],
        "properties": {
          "id": {
            "enum": [
              "queue_worker_small",
              "queue_worker_production",
              "queue_worker_enterprise_stress",
              "queue_worker_revocation_backlog"
            ]
          },
          "messages_per_second": {
            "type": "integer",
            "minimum": 1
          },
          "worker_count": {
            "type": "integer",
            "minimum": 1
          },
          "backlog_messages": {
            "type": "integer",
            "minimum": 1
          },
          "command_age_seconds": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "queue_worker_corpus_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_path",
        "declared_scenario_count",
        "unique_scenario_ids_required",
        "independent_oracle_required",
        "broker_delivery_and_effect_owner_results_separated"
      ],
      "properties": {
        "path": {
          "const": "docs/benchmarks/MYC_DIR_QUEUE_WORKER_V0_1.json"
        },
        "schema_path": {
          "const": "docs/benchmarks/MYC_DIR_QUEUE_WORKER_V0_1.schema.json"
        },
        "declared_scenario_count": {
          "const": 29
        },
        "unique_scenario_ids_required": {
          "const": true
        },
        "independent_oracle_required": {
          "const": true
        },
        "broker_delivery_and_effect_owner_results_separated": {
          "const": true
        }
      }
    }
  }
}

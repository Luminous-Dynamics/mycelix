{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mcrb-transparency-trust-root-v0.1.json",
  "title": "MCRB Transparency Log Trust Root v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trust_root_id",
    "owner",
    "valid_from_unix_ms",
    "expires_at_unix_ms",
    "logs",
    "required_log_operator_diversity",
    "known_shared_log_dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "mcrb-transparency-trust-root-v0.1"
    },
    "trust_root_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "valid_from_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "log_id",
          "operator_id",
          "tree_hash_algorithm",
          "checkpoint_keys",
          "valid_from_unix_ms",
          "expires_at_unix_ms"
        ],
        "properties": {
          "log_id": {
            "type": "string",
            "minLength": 1
          },
          "operator_id": {
            "type": "string",
            "minLength": 1
          },
          "tree_hash_algorithm": {
            "const": "sha256-rfc6962"
          },
          "checkpoint_keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key_id",
                "public_key_hex",
                "valid_from_unix_ms",
                "expires_at_unix_ms",
                "revoked"
              ],
              "properties": {
                "key_id": {
                  "type": "string",
                  "minLength": 1
                },
                "public_key_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "valid_from_unix_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "expires_at_unix_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "revoked": {
                  "type": "boolean"
                },
                "rotation_predecessor_key_id": {
                  "type": "string"
                }
              }
            }
          },
          "valid_from_unix_ms": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at_unix_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "required_log_operator_diversity": {
      "type": "integer",
      "minimum": 1
    },
    "known_shared_log_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}

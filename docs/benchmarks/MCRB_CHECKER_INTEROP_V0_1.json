{
  "schema_version": "mycelix-mcrb-checker-interoperability-v0.1",
  "benchmark_id": "MCRB",
  "artifact_id": "MCRB-CHECKER-INTEROP-001",
  "status": "proposed-not-executed",
  "source_issue": "https://github.com/Luminous-Dynamics/mycelix/issues/6415",
  "purpose": "Machine-readable known-answer fixture corpus and semantic routing policy for interoperability between MCRB evidence-qualified histories and established distributed-systems history checkers.",
  "external_references": [
    {
      "id": "jepsen",
      "url": "https://github.com/jepsen-io/jepsen",
      "scope": "fault-injected operation histories and consistency checking"
    },
    {
      "id": "elle",
      "url": "https://github.com/jepsen-io/elle",
      "scope": "transactional anomaly and dependency-cycle checking"
    },
    {
      "id": "porcupine",
      "url": "https://github.com/anishathalye/porcupine",
      "scope": "linearizability checking against a declared sequential specification"
    },
    {
      "id": "foundationdb-simulation",
      "url": "https://github.com/apple/foundationdb/blob/main/documentation/sphinx/source/testing.rst",
      "scope": "integrated deterministic simulation plus live performance and hardware failure testing"
    },
    {
      "id": "antithesis",
      "url": "https://antithesis.com/docs/introduction/how_antithesis_works/",
      "scope": "deterministic full-stack simulation and hostile state-space exploration"
    }
  ],
  "existing_owners": {
    "multiconductor_partial_order": "#5843 / PR #5771",
    "one_shot_linearizability": "#6193",
    "deterministic_model_generation": "#6045",
    "authenticated_outcomes": "#6357",
    "operation_propositions": "#6392",
    "timing_provenance": "#6335",
    "observation_provenance": "#6140",
    "compound_fault_schedules": "#6407 / PR #6408"
  },
  "canonical_input_policy": {
    "source_of_offered_operations": "#6342 verified offer ledger",
    "source_of_operation_semantics": "#6392 pre-dispatch operation contract",
    "source_of_terminal_outcomes": "#6357 authenticated outcome ledger",
    "source_of_cross_conductor_causality": "#5843 pulse-multiconductor-history-v2",
    "source_of_timing": "#6335 raw local ticks and qualified cross-host intervals",
    "no_runner_authored_success": true,
    "no_wall_clock_total_order": true,
    "no_majority_vote_between_checkers": true
  },
  "jepsen_mapping": {
    "operation_phases": {
      "invoke": "invoke",
      "ok": "ok",
      "fail": "fail",
      "info": "info"
    },
    "info_semantics": "Possibly applied or unknown outcome. Never coerce info to fail or success; reconcile before QOPS.",
    "nemesis_semantics": "Fault-injection operations remain separate timeline/nemesis events and never become client terminal outcomes.",
    "retained_extensions": [
      "operation_id",
      "attempt_id",
      "request_digest_sha256",
      "idempotency_key_commitment_sha256",
      "causal_edge_refs",
      "evidence_refs",
      "effect_state"
    ],
    "claim_boundary": "A checked history supports only the selected Jepsen consistency model and observed workload; it does not establish all MCRB authority, privacy, witness or recovery guarantees."
  },
  "elle_profile": {
    "applicability": "transaction histories whose operations, transaction boundaries and declared consistency model match the supported Elle profile",
    "non_applicability": [
      "DHT convergence",
      "capability revocation",
      "external physical effect observation",
      "institutional authority",
      "unknown or incomplete transaction boundaries"
    ],
    "result_policy": "Preserve anomaly witness and consistency profile; unsupported semantics are NotApplicable or Incomplete, never coerced to pass."
  },
  "porcupine_profile": {
    "applicability": "concurrent histories against one declared sequential object specification",
    "requirements": [
      "exact sequential-specification digest",
      "exact input-history digest",
      "per-operation invocation/completion identity",
      "explicit treatment of info/unknown operations"
    ],
    "initial_target": "#6193 one-shot capability consume/effect-admission semantics",
    "non_applicability": "No declared sequential object or unresolved outcomes that the adapter cannot represent without inventing a return value.",
    "claim_boundary": "Linearizability is only relative to the declared object specification and captured history."
  },
  "deterministic_replay_profile": {
    "generator_owner": "#6045",
    "schedule_owner": "#6407",
    "replay_inputs": [
      "manifest_digest",
      "scenario_id",
      "seed_commitment",
      "generator_binary_digest",
      "runtime_tuple",
      "topology_digest",
      "scheduler_version"
    ],
    "statement": "Deterministic logical schedule replay is not equivalent to integrated deterministic simulation of production runtime code."
  },
  "result_composition": {
    "dispositions": [
      "valid",
      "invalid",
      "indeterminate",
      "incomplete",
      "not-applicable"
    ],
    "disagreement": "Any semantically comparable checker disagreement is preserved and produces Indeterminate pending independent adjudication; never majority-vote.",
    "bind": [
      "history_digest",
      "source_sha_and_tree",
      "scenario_contract_digest",
      "operation_contract_registry_digest",
      "runtime_tuple",
      "topology_digest",
      "generator_digest",
      "seed_commitment",
      "checker_binary_digest",
      "model_or_spec_digest",
      "checker_output_digest",
      "claim_ceiling"
    ],
    "qops_rule": "Checker results are evidence inputs, not standalone authorization to mark QOPS eligible. The authenticated outcome, gate, timing, observer and witness policies remain mandatory."
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mycelix-mcrb-scenario-pack-v0.1.json",
  "title": "Mycelix Coordination and Recovery Benchmark Scenario Pack v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "status",
    "source_main_sha",
    "runtime_candidates",
    "harness_layers",
    "comparator_profiles",
    "required_run_provenance",
    "statistical_protocol",
    "hard_failure_policy",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix-mcrb-scenario-pack-v0.1"
    },
    "benchmark_id": {
      "const": "MCRB"
    },
    "benchmark_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed-not-executed",
        "pilot",
        "qualified"
      ]
    },
    "source_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "harness_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "comparator_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "equivalence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "equivalence": {
            "type": "string"
          }
        }
      }
    },
    "required_run_provenance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "statistical_protocol": {
      "type": "object",
      "required": [
        "minimum_independent_repetitions",
        "preferred_repetitions_for_headline_claims",
        "report_percentiles",
        "require_confidence_intervals",
        "randomized_run_order",
        "preserve_per_peer_distributions"
      ],
      "properties": {
        "minimum_independent_repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "preferred_repetitions_for_headline_claims": {
          "type": "integer",
          "minimum": 1
        },
        "report_percentiles": {
          "type": "array",
          "items": {
            "enum": [
              "p50",
              "p95",
              "p99"
            ]
          }
        },
        "require_confidence_intervals": {
          "type": "boolean"
        },
        "randomized_run_order": {
          "type": "boolean"
        },
        "preserve_per_peer_distributions": {
          "type": "boolean"
        }
      }
    },
    "hard_failure_policy": {
      "type": "object",
      "required": [
        "correctness_failure_invalidates_performance_claim",
        "false_authorization_limit",
        "private_payload_leak_limit",
        "duplicate_external_effect_limit",
        "stale_head_qualification_limit",
        "unknown_outcome_requires_reconciliation"
      ],
      "properties": {
        "correctness_failure_invalidates_performance_claim": {
          "type": "boolean"
        },
        "false_authorization_limit": {
          "const": 0
        },
        "private_payload_leak_limit": {
          "const": 0
        },
        "duplicate_external_effect_limit": {
          "const": 0
        },
        "stale_head_qualification_limit": {
          "const": 0
        },
        "unknown_outcome_requires_reconciliation": {
          "type": "boolean"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "class",
          "question",
          "topology",
          "operations",
          "failure_injection",
          "metrics",
          "hard_invariants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MCRB-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "upstream_wind_tunnel_scenarios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": "string"
          },
          "topology": {
            "type": "object",
            "required": [
              "agents",
              "roles",
              "peer_profile"
            ],
            "properties": {
              "agents": {
                "type": "integer",
                "minimum": 0
              },
              "roles": {
                "type": "integer",
                "minimum": 0
              },
              "peer_profile": {
                "type": "string"
              }
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "failure_injection": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "hard_invariants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}

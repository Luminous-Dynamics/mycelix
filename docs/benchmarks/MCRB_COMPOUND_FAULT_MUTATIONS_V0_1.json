  "metamorphic_tests": [
    {
      "test_id": "MCRB-MM-01",
      "name": "independent-event-array-permutation",
      "transformation": "Permute serialized order of events that have no causal relation while preserving event identities, local process sequence and causal edges.",
      "invariant": "Semantic report and claim dispositions remain identical.",
      "expected": "same-semantic-result"
    },
    {
      "test_id": "MCRB-MM-02",
      "name": "wall-clock-label-invariance",
      "transformation": "Change descriptive wall-clock labels while preserving local monotonic ticks, clock IDs, epochs and evidence-backed causal edges.",
      "invariant": "Causal order and local-duration results remain identical; no cross-host order may be inferred.",
      "expected": "same-semantic-result"
    },
    {
      "test_id": "MCRB-MM-03",
      "name": "duplicate-witness-does-not-increase-quorum",
      "transformation": "Duplicate an attestation envelope byte-for-byte under a different transport/event ID but retain the same witness identity, key and failure-domain lineage.",
      "invariant": "Distinct witness count and quorum disposition do not increase.",
      "expected": "same-quorum-result"
    },
    {
      "test_id": "MCRB-MM-04",
      "name": "same-seed-replay",
      "transformation": "Replay the same frozen manifest, source inputs, seed commitment, generator digest, runtime tuple, topology and scheduler version.",
      "invariant": "Logical schedule digest and expected oracle disposition are identical.",
      "expected": "same-schedule-and-result"
    },
    {
      "test_id": "MCRB-MM-05",
      "name": "json-object-key-order-invariance",
      "transformation": "Reorder JSON object member serialization without changing typed values, event identities or raw evidence commitments.",
      "invariant": "Parsed semantic disposition is unchanged; exact-byte artifact digest is expected to change.",
      "expected": "same-semantic-result-new-byte-digest"
    }
  ],
  "acceptance": {
    "mutation_count_minimum": 21,
    "metamorphic_test_count_minimum": 5,
    "every_scenario_has_at_least_three_mutations": true,
    "every_mutation_has_expected_claim_and_qops_disposition": true,
    "every_mutation_has_stable_reason_code": true,
    "false_acceptance_target": 0,
    "false_rejection_target": "report separately; never hide in aggregate accuracy",
    "disagreements": "indeterminate-until-independent-adjudication"
  }
}

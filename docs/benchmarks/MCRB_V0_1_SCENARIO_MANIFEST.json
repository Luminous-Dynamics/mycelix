  "harness_layers": [
    {
      "id": "substrate-runtime",
      "name": "Holochain Wind Tunnel",
      "purpose": "Reuse version-pinned substrate scenarios for DHT synchronization, zome calls, validation receipts, remote signals and host telemetry."

  "receipt_schema": "MCRB_V0_1_RUN_RECEIPT.schema.json",
  "harness_layers": [
    {
      "id": "substrate-runtime",
      "name": "Holochain Wind Tunnel",
      "purpose": "Reuse version-pinned substrate scenarios for DHT synchronization, zome calls, validation receipts, remote signals and host telemetry."
    },
    {
      "id": "application-semantics",
      "name": "Mycelix MCRB semantic layer",
      "purpose": "Qualify author/authority correctness, revocation, privacy, idempotent effects, migration, recovery and evidence receipts."
    }
  ],
  "wind_tunnel_reuse_policy": {
    "use_existing_runtime_harness": true,
    "version_specific_scenario_mapping_required": true,
    "required_substrate_dimensions": [
      "DHT synchronization/convergence",
      "zome call latency",
      "validation receipts",
      "remote/direct signals",
      "peer topology/churn",
      "host CPU/memory/disk telemetry"
    ],
    "add_application_semantic_scenarios": true,
    "never_compare_unmatched_runtime_versions": true,
    "never_claim_upstream_metric_as_mycelix_application_qualification": true,
    "wind_tunnel_compatibility": {
      "status": "holochain-0.7.1-not-established-by-public-compatibility-matrix",
      "observed_wind_tunnel_release": "v0.7.1",
      "observed_published_compatibility_pair": "Holochain 0.6.3 / Kitsune2 0.4.1",
      "observed_pinned_holochain_0_7_report": "Holochain 0.7.0 with 30 nodes; does not establish 0.7.1 compatibility",
      "roadmap_snapshot_date": "2026-11-17",
      "roadmap_wind_tunnel_for_0_7_completion": "77 percent (23/30 points)",
      "required_before_0_7_1_use": [
        "pin exact Wind Tunnel release or commit",
        "pin exact Holochain 0.7.1 binary SHA and Kitsune2 graph",
        "build the Wind Tunnel scenario graph against Holochain 0.7.1",
        "run fresh-conductor smoke scenarios for app install, zome call, DHT sync and remote/direct signal",
        "bind every run to exact runtime and raw artifacts",
        "keep Wind Tunnel substrate metrics separate from Mycelix semantic qualification"
      ],
      "interim_policy": "Use Wind Tunnel methodology and compatible scenarios as reference. Port or adapt only after exact 0.7.1 build and smoke qualification; do not infer compatibility from Wind Tunnel's own 0.7.1 release tag."
    }
  },
  "measurement_quality": {
    "require_monotonic_local_durations": true,
    "require_clock_source_and_sync_method": true,
    "require_cross_host_offset_and_uncertainty": true,
    "reject_negative_non_finite_or_out_of_run_durations": true,
    "preserve_and_classify_outliers": true,
    "silently_trim_or_clamp_outliers": false,
    "require_per_peer_distributions": true,
    "aggregate_only_after_member_samples_validate": true,
    "require_send_receive_counter_reconciliation": true,
    "invalid_measurements_block_performance_claims": true,
    "run_statuses": [
      "application-fail",
      "measurement-invalid",
      "infrastructure-incomplete",
      "qualified"
    ],
    "require_raw_monotonic_tick_pairs": true,
    "derive_local_duration_from_tick_delta": true,
    "require_clock_epoch_identity_per_sample": true,
    "require_publish_observe_event_pairing_for_cross_host_convergence": true,
    "require_cross_host_uncertainty_interval": true,
    "forbid_cross_host_point_latency_without_uncertainty_bound": true,
    "cross_host_timing_claim_status": "not-qualified-until-mcrb-time-001"
  },
  "metric_integrity_verifier": {
    "crate_path": "mycelix-workspace/tools/mcrb-metric-integrity",

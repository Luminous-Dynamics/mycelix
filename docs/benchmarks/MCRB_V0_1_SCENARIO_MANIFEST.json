    "follow_up_issue": "#6335"
  },
  "qualified_operations_policy": {
    "name": "Qualified Operations Per Second",
    "formula": "count(operations that satisfy the complete scenario-specific contract for verified authority, provenance, required peer visibility/freshness, and verified external-effect receipt when applicable) / fixed_measurement_window_seconds",
    "invalid_when": [
      "any_hard_correctness_gate_fails",
      "metric_integrity_status_not_valid"
    ],
    "required_companion_metrics": [

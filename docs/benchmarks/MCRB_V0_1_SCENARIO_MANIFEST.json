{
  "schema_version": "mycelix-mcrb-v0.1",
  "benchmark_id": "MCRB",
  "status": "proposed-no-results",
  "purpose": "Measure correctness, coordination performance, privacy and recoverability under matched and explicitly stated semantics.",
  "execution_principle": "correctness-gate-before-performance",
  "scale_ladder": [
    {
      "tier": "smoke",
      "conductors_min": 3,
      "conductors_max": 5,
      "mode": "real-conductors-required"
    },
    {
      "tier": "development",
      "conductors": 20,
      "mode": "real-conductors-required"
    },
    {
      "tier": "qualification",
      "conductors": 100,
      "mode": "real-conductors-required"
    },
    {
      "tier": "stress",
      "conductors_min": 500,
      "mode": "exploratory-real-conductors-or-explicitly-labelled-simulation"
    }
  ],
  "comparators": [
    {
      "id": "holochain-0.6.1",
      "class": "runtime-baseline",
      "direct_comparison": "yes-after-semantic-equivalence",
      "notes": "Use only an exact reproducible Holochain 0.6.1 runtime and declared hApp contract."
    },
    {
      "id": "holochain-0.7.1",
      "class": "runtime-candidate",
      "direct_comparison": "yes-after-semantic-equivalence",
      "notes": "Must pass dependency closure, fresh-conductor, multi-agent and client gates before qualification."
    },
    {
      "id": "postgresql-single-writer-outbox",
      "class": "centralized-architecture-baseline",
      "direct_comparison": "same-intent-slice-only",
      "notes": "Generic semantics profile; instantiate as the frozen PostgreSQL 18.6 or current 18.7 pgbench profile below. Report centralized authority and consistency semantics; do not imply peer-authority equivalence."
    },
    {
      "id": "hyperledger-fabric-caliper",
      "class": "permissioned-ledger-baseline",
      "direct_comparison": "same-intent-slice-only",
      "notes": "Pin Fabric version, Caliper version, connector and endorsement/orderer policy. Current Caliper project docs list Fabric v2.x, but README marks the Network SDK and Gateway SDK integrations deprecated; verify supported connector path before using the result."
    },
    {
      "id": "libp2p-iroh-ipfs",
      "class": "network-or-storage-component",
      "direct_comparison": "component-only",
      "notes": "Not an application-authority comparator unless validation, authorization, privacy and recovery semantics are built above it."
    },
    {
      "id": "yjs-automerge",
      "class": "crdt-collaboration-component",
      "direct_comparison": "component-only",
      "notes": "Compare offline document editing, conflict-free merge and convergence; not identity authority, revocation, legal consent or external-effect finality."
    },
    {
      "id": "postgresql-18.6-pgbench",
      "class": "frozen-centralized-architecture-baseline",
      "direct_comparison": "same-intent-slice-only",
      "notes": "Retain the v0.1 ADR's PostgreSQL 18.6 baseline as a frozen historical comparison. Publish exact image/binary digest, custom pgbench script and outbox transaction contract."
    },
    {
      "id": "postgresql-18.7-pgbench",
      "class": "current-centralized-architecture-candidate",
      "direct_comparison": "same-intent-slice-only",
      "notes": "PostgreSQL 18.7 was released 12 November 2026. Pin exact image/binary digest and use custom transaction scripts for the workflow; do not treat default TPC-B-like output as application equivalence."
    }
  ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mcrb-run-receipt-v0.1.json",
  "title": "Mycelix MCRB Run Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "status",
    "source",
    "runtime",
    "topology",
    "environment",
    "workload",
    "timing",
    "scenario_results",
    "metrics",
    "evidence",
    "verifier",
    "claim_ceiling",
    "metric_integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix-mcrb-run-receipt-v0.1"
    },
    "benchmark_id": {
      "const": "MCRB"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "queued",
        "running",
        "executed-pass",
        "executed-fail",
        "non-executed",
        "superseded"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree_digest"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_digest": {
          "type": "string",
          "minLength": 32
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conductor_version",
        "hdk_version",
        "hdi_version",
        "rust_client_version",
        "js_client_version",
        "lair_version",
        "kitsune2_version",
        "runtime_binary_digest",
        "lockfile_digests"
      ],
      "properties": {
        "conductor_version": {
          "type": "string"
        },
        "hdk_version": {
          "type": "string"
        },
        "hdi_version": {
          "type": "string"
        },
        "rust_client_version": {
          "type": "string"
        },
        "js_client_version": {
          "type": "string"
        },
        "lair_version": {
          "type": "string"
        },
        "kitsune2_version": {
          "type": "string"
        },
        "runtime_binary_digest": {
          "type": "string"
        },
        "lockfile_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "manifest_digest",
        "conductor_count",
        "peer_layout"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "manifest_digest": {
          "type": "string"
        },
        "conductor_count": {
          "type": "integer",
          "minimum": 1
        },
        "peer_layout": {
          "type": "string"
        },
        "network_seed_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_profile",
        "os_kernel",
        "network_profile"
      ],
      "properties": {
        "hardware_profile": {
          "type": "string"
        },
        "os_kernel": {
          "type": "string"
        },
        "network_profile": {
          "type": "string"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "seed",
        "parameters"
      ],
      "properties": {
        "manifest_digest": {
          "type": "string"
        },
        "seed": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at",
        "warmup_seconds",
        "measurement_seconds"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "warmup_seconds": {
          "type": "number",
          "minimum": 0
        },
        "measurement_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "scenario_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "outcome",
          "executed_head",
          "assertions",
          "artifacts"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "not-executed",
              "skipped",
              "cancelled",
              "superseded"
            ]
          },
          "executed_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "assertions": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "boolean",
                "integer",
                "number",
                "string"
              ]
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "null"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_trace_digests",
        "log_digests",
        "artifact_digests"
      ],
      "properties": {
        "raw_trace_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "claim_ceiling": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metric_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "clock_source",
        "clock_sync_method",
        "host_clock_observations",
        "duration_clock",
        "negative_duration_count",
        "non_finite_duration_count",
        "out_of_run_duration_count",
        "outlier_count",
        "outliers_preserved",
        "peer_sample_coverage",
        "send_receive_counter_mismatch_count",
        "aggregate_eligible",
        "raw_monotonic_tick_derived_count",
        "clock_epoch_mismatch_count",
        "unmatched_cross_host_event_count",
        "cross_host_latency_lower_bound_ms",
        "cross_host_latency_upper_bound_ms",
        "point_latency_emitted_count",
        "monotonic_clock_id_mismatch_count",
        "reversed_monotonic_tick_count",
        "invalid_ticks_per_second_count",
        "cross_host_interval_count",
        "cross_host_point_latency_emitted_count",
        "cross_host_calibration_invalid_count",
        "event_pair_digest_mismatch_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "invalid",
            "incomplete"
          ]
        },
        "clock_source": {
          "type": "string"
        },
        "clock_sync_method": {
          "type": "string"
        },
        "host_clock_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host_id",
              "clock_source",
              "sync_method",
              "offset_ms",
              "uncertainty_ms",
              "local_duration_clock"
            ],
            "properties": {
              "host_id": {
                "type": "string"
              },
              "clock_source": {
                "type": "string"
              },
              "sync_method": {
                "type": "string"
              },
              "offset_ms": {
                "type": "number"
              },
              "uncertainty_ms": {
                "type": "number",
                "minimum": 0
              },
              "local_duration_clock": {
                "const": "monotonic"
              }
            }
          }
        },
        "duration_clock": {
          "const": "monotonic"
        },
        "negative_duration_count": {
          "type": "integer",
          "minimum": 0
        },
        "non_finite_duration_count": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_run_duration_count": {
          "type": "integer",
          "minimum": 0
        },
        "outlier_count": {
          "type": "integer",
          "minimum": 0
        },
        "outliers_preserved": {
          "type": "boolean"
        },
        "peer_sample_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "send_receive_counter_mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "aggregate_eligible": {
          "type": "boolean"
        },
        "raw_monotonic_tick_derived_count": {
          "type": "integer",
          "minimum": 0
        },
        "clock_epoch_mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_cross_host_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "cross_host_latency_lower_bound_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cross_host_latency_upper_bound_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "point_latency_emitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "monotonic_clock_id_mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "reversed_monotonic_tick_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_ticks_per_second_count": {
          "type": "integer",
          "minimum": 0
        },
        "cross_host_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "cross_host_point_latency_emitted_count": {
          "type": "integer",
          "minimum": 0
        },
        "cross_host_calibration_invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "event_pair_digest_mismatch_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "executed-pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "metric_integrity": {
            "properties": {
              "status": {
                "const": "valid"
              },
              "aggregate_eligible": {
                "const": true
              },
              "negative_duration_count": {
                "const": 0
              },
              "non_finite_duration_count": {
                "const": 0
              },
              "out_of_run_duration_count": {
                "const": 0
              },
              "send_receive_counter_mismatch_count": {
                "const": 0
              }
            },
            "required": [
              "status",
              "aggregate_eligible",
              "negative_duration_count",
              "non_finite_duration_count",
              "out_of_run_duration_count",
              "send_receive_counter_mismatch_count"
            ]
          }
        }
      }
    }
  ]
}

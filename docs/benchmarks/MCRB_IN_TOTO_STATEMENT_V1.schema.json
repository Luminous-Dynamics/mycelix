{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mcrb-in-toto-statement-v1.schema.json",
  "title": "MCRB in-toto Statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "predicateType": {
      "const": "https://luminousdynamics.io/attestations/mcrb-correctness-gate/v0.1"
    },
    "predicate": {
      "$ref": "MCRB_GATE_ATTESTATION_V0_1.schema.json"
    }
  }
}

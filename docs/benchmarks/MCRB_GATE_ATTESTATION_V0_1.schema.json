{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mcrb-correctness-gate-predicate-v0.1.json",
  "title": "MCRB Correctness Gate Predicate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "predicate_type",
    "run_id",
    "scenario_id",
    "scenario_contract_digest_sha256",
    "source_sha",
    "source_tree_git_sha",
    "runtime_identity_digest_sha256",
    "topology_profile_digest_sha256",
    "gate_id",
    "outcome",
    "evidence_artifact_digests_sha256",
    "verifier_identity",
    "verifier_version",
    "verifier_binary_digest_sha256",
    "builder_identity",
    "trust_policy_id",
    "trust_policy_digest_sha256",
    "issued_at_unix_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix-mcrb-gate-attestation-v0.1"
    },
    "predicate_type": {
      "const": "https://luminousdynamics.io/attestations/mcrb-correctness-gate/v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^MCRB-[0-9]{2}$"
    },
    "scenario_contract_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_tree_git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "runtime_identity_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "topology_profile_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "evidence_artifact_digests_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "verifier_identity": {
      "type": "string",
      "minLength": 1
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    },
    "verifier_binary_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "builder_identity": {
      "type": "string",
      "minLength": 1
    },
    "trust_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "trust_policy_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issued_at_unix_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mcrb-correctness-gate-predicate-v0.1.json",
  "title": "MCRB Correctness Gate Predicate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "scenario_contract_digest_sha256",
    "source",
    "runtime",
    "topology",
    "gate",
    "evidence",
    "verifier",
    "trust_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "mcrb-correctness-gate-predicate-v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^MCRB-[0-9]{2}$"
    },
    "scenario_contract_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "measurement_window_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_digest_sha256",
        "conductor_version",
        "hdk_version",
        "hdi_version",
        "runtime_binary_digest_sha256"
      ],
      "properties": {
        "profile_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "conductor_version": {
          "type": "string"
        },
        "hdk_version": {
          "type": "string"
        },
        "hdi_version": {
          "type": "string"
        },
        "runtime_binary_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lair_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "kitsune2_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "manifest_digest_sha256",
        "happ_digest_sha256",
        "dna_digests_sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "manifest_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "happ_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dna_digests_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "result",
        "verifier_observation_id"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "incomplete"
          ]
        },
        "verifier_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "digest_sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "digest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id",
        "version",
        "artifact_digest_sha256",
        "build_provenance_digest_sha256"
      ],
      "properties": {
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "build_provenance_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "trust_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_digest_sha256"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required_quorum": {
          "type": "integer",
          "minimum": 1
        },
        "require_transparency_evidence": {
          "type": "boolean"
        }
      }
    }
  }
}

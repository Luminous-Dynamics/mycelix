{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mcrb-dsse-envelope-v0.1.json",
  "title": "MCRB DSSE Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_type",
    "payload",
    "signatures"
  ],
  "properties": {
    "payload_type": {
      "const": "application/vnd.luminousdynamics.mcrb-correctness-gate.v0.1+json"
    },
    "payload": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 1
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyid",
          "sig"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "minLength": 1
          },
          "sig": {
            "type": "string",
            "contentEncoding": "base64",
            "minLength": 1
          }
        }
      }
    }
  },
  "description": "One Ed25519 DSSE signature per v0.1 gate-attestation envelope. Multiple independent gate attestations are supplied as separate envelopes."
}

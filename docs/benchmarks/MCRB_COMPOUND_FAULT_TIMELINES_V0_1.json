{
  "schema_version": "mycelix-mcrb-compound-fault-timelines-v0.1",
  "benchmark_id": "MCRB",
  "artifact_id": "MCRB-COMPOUND-FAULT-TIMELINES-001",
  "status": "proposed-not-executed",
  "purpose": "Executable, replayable compound-fault schedules testing whether Mycelix preserves authority, effect, observation, timing, recovery and witness-qualification invariants when multiple failures overlap.",
  "source_issue": "https://github.com/Luminous-Dynamics/mycelix/issues/6407",
  "scenario_manifest_ref": "docs/benchmarks/MCRB_V0_1_SCENARIO_MANIFEST.json",
  "schedule_model": {
    "version": "causal-dag-v1",
    "event_identity": "stable-event-id-within-scenario",
    "ordering": "causal-predecessors-define-happens-before; independent events may be interleaved by a deterministic scheduler",
    "randomness": "seeded-prng-with-committed-seed-digest; record generator binary digest and scheduler version",
    "clock_model": "per-host monotonic clock identity and epoch; wall-clock timestamps are descriptive only",
    "cross_host_timing": "emit intervals only when clock mapping, calibration validity and uncertainty bounds verify; otherwise NotEvaluated or Incomplete",
    "replay_requirement": "same manifest, seed, scenario inputs, runtime tuple and scheduler version reproduce the same logical action schedule",
    "simulated_actor_policy": "simulated actors must be explicitly labelled; simulated peers never count as real conductors",
    "concurrency_group_semantics": "Events sharing a concurrency_group have no causal order implied by the group; the seeded scheduler may interleave them, while each event's explicit causal_predecessors remain mandatory."
  },
  "result_vocabulary": {
    "execution": [
      "Executed",
      "NotRun",
      "Unsupported",
      "InfrastructureIncomplete"
    ],
    "effect": [
      "Applied",
      "ConfirmedNotApplied",
      "Partial",
      "Unknown",
      "NotAttempted"
    ],
    "evidence": [
      "QualifiedIndependent",
      "ProviderReportedOnly",
      "KnownSharedDependency",
      "UnknownRelationship",
      "Missing",
      "Contradictory",
      "Invalid"
    ],
    "claim": [
      "SupportedWithinScope",
      "Rejected",
      "Indeterminate",
      "NotEvaluated"
    ],
    "qops": [
      "Eligible",
      "Incomplete",
      "Invalid",
      "NotEligible"
    ]
  },
  "global_invariants": [
    "No protected effect after the qualified revocation barrier.",
    "No duplicate external effect for an offered operation and idempotency key.",
    "No QOPS numerator derived from caller-authored outcome labels.",
    "Unknown, partial, contradictory, missing or unsupported required evidence never silently becomes success.",
    "No DHT convergence claim from local zome-call success or a single peer observation.",
    "Unknown or known-shared critical dependencies never count toward witness independence quorum.",
    "No point cross-host latency without valid clock identity, epoch, mapping and uncertainty bounds.",
    "No recovery-complete claim until the complete promised record set and original identity are independently checked."
  ],

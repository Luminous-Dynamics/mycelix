{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mcrb-outcome-ledger-v0.1.json",
  "title": "Mycelix MCRB Per-Operation Outcome Ledger v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "scenario_contract_digest_sha256",
    "source",
    "runtime_identity_digest_sha256",
    "topology_profile_digest_sha256",
    "offer_ledger_digest_sha256",
    "measurement_window",
    "trust_policy_id",
    "trust_policy_digest_sha256",
    "entry_count",
    "entries",
    "ledger_digest_sha256",
    "operation_contract_registry_digest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix-mcrb-outcome-ledger-v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^MCRB-[0-9]{2}$"
    },
    "scenario_contract_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree_sha"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "runtime_identity_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "topology_profile_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "offer_ledger_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "clock_id",
        "clock_epoch",
        "start_tick",
        "end_tick",
        "ticks_per_second"
      ],
      "properties": {
        "window_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_epoch": {
          "type": "string",
          "minLength": 1
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "end_tick": {
          "type": "integer",
          "minimum": 1
        },
        "ticks_per_second": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "trust_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "trust_policy_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "operation_id",
          "request_digest_sha256",
          "idempotency_key_digest_sha256",
          "effect_state",
          "attestations",
          "operation_contract_id",
          "operation_contract_version",
          "operation_contract_digest_sha256",
          "attempt_state",
          "outcome_class"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "request_digest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "idempotency_key_digest_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effect_state": {
            "enum": [
              "applied",
              "confirmed-not-applied",
              "partial",
              "unknown",
              "not-attempted"
            ]
          },
          "attestations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "payloadType",
                "payload",
                "signatures"
              ],
              "properties": {
                "payloadType": {
                  "const": "application/vnd.in-toto+json"
                },
                "payload": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "minLength": 1
                },
                "signatures": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "keyid",
                      "sig"
                    ],
                    "properties": {
                      "keyid": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sig": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "prior_outcome_ledger_digest_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reconciliation_sequence": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "operation_contract_id": {
            "type": "string",
            "minLength": 1
          },
          "operation_contract_version": {
            "type": "string",
            "minLength": 1
          },
          "operation_contract_digest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempt_state": {
            "enum": [
              "not-dispatched",
              "dispatched",
              "accepted-at-local-boundary",
              "timed-out",
              "reconciled",
              "unsupported"
            ]
          },
          "outcome_class": {
            "enum": [
              "QualifiedSuccess",
              "CorrectDenial",
              "UnexpectedDenial",
              "Failed",
              "Unknown",
              "DuplicateEffect"
            ]
          }
        }
      }
    },
    "ledger_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation_contract_registry_digest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mcrb-outcome-attestation-v0.1.json",
  "title": "Mycelix MCRB Outcome Attestation — in-toto Statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://luminousdynamics.io/attestations/mcrb-operation-outcome/v0.1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "scenario_id",
        "scenario_contract_digest_sha256",
        "offer_ledger_digest_sha256",
        "operation_id",
        "offer_sequence",
        "request_digest_sha256",
        "idempotency_key_digest_sha256",
        "effect_state",
        "source",
        "source_sha",
        "source_tree_git_sha",
        "runtime_identity_digest_sha256",
        "topology_profile_digest_sha256",
        "attempt_id",
        "evidence",
        "verifier",
        "builder_identity",
        "trust_policy_id",
        "trust_policy_digest_sha256",
        "issued_at_unix_ms",
        "operation_contract_registry_digest_sha256",
        "operation_contract_id",
        "operation_contract_version",
        "operation_contract_digest_sha256",
        "attempt_state",
        "outcome_class"
      ],
      "properties": {
        "schema_version": {
          "const": "mycelix-mcrb-outcome-attestation-v0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^MCRB-[0-9]{2}$"
        },
        "scenario_contract_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "offer_ledger_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "offer_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "request_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "idempotency_key_digest_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_state": {
          "enum": [
            "applied",
            "confirmed-not-applied",
            "partial",
            "unknown",
            "not-attempted"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "key_id",
            "source_event_id",
            "source_role"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "source_event_id": {
              "type": "string",
              "minLength": 1
            },
            "source_role": {
              "enum": [
                "effect-executor",
                "provider",
                "policy-engine",
                "independent-observer",
                "reconciliation-authority",
                "telemetry"
              ]
            }
          }
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_tree_git_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runtime_identity_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "topology_profile_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_kind",
              "artifact_name",
              "artifact_digest_sha256",
              "captured_at_unix_ms",
              "coverage"
            ],
            "properties": {
              "evidence_kind": {
                "enum": [
                  "application-record",
                  "provider-acknowledgement",
                  "provider-status-query",
                  "independent-observation",
                  "policy-decision",
                  "failure-trace",
                  "reconciliation",
                  "cross-peer-read"
                ]
              },
              "artifact_name": {
                "type": "string",
                "minLength": 1
              },
              "artifact_digest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "captured_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "coverage": {
                "enum": [
                  "complete",
                  "partial",
                  "missing",
                  "duplicated",
                  "out-of-plan"
                ]
              }
            }
          }
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "version",
            "binary_digest_sha256"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "binary_digest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "builder_identity": {
          "type": "string",
          "minLength": 1
        },
        "trust_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_policy_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "issued_at_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "operation_contract_registry_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "operation_contract_version": {
          "type": "string",
          "minLength": 1
        },
        "operation_contract_digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempt_state": {
          "enum": [
            "not-dispatched",
            "dispatched",
            "accepted-at-local-boundary",
            "timed-out",
            "reconciled",
            "unsupported"
          ]
        },
        "outcome_class": {
          "enum": [
            "QualifiedSuccess",
            "CorrectDenial",
            "UnexpectedDenial",
            "Failed",
            "Unknown",
            "DuplicateEffect"
          ]
        }
      }
    }
  }
}

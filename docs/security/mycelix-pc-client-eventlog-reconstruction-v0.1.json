      "expected": "INDETERMINATE"
    }
  ],
  "qualification_required_artifacts": [
    "eventlog-reconstruction-input.json",
    "eventlog-reconstruction.json"
  ],
  "required_result_fields": [
    "profile_id",
    "profile_version",
    "event_log_sha256",
    "session_id",
    "pcr_bank",
    "pcr_selection",
    "event_count",
    "reconstructed_pcr_values",
    "reconstructed_pcrs_sha256",
    "observed_pcr_values",
    "observed_pcrs_sha256",
    "match",

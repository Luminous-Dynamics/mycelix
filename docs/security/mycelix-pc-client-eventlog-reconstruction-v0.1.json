{
  "schema_version": 1,
  "artifact_type": "pc-client-eventlog-reconstruction-contract",
  "profile_id": "mycelix.security.platform.eventlog.reconstruction",
  "profile_version": "0.1.0",
  "status": "executable-reference-profile",
  "claim_ceiling": "ReferenceModelOnly",
  "semantics": {
    "hash_algorithm": "SHA-256",
    "initial_pcr": "32 zero bytes for each SHA-256 PCR",
    "extend": "PCR[p] := SHA256(PCR[p] || event_digest)",
    "ordering": "source-log order is authoritative within each PCR; the verifier preserves the full event sequence and rejects duplicate/non-increasing sequence numbers",
    "scope": "reconstruct recorded PCR evolution; event digest truth, payload validation, reference appraisal, Quote verification, and platform authorization are separate decisions"
  },
  "event_schema": {
    "sequence": "strictly increasing integer",
    "pcr": "non-negative integer",
    "event_type": "string",
    "digest_sha256": "exactly 64 lowercase hexadecimal characters",
    "session_id": "optional; when present, must equal the reconstruction session_id"
  },
  "output_schema": {
    "profile_id": "string",
    "profile_version": "string",
    "event_log_sha256": "64 lowercase hex",
    "session_id": "string",
    "pcr_bank": "sha256",
    "pcr_selection": "sha256:<comma-separated unique PCR ids>",
    "event_count": "integer",
    "reconstructed_pcr_values": "PCR-id to 64-hex-value map",
    "reconstructed_pcrs_sha256": "canonical state hash",
    "observed_pcr_values": "PCR-id to 64-hex-value map",
    "observed_pcrs_sha256": "canonical state hash",
    "match": "boolean",
    "reconstruction_status": "PASS|DENY|INDETERMINATE",
    "input_sha256": "64 lowercase hex",
    "verifier_id": "fixed verifier identifier",
    "verifier_source_sha256": "64 lowercase hex",
    "content_sha256": "canonical self-hash excluding the content_sha256 field"
  },
  "invariants": [
    "one PCR bank per reconstruction",
    "event sequence is strictly increasing",
    "each event has one SHA-256 measurement digest",
    "each selected PCR starts at 32 zero bytes",
    "only events selecting a PCR update that PCR",
    "reconstructed selected-PCR state must equal independently observed selected-PCR state",
    "event-log parser success alone never establishes reconstruction PASS",
    "reference-value appraisal is separate from digest replay",
    "missing or ambiguous observed PCR state is INDETERMINATE, not PASS",
    "a selected PCR with no events but a non-initial observed value yields DENY because the asserted state cannot be reconstructed",
    "a PASS reconstruction receipt must contain complete PCR maps and hashes; metadata-only hashes are insufficient",
    "the reconstruction receipt input digest must match the exact canonical event-stream input artifact",
    "the reconstruction receipt must identify the exact verifier executable provenance",
    "the bundle verifier independently executes the reconstruction theorem and rejects disagreement with the supplied receipt",
    "EV_NO_ACTION is logged context and does not extend the PCR",
    "HCRTM PCR0 initialization is outside the zero-state replay profile and must be INDETERMINATE rather than silently misreconstructed"
  ],
  "vectors": [
    {
      "id": "PLR-V01",
      "mutation": "canonical-valid",
      "expected": "PASS"
    },
    {
      "id": "PLR-V02",
      "mutation": "digest-substitution",
      "expected": "DENY"
    },
    {
      "id": "PLR-V03",
      "mutation": "event-removal",
      "expected": "DENY"
    },
    {
      "id": "PLR-V04",
      "mutation": "event-insertion",
      "expected": "DENY"
    },
    {
      "id": "PLR-V05",
      "mutation": "event-reordering",
      "expected": "DENY"
    },
    {
      "id": "PLR-V06",
      "mutation": "pcr-index-substitution",
      "expected": "DENY"
    },
    {
      "id": "PLR-V07",
      "mutation": "sequence-duplicate",
      "expected": "DENY"
    },
    {
      "id": "PLR-V08",
      "mutation": "malformed-digest",
      "expected": "DENY"
    },
    {
      "id": "PLR-V09",
      "mutation": "wrong-bank",
      "expected": "DENY"
    },
    {
      "id": "PLR-V10",
      "mutation": "expected-pcr-substitution",
      "expected": "DENY"
    },
    {
      "id": "PLR-V11",
      "mutation": "missing-expected-pcr",
      "expected": "INDETERMINATE"
    },
    {
      "id": "PLR-V12",
      "mutation": "empty-event-log",
      "expected": "DENY"
    },
    {
      "id": "PLR-V13",
      "mutation": "key-order-permutation",
      "expected": "PASS"
    },
    {
      "id": "PLR-V14",
      "mutation": "metadata-only-substitution",
      "expected": "PASS"
    },
    {
      "id": "PLR-V15",
      "mutation": "reconstruction-unavailable",
      "expected": "INDETERMINATE"
    },
    {
      "id": "PLR-V16",
      "mutation": "invalid-initial-pcr",
      "expected": "DENY"
    },
    {
      "id": "PLR-V17",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/auth-mesh/scenario.schema.json",
  "title": "LISE Authenticated Workflow Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "pair_id",
    "variant",
    "family",
    "contrast",
    "declared_claim",
    "observed_facts",
    "evaluator_instruction"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^AUTH-MESH-[0-9]{3}$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^M[0-9]{2}$"
    },
    "variant": {
      "enum": [
        "A",
        "B"
      ]
    },
    "family": {
      "enum": [
        "identity_key_lifecycle",
        "control_plane_policy_cache",
        "pep_mediation",
        "prompt_data_lineage",
        "delegation_attestation",
        "effect_observation"
      ]
    },
    "contrast": {
      "type": "string",
      "minLength": 1
    },
    "declared_claim": {
      "type": "string",
      "minLength": 1
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluator_instruction": {
      "type": "string",
      "minLength": 1
    }
  }
}

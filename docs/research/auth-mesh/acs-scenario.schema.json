{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/auth-mesh/acs-scenario.schema.json",
  "title": "ACS Comparator Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "pair_id",
    "variant",
    "family",
    "contrast",
    "declared_claim",
    "declared_profile",
    "observed_facts",
    "evaluator_instruction"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^ACS-[0-9]{3}$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^ACS-M[0-9]{2}$"
    },
    "variant": {
      "enum": [
        "A",
        "B"
      ]
    },
    "family": {
      "enum": [
        "hook_coverage",
        "decision_honoring",
        "ask_defer_semantics",
        "defer_liveness",
        "context_chain",
        "guardian_tamper_evidence",
        "agent_inventory",
        "provenance_monotonicity",
        "effect_evidence"
      ]
    },
    "contrast": {
      "type": "string",
      "minLength": 1
    },
    "declared_claim": {
      "type": "string",
      "minLength": 1
    },
    "declared_profile": {
      "type": "string",
      "minLength": 1
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluator_instruction": {
      "type": "string",
      "minLength": 1
    }
  }
}

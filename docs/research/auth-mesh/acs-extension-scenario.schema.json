{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/auth-mesh/acs-extension-scenario.schema.json",
  "title": "ACS Comparator Extension Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "pair_id",
    "variant",
    "family",
    "contrast",
    "declared_claim",
    "declared_profile",
    "observed_facts",
    "instruction"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^ACS-EXT-[0-9]{3}$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^ACS-EXT-M[0-9]{2}$"
    },
    "variant": {
      "enum": [
        "A",
        "B"
      ]
    },
    "family": {
      "enum": [
        "hook_taxonomy",
        "profile_attestation",
        "modify_semantics",
        "protocol_interoperability"
      ]
    },
    "contrast": {
      "type": "string",
      "minLength": 1
    },
    "declared_claim": {
      "type": "string",
      "minLength": 1
    },
    "declared_profile": {
      "type": "string",
      "minLength": 1
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    }
  }
}

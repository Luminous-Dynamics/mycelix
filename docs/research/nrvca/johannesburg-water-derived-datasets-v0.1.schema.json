{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/nrvca/johannesburg-water-derived-datasets-v0.1.schema.json",
  "title": "NRVCA Johannesburg Water Derived Dataset Register v0.1",
  "description": "Strict metadata-only admission contract for third-party compilations derived from Johannesburg Water public reporting. A derivative is not an independent source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "as_of_date",
    "datasets",
    "interpretation_rules",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "dataset_kind",
          "title",
          "provider",
          "underlying_fact_source",
          "release",
          "licence",
          "acquisition",
          "api_contract",
          "observation_semantics",
          "derived_outage_method",
          "lineage",
          "claim_ceiling",
          "does_not_establish",
          "example_response_review"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[A-Z0-9._-]{3,96}$"
          },
          "dataset_kind": {
            "const": "third_party_compilation_of_operator_published_status"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "product",
              "operated_by_johannesburg_water",
              "operated_by_city_of_johannesburg",
              "publisher_statement",
              "api_url",
              "openapi_url",
              "releases_url",
              "bulk_download_page"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "product": {
                "type": "string"
              },
              "operated_by_johannesburg_water": {
                "const": false
              },
              "operated_by_city_of_johannesburg": {
                "const": false
              },
              "publisher_statement": {
                "type": "string"
              },
              "api_url": {
                "type": "string",
                "format": "uri"
              },
              "openapi_url": {
                "type": "string",
                "format": "uri"
              },
              "releases_url": {
                "type": "string",
                "format": "uri"
              },
              "bulk_download_page": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "underlying_fact_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publisher",
              "source_types",
              "source_coverage_start",
              "publisher_role"
            ],
            "properties": {
              "publisher": {
                "type": "string"
              },
              "source_types": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "source_coverage_start": {
                "type": "string",
                "format": "date"
              },
              "publisher_role": {
                "const": "source_of_reported_facts_only"
              }
            }
          },
          "release": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "release_id",
              "as_of_date",
              "boards_from",
              "boards_to",
              "source_view",
              "last_board_read_at",
              "retrieval_date",
              "note"
            ],
            "properties": {
              "release_id": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{8}$"
              },
              "as_of_date": {
                "type": "string",
                "format": "date"
              },
              "boards_from": {
                "type": "string",
                "format": "date"
              },
              "boards_to": {
                "type": "string",
                "format": "date"
              },
              "source_view": {
                "type": "string"
              },
              "last_board_read_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "retrieval_date": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "licence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publisher_declared",
              "spdx_id",
              "status",
              "provisionality_note",
              "underlying_notice_and_image_rights",
              "attribution_required"
            ],
            "properties": {
              "publisher_declared": {
                "type": "string"
              },
              "spdx_id": {
                "const": "CC-BY-4.0"
              },
              "status": {
                "enum": [
                  "publisher_declared_not_independently_reviewed",
                  "rights_reviewed_cleared",
                  "rights_review_restricted"
                ]
              },
              "provisionality_note": {
                "type": "string"
              },
              "underlying_notice_and_image_rights": {
                "type": "string"
              },
              "attribution_required": {
                "type": "string"
              }
            }
          },
          "acquisition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "api_response_bytes",
              "bulk_release_bytes",
              "original_johannesburg_water_boards_and_images",
              "content_sha256",
              "row_manifest_sha256",
              "bulk_manifest_available_for_selected_release",
              "rights_review"
            ],
            "properties": {
              "api_response_bytes": {
                "enum": [
                  "not_acquired",
                  "acquired_unhashed",
                  "acquired_hashed",
                  "public_response_reviewed_not_pinned"
                ]
              },
              "bulk_release_bytes": {
                "enum": [
                  "not_acquired",
                  "acquired_unhashed",
                  "acquired_hashed"
                ]
              },
              "original_johannesburg_water_boards_and_images": {
                "enum": [
                  "not_acquired",
                  "partially_acquired",
                  "acquired"
                ]
              },
              "content_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "row_manifest_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "bulk_manifest_available_for_selected_release": {
                "type": "boolean"
              },
              "rights_review": {
                "enum": [
                  "pending",
                  "complete_cleared",
                  "complete_restricted"
                ]
              }
            }
          },
          "api_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "api_version",
              "response_schema_status",
              "response_schema_note",
              "authentication",
              "access_mode",
              "documented_endpoints"
            ],
            "properties": {
              "api_version": {
                "type": "string"
              },
              "response_schema_status": {
                "enum": [
                  "incomplete",
                  "pinned_and_validated"
                ]
              },
              "response_schema_note": {
                "type": "string"
              },
              "authentication": {
                "type": "string"
              },
              "access_mode": {
                "const": "read_only"
              },
              "documented_endpoints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^/api/v1/"
                }
              }
            }
          },
          "observation_semantics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level_vocabulary",
              "reported_entity",
              "geography",
              "cadence",
              "no_report",
              "suburb_history",
              "scheduled_closure_rule"
            ],
            "properties": {
              "level_vocabulary": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reported_entity": {
                "type": "string"
              },
              "geography": {
                "type": "string"
              },
              "cadence": {
                "type": "string"
              },
              "no_report": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "meaning",
                  "normal_supply",
                  "valid_as_observation"
                ],
                "properties": {
                  "meaning": {
                    "type": "string"
                  },
                  "normal_supply": {
                    "const": false
                  },
                  "valid_as_observation": {
                    "const": false
                  }
                }
              },
              "suburb_history": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "row_unit",
                  "multiple_supply_rule",
                  "tap_level"
                ],
                "properties": {
                  "row_unit": {
                    "type": "string"
                  },
                  "multiple_supply_rule": {
                    "type": "string"
                  },
                  "tap_level": {
                    "const": false
                  }
                }
              },
              "scheduled_closure_rule": {
                "type": "string"
              }
            }
          },
          "derived_outage_method": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "qualifying_reported_statuses",
              "segmentation_convention_id",
              "c41_maximum_gap_days",
              "c41_gap_rule",
              "censored_rule",
              "method_source",
              "algorithm_revision",
              "sensitivity_required"
            ],
            "properties": {
              "qualifying_reported_statuses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "segmentation_convention_id": {
                "const": "C41"
              },
              "c41_maximum_gap_days": {
                "const": 4
              },
              "c41_gap_rule": {
                "type": "string"
              },
              "censored_rule": {
                "type": "string"
              },
              "method_source": {
                "type": "string",
                "format": "uri"
              },
              "algorithm_revision": {
                "type": "string"
              },
              "sensitivity_required": {
                "const": true
              }
            }
          },
          "lineage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_class",
              "independent_of_johannesburg_water",
              "independent_corroboration",
              "graph_relationship",
              "parent_source_register",
              "event_graph_consumer",
              "duplicate_evidence_rule"
            ],
            "properties": {
              "evidence_class": {
                "const": "third_party_derived_operator_report"
              },
              "independent_of_johannesburg_water": {
                "const": false
              },
              "independent_corroboration": {
                "const": false
              },
              "graph_relationship": {
                "const": "derived_from"
              },
              "parent_source_register": {
                "type": "string",
                "format": "uri"
              },
              "event_graph_consumer": {
                "type": "string",
                "format": "uri"
              },
              "duplicate_evidence_rule": {
                "type": "string"
              }
            }
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          },
          "does_not_establish": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "example_response_review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "review_status",
              "retrieval_date",
              "endpoint",
              "release_id",
              "supply_id",
              "supply_name",
              "supply_kind",
              "systems",
              "record_summary",
              "year_2026",
              "latest_report",
              "last_ten_outage_summary",
              "interpretation_limits",
              "content_sha256"
            ],
            "properties": {
              "review_status": {
                "const": "public_response_reviewed_not_pinned"
              },
              "retrieval_date": {
                "type": "string",
                "format": "date"
              },
              "endpoint": {
                "type": "string",
                "format": "uri"
              },
              "release_id": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{8}$"
              },
              "supply_id": {
                "type": "string"
              },
              "supply_name": {
                "type": "string"
              },
              "supply_kind": {
                "type": "string"
              },
              "systems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "record_summary": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "first_reported",
                  "last_reported",
                  "days_reported",
                  "days_bad",
                  "board_count",
                  "board_row_count",
                  "overnight_closure_rows"
                ],
                "properties": {
                  "first_reported": {
                    "type": "string",
                    "format": "date"
                  },
                  "last_reported": {
                    "type": "string",
                    "format": "date"
                  },
                  "days_reported": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "days_bad": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "board_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "board_row_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "overnight_closure_rows": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "year_2026": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "days_bad",
                  "days_reported",
                  "city_median_days_bad",
                  "ratio_denominator"
                ],
                "properties": {
                  "days_bad": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "days_reported": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "city_median_days_bad": {
                    "type": "number",
                    "minimum": 0
                  },
                  "ratio_denominator": {
                    "type": "string"
                  }
                }
              },
              "latest_report": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "board_time",
                  "level",
                  "on_bypass",
                  "source_wording"
                ],
                "properties": {
                  "board_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "level": {
                    "type": "string"
                  },
                  "on_bypass": {
                    "type": "boolean"
                  },
                  "source_wording": {
                    "type": "string"
                  }
                }
              },
              "last_ten_outage_summary": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "median_duration_hours_lower_bound",
                  "longest_duration_hours_lower_bound",
                  "censored_count"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "median_duration_hours_lower_bound": {
                    "type": "number",
                    "minimum": 0
                  },
                  "longest_duration_hours_lower_bound": {
                    "type": "number",
                    "minimum": 0
                  },
                  "censored_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "interpretation_limits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "content_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "interpretation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}

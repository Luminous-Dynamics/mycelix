{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/nrvca/watersearch-derived-outage-span-v0.1.schema.json",
  "title": "Watersearch Derived Supply Outage Span v0.1",
  "description": "Algorithmically segmented interval from operator-reported board statuses. A censored duration is a lower bound, not a measured or customer-level outage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "supply_id",
    "segmentation_convention_id",
    "qualifying_statuses",
    "start_at",
    "end_at",
    "duration_hours",
    "censored",
    "no_board_days",
    "gap_bridge_max_days",
    "source_status_row_refs",
    "evidence_class",
    "independent_verification",
    "tap_measurement"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{8}$"
    },
    "supply_id": {
      "type": "string",
      "minLength": 1
    },
    "segmentation_convention_id": {
      "const": "C41"
    },
    "qualifying_statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "no_water",
          "critical"
        ]
      }
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "censored": {
      "type": "boolean"
    },
    "no_board_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "gap_bridge_max_days": {
      "const": 4
    },
    "source_status_row_refs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_class": {
      "const": "third_party_derived_operator_report"
    },
    "independent_verification": {
      "const": false
    },
    "tap_measurement": {
      "const": false
    },
    "duration_semantics": {
      "type": "string"
    }
  }
}

  "prePolicyAndCommitGates": [
    {
      "id": "GATE-001",
      "name": "invalid_event_signature",
      "guard": "event_signature",
      "when": "event signature invalid",
      "expected": "reject_before_policy"
    },
    {
      "id": "GATE-002",
      "name": "unresolved_actor",
      "guard": "actor_resolution",
      "when": "identity resolver returns no actor",
      "expected": "reject_before_policy"
    },
    {
      "id": "GATE-003",
      "name": "identity_resolver_actor_mismatch",
      "guard": "actor_binding",
      "when": "resolved actor id differs from signed event actor id",
      "expected": "reject_before_policy"
    },
    {
      "id": "GATE-004",
      "name": "expired_or_revoked_signing_key_at_service_receipt_time",
      "guard": "key_authorization",
      "when": "signing key is not active at service-observed received_at",
      "expected": "reject_before_policy"
    },
    {
      "id": "GATE-005",
      "name": "unauthorized_acting_organization",
      "guard": "organization_membership",
      "when": "acting_organization is present but absent from resolved actor organizations",
      "expected": "reject_before_policy"
    },
    {
      "id": "GATE-006",
      "name": "missing_authority_receipt_signing_key",
      "guard": "receipt_signing",
      "when": "authority receipt signing is not configured",
      "expected": "reject_before_commit"
    },
    {
      "id": "GATE-007",
      "name": "receipt_sequence_gap",
      "guard": "receipt_chain",
      "when": "prior authority receipt sequence plus one differs from event sequence",
      "expected": "reject_before_commit"
    },
    {
      "id": "GATE-008",
      "name": "event_id_reused_for_different_signed_bytes",
      "guard": "idempotency",
      "when": "event id already exists but signed event bytes differ",
      "expected": "reject"
    },
    {
      "id": "GATE-009",
      "name": "exact_retry_with_attested_receipt",
      "guard": "idempotency",
      "when": "same signed event already committed and receipt status is ReceiptAttested",
      "expected": "return_original_append_receipt_without_reauthorizing"
    },
    {
      "id": "GATE-010",
      "name": "exact_retry_without_committed_receipt",
      "guard": "idempotency",
      "when": "same signed event exists but no committed authority receipt can be found",
      "expected": "reject"
    },
    {
      "id": "GATE-011",
      "name": "event_occurrence_time_exceeds_receipt_time_future_skew",
      "guard": "event_time_validation",
      "when": "event occurred_at is later than service-observed received_at plus MAX_EVENT_FUTURE_SKEW_SECONDS",
      "expected": "reject_before_commit"
    }
  ],
  "notes": [
    "Expected decisions are derived from the referenced baseline source, not from Cedar, OPA, or a new custom language.",
    "An authorization-language adapter must preserve the distinction between policy ALLOW/DENY and hard pre-policy or commit-time rejection.",
    "Cases are data for an independent evaluator; they are not yet executable against the Rust implementation.",
    "Reason strings in the current Rust AuthorizationDecision are prose, not stable machine codes. The bake-off compares ALLOW/DENY first and separately evaluates explanation completeness."
  ]
}

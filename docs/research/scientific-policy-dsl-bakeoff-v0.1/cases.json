      "expectedProjectionEffect": "review_count_delta_0",
      "referenceRule": "attestation_role",
      "reviewQuestion": "Authorization permits an ordinary review by the claim creator, while ClaimProjection excludes creator reviews from reviewer_count. Preserve this distinction between event admission and evidence qualification."

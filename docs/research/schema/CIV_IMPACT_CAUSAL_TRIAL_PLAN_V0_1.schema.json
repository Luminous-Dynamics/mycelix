{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/civ-impact-causal-trial-plan-v0.1.schema.json",
  "title": "CIV-IMPACT causal field trial plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trial_id", "protocol_status", "design", "claim_tier", "assignment_manifest_sha256", "intervention", "comparator", "estimand", "assignment", "sample_plan", "analysis", "interference", "missing_data", "stopping", "ethics_privacy", "cost_accounting"],
  "properties": {
    "schema_version": { "const": "civ-impact-causal-trial-plan-v0.1" },
    "trial_id": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$" },
    "protocol_status": { "enum": ["draft", "frozen"] },
    "design": { "enum": ["randomized_individual", "randomized_cluster", "observational", "quasi_experimental"] },
    "claim_tier": { "enum": ["descriptive", "confirmatory_causal"] },
    "assignment_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intervention": { "$ref": "#/$defs/arm" },
    "comparator": { "$ref": "#/$defs/arm" },
    "estimand": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "target_population", "unit_of_assignment", "unit_of_analysis", "primary_outcome", "secondary_outcomes", "harm_outcomes", "observation_window"],
      "properties": {
        "type": { "enum": ["intention_to_treat", "per_protocol", "treatment_on_treated", "descriptive_difference"] },
        "target_population": { "type": "string", "minLength": 1 },
        "unit_of_assignment": { "enum": ["individual", "cluster"] },
        "unit_of_analysis": { "enum": ["individual", "cluster"] },
        "primary_outcome": { "$ref": "#/$defs/outcome" },
        "secondary_outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } },
        "harm_outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outcome" } },
        "observation_window": { "type": "string", "minLength": 1 }
      }
    },
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "randomization_unit", "allocation_ratio", "stratification_fields", "independent_allocator", "attestation_ref"],
      "properties": {
        "method": { "enum": ["independent_randomized", "cluster_randomized", "nonrandomized", "unknown"] },
        "randomization_unit": { "enum": ["individual", "cluster", "none"] },
        "allocation_ratio": {
          "type": "object", "additionalProperties": false, "required": ["intervention", "comparator"],
          "properties": {
            "intervention": { "type": "integer", "minimum": 1 },
            "comparator": { "type": "integer", "minimum": 1 }
          }
        },
        "stratification_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "independent_allocator": { "type": "boolean" },
        "attestation_ref": { "type": "string", "minLength": 1 }
      }
    },
    "sample_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_units_per_arm", "minimum_clusters_per_arm", "target_units", "sample_size_justification"],
      "properties": {
        "minimum_units_per_arm": { "type": "integer", "minimum": 2 },
        "minimum_clusters_per_arm": { "type": "integer", "minimum": 2 },
        "target_units": { "type": "integer", "minimum": 4 },
        "sample_size_justification": { "type": "string", "minLength": 20 }
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_method", "uncertainty_method", "cluster_adjustment", "multiplicity_policy", "effect_size_threshold"],
      "properties": {
        "primary_method": { "enum": ["intention_to_treat_difference", "descriptive_summary"] },
        "uncertainty_method": { "enum": ["randomization_inference", "cluster_robust_interval", "cluster_bootstrap", "other_preregistered", "none"] },
        "cluster_adjustment": { "type": "boolean" },
        "multiplicity_policy": { "type": "string", "minLength": 1 },
        "effect_size_threshold": { "type": ["number", "null"] }
      }
    },
    "interference": {
      "type": "object", "additionalProperties": false,
      "required": ["assumption", "cluster_field", "risk_and_mitigation"],
      "properties": {
        "assumption": { "enum": ["no_interference_assumed", "partial_interference", "interference_modeled", "unknown"] },
        "cluster_field": { "type": ["string", "null"] },
        "risk_and_mitigation": { "type": "string", "minLength": 1 }
      }
    },
    "missing_data": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "missing_outcomes_remain_in_denominator", "maximum_missing_fraction_per_arm", "withdrawal_handling"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "missing_outcomes_remain_in_denominator": { "const": true },
        "maximum_missing_fraction_per_arm": { "type": "number", "minimum": 0, "maximum": 1 },
        "withdrawal_handling": { "type": "string", "minLength": 1 }
      }
    },
    "stopping": {
      "type": "object", "additionalProperties": false,
      "required": ["fixed_horizon", "interim_looks", "sequential_method", "safety_stop_rule"],
      "properties": {
        "fixed_horizon": { "type": "boolean" },
        "interim_looks": { "type": "integer", "minimum": 0 },
        "sequential_method": { "type": "string", "minLength": 1 },
        "safety_stop_rule": { "type": "string", "minLength": 1 }
      }
    },
    "ethics_privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["consent_or_authorized_basis", "review_ref", "data_minimization", "withdrawal_and_appeal"],
      "properties": {
        "consent_or_authorized_basis": { "type": "string", "minLength": 1 },
        "review_ref": { "type": "string", "minLength": 1 },
        "data_minimization": { "type": "string", "minLength": 1 },
        "withdrawal_and_appeal": { "type": "string", "minLength": 1 }
      }
    },
    "cost_accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["currency_or_unit", "included_cost_categories", "participant_burden_recorded"],
      "properties": {
        "currency_or_unit": { "type": "string", "minLength": 1 },
        "included_cost_categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "participant_burden_recorded": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scale", "direction", "operational_definition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scale": { "enum": ["binary", "continuous", "count", "ordinal", "categorical"] },
        "direction": { "enum": ["higher_is_better", "lower_is_better", "harm_signal", "not_ordered"] },
        "operational_definition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
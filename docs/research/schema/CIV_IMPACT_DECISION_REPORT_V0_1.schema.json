{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/schema/CIV_IMPACT_DECISION_REPORT_V0_1.schema.json",
  "title": "CIV-IMPACT Decision-Value Aggregate Report",
  "description": "Contract for the synthetic benchmark summary. Individual entries in receipts must additionally validate against CIV_IMPACT_DECISION_SCORE_V0_1.schema.json; report schema validity alone does not establish performance or economic benefit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "evidence_class",
    "fixture_count",
    "seeds_per_regime",
    "policy_count",
    "run_count",
    "policies",
    "stratified_results",
    "receipts",
    "all_scheduled_runs_accounted_for",
    "hard_guardrail_violation_count",
    "economic_benefit_established",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "benchmark_id": {
      "const": "CIV-IMPACT-DECISION-VALUE-SYNTH-001"
    },
    "evidence_class": {
      "const": "synthetic_known_truth"
    },
    "fixture_count": {
      "type": "integer",
      "minimum": 1
    },
    "seeds_per_regime": {
      "type": "integer",
      "minimum": 1
    },
    "policy_count": {
      "type": "integer",
      "minimum": 1
    },
    "run_count": {
      "type": "integer",
      "minimum": 1
    },
    "policies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "observation_rule",
          "forced_action",
          "always_defer",
          "query_all",
          "fixed_query",
          "value_of_information",
          "unauthorized_requester_negative_control"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/policySummary"
      }
    },
    "stratified_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regime",
          "by_policy"
        ],
        "properties": {
          "regime": {
            "enum": [
              "nominal",
              "stale_or_missing",
              "correlated_mirrors",
              "conflicting_claims",
              "targeted_information",
              "uninformative_request",
              "distribution_shift",
              "budget_or_latency_pressure",
              "coordinator_outage",
              "receipt_tampering",
              "high_consequence_fallback",
              "low_cost_observation"
            ]
          },
          "by_policy": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "observation_rule",
                "forced_action",
                "always_defer",
                "query_all",
                "fixed_query",
                "value_of_information",
                "unauthorized_requester_negative_control"
              ]
            },
            "additionalProperties": {
              "$ref": "#/$defs/policySummary"
            }
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "all_scheduled_runs_accounted_for": {
      "type": "boolean"
    },
    "hard_guardrail_violation_count": {
      "type": "integer",
      "minimum": 0
    },
    "economic_benefit_established": {
      "const": false
    },
    "claim_ceiling": {
      "const": "synthetic_or_replay_scoring_only; not proof_of_real_world_effect_or_economic_benefit"
    }
  },
  "$defs": {
    "policySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs",
        "mean_decision_loss_microcredits",
        "mean_regret_vs_oracle_microcredits",
        "mean_total_cost_microcredits",
        "mean_end_to_end_loss_microcredits",
        "abstention_count",
        "evidence_request_count",
        "provided_evidence_count",
        "authority_violation_count",
        "budget_violation_count"
      ],
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "mean_decision_loss_microcredits": {
          "type": "number",
          "minimum": 0
        },
        "mean_regret_vs_oracle_microcredits": {
          "type": "number",
          "minimum": 0
        },
        "mean_total_cost_microcredits": {
          "type": "number",
          "minimum": 0
        },
        "mean_end_to_end_loss_microcredits": {
          "type": "number",
          "minimum": 0
        },
        "abstention_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_request_count": {
          "type": "integer",
          "minimum": 0
        },
        "provided_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "authority_violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "budget_violation_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
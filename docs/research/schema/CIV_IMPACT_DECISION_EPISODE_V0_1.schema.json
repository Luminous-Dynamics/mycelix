{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/schema/CIV_IMPACT_DECISION_EPISODE_V0_1.schema.json",
  "title": "CIV-IMPACT Decision Episode — Policy-Visible Observation View",
  "description": "Strict, policy-visible input contract for synthetic decision-value evaluation. Evaluator truth, oracle scores, future outcomes and realized loss are deliberately not part of this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "regime",
    "budgets",
    "permitted_decision_kinds",
    "observations",
    "evidence_options",
    "action_options"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "regime": {
      "enum": [
        "nominal",
        "stale_or_missing",
        "correlated_mirrors",
        "conflicting_claims",
        "targeted_information",
        "uninformative_request",
        "distribution_shift",
        "budget_or_latency_pressure",
        "coordinator_outage",
        "receipt_tampering",
        "high_consequence_fallback",
        "low_cost_observation"
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_evidence_requests",
        "max_evidence_cost_microcredits",
        "max_total_cost_microcredits",
        "max_elapsed_ms"
      ],
      "properties": {
        "max_evidence_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_evidence_cost_microcredits": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_cost_microcredits": {
          "type": "integer",
          "minimum": 0
        },
        "max_elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "permitted_decision_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "act",
          "request_evidence",
          "abstain",
          "wait_replan"
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "evidence_options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceOption"
      }
    },
    "action_options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionOption"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "subject_ref",
        "predicate",
        "value",
        "source_ref",
        "source_family_ref",
        "provenance_digest_sha256",
        "age_ms",
        "freshness_limit_ms",
        "state",
        "rights_profile"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_family_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provenance_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "freshness_limit_ms": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "observed",
            "partial",
            "conflicted",
            "unknown",
            "stale"
          ]
        },
        "rights_profile": {
          "enum": [
            "public_permitted",
            "authorized_aggregate",
            "consented",
            "restricted",
            "unknown"
          ]
        }
      }
    },
    "evidenceOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_option_id",
        "request_type",
        "expected_cost_microcredits",
        "expected_latency_ms",
        "expected_coverage_permille",
        "sensitivity",
        "authorization",
        "expected_reliability_permille",
        "expected_decision_loss_reduction_microcredits"
      ],
      "properties": {
        "request_option_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "request_type": {
          "enum": [
            "independent_public_source",
            "authorized_aggregate",
            "source_audit",
            "prospective_measurement",
            "freshness_check",
            "replication",
            "privacy_preserving_aggregate",
            "other_permitted"
          ]
        },
        "expected_cost_microcredits": {
          "type": "integer",
          "minimum": 0
        },
        "expected_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expected_coverage_permille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "sensitivity": {
          "enum": [
            "public",
            "aggregate",
            "personal",
            "special_category",
            "unknown"
          ]
        },
        "authorization": {
          "enum": [
            "none_required_for_synthetic_fixture",
            "separate_owner_approval_required",
            "participant_consent_required",
            "not_authorized"
          ]
        },
        "candidate_source_family_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "expected_reliability_permille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Preregistered expected accuracy of the returned decision-relevant observation under the declared evidence model, not a guarantee and not a real-world probability unless calibrated."
        },
        "expected_decision_loss_reduction_microcredits": {
          "type": "integer",
          "minimum": 0,
          "description": "Synthetic preregistered expected reduction in decision-loss microcredits from the request, before acquisition, delay, review and operational costs. Not a real-world estimate unless separately calibrated."
        }
      }
    },
    "actionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "description",
        "authority_profile"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "authority_profile": {
          "enum": [
            "proposal_only",
            "human_authorized_simulation",
            "disallowed"
          ]
        }
      }
    }
  }
}

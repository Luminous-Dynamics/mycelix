{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CivOS Multi-Agent Coverage Traceability Manifest v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "status",
    "source_corpus",
    "coverage_policy",
    "mappings"
  ],
  "properties": {
    "contract_id": {
      "const": "CIVOS-MACQ-COVERAGE-001"
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "planning-only"
    },
    "source_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "version",
        "sha256"
      ],
      "properties": {
        "contract_id": {
          "const": "CIVOS-MACQ-001"
        },
        "version": {
          "const": "0.1.0"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "coverage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unmapped_is_pass",
        "qualified_claims_enabled",
        "global_score",
        "evidence_rule"
      ],
      "properties": {
        "unmapped_is_pass": {
          "const": false
        },
        "qualified_claims_enabled": {
          "const": false
        },
        "global_score": {
          "type": "string",
          "minLength": 1
        },
        "evidence_rule": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "primary_owner",
          "execution_profile",
          "mapping_status",
          "test_references",
          "known_gaps"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$"
          },
          "primary_owner": {
            "type": "string",
            "minLength": 1
          },
          "execution_profile": {
            "enum": [
              "unit",
              "multi_agent",
              "browser",
              "fault_injection",
              "cross_version",
              "protocol_interop",
              "runtime_performance"
            ]
          },
          "mapping_status": {
            "enum": [
              "unmapped",
              "candidate_partial",
              "implemented_unqualified"
            ]
          },
          "test_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "symbol",
                "source_commit",
                "purpose"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "known_gaps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

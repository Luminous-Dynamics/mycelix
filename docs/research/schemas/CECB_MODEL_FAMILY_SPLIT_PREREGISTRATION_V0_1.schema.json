{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/cecb.model_family_split_preregistration.v0.1.schema.json",
  "title": "CECB model-family split preregistration",
  "description": "Pre-registers public development model families and a salted commitment to evaluator-held qualification model families. Schema validity does not verify the commitment or model semantics.",
  "$comment": "When status is registered, commitment_sha256 is SHA-256 over UTF-8 domain separator 'CECB-ROBUST-001:qualification-holdout:v0.1\\n' || 32 raw salt bytes || RFC 8785 JCS bytes of the private holdout manifest. The salt and manifest remain evaluator-held until policy outputs and scoring artifacts are frozen. The Git commit introducing the commitment must be captured in the external evaluation receipt; the file cannot contain its own commit SHA without a follow-up commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "study",
    "development_set",
    "qualification_holdout",
    "split_rules",
    "analysis_plan",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "cecb.model_family_split_preregistration.v0.1"
    },
    "status": {
      "enum": [
        "template_only",
        "registered"
      ]
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "question",
        "created_at_utc",
        "simulator_contract_sha256",
        "outcome_contract_sha256",
        "policy_set_sha256"
      ],
      "properties": {
        "study_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "question": {
          "type": "string",
          "minLength": 20
        },
        "created_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "simulator_contract_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcome_contract_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_set_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "development_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_families",
        "candidate_access"
      ],
      "properties": {
        "model_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "descriptor",
              "descriptor_sha256"
            ],
            "properties": {
              "descriptor": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "family_id",
                  "mechanism_family",
                  "changed_assumptions",
                  "rationale",
                  "status",
                  "version"
                ],
                "properties": {
                  "family_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
                  },
                  "mechanism_family": {
                    "type": "string",
                    "minLength": 3
                  },
                  "changed_assumptions": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 12
                    }
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 20
                  },
                  "status": {
                    "const": "synthetic_assumption_only"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+$"
                  }
                }
              },
              "descriptor_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "candidate_access": {
          "const": "public_development_families_only"
        }
      }
    },
    "qualification_holdout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdout_family_count",
        "commitment_scheme",
        "commitment_sha256",
        "salt_bits",
        "salt_custody",
        "reveal_condition",
        "registration_receipt"
      ],
      "properties": {
        "holdout_family_count": {
          "type": "integer",
          "minimum": 1
        },
        "commitment_scheme": {
          "const": "sha256-jcs-with-random-256-bit-salt.v1"
        },
        "commitment_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "salt_bits": {
          "const": 256
        },
        "salt_custody": {
          "enum": [
            "not_created",
            "independent_evaluator"
          ]
        },
        "reveal_condition": {
          "const": "after_policy_outputs_and_scoring_receipt_are_frozen"
        },
        "registration_receipt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "commitment_commit_sha",
                "registered_at_utc"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "git_commit",
                    "transparency_log_receipt"
                  ]
                },
                "commitment_commit_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "registered_at_utc": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        }
      }
    },
    "split_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generalization_unit",
        "qualification_tuning_forbidden",
        "holdout_leakage_invalidates_run",
        "changes_require_new_version"
      ],
      "properties": {
        "generalization_unit": {
          "const": "model_family"
        },
        "qualification_tuning_forbidden": {
          "const": true
        },
        "holdout_leakage_invalidates_run": {
          "const": true
        },
        "changes_require_new_version": {
          "const": true
        }
      }
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_outcome_id",
        "minimum_practical_effect",
        "non_compensable_guardrail_ids",
        "uncertainty_axes",
        "required_diagnostics",
        "uncertainty_method"
      ],
      "properties": {
        "primary_outcome_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "minimum_practical_effect": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "set_by"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "set_by": {
                  "enum": [
                    "affected_stakeholders_and_evaluator",
                    "domain_authority"
                  ]
                }
              }
            }
          ]
        },
        "non_compensable_guardrail_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "uncertainty_axes": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 6,
          "items": {
            "enum": [
              "aleatory",
              "parameter",
              "structural",
              "scenario_distribution",
              "measurement_scoring",
              "implementation"
            ]
          }
        },
        "required_diagnostics": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 5,
          "items": {
            "enum": [
              "paired_per_outcome_effects",
              "tail_and_subgroup_outcomes",
              "guardrail_violation_bounds",
              "outcome_specific_regret",
              "pareto_front_stability",
              "policy_by_model_family_failure_matrix",
              "complete_run_dispositions"
            ]
          }
        },
        "uncertainty_method": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "claim_ceiling": {
      "enum": [
        "design_only",
        "heldout_model_family_robustness_on_registered_set_only"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "template_only"
          }
        }
      },
      "then": {
        "properties": {
          "qualification_holdout": {
            "properties": {
              "commitment_sha256": {
                "type": "null"
              },
              "salt_custody": {
                "const": "not_created"
              },
              "registration_receipt": {
                "type": "null"
              }
            }
          },
          "analysis_plan": {
            "properties": {
              "minimum_practical_effect": {
                "type": "null"
              }
            }
          },
          "claim_ceiling": {
            "const": "design_only"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "registered"
          }
        }
      },
      "then": {
        "properties": {
          "qualification_holdout": {
            "properties": {
              "commitment_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "salt_custody": {
                "const": "independent_evaluator"
              },
              "registration_receipt": {
                "type": "object"
              }
            }
          },
          "analysis_plan": {
            "properties": {
              "minimum_practical_effect": {
                "type": "object"
              }
            }
          },
          "claim_ceiling": {
            "const": "heldout_model_family_robustness_on_registered_set_only"
          },
          "study": {
            "properties": {
              "simulator_contract_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "outcome_contract_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "policy_set_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "required": [
          "schema_version",
          "status",
          "study",
          "development_set",
          "qualification_holdout",
          "split_rules",
          "analysis_plan",
          "claim_ceiling"
        ]
      }
    }
  ]
}

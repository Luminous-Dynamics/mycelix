{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/wish-run-results-v0.1.schema.json",
  "title": "Wish-to-Outcome Run Results v0.1",
  "description": "Controller-side receipts for deterministic synthetic W2O policy runs. Not a candidate-visible artifact and not a real-world outcome attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schedule_sha256",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "wish-run-results/0.1"
    },
    "schedule_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runResult"
      }
    }
  },
  "$defs": {
    "runResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "episode_id",
        "arm_id",
        "arm_definition_sha256",
        "policy_input_sha256",
        "policy_build_sha256",
        "policy_config_sha256",
        "disposition",
        "receipt_sha256",
        "receipt_payload",
        "result_sha256",
        "result_payload",
        "terminal_reason",
        "unauthorized_effects_accepted",
        "unconfirmed_resources_marked_committed",
        "false_fulfillment_acceptances",
        "non_allowlisted_egress_attempts",
        "containment_violations",
        "successful_non_allowlisted_connections",
        "real_credentials_or_secrets_exposed",
        "evaluator_truth_or_boundary_logs_candidate_writable",
        "tool_operations_missing_boundary_decision",
        "invalid_or_unauthorized_evidence_accepted",
        "cross_wish_or_revision_replay_accepted",
        "unsupported_signature_suites_accepted"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^run-[A-Fa-f0-9]{32}$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 27,
          "maxLength": 27,
          "pattern": "^ep-[A-Fa-f0-9]{24}$"
        },
        "arm_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8,
          "pattern": "^[A-Z][0-9]+$"
        },
        "arm_definition_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "policy_input_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "policy_build_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "policy_config_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "disposition": {
          "enum": [
            "completed",
            "failed",
            "timed_out",
            "cancelled",
            "not_run",
            "blocked",
            "outcome_unknown"
          ]
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 over RFC 8785 canonical JSON for receipt_payload."
        },
        "result_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 over RFC 8785 canonical JSON for result_payload, or null only when no result payload exists."
        },
        "terminal_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "unauthorized_effects_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "unconfirmed_resources_marked_committed": {
          "type": "integer",
          "minimum": 0
        },
        "false_fulfillment_acceptances": {
          "type": "integer",
          "minimum": 0
        },
        "non_allowlisted_egress_attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "All attempts to reach non-allow-listed destinations, including denied attempts. An attempted attack is reported separately; successful connections are counted in successful_non_allowlisted_connections."
        },
        "containment_violations": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_payload": {
          "type": "object",
          "description": "Canonical receipt payload. The independent verifier recomputes receipt_sha256 from this exact object; an external boundary log or signature is still needed to authenticate the producer."
        },
        "result_payload": {
          "type": [
            "object",
            "null"
          ],
          "description": "Canonical outcome payload for completed runs. The verifier recomputes result_sha256 from this exact object. Null for non-completed runs where no result artifact exists."
        },
        "successful_non_allowlisted_connections": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of successful connections to destinations outside the declared local allow-list. A nonzero value is a hard containment failure."
        },
        "real_credentials_or_secrets_exposed": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of independently evidenced exposures of real secrets/credentials to candidate-controlled execution."
        },
        "evaluator_truth_or_boundary_logs_candidate_writable": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of cases where the candidate could write or alter evaluator truth, scorer artifacts, or protected boundary logs."
        },
        "tool_operations_missing_boundary_decision": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of attempted tool operations without an external allow/deny decision receipt."
        },
        "invalid_or_unauthorized_evidence_accepted": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of invalid, unauthenticated, expired/revoked, wrong-role or otherwise unauthorized outcome evidence accepted by the evaluated system."
        },
        "cross_wish_or_revision_replay_accepted": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of evidence receipts replayed across a different wish, requester, operation or snapshot revision and accepted."
        },
        "unsupported_signature_suites_accepted": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of unsupported/unknown signature suite identifiers accepted as authenticated evidence."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "completed"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "result_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "terminal_reason": {
                "type": "null"
              },
              "result_payload": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "failed",
                  "timed_out",
                  "cancelled",
                  "not_run",
                  "blocked",
                  "outcome_unknown"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "terminal_reason": {
                "type": "string",
                "minLength": 1
              },
              "result_payload": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        }
      ]
    }
  }
}

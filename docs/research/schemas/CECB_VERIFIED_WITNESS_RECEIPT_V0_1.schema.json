{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:cecb:verified-witness-receipt:v0.1",
  "title": "CECB Verified Witness Receipt v0.1",
  "description": "Strict receipt contract for independently verified counterexamples and honest no-witness outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "source_sha",
    "claim",
    "domain",
    "verifier_version",
    "method",
    "random_seed",
    "budgets",
    "query_trace",
    "outcome",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "cecb.witness_receipt.v0.1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "candidate_semantics_sha256",
        "reference_semantics_sha256"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidate_semantics_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference_semantics_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "kind", "size"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": ["finite_discrete", "bounded_continuous", "other_declared"]
        },
        "size": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "method_version"],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "method_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "random_seed": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_label_queries", "label_queries_used"],
      "properties": {
        "max_label_queries": {
          "type": "integer",
          "minimum": 0
        },
        "label_queries_used": {
          "type": "integer",
          "minimum": 0
        },
        "max_runtime_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "runtime_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "query_trace": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_index", "request_sha256", "response_sha256"],
        "properties": {
          "query_index": {
            "type": "integer",
            "minimum": 0
          },
          "request_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "response_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "valid_counterexample",
        "no_counterexample_found_within_budget",
        "verified_no_counterexample_in_bounded_domain"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "complete_domain_checked",
        "witness_feasible",
        "mismatch_reproduced",
        "checked_domain_size",
        "proof_artifact_sha256"
      ],
      "properties": {
        "mode": {
          "enum": [
            "candidate_witness_replay",
            "budgeted_search",
            "bounded_domain_exhaustive",
            "independent_proof_artifact"
          ]
        },
        "complete_domain_checked": {
          "type": "boolean"
        },
        "witness_feasible": {
          "type": "boolean"
        },
        "mismatch_reproduced": {
          "type": "boolean"
        },
        "checked_domain_size": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "proof_artifact_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "feasible",
        "candidate_prediction",
        "reference_prediction",
        "witness_sha256"
      ],
      "properties": {
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "feasible": {
          "type": "boolean"
        },
        "candidate_prediction": {
          "type": "boolean"
        },
        "reference_prediction": {
          "type": "boolean"
        },
        "witness_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "diagnosis_id": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "repair_patch_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "candidate_prediction": { "const": true },
                "reference_prediction": { "const": false }
              }
            },
            {
              "properties": {
                "candidate_prediction": { "const": false },
                "reference_prediction": { "const": true }
              }
            }
          ]
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": { "const": "valid_counterexample" }
        },
        "required": ["outcome"]
      },
      "then": {
        "required": ["witness"],
        "properties": {
          "witness": {
            "properties": {
              "feasible": { "const": true }
            }
          },
          "verification": {
            "properties": {
              "mode": {
                "enum": ["candidate_witness_replay", "bounded_domain_exhaustive"]
              },
              "witness_feasible": { "const": true },
              "mismatch_reproduced": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": { "const": "no_counterexample_found_within_budget" }
        },
        "required": ["outcome"]
      },
      "then": {
        "not": { "required": ["witness"] },
        "properties": {
          "verification": {
            "properties": {
              "mode": { "const": "budgeted_search" },
              "complete_domain_checked": { "const": false },
              "witness_feasible": { "const": false },
              "mismatch_reproduced": { "const": false },
              "proof_artifact_sha256": { "const": null }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": { "const": "verified_no_counterexample_in_bounded_domain" }
        },
        "required": ["outcome"]
      },
      "then": {
        "not": { "required": ["witness"] },
        "properties": {
          "verification": {
            "oneOf": [
              {
                "properties": {
                  "mode": { "const": "bounded_domain_exhaustive" },
                  "complete_domain_checked": { "const": true },
                  "checked_domain_size": { "type": "integer", "minimum": 1 },
                  "proof_artifact_sha256": { "const": null }
                }
              },
              {
                "properties": {
                  "mode": { "const": "independent_proof_artifact" },
                  "complete_domain_checked": { "const": true },
                  "checked_domain_size": { "const": null },
                  "proof_artifact_sha256": { "$ref": "#/$defs/sha256" }
                }
              }
            ]
          }
        }
      }
    }
  ]
}

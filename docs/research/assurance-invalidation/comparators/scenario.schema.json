{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/assurance-invalidation/comparators/tuf-rekor-scenario.schema.json",
  "title": "TUF/Rekor Metadata Comparator Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "pair_id",
    "variant",
    "comparator",
    "family",
    "contrast",
    "claim_id",
    "claim_property",
    "claim_scope",
    "prior_evidence",
    "change_observations",
    "change_coverage",
    "frontier_before",
    "frontier_after",
    "source_owner",
    "evaluator_instruction"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^META-[0-9]{3}$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^META-M[0-9]{2}$"
    },
    "variant": {
      "enum": [
        "A",
        "B"
      ]
    },
    "comparator": {
      "enum": [
        "TUF",
        "Rekor"
      ]
    },
    "family": {
      "enum": [
        "tuf_metadata_freshness",
        "tuf_snapshot_consistency",
        "tuf_delegation_revocation",
        "tuf_root_rotation",
        "rekor_inclusion",
        "rekor_consistency",
        "rekor_split_view",
        "rekor_absence"
      ]
    },
    "contrast": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_property": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope": {
      "type": "string",
      "minLength": 1
    },
    "prior_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_coverage": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "frontier_before": {
      "type": "string",
      "minLength": 1
    },
    "frontier_after": {
      "type": "string",
      "minLength": 1
    },
    "source_owner": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_instruction": {
      "type": "string",
      "minLength": 1
    }
  }
}

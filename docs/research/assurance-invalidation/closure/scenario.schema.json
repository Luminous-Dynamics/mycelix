{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/assurance-invalidation/closure/scenario.schema.json",
  "title": "LISE Invalidation Closure Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "pair_id",
    "variant",
    "family",
    "nodes",
    "dependency_edges",
    "change_events",
    "change_coverage",
    "unknown_scope_claim_nodes",
    "owner_semantics"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^CLOSE-[0-9]{3}$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^CLOSE-M[0-9]{2}$"
    },
    "variant": {
      "enum": [
        "A",
        "B"
      ]
    },
    "family": {
      "enum": [
        "key_lifecycle",
        "policy_dependency",
        "model_policy_scope",
        "route_inventory",
        "observer_dependency"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_kind",
          "claim_dimension"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_kind": {
            "enum": [
              "DEPENDENCY",
              "CLAIM_DIMENSION"
            ]
          },
          "claim_dimension": {
            "type": "string"
          }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_node_id",
          "to_node_id",
          "relation"
        ],
        "properties": {
          "from_node_id": {
            "type": "string",
            "minLength": 1
          },
          "to_node_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "const": "SUPPORTS_OR_CONDITIONS"
          }
        }
      }
    },
    "change_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "target_node_id",
          "event_type",
          "observation"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "target_node_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "enum": [
              "OBSERVED_QUALIFIED",
              "UNKNOWN",
              "UNSUPPORTED"
            ]
          }
        }
      }
    },
    "change_coverage": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "UNKNOWN"
      ]
    },
    "unknown_scope_claim_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "owner_semantics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

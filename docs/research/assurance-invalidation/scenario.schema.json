{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/assurance-invalidation/scenario.schema.json",
  "title": "LISE Assurance Invalidation Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "pair_id",
    "variant",
    "family",
    "contrast",
    "claim_id",
    "claim_property",
    "claim_scope",
    "prior_evidence",
    "change_observations",
    "change_coverage",
    "frontier_before",
    "frontier_after",
    "owner_semantics",
    "evaluator_instruction"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^INV-[0-9]{3}$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^INV-M[0-9]{2}$"
    },
    "variant": {
      "enum": [
        "A",
        "B"
      ]
    },
    "family": {
      "enum": [
        "identity_key_lifecycle",
        "policy_authority_delegation",
        "pep_route_profile",
        "agent_subject_context",
        "evidence_observer_dependency",
        "temporal_frontier_checkpoint",
        "evidence_lease"
      ]
    },
    "contrast": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_property": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope": {
      "type": "string",
      "minLength": 1
    },
    "prior_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_coverage": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "frontier_before": {
      "type": "string",
      "minLength": 1
    },
    "frontier_after": {
      "type": "string",
      "minLength": 1
    },
    "owner_semantics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluator_instruction": {
      "type": "string",
      "minLength": 1
    }
  }
}

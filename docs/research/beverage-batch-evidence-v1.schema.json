{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beverage Batch Evidence Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "batch_id",
    "events",
    "evidence_records",
    "attestations",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "beverage-batch-evidence-v1"
    },
    "status": {
      "const": "synthetic_fixture_not_a_production_record"
    },
    "batch_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_type",
          "occurred_at",
          "actor_ref",
          "input_batch_ids",
          "output_batch_ids",
          "evidence_refs"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "enum": [
              "RECEIVED",
              "PROCESS_STARTED",
              "FERMENTATION_COMPLETED",
              "BLENDED",
              "DISTILLED",
              "MATURED",
              "PACKAGED",
              "SHIPPED",
              "RECALLED",
              "CORRECTED"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor_ref": {
            "type": "string",
            "minLength": 1
          },
          "location_ref": {
            "type": "string"
          },
          "input_batch_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_batch_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supersedes_event_id": {
            "type": "string"
          }
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "subject_batch_id",
          "evidence_class",
          "category",
          "recorded_at",
          "method",
          "artifact_sha256",
          "rights_status",
          "data_sensitivity"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_batch_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "MEASURED",
              "MODELLED",
              "SIMULATED",
              "DECLARED",
              "UNKNOWN"
            ]
          },
          "category": {
            "enum": [
              "LAB_RESULT",
              "PROCESS_SENSOR",
              "INGREDIENT_ORIGIN",
              "CALIBRATION",
              "CUSTODY",
              "SUSTAINABILITY",
              "PRODUCT_IDENTITY",
              "OTHER"
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "instrument_ref": {
            "type": "string"
          },
          "calibration_evidence_ref": {
            "type": "string"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_uri": {
            "type": "string",
            "format": "uri"
          },
          "rights_status": {
            "enum": [
              "PERMITTED",
              "PERMITTED_WITH_ATTRIBUTION",
              "RESTRICTED",
              "PROHIBITED",
              "UNKNOWN"
            ]
          },
          "permission_ref": {
            "type": "string"
          },
          "data_sensitivity": {
            "enum": [
              "PUBLIC",
              "PARTNER",
              "CONFIDENTIAL",
              "TRADE_SECRET",
              "PERSONAL_DATA"
            ]
          },
          "supersedes_evidence_id": {
            "type": "string"
          }
        }
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attestation_id",
          "issuer_ref",
          "subject_ref",
          "subject_sha256",
          "scope",
          "issued_at",
          "signature_algorithm",
          "signature_sha256"
        ],
        "properties": {
          "attestation_id": {
            "type": "string",
            "minLength": 1
          },
          "issuer_ref": {
            "type": "string",
            "minLength": 1
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1
          },
          "subject_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time"
          },
          "signature_algorithm": {
            "type": "string",
            "minLength": 1
          },
          "signature_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verification_key_ref": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "subject_batch_id",
          "claim_type",
          "claim_value",
          "evidence_refs",
          "requested_audience"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_batch_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "ORIGIN",
              "PRODUCT_IDENTITY",
              "LAB_ATTRIBUTE",
              "INGREDIENTS",
              "SENSORY_ATTRIBUTE",
              "SUSTAINABILITY",
              "NUTRITION",
              "SAFETY",
              "REGULATORY_LABEL",
              "OTHER"
            ]
          },
          "claim_value": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array"
            ]
          },
          "units": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attestation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requested_audience": {
            "enum": [
              "PUBLIC",
              "TRADING_PARTNER",
              "AUDITOR",
              "REGULATOR",
              "INTERNAL"
            ]
          },
          "required_evidence_classes": {
            "type": "array",
            "items": {
              "enum": [
                "MEASURED",
                "MODELLED",
                "SIMULATED",
                "DECLARED"
              ]
            }
          },
          "required_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "jurisdiction_rule_ref": {
            "type": "string"
          },
          "required_effective_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}

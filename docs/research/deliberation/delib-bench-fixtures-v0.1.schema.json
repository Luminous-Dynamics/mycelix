{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/deliberation/delib-bench-fixtures-v0.1.schema.json",
  "title": "DelibBench synthetic fixture corpus v0.1",
  "description": "Strict schema for deterministic synthetic steering/representation fixtures. Structural validity is not human-subject or deliberative-quality qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "claim_ceiling",
    "fixture_count",
    "attack_family_count",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "const": "delib-bench-fixtures-v0.1"
    },
    "status": {
      "type": "string",
      "minLength": 20
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 20
    },
    "fixture_count": {
      "type": "integer",
      "minimum": 30
    },
    "attack_family_count": {
      "type": "integer",
      "minimum": 12
    },
    "fixtures": {
      "type": "array",
      "minItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "family",
          "class",
          "scenario_note",
          "source_claims",
          "output",
          "oracle",
          "evidence_state"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 8
          },
          "family": {
            "type": "string",
            "minLength": 3
          },
          "class": {
            "enum": [
              "red_team",
              "positive_control"
            ]
          },
          "scenario_note": {
            "type": "string",
            "minLength": 10
          },
          "source_claims": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_id",
                "speaker_id",
                "position",
                "epistemic_status",
                "source_ref"
              ],
              "properties": {
                "claim_id": {
                  "type": "string",
                  "minLength": 2
                },
                "speaker_id": {
                  "type": "string",
                  "minLength": 2
                },
                "position": {
                  "type": "string",
                  "minLength": 2
                },
                "epistemic_status": {
                  "enum": [
                    "supported",
                    "uncertain",
                    "contested"
                  ]
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "representations",
              "cited_source_refs",
              "uncertainty_preserved_claim_ids",
              "asserted_consensus",
              "asserted_authority",
              "followed_injection",
              "adopted_leading_frame",
              "presentation_order",
              "expected_presentation_order",
              "allocation_units",
              "reference_allocation_units",
              "attention_share",
              "max_attention_share",
              "counted_principal_ids"
            ],
            "properties": {
              "representations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "claim_id",
                    "speaker_id",
                    "position",
                    "epistemic_status",
                    "source_ref"
                  ],
                  "properties": {
                    "claim_id": {
                      "type": "string",
                      "minLength": 2
                    },
                    "speaker_id": {
                      "type": "string",
                      "minLength": 2
                    },
                    "position": {
                      "type": "string",
                      "minLength": 2
                    },
                    "epistemic_status": {
                      "enum": [
                        "supported",
                        "uncertain",
                        "contested"
                      ]
                    },
                    "source_ref": {
                      "type": "string",
                      "minLength": 2
                    }
                  }
                }
              },
              "cited_source_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "uncertainty_preserved_claim_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "asserted_consensus": {
                "type": "boolean"
              },
              "asserted_authority": {
                "type": "boolean"
              },
              "followed_injection": {
                "type": "boolean"
              },
              "adopted_leading_frame": {
                "type": "boolean"
              },
              "presentation_order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "expected_presentation_order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "allocation_units": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "item",
                    "units"
                  ],
                  "properties": {
                    "item": {
                      "type": "string",
                      "minLength": 2
                    },
                    "units": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "reference_allocation_units": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "item",
                    "units"
                  ],
                  "properties": {
                    "item": {
                      "type": "string",
                      "minLength": 2
                    },
                    "units": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "attention_share": {
                "type": "number",
                "minimum": 0
              },
              "max_attention_share": {
                "type": "number",
                "minimum": 0
              },
              "counted_principal_ids": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expected_disposition",
              "expected_violations"
            ],
            "properties": {
              "expected_disposition": {
                "enum": [
                  "Pass",
                  "Fail"
                ]
              },
              "expected_violations": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              }
            }
          },
          "evidence_state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_status",
              "presented_status",
              "required_evidence_refs",
              "preserved_evidence_refs",
              "required_unresolved_objection_ids",
              "preserved_unresolved_objection_ids",
              "decision_status",
              "decision_assumptions"
            ],
            "properties": {
              "source_status": {
                "enum": [
                  "Contested",
                  "Indeterminate",
                  "Resolved"
                ]
              },
              "presented_status": {
                "enum": [
                  "Contested",
                  "Indeterminate",
                  "Resolved"
                ]
              },
              "required_evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "preserved_evidence_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "required_unresolved_objection_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "preserved_unresolved_objection_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "decision_status": {
                "enum": [
                  "NoDecision",
                  "ProceedConditionally",
                  "Defer"
                ]
              },
              "decision_assumptions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          }
        }
      }
    }
  }
}

    "provenance_fidelity",
    "acquisition_loss",
    "compression_loss",
    "reasoning_loss",
    "token_cost",
    "latency",
    "compute"
  ],
  "preregistered_contrasts": [
    "rarity_advantage_by_support_and_decoy_ownership",
    "relevance_filter_decoy_admission",
    "evidence_balance_vs_rarity_and_relevance",
    "attribution_only_choice_displacement",
    "acquisition_vs_compression_vs_reasoning_failure",

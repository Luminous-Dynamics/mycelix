{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/IPB_PROTECTED_EFFECT_TRACE.schema.json",
  "title": "Luminous Protected Effect Trace Contract v0.1",
  "description": "Normalized, source-qualified event trace for cross-benchmark authorization and protected-effect evaluation. This schema validates structure, not truth or source independence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_version",
    "suite_id",
    "scenario_id",
    "run_id",
    "evaluation_arm",
    "system",
    "task",
    "frozen_input_sha256",
    "expected_action_ids",
    "events"
  ],
  "properties": {
    "trace_version": {
      "const": "0.1"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^(F|A|R)[0-9]{2}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_arm": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "system_version",
        "build_sha",
        "configuration_sha256",
        "harness_name",
        "harness_version"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "system_version": {
          "type": "string",
          "minLength": 1
        },
        "build_sha": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "harness_name": {
          "type": "string",
          "minLength": 1
        },
        "harness_version": {
          "type": "string",
          "minLength": 1
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_schema_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ref",
        "instruction_sha256",
        "authorized_scope_ref"
      ],
      "properties": {
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "instruction_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authorized_scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "objective_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "frozen_input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expected_action_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_id",
          "event_type",
          "occurred_at",
          "recorded_at",
          "source_kind",
          "source_ref",
          "capture_origin"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "enum": [
              "task_created",
              "clarification_requested",
              "clarification_received",
              "operation_proposed",
              "approval_recorded",
              "authority_snapshot",
              "constitution_snapshot",
              "resource_snapshot",
              "credential_inventory",
              "policy_decision",
              "route_inventory",
              "preflight_decision",
              "provider_dispatch",
              "provider_acknowledgement",
              "provider_status_query",
              "protected_effect_observation",
              "reconciliation",
              "retry_attempt",
              "compensation_action",
              "revocation_observed",
              "session_revalidation",
              "claim_observation"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_kind": {
            "enum": [
              "principal",
              "human_reviewer",
              "candidate_agent",
              "authority_owner",
              "constitution_owner",
              "resource_owner",
              "policy_engine",
              "enforcement_point",
              "provider",
              "independent_observer",
              "harness",
              "evaluator"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "capture_origin": {
            "enum": [
              "independent_harness",
              "owner_native",
              "provider_native",
              "candidate_reported",
              "human_entered",
              "evaluator_derived"
            ]
          },
          "correlation_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "causation_event_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "principal_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "logical_operation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "action_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "action_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "destination_or_audience": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          },
          "amount_minor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_state": {
            "enum": [
              "authorized",
              "denied",
              "revoked",
              "historical",
              "pending",
              "unknown",
              "not_applicable",
              null
            ]
          },
          "constitution_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "constitution_epoch": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "constitution_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "authority_state": {
            "enum": [
              "current",
              "revoked",
              "expired",
              "not_yet_valid",
              "unknown",
              "not_applicable",
              null
            ]
          },
          "authority_effective_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "authority_known_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "resource_state": {
            "enum": [
              "matches",
              "mismatch",
              "unknown",
              "not_required",
              "not_applicable",
              null
            ]
          },
          "route_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "enforcement_point_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "route_reachable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "decision": {
            "enum": [
              "ALLOW",
              "DENY",
              "HOLD",
              "INDETERMINATE",
              null
            ]
          },
          "attempt_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_contract_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "idempotency_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_outcome": {
            "enum": [
              "accepted",
              "rejected",
              "timeout",
              "unknown",
              "not_applicable",
              null
            ]
          },
          "effect_state": {
            "enum": [
              "not_attempted",
              "confirmed_no_effect",
              "confirmed_applied",
              "partially_applied",
              "unknown",
              "partial_with_unknown",
              "provider_reported_applied",
              "unsupported",
              null
            ]
          },
          "observation_kind": {
            "enum": [
              "provider_acknowledgement",
              "provider_status_query",
              "independent_observation",
              "owner_reconciliation",
              "missing",
              "not_applicable",
              null
            ]
          },
          "observer_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependency_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "independence_classification": {
            "enum": [
              "qualified_independent",
              "known_shared_dependency",
              "unknown",
              "not_assessed",
              "not_applicable",
              null
            ]
          },
          "expected_action_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observed_action_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "retry_safety": {
            "enum": [
              "same_operation_same_key_qualified",
              "unsupported",
              "unknown",
              "not_applicable",
              null
            ]
          },
          "retry_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "compensation_of_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_disposition": {
            "enum": [
              "supported_within_scope",
              "contested",
              "disputed",
              "unsupported",
              "superseded",
              "unknown",
              "not_applicable",
              null
            ]
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "knowledge_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "details_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

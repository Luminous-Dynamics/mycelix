{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/docs/research/LARP_V2_CONFORMANCE_SCHEMA_V0_1.json",
  "title": "LARP v2 conformance scenario and oracle schema",
  "description": "Strict schema for the synthetic scenario inputs and their separately maintained reference oracle. Cross-file ID parity and case_count equality require an additional conformance check.",
  "oneOf": [
    {
      "$ref": "#/$defs/scenarioSuite"
    },
    {
      "$ref": "#/$defs/oracleSuite"
    }
  ],
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "kind",
        "title",
        "given",
        "request",
        "facts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(P|A|R)[0-9]{2}$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "positive",
            "attack",
            "recovery"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "given": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "request": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "$ref": "#/$defs/facts"
        }
      }
    },
    "oracleRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "expected_disposition",
        "reason_codes",
        "notes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^(P|A|R)[0-9]{2}$"
        },
        "expected_disposition": {
          "type": "string",
          "enum": [
            "permit",
            "deny",
            "hold",
            "indeterminate",
            "challenge_required"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenarioSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "suite_id",
        "status",
        "contract_version",
        "case_count",
        "fixture_rules",
        "cases",
        "fact_schema_version"
      ],
      "properties": {
        "schema_version": {
          "const": "lise.larp-scenarios.v0.1"
        },
        "suite_id": {
          "const": "LARP-CONTRACTS-001"
        },
        "status": {
          "const": "synthetic-development-seed"
        },
        "contract_version": {
          "const": "LARP-v2-contract-kernel-0.1"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "fixture_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scenario"
          }
        },
        "fact_schema_version": {
          "const": "lise.larp-facts.v0.1"
        }
      }
    },
    "oracleSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "suite_id",
        "status",
        "scenario_file",
        "disposition_vocabulary",
        "case_count",
        "rows"
      ],
      "properties": {
        "schema_version": {
          "const": "lise.larp-oracle.v0.1"
        },
        "suite_id": {
          "const": "LARP-CONTRACTS-001"
        },
        "status": {
          "const": "synthetic-reference-oracle-pending-independent-review"
        },
        "scenario_file": {
          "const": "LARP_V2_CONFORMANCE_SCENARIOS_V0_1.json"
        },
        "disposition_vocabulary": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "permit",
              "deny",
              "hold",
              "indeterminate",
              "challenge_required"
            ]
          }
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/oracleRow"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "evaluated_at_unix",
        "authority",
        "scope",
        "rights",
        "evidence",
        "institution",
        "execution"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "protected_action",
            "contract_activation",
            "ratification",
            "evidence_admission",
            "historical_reconstruction",
            "exit",
            "remedy",
            "staged_reward",
            "safe_continuity"
          ]
        },
        "evaluated_at_unix": {
          "type": "integer",
          "minimum": 0
        },
        "authority": {
          "$ref": "#/$defs/authorityFacts"
        },
        "scope": {
          "$ref": "#/$defs/scopeFacts"
        },
        "rights": {
          "$ref": "#/$defs/rightsFacts"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceFacts"
        },
        "institution": {
          "$ref": "#/$defs/institutionFacts"
        },
        "execution": {
          "$ref": "#/$defs/executionFacts"
        }
      }
    },
    "authorityFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_authorized": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "peer_credential_only": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "transitive_authority": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "constitution_current": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "local_ratification": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "predecessor_digest_matches": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ai_self_ratification": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "old_authority_stale": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "restore_old_privileges": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recovery_quorum_met": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "partner_credential_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "treasury_separately_authorized": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "scopeFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "exact_operation_match": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delegation_attenuates": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "payout_bounded": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "rightsFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rights_satisfied": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "remedy_path_defined": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "high_impact": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "exit_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "challenge_upheld": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reviewer_independent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "remedy_authorized": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "history_preserved": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "evidenceFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sufficient": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "independent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "inventory_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "known_shared_dependency": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "historically_valid_at_time": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fresh_for_current_time": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "outcome_independently_observed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "similarity_only_signal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "score_only_sanction": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "institutionFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_risk": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "oversight_independent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "known_route_bypass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "degraded_service_allowlisted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "high_impact_paused": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "high_impact_requested": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "old_sessions_fenced": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "executionFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "not_started",
            "unknown",
            "partially_applied",
            "applied",
            "confirmed_no_effect"
          ]
        },
        "retry_requested": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "retry_safety_qualified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "single_use_consumed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "duplicate_requested": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "contract_expires_at_unix": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}

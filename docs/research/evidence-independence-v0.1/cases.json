{
  "schemaVersion": "0.1.0",
  "title": "Mycelix evidence independence conformance corpus",
  "status": "research_fixture_contract_not_runtime_evidence",
  "semanticBoundary": "This corpus tests identity/provenance independence classifications. It does not establish scientific truth, evidential quality, or funding eligibility.",
  "profileDefinitions": {
    "reviewer_diversity": {
      "requiredDimensions": [
        "actor"
      ],
      "requiredPresence": [
        "actor"
      ],
      "minimumDistinctSources": 2
    },
    "organization_independence": {
      "requiredDimensions": [
        "actor",
        "organization"
      ],
      "requiredPresence": [
        "actor",
        "organization"
      ],
      "minimumDistinctSources": 2
    },
    "empirical_replication": {
      "requiredDimensions": [
        "actor",
        "organization",
        "lab",
        "dataset_lineage"
      ],
      "requiredPresence": [
        "actor",
        "organization",
        "lab",
        "dataset_lineage",
        "protocol",
        "preregistration"
      ],
      "minimumDistinctSources": 2,
      "sharedProtocolAllowed": true
    },
    "computational_reproduction": {
      "requiredDimensions": [
        "actor",
        "method_family",
        "execution_provenance"
      ],
      "requiredPresence": [
        "actor",
        "dataset_lineage",
        "method_family",
        "execution_provenance",
        "protocol"
      ],
      "minimumDistinctSources": 2,
      "sameDatasetAllowed": true
    }
  },
  "dimensionStatuses": [
    "established",
    "not_established",
    "unknown",
    "conflicted"
  ],
  "qualificationStatuses": [
    "qualified",
    "not_qualified",
    "indeterminate"
  ],

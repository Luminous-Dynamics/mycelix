{
  "schema_version": "0.1.0",
  "id": "CIV-BOOT-COMPUTER-REPRO-CORPUS",
  "status": "E0 synthetic benchmark specification; no physical run results are encoded",
  "purpose": "Test claim boundaries for bounded computer reproduction. These are preregistered scenario expectations for a future independent evaluator, not evidence that any scenario has occurred physically.",
  "canonical_owners": {
    "computer_domain": "https://github.com/Luminous-Dynamics/symthaea/issues/5796",
    "computer_fixture": "https://github.com/Luminous-Dynamics/symthaea/issues/5798",
    "host_removal_campaign": "https://github.com/Luminous-Dynamics/symthaea/issues/7658",
    "capability_closure": "https://github.com/Luminous-Dynamics/symthaea/issues/5781",
    "atlas_projection": "https://github.com/Luminous-Dynamics/mycelix/issues/5063"
  },
  "semantics": {
    "C0": "The target can be assembled from the declared complete BOM and passes the baseline profile tests.",
    "C2": "Specified mechanical support parts can be locally produced and inspected under the declared profile.",
    "C3": "A board can be populated/reworked and tested using a purchased bare PCB and qualified component stock.",
    "C4": "The connected original host runs the bounded workflow to build/program/test a copy.",
    "C5": "After verified removal of the original host, the first copy independently runs the preserved workflow to build/program/cold-boot/test another copy.",
    "C6": "A particular bare-PCB process is locally demonstrated under a separately qualified profile.",
    "C7": "A separately qualified semiconductor die fabrication chain exists; this is out of scope for the initial campaign.",
    "E5": "Independent reproduction by a separately operated node using transferred knowledge and qualified inputs; not inferable from a same-host second run.",
    "C1": "Diagnose and repair a declared failed subsystem using qualified tools/parts, then independently pass the post-repair acceptance test."
  },
  "state_fields": {
    "baseline_computer_operational": "A currently working target exists; this alone grants no manufacturing capability.",
    "target_bom_complete": "Complete BOM with identities, revisions and quantities is frozen.",
    "compute_module_stock": "A compatible compute module/CPU/SoM needed for each copy is present or provided via a declared qualified source.",
    "memory_storage_stock": "Compatible memory/storage needed for each copy is present or provided via a declared qualified source.",
    "bare_pcb_stock": "Correct revision of bare PCB is available from a declared source.",
    "electronic_component_stock": "Required imported ICs, passives, connectors and other parts are available and revision-compatible.",
    "mechanical_fabrication_qualified": "Declared local mechanical route is qualified for the specific enclosure/fixture outputs.",
    "board_assembly_qualified": "Board population/rework route is qualified for this board profile.",
    "board_test_qualified": "Required electrical test fixture and acceptance criteria are available and qualified.",
    "calibration_current": "Required measurement/reference artifacts are present and current.",
    "independent_acceptance_suite": "Frozen independent CPU/MCU, memory, storage, I/O, power/thermal and boot tests are available as appropriate to profile.",
    "offline_source_toolchain_complete": "Sources, compiler/build system, firmware, licenses, dependencies, design artifacts and recovery instructions needed for the workflow are archived and usable offline.",
    "host_online_tools_available": "The original host may use declared network-accessible tools/services during C4.",
    "host_removal_verified": "Original host is disconnected from the active production path and this condition is independently observed.",
    "hidden_original_host_path": "A hidden network, remote session, delegated worker or other path still relies on the original host.",
    "revision_match": "Hardware, firmware, process profile, toolchain and BOM revisions match the frozen declared profile.",
    "interventions_fully_recorded": "Human steps, outside services, failures, rework and external components are fully recorded.",
    "external_services_declared": "Every external manufacturing/toolchain/test/service dependency is declared in the run receipt.",
    "qualified_bare_pcb_process": "A local bare-PCB fabrication process is qualified for the exact declared board profile.",
    "qualified_semiconductor_die_process": "Every required die-fabrication dependency is independently modeled and qualified for the declared semiconductor profile.",
    "separate_node_transfer": "A separately operated node/operator reproduces the profile from transferred knowledge and qualified inputs.",
    "tool_renewal_closed": "Tools, calibration and maintenance resources required for subsequent generations can be renewed/reproduced under the declared horizon.",
    "qualified_seed_clone_available": "A previously built first-generation copy has independently passed the declared acceptance suite and is the C5 reproducing host.",
    "diagnostics_and_rework_qualified": "A diagnostic, repair/rework, and post-repair verification route is qualified for the declared subsystem profile.",
    "declared_replacement_parts_stock": "Required declared replacement parts for the profile are in stock or available through a qualified, declared source.",
    "repair_post_test_available": "Independent post-repair tests and required current measurement references are available."
  },
  "outcome_fields": {
    "baseline_use": "true|false|unresolved",
    "C0_assembly": "pass|fail|unresolved|not_evaluated",
    "C2_mechanical_support": "pass|fail|unresolved|not_evaluated",
    "C3_board_assembly": "pass|fail|unresolved|not_evaluated",
    "C4_host_assisted_clone": "pass|fail|unresolved|not_evaluated",
    "C5_host_removed_reproduction": "pass|fail|unresolved|not_evaluated",
    "E5_independent_transfer": "eligible|not_eligible|unresolved",
    "multigeneration_renewal": "pass|fail|unresolved|not_evaluated",
    "PCB_local_fabrication": "pass|fail|unresolved|not_evaluated (independent branch; not an ordered reproduction level)",
    "DIE_local_fabrication": "pass|fail|unresolved|not_evaluated (independent deep-industrial branch; not inferred from computer replication)",
    "C1_repair": "pass|fail|unresolved|not_evaluated"
  },

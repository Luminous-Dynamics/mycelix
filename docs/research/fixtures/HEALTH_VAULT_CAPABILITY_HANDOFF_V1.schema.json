{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/health-vault-capability-handoff-v1.json",
  "title": "Mycelix Health Vault capability handoff adversarial corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "claim_ceiling",
    "invariants",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix.health-vault.capability-handoff-fixtures.v1"
    },
    "status": {
      "const": "authored_not_executed"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "operation",
          "category",
          "setup",
          "expected",
          "measurements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HCH-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "offer_ingest",
              "offer_validate",
              "offer_decrypt",
              "shared_read",
              "offer_delivery",
              "secret_sink_scan",
              "key_enrollment"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "setup": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol_result",
              "failure_code",
              "effective_claim_delta",
              "protected_payload_bytes_returned"
            ],
            "properties": {
              "protocol_result": {
                "enum": [
                  "success",
                  "denied",
                  "unavailable",
                  "retryable"
                ]
              },
              "failure_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effective_claim_delta": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "protected_payload_bytes_returned": {
                "const": 0
              }
            }
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-adapter-run-receipt-v1.json",
  "title": "AeroCommons Adapter Run Receipt V1",
  "description": "Content-bound record of one declared adapter invocation. Schema validity and digest integrity do not authenticate execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "benchmark_id", "case_id", "adapter", "inputs",
    "invocation", "outputs", "status", "exit_code", "elapsed_ms", "warnings",
    "unsupported_assertions", "receipt_sha256"
  ],
  "properties": {
    "schema": { "const": "AeroAdapterRunReceiptV1" },
    "run_id": { "type": "string", "minLength": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "version", "executable"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executable": { "$ref": "#/$defs/contentArtifact" },
        "build_provenance": {
          "oneOf": [
            { "$ref": "#/$defs/artifactRef" },
            { "type": "null" }
          ]
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifact", "rights_status"],
        "properties": {
          "role": {
            "enum": [
              "ap242_product_definition", "qif_input", "nc_program",
              "metrology_plan", "adapter_configuration", "auxiliary"
            ]
          },
          "artifact": { "$ref": "#/$defs/contentArtifact" },
          "rights_status": { "$ref": "#/$defs/rightsStatus" }
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arguments", "environment_profile", "configuration_sha256",
        "locale", "timezone", "network_policy", "declared_egress",
        "observed_egress", "timeout_ms"
      ],
      "properties": {
        "arguments": { "$ref": "#/$defs/contentArtifact" },
        "environment_profile": { "$ref": "#/$defs/contentArtifact" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "network_policy": { "enum": ["disabled", "allowlisted"] },
        "declared_egress": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "observed_egress": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifact", "rights_status"],
        "properties": {
          "role": { "enum": ["raw_artifact", "normalized_assertions"] },
          "artifact": { "$ref": "#/$defs/contentArtifact" },
          "rights_status": { "$ref": "#/$defs/rightsStatus" }
        }
      }
    },
    "status": { "enum": ["succeeded", "failed", "timed_out"] },
    "exit_code": { "type": ["integer", "null"] },
    "elapsed_ms": { "type": "integer", "minimum": 1 },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unsupported_assertions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "contentArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256", "byte_length", "media_type", "format_id"],
      "properties": {
        "reference": { "$ref": "#/$defs/artifactRef" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "format_id": { "type": "string", "minLength": 1 }
      }
    },
    "rightsStatus": {
      "enum": ["CLEARED_FOR_TESTING", "CLEARED_FOR_REDISTRIBUTION", "NOT_REVIEWED", "RESTRICTED"]
    }
  }
}

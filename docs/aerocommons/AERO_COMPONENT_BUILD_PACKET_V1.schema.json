{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/AeroComponentBuildPacketV1.json",
  "title": "AeroComponentBuildPacketV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "component",
    "configuration",
    "design_definition",
    "requirements",
    "process_plan",
    "material_batch",
    "machine",
    "tooling",
    "build_evidence",
    "inspection_plan",
    "inspection_instrument",
    "inspection_calibration",
    "inspection_result",
    "inspection_evidence",
    "test_plan",
    "test_instrument",
    "test_calibration",
    "test_result",
    "test_evidence"
  ],
  "properties": {
    "schema": {
      "const": "AeroComponentBuildPacketV1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "$ref": "#/$defs/ref"
    },
    "configuration": {
      "$ref": "#/$defs/ref"
    },
    "design_definition": {
      "$ref": "#/$defs/content"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "process_plan": {
      "$ref": "#/$defs/content"
    },
    "material_batch": {
      "$ref": "#/$defs/ref"
    },
    "machine": {
      "$ref": "#/$defs/ref"
    },
    "tooling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "build_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "inspection_plan": {
      "$ref": "#/$defs/ref"
    },
    "inspection_instrument": {
      "$ref": "#/$defs/ref"
    },
    "inspection_calibration": {
      "$ref": "#/$defs/evidence"
    },
    "inspection_result": {
      "$ref": "#/$defs/content"
    },
    "inspection_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "test_plan": {
      "$ref": "#/$defs/ref"
    },
    "test_instrument": {
      "$ref": "#/$defs/ref"
    },
    "test_calibration": {
      "$ref": "#/$defs/evidence"
    },
    "test_result": {
      "$ref": "#/$defs/content"
    },
    "test_evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "sha256",
        "byte_length",
        "media_type",
        "format_id"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/ref"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "format_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "AeroEvidenceV1 from the pinned Mycelix evidence-types crate; structural validation is delegated to that crate."
    }
  }
}

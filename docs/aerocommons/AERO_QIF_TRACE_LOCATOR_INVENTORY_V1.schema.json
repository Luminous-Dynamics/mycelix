{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-qif-trace-locator-inventory-v1.json",
  "title": "AeroQifTraceLocatorInventoryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "body",
    "inventory_sha256"
  ],
  "properties": {
    "schema": {
      "const": "AeroQifTraceLocatorInventoryV1"
    },
    "body": {
      "$ref": "#/$defs/body"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "qifRole": {
      "enum": [
        "results",
        "plan",
        "auxiliary"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_qpid",
        "source_path",
        "source_element_id",
        "local_reference_id",
        "parent_external_document_reference_id",
        "external_document_reference_id",
        "external_xid"
      ],
      "properties": {
        "document_qpid": {
          "$ref": "#/$defs/uuid"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/QIFDocument/"
        },
        "source_element_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "local_reference_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "parent_external_document_reference_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "external_document_reference_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "external_xid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qpid",
        "role",
        "sha256",
        "byte_length",
        "root_expanded_name",
        "version_qif",
        "element_count",
        "max_observed_depth",
        "text_bytes"
      ],
      "properties": {
        "qpid": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "$ref": "#/$defs/qifRole"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "root_expanded_name": {
          "type": "string",
          "minLength": 1
        },
        "version_qif": {
          "const": "3.0.0"
        },
        "element_count": {
          "type": "integer",
          "minimum": 1
        },
        "max_observed_depth": {
          "type": "integer",
          "minimum": 1
        },
        "text_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "capture",
        "locator",
        "field_value_sha256",
        "captured_value",
        "captured_attributes"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "capture": {
          "enum": [
            "element",
            "element_id",
            "text",
            "qif_reference",
            "local_qif_reference",
            "document_qpid",
            "external_plan_qpid",
            "external_plan_uri"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "field_value_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_attributes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^\\{[^}]*\\}.+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results_qpid",
        "local_reference_id",
        "plan_qpid",
        "source_uri",
        "source_locator"
      ],
      "properties": {
        "results_qpid": {
          "$ref": "#/$defs/uuid"
        },
        "local_reference_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "plan_qpid": {
          "$ref": "#/$defs/uuid"
        },
        "source_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/QIFDocument/"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_id",
        "profile_id",
        "profile_version",
        "profile_sha256",
        "qif_standard_version",
        "documents",
        "locators",
        "declared_external_document_reference_ids",
        "external_document_references"
      ],
      "properties": {
        "inventory_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qif_standard_version": {
          "const": "3.0.0"
        },
        "documents": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "declared_external_document_reference_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "uniqueItems": true
        },
        "external_document_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/externalReference"
          }
        }
      }
    }
  }
}
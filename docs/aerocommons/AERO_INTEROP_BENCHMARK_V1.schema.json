{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-interop-benchmark-v1.json",
  "title": "AeroInteropBenchmarkV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "body",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "AeroInteropBenchmarkV1"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body": {
      "$ref": "#/$defs/manifestBody"
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contentArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "sha256",
        "byte_length",
        "media_type",
        "format_id"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/artifactRef"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "format_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manifestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "profile_version",
        "qif_standard_version",
        "ap242_edition",
        "corpus_version",
        "tools",
        "cases"
      ],
      "properties": {
        "benchmark_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "qif_standard_version": {
          "type": "string",
          "minLength": 1
        },
        "ap242_edition": {
          "type": "string",
          "minLength": 1
        },
        "corpus_version": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "version",
        "category",
        "executable",
        "arguments",
        "environment_profile",
        "configuration_sha256",
        "locale",
        "timezone",
        "network_policy",
        "declared_egress",
        "timeout_ms"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "qif_schema_validator",
            "qif_xslt_validator",
            "step_analyzer",
            "cad_or_cmm_adapter",
            "extractor",
            "trace_resolver",
            "semantic_comparator",
            "other"
          ]
        },
        "executable": {
          "$ref": "#/$defs/contentArtifact"
        },
        "arguments": {
          "$ref": "#/$defs/contentArtifact"
        },
        "environment_profile": {
          "$ref": "#/$defs/contentArtifact"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "network_policy": {
          "enum": [
            "disabled",
            "allowlisted"
          ]
        },
        "declared_egress": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_class",
        "inputs",
        "oracle_artifact",
        "oracle_rights_status",
        "oracle_method",
        "oracle_profile_version",
        "claims"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "case_class": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "oracle_artifact": {
          "$ref": "#/$defs/contentArtifact"
        },
        "oracle_rights_status": {
          "enum": [
            "CLEARED_FOR_TESTING",
            "CLEARED_FOR_REDISTRIBUTION",
            "NOT_REVIEWED",
            "RESTRICTED"
          ]
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "oracle_method": {
          "type": "string",
          "minLength": 1
        },
        "oracle_profile_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "artifact",
        "rights_status"
      ],
      "properties": {
        "role": {
          "enum": [
            "ap242_product_definition",
            "qif_input",
            "nc_program",
            "metrology_plan",
            "adapter_configuration",
            "auxiliary"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/contentArtifact"
        },
        "rights_status": {
          "enum": [
            "CLEARED_FOR_TESTING",
            "CLEARED_FOR_REDISTRIBUTION",
            "NOT_REVIEWED",
            "RESTRICTED"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "dimension",
        "expectation",
        "safety_critical",
        "source_locator",
        "rationale_code"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": [
            "qif_structure",
            "qif_normative_checks",
            "ap242_pmi_conformance",
            "source_extraction",
            "identity_resolution",
            "semantic_preservation",
            "result_status_retention",
            "reproducibility",
            "execution_security"
          ]
        },
        "expectation": {
          "enum": [
            "accept",
            "reject",
            "unadjudicated"
          ]
        },
        "safety_critical": {
          "type": "boolean"
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "rationale_code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-qif-ingest-qualification-v1.json",
  "title": "AeroQifIngestQualificationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "body",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "AeroQifIngestQualificationV1"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_id",
        "benchmark_case_id",
        "qif_standard_version",
        "qif_profile",
        "documents",
        "external_document_bindings",
        "bundles",
        "runtime",
        "tools",
        "sandbox",
        "stage_results",
        "extraction"
      ],
      "properties": {
        "qualification_id": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_case_id": {
          "type": "string",
          "minLength": 1
        },
        "qif_standard_version": {
          "const": "3.0.0"
        },
        "qif_profile": {
          "enum": [
            "qif3_normative",
            "qif3_plus_preview"
          ]
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "qpid",
              "role",
              "artifact"
            ],
            "properties": {
              "qpid": {
                "$ref": "#/$defs/uuid"
              },
              "role": {
                "enum": [
                  "results",
                  "plan",
                  "auxiliary"
                ]
              },
              "artifact": {
                "$ref": "#/$defs/contentArtifact"
              },
              "source_uri": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "external_document_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "results_qpid",
              "local_reference_id",
              "target_plan_qpid",
              "staged_relative_path"
            ],
            "properties": {
              "results_qpid": {
                "$ref": "#/$defs/uuid"
              },
              "local_reference_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "target_plan_qpid": {
                "$ref": "#/$defs/uuid"
              },
              "source_uri": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "staged_relative_path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*[\\\\:%])[A-Za-z0-9._/-]+$"
              }
            }
          }
        },
        "bundles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xsd",
            "xslt"
          ],
          "properties": {
            "xsd": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entrypoint",
                "files"
              ],
              "properties": {
                "entrypoint": {
                  "$ref": "#/$defs/contentArtifact"
                },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/bundleFile"
                  }
                }
              }
            },
            "xslt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root_stylesheet",
                "files",
                "check_parameters",
                "profile"
              ],
              "properties": {
                "root_stylesheet": {
                  "$ref": "#/$defs/contentArtifact"
                },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/bundleFile"
                  }
                },
                "check_parameters": {
                  "$ref": "#/$defs/contentArtifact"
                },
                "profile": {
                  "enum": [
                    "qif3_normative",
                    "qif3_plus_preview"
                  ]
                }
              }
            }
          }
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "tools": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "stage_results": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "extraction": {
          "oneOf": [
            {
              "$ref": "#/$defs/extraction"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contentArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "sha256",
        "byte_length",
        "media_type",
        "format_id"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/artifactRef"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "format_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "artifact"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/contentArtifact"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_name",
        "runtime_version",
        "support",
        "runtime_image"
      ],
      "properties": {
        "runtime_name": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "enum": [
            "supported_lts",
            "unsupported_legacy",
            "unverified"
          ]
        },
        "runtime_image": {
          "$ref": "#/$defs/contentArtifact"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "kind",
        "name",
        "version",
        "source_repository",
        "source_commit_sha",
        "executable"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "xml_schema",
            "xslt",
            "extractor",
            "trace_resolver"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_repository": {
          "type": "string",
          "minLength": 1
        },
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "executable": {
          "$ref": "#/$defs/contentArtifact"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "filesystem",
        "rootless",
        "no_host_secrets",
        "cpu_limit_seconds",
        "memory_limit_bytes",
        "wall_time_limit_ms",
        "max_document_bytes",
        "max_total_input_bytes",
        "max_document_count",
        "max_link_recursion_depth",
        "policy_artifact",
        "runner_attestation"
      ],
      "properties": {
        "network": {
          "enum": [
            "disabled",
            "allowlisted",
            "enabled",
            "unknown"
          ]
        },
        "filesystem": {
          "enum": [
            "staged_inputs_read_only_outputs_write_only",
            "unrestricted",
            "unknown"
          ]
        },
        "rootless": {
          "type": "boolean"
        },
        "no_host_secrets": {
          "type": "boolean"
        },
        "cpu_limit_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "memory_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "wall_time_limit_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "max_document_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "max_total_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "max_document_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_link_recursion_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "policy_artifact": {
          "$ref": "#/$defs/contentArtifact"
        },
        "runner_attestation": {
          "$ref": "#/$defs/contentArtifact"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "disposition",
        "validator_tool_id",
        "report_artifact",
        "reason_codes"
      ],
      "properties": {
        "stage": {
          "enum": [
            "xml_well_formedness",
            "xsd_structure",
            "xslt_format",
            "xslt_quality",
            "xslt_semantic",
            "extraction_fidelity",
            "external_reference_resolution"
          ]
        },
        "disposition": {
          "enum": [
            "passed",
            "failed",
            "warning",
            "unknown",
            "not_run",
            "blocked"
          ]
        },
        "validator_tool_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_artifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_trace_artifact",
        "source_mapping_manifest",
        "required_locators",
        "mappings",
        "mapping_counts"
      ],
      "properties": {
        "normalized_trace_artifact": {
          "$ref": "#/$defs/contentArtifact"
        },
        "source_mapping_manifest": {
          "$ref": "#/$defs/contentArtifact"
        },
        "mapping_counts": {
          "$ref": "#/$defs/mappingCounts"
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceMapping"
          }
        },
        "required_locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceFieldLocator"
          }
        }
      }
    },
    "mappingCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_required",
        "mapped",
        "unresolved",
        "ambiguous",
        "unsupported",
        "dropped"
      ],
      "properties": {
        "total_required": {
          "type": "integer",
          "minimum": 0
        },
        "mapped": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_qpid",
        "source_path",
        "source_element_id",
        "external_document_reference_id",
        "external_xid",
        "mapping_rule_id",
        "mapping_profile_version",
        "disposition",
        "target_object_kind",
        "target_object_id",
        "reason_code"
      ],
      "properties": {
        "document_qpid": {
          "$ref": "#/$defs/uuid"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/QIFDocument/"
        },
        "source_element_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "external_document_reference_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "external_xid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "mapping_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "mapping_profile_version": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "mapped",
            "unresolved",
            "ambiguous",
            "unsupported",
            "dropped"
          ]
        },
        "target_object_kind": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "target_object_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "sourceFieldLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_qpid",
        "source_path",
        "source_element_id",
        "external_document_reference_id",
        "external_xid"
      ],
      "properties": {
        "document_qpid": {
          "$ref": "#/$defs/uuid"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/QIFDocument/"
        },
        "source_element_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "external_document_reference_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "external_xid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/feat/economy-atlas-model-registry-v1/docs/economy-atlas/regenerative-observation-record.schema.json",
  "title": "Mycelix regenerative observation receipt v1",
  "description": "Schema for source-bound, unreviewed observations associated with a candidate indicator. A valid record is not proof of source correctness, causal impact or indicator qualification.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "observation_id",
    "qualification_status",
    "indicator_id",
    "indicator_catalog_sha256",
    "source",
    "geography",
    "period",
    "indicator_native_unit_contract",
    "unit_mapping_note",
    "denominator_contract_note",
    "native_unit",
    "denominator_definition",
    "observation_status",
    "measurement",
    "transformation",
    "coverage",
    "uncertainty",
    "quality_flags"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "regenerative_observation_record"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "qualification_status": {
      "const": "unreviewed_source_observation"
    },
    "indicator_id": {
      "type": "string",
      "minLength": 3
    },
    "indicator_catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "dataset_id",
        "series_id",
        "source_url",
        "source_revision",
        "retrieved_on",
        "artifact_sha256",
        "license_or_access_policy"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "series_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_or_access_policy": {
          "type": "string",
          "minLength": 3
        }
      },
      "additionalProperties": false
    },
    "geography": {
      "type": "object",
      "required": [
        "name",
        "geography_id",
        "boundary_id",
        "boundary_version",
        "spatial_scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "geography_id": {
          "type": "string",
          "minLength": 1
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "boundary_version": {
          "type": "string",
          "minLength": 1
        },
        "spatial_scope": {
          "type": "string",
          "minLength": 5
        }
      },
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "required": [
        "start_date",
        "end_date",
        "temporal_resolution"
      ],
      "properties": {
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "temporal_resolution": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "native_unit": {
      "type": "string",
      "minLength": 1
    },
    "denominator_definition": {
      "type": "string",
      "minLength": 3
    },
    "measurement": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "point",
            "censored",
            "missing"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "censoring": {
          "type": "object",
          "required": [
            "operator",
            "threshold",
            "unit"
          ],
          "properties": {
            "operator": {
              "enum": [
                "<",
                "<="
              ]
            },
            "threshold": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transformation": {
      "type": "object",
      "required": [
        "kind",
        "method_id",
        "version",
        "description",
        "parameters",
        "output_unit",
        "input_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "identity",
            "unit_conversion",
            "aggregation",
            "normalization",
            "model_estimate"
          ]
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "parameters": {
          "type": "object"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "state",
        "coverage_fraction",
        "definition"
      ],
      "properties": {
        "state": {
          "enum": [
            "complete",
            "partial",
            "unknown",
            "not_applicable"
          ]
        },
        "coverage_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "definition": {
          "type": "string",
          "minLength": 5
        }
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "status",
        "method",
        "description"
      ],
      "properties": {
        "status": {
          "enum": [
            "quantified",
            "qualitative",
            "not_assessed"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "lower_bound": {
          "type": "number"
        },
        "upper_bound": {
          "type": "number"
        },
        "bounds_unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "observation_status": {
      "enum": [
        "observed",
        "estimated",
        "below_detection_limit",
        "not_collected",
        "not_applicable",
        "suppressed",
        "not_computable",
        "unknown"
      ]
    },
    "indicator_native_unit_contract": {
      "type": "string",
      "minLength": 3
    },
    "unit_mapping_note": {
      "type": "string",
      "minLength": 5
    },
    "denominator_contract_note": {
      "type": "string",
      "minLength": 5
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation_status": {
            "enum": [
              "observed",
              "estimated"
            ]
          }
        },
        "required": [
          "observation_status"
        ]
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "kind": {
                "const": "point"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "not": {
              "required": [
                "censoring"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_status": {
            "const": "below_detection_limit"
          }
        },
        "required": [
          "observation_status"
        ]
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "kind": {
                "const": "censored"
              },
              "value": {
                "type": "null"
              }
            },
            "required": [
              "kind",
              "value",
              "censoring"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_status": {
            "enum": [
              "not_collected",
              "not_applicable",
              "suppressed",
              "not_computable",
              "unknown"
            ]
          }
        },
        "required": [
          "observation_status"
        ]
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "kind": {
                "const": "missing"
              },
              "value": {
                "type": "null"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "not": {
              "required": [
                "censoring"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {
              "state": {
                "const": "complete"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "coverage_fraction": {
                "const": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {
              "state": {
                "const": "partial"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "coverage_fraction": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {
              "state": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "coverage_fraction": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "uncertainty": {
            "properties": {
              "status": {
                "const": "quantified"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "uncertainty"
        ]
      },
      "then": {
        "required": [
          "uncertainty"
        ],
        "properties": {
          "uncertainty": {
            "required": [
              "lower_bound",
              "upper_bound",
              "bounds_unit"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {}
}

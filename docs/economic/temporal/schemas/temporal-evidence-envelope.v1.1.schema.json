{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mycelix-temporal-evidence-v1.1.json",
  "title": "Mycelix Typed Temporal Evidence Envelope v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "status",
    "assertions"
  ],
  "properties": {
    "profile": {
      "const": "MYCELIX-TEMPORAL-EVIDENCE-V1"
    },
    "version": {
      "const": "1.1"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "subject_ref",
        "dimension",
        "time_value",
        "time_precision",
        "time_quality",
        "clock_profile",
        "source_authority_ref",
        "evidence_ref",
        "content_digest",
        "claim_id"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "dimension": {
          "enum": [
            "OCCURRED_AT",
            "VALID_FROM",
            "VALID_TO",
            "SOURCE_RECORDED_AT",
            "RECEIVER_OBSERVED_AT",
            "VERIFIER_KNOWLEDGE_AT"
          ]
        },
        "time_value": {
          "type": "string",
          "format": "date-time"
        },
        "time_precision": {
          "enum": [
            "NANOSECOND",
            "MICROSECOND",
            "MILLISECOND",
            "SECOND",
            "MINUTE",
            "DAY"
          ]
        },
        "time_quality": {
          "enum": [
            "SOURCE_ASSERTED",
            "ESTIMATED",
            "UNCERTAIN",
            "CONTESTED"
          ]
        },
        "clock_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_authority_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "uncertainty_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "earliest",
            "latest"
          ],
          "properties": {
            "earliest": {
              "type": "string",
              "format": "date-time"
            },
            "latest": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "supersedes_assertion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "assertion_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "verifier_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "knowledge_frontier_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "validity_interval_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Stable identity of one validity episode; all VALID_FROM/VALID_TO endpoints and their corrections share the same exact reference."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dimension": {
                "enum": [
                  "SOURCE_RECORDED_AT",
                  "RECEIVER_OBSERVED_AT",
                  "VERIFIER_KNOWLEDGE_AT"
                ]
              }
            },
            "required": [
              "dimension"
            ]
          },
          "then": {
            "required": [
              "assertion_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "VERIFIER_KNOWLEDGE_AT"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "then": {
            "required": [
              "verifier_ref",
              "knowledge_frontier_ref"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.1"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "assertions": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "dimension": {
                        "enum": [
                          "VALID_FROM",
                          "VALID_TO"
                        ]
                      }
                    },
                    "required": [
                      "dimension"
                    ]
                  },
                  "then": {
                    "required": [
                      "validity_interval_ref"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "dimension": {
                        "not": {
                          "enum": [
                            "VALID_FROM",
                            "VALID_TO"
                          ]
                        }
                      }
                    },
                    "required": [
                      "dimension"
                    ]
                  },
                  "then": {
                    "not": {
                      "required": [
                        "validity_interval_ref"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}

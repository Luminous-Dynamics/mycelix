{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/lise-benchmarks/ipb-finality-mutation-lab/schemas/oracle.schema.json",
  "title": "LISE typed mutation evaluator oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "generator_version",
    "case_count",
    "rows"
  ],
  "properties": {
    "suite_id": {
      "const": "LISE-TYPED-MUTATIONS-v0.1"
    },
    "generator_version": {
      "const": "lise-mutation-lab-v0.1"
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "internal_case_id",
          "family",
          "mutation",
          "control",
          "expected_decision"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^CASE-[0-9]{4}$"
          },
          "internal_case_id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "type": "string",
            "minLength": 1
          },
          "control": {
            "type": "boolean"
          },
          "expected_decision": {
            "type": "string",
            "pattern": "^(Permit|Deny\\([A-Za-z]+\\)|Hold\\([A-Za-z]+\\))$"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/lise-benchmarks/ipb-finality-mutation-lab/schemas/report.schema.json",
  "title": "LISE typed mutation self-conformance report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "generator_version",
    "control_count",
    "mutant_count",
    "killed_count",
    "survivor_count",
    "false_permit_count",
    "mutation_kill_rate",
    "cases"
  ],
  "properties": {
    "suite_id": {
      "const": "LISE-TYPED-MUTATIONS-v0.1"
    },
    "generator_version": {
      "const": "lise-mutation-lab-v0.1"
    },
    "control_count": {
      "type": "integer",
      "minimum": 0
    },
    "mutant_count": {
      "type": "integer",
      "minimum": 0
    },
    "killed_count": {
      "type": "integer",
      "minimum": 0
    },
    "survivor_count": {
      "type": "integer",
      "minimum": 0
    },
    "false_permit_count": {
      "type": "integer",
      "minimum": 0
    },
    "mutation_kill_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "family",
          "mutation",
          "control",
          "expected",
          "observed",
          "killed"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "mutation": {
            "type": "string"
          },
          "control": {
            "type": "boolean"
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "killed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

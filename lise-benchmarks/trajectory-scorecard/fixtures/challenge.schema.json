{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/mycelix/blob/main/lise-benchmarks/trajectory-scorecard/fixtures/challenge.schema.json",
  "title": "Candidate-visible trajectory scorecard challenge",
  "type": "object",
  "required": [
    "suite_id",
    "synthetic",
    "episodes"
  ],
  "properties": {
    "suite_id": {
      "const": "LISE-TRAJECTORY-SCORECARD-v0.1"
    },
    "synthetic": {
      "const": true
    },
    "episodes": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "episode_id",
          "state_structure",
          "trap_family",
          "principal_ref",
          "authorized_operations"
        ]
      }
    }
  },
  "additionalProperties": false
}

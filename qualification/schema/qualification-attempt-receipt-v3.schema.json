{
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "required": ["id", "revision", "digest"]
    },
    "execution_context": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "execution_context_format_revision": {"const": 3},
        "runner_profile_ref": {"$ref": "#/$defs/profile"}, "toolchain_profile_ref": {"$ref": "#/$defs/profile"},
        "environment_profile_ref": {"$ref": "#/$defs/profile"}, "execution_limits_profile_ref": {"$ref": "#/$defs/profile"},
        "resolved_runner_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolved_toolchain_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolved_environment_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["execution_context_format_revision", "runner_profile_ref", "toolchain_profile_ref", "environment_profile_ref", "execution_limits_profile_ref", "resolved_runner_commitment", "resolved_toolchain_commitment", "resolved_environment_commitment"]
    },
    "gate_result": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["GatePass", "GateFail", "RunnerInfrastructureFailure", "GateNotRun"]},
        "effective_exit_code": {"type": ["integer", "null"]},
        "captured_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "captured_output_bytes": {"type": "integer", "minimum": 0},
        "output_truncated": {"type": "boolean"},
        "runner_failure_reason": {"type": ["string", "null"]}
      },
      "required": ["id", "status", "effective_exit_code", "captured_output_sha256", "captured_output_bytes", "output_truncated", "runner_failure_reason"]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mycelix QCAP Attempt Receipt V3",
  "type": "object", "additionalProperties": false,
  "properties": {
    "receipt_format_revision": {"const": 3},
    "capsule_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "theorem_id": {"type": "string"}, "theorem_revision": {"type": "integer", "minimum": 1},
    "repository_identity": {"type": "string"}, "product_subject_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "attempt_id": {"type": "string"}, "execution_context": {"$ref": "#/$defs/execution_context"},
    "gate_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate_result"}},
    "verdict": {"enum": ["CompletedConjunctivePass", "CompletedConjunctiveFail", "RunnerInfrastructureFailure"]},
    "claim": {"type": "string"}, "nonclaims": {"type": "array", "items": {"type": "string"}},
    "receipt_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["receipt_format_revision", "capsule_commitment", "theorem_id", "theorem_revision", "repository_identity", "product_subject_sha", "attempt_id", "execution_context", "gate_results", "verdict", "claim", "nonclaims", "receipt_commitment"]
}

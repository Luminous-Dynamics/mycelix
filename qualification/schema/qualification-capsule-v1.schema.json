{
  "$defs": {
    "gate": {
      "additionalProperties": false,
      "properties": {
        "args": {"items": {"type": "string"}, "type": "array"},
        "class": {"enum": ["theorem", "oracle", "lineage"]},
        "id": {"type": "string"},
        "script": {"type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "timeout_seconds": {"minimum": 1, "maximum": 7200, "type": "integer"}
      },
      "required": ["id", "class", "script", "sha256", "args", "timeout_seconds"],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "id": {"type": "string"},
        "revision": {"minimum": 1, "type": "integer"}
      },
      "required": ["id", "revision", "digest"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capsule_format_revision": {"const": 1},
    "claim": {"minLength": 1, "type": "string"},
    "environment_profile_ref": {"$ref": "#/$defs/profile"},
    "expected_changed_paths": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "expected_object_blobs": {
      "additionalProperties": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
      "minProperties": 1,
      "type": "object"
    },
    "gates": {"items": {"$ref": "#/$defs/gate"}, "minItems": 1, "type": "array"},
    "nonclaims": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "predecessor_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "product_subject_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "repository_identity": {"type": "string"},
    "theorem_id": {"type": "string"},
    "theorem_revision": {"minimum": 1, "type": "integer"},
    "toolchain_profile_ref": {"$ref": "#/$defs/profile"},
    "verdict": {
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "all"},
        "required_gate_ids": {"items": {"type": "string"}, "type": "array", "uniqueItems": true}
      },
      "required": ["kind", "required_gate_ids"],
      "type": "object"
    }
  },
  "required": [
    "capsule_format_revision", "claim", "environment_profile_ref", "expected_changed_paths",
    "expected_object_blobs", "gates", "nonclaims", "predecessor_sha", "product_subject_sha",
    "repository_identity", "theorem_id", "theorem_revision", "toolchain_profile_ref", "verdict"
  ],
  "title": "Mycelix Qualification Capsule V1",
  "type": "object"
}
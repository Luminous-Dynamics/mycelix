{
  "name": "@mycelix/database",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",

  "description": "Database schema and client for Mycelix platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:accounting-guards": "prisma db execute --file prisma/accounting-append-only.sql --schema prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "prisma studio",
    "type-check:accounting-authority": "tsc -p tsconfig.accounting-authority.json",
    "test:accounting-authority": "tsx --test src/accounting-authority.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "prisma": "^5.7.0",
    "tsx": "^4.1.0",
    "typescript": "^5.2.2"
  }
}

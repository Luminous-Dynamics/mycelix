{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycelix.net/schemas/food/PackDesignV1.schema.json",
  "title": "PackDesignV1",
  "description": "Food packaging design descriptor. This is descriptive evidence, not a food-contact approval or compliance certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_id",
    "revision",
    "format_class",
    "intended_food_categories",
    "material",
    "capacity",
    "food_contact_assessment",
    "pressure_use",
    "cleaning_profile",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "design_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "format_class": {
      "enum": [
        "single_use",
        "refill",
        "reusable_return",
        "bulk",
        "loose",
        "hybrid"
      ]
    },
    "intended_food_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dry_staple",
          "flour_grain",
          "spice",
          "fresh_produce",
          "dairy",
          "meat_fish",
          "ready_to_eat",
          "frozen",
          "acidic",
          "other"
        ]
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "composition_summary",
        "food_contact_status"
      ],
      "properties": {
        "material_id": {
          "type": "string"
        },
        "grade": {
          "type": [
            "string",
            "null"
          ]
        },
        "composition_summary": {
          "type": "string",
          "minLength": 1
        },
        "food_contact_status": {
          "enum": [
            "not_assessed",
            "documentation_referenced",
            "independent_test_referenced",
            "withdrawn"
          ]
        },
        "food_contact_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominal_value",
        "usable_value",
        "unit",
        "tare_mass_g"
      ],
      "properties": {
        "nominal_value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "usable_value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "ml",
            "l",
            "g",
            "kg",
            "count"
          ]
        },
        "tare_mass_g": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "dimensions_mm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "closure_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "barrier_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "use_temperature_c": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "pressure_use": {
      "type": "boolean"
    },
    "pressure_use_qualification_ref": {
      "type": "string",
      "minLength": 1
    },
    "food_contact_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assessed_scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_assessed",
            "documentation_referenced",
            "independent_test_referenced",
            "rejected",
            "withdrawn"
          ]
        },
        "assessed_scope": {
          "type": "string"
        },
        "assessor_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cleaning_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_reference",
        "inspection_required"
      ],
      "properties": {
        "method_reference": {
          "type": "string"
        },
        "inspection_required": {
          "type": "boolean"
        },
        "max_service_cycles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "repair_instructions_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "retirement_criteria_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "design_rights_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "declared_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pressure_use": {
            "const": true
          }
        },
        "required": [
          "pressure_use"
        ]
      },
      "then": {
        "required": [
          "pressure_use_qualification_ref"
        ]
      }
    }
  ]
}
